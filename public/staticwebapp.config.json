{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/_astro/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/documents/*",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Content-Disposition": "inline"
      }
    },
    {
      "route": "/*.{png,jpg,jpeg,webp,avif,svg,ico,woff2}",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self' https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".avif": "image/avif",
    ".woff2": "font/woff2",
    ".pdf": "application/pdf"
  },
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_astro/*", "/documents/*", "/*.{css,js,png,jpg,jpeg,webp,avif,svg,ico,woff2,xml,txt,json}"]
  }
}
