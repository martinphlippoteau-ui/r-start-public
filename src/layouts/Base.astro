---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Consent from '@/components/Consent.astro';
import SubscribeSoon from '@/components/SubscribeSoon.astro';
import { site } from '@/config/site';
import JsonLd from '@/components/JsonLd.astro';
import { nav } from '@/content/fr/nav';
import { withBase } from '@/lib/href';
// Sous-ensemble latin de la police variable (le seul utilisé par le contenu français) : préchargé pour que
// le premier rendu du texte n'attende pas la découverte du @font-face dans la feuille de style. Même fichier
// que celui référencé par le CSS de @fontsource-variable/plus-jakarta-sans (global.css), donc un seul
// téléchargement ; `?url` passe par le pipeline d'assets de Vite, comme l'url() du CSS.
import plusJakartaLatinUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  noindex,
  ogImageAlt,
  jsonLd,
} = Astro.props;

/**
 * Type de page, joint à chaque événement de mesure (plan de taggage du 14/09/2026). Déduit du chemin
 * plutôt que passé en prop : une page qui oublierait la prop serait comptée « inconnu » sans que
 * personne ne le voie, alors que le chemin, lui, est toujours juste.
 * `souscriptionOuverte` accompagne chaque événement pour la même raison : tant que le tunnel n'est pas
 * ouvert, tous les appels à souscrire aboutissent à une fenêtre d'attente. Sans ce repère, les taux de
 * la période d'attente seraient comparés à ceux d'après l'ouverture, et la comparaison n'aurait
 * aucun sens.
 */
const chemin = (path ?? Astro.url.pathname).replace(/^\/+|\/+$/g, '');
const typeDePage = !chemin
  ? 'accueil'
  : ['mentions-legales', 'politique-de-confidentialite', 'cookies'].includes(chemin)
    ? 'legal'
    : chemin.replace(/\//g, '-');
---

<!doctype html>
{/* `intro` : cascade d'ouverture CSS du hero ([data-intro], global.css), décidée avant tout rendu, sans script inline (CSP). */}
<html lang="fr" dir="ltr" class="intro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /*
       * Défenses posées en BALISE, faute de pouvoir poser des en-têtes (14/09/2026). GitHub Pages ne
       * sert aucun en-tête personnalisé et ignore deploy/azure/staticwebapp.config.json : sans ces deux
       * balises, le site n'avait aucune politique de sécurité du contenu et aucune politique de
       * référent. La balise couvre la CSP et le référent ; elle ne peut PAS porter `frame-ancestors`,
       * `report-uri` ni `X-Frame-Options`, que les navigateurs n'acceptent qu'en en-tête. La protection
       * contre l'encadrement arrivera donc avec Azure, voir deploy/azure/README.md.
       *
       * La politique est celle du fichier Azure, à deux exceptions près, imposées par la balise :
       * `frame-ancestors` retiré, et `style-src 'unsafe-inline'` conservé (Astro pose des styles de
       * portée sur les éléments). Elle est APPLIQUÉE, pas en observation : aucun script exécutable en
       * ligne ne subsiste depuis la conversion des outils et du comparateur en blocs de données.
       */
    }
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' https://*.googletagmanager.com https://widget.trustpilot.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.trustpilot.com; img-src 'self' data: https://*.googletagmanager.com https://*.google-analytics.com https://*.trustpilot.com; style-src 'self' 'unsafe-inline'; font-src 'self' https://*.trustpilot.com; frame-src https://widget.trustpilot.com; base-uri 'self'; object-src 'none'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <Seo {title} {description} {path} {noindex} {ogImageAlt} />
    <link rel="preload" href={plusJakartaLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#024b67" />
    <meta name="color-scheme" content="light" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body
    class="min-h-svh bg-paper text-ink"
    data-page-type={typeDePage}
    data-souscription-ouverte={site.subscribeOpen ? 'oui' : 'non'}
  >
    <a href="#contenu" class="skip-link btn btn-primary btn-md">{nav.skipLink}</a>
    <slot />
    <Consent />
    {!site.subscribeOpen && <SubscribeSoon />}
    <script>
      import '@/scripts/consent';
      import '@/scripts/campagne';
      import '@/scripts/analytics';
      import '@/scripts/motion';
    </script>
  </body>
</html>
