---
/**
 * Page /outils (12/09/2026) : les quatre outils chiffrés du site.
 * SiteNav → main#contenu : PageHero (fil d'Ariane, H1, ligne risques visible sans défiler) → cadre qui
 * pose la règle commune aux quatre outils → simulateur de frais et point de bascule → calendrier de
 * jouissance → coût d'une sortie anticipée → versements programmés → notes → Footer.
 *
 * Règle de la page : aucun outil ne projette de performance. Ils appliquent les taux du contrat aux
 * montants saisis par le visiteur, et le cadre en tête de page le dit avant tout calcul. Voir
 * src/content/fr/toolsPage.ts pour le détail et pour les deux idées écartées.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Container from '@/components/ui/Container.astro';
import PageHero from '@/components/ui/PageHero.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import ToolsSuite from '@/components/pages/outils/ToolsSuite.astro';
import { pages } from '@/config/pages';
import { notes, toolsPage } from '@/content/fr/toolsPage';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.tools;
const { seo, hero, frame } = toolsPage;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('tools'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero eyebrow={hero.eyebrow} title={hero.title} riskLine={hero.riskLine}>
      <Breadcrumb slot="breadcrumb" key="tools" tone="dark" />
    </PageHero>

    {
      /* Le cadre se lit AVANT le premier outil : il dit ce que ces calculs sont, et ce qu'ils ne sont
        pas. Son contre-poids est son frère direct, à la même taille, jamais animé. */
    }
    <Section id="cadre" tone="paper" spacing="compact" labelledBy="cadre-title">
      <Container size="wide">
        <h2 id="cadre-title" class="text-display-sm">{frame.title}</h2>
        <div data-advantage class="text-lead mt-4 max-w-3xl text-ink">
          <p>{frame.body}</p>
        </div>
        <RiskNote text={frame.risk} size="lead" class="mt-5" noteId={frame.noteId} />
      </Container>
    </Section>

    <ToolsSuite />
    <LegalNotes notes={notes} />
  </main>
  <Footer />
</Base>
