---
/**
 * Page de prévisualisation (développement) : assemble automatiquement toutes les sections présentes dans
 * src/components/sections dans l'ordre de leur nom de fichier (NN-Nom.astro).
 * HORS ROUTAGE depuis le 10/09/2026 (préfixe `_` : Astro ne construit pas la page) : elle rendait les
 * sections 05, 06 et 09 retirées de l'accueil, avec leurs anciens libellés, sur une URL atteignable.
 * Pour la réactiver ponctuellement en local, retirer le `_` du nom de fichier, sans la livrer.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Footer from '@/components/Footer.astro';
import { seo } from '@/content/fr/seo';

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const modules = import.meta.glob<{ default: any }>('/src/components/sections/*.astro', {
  eager: true,
});
const all = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ path, Component: mod.default }));
const hero = all.find((s) => /\/01-/.test(s.path));
const rest = all.filter((s) => s !== hero);
---

<Base
  title="Prévisualisation des sections R Start"
  description={seo.description}
  path="/sections-preview"
  noindex
>
  <SiteNav />
  <main id="contenu">
    {hero && <hero.Component />}
    {rest.map(({ Component }) => <Component />)}
    <LegalNotes />
  </main>
  <Footer />
</Base>
