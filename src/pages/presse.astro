---
/**
 * Page /presse, « La presse en parle » (grand public) : SiteNav collée en haut → main#contenu
 * (PageHero avec le fil d'Ariane dans son slot et le CTA, sans ligne risques depuis le 14/09/2026 →
 * citations mises en avant → revue de presse → contacts presse, zone 4 → LegalNotes, toujours monté
 * mais qui ne rend rien, AFFICHER = false) → Footer. L'avertissement de la revue, dans sa bande
 * sombre, a été retiré le 16/09/2026 (voir press.ts).
 * La salle de presse, qui portait les communiqués et le kit média (arbitrage du 10/09/2026), a été
 * désactivée le 15/09/2026 puis supprimée le 22/09/2026 ; ses contacts sont rendus ici.
 * Métadonnées (title, description, canonical) depuis press.seo, chemin depuis src/config/pages.ts ;
 * JSON-LD Organization + WebPage + BreadcrumbList via src/lib/seo.ts. Aucun texte en dur.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Coverage from '@/components/pages/presse/Coverage.astro';
import Quotes from '@/components/pages/presse/Quotes.astro';
import Contacts from '@/components/pages/presse/Contacts.astro';
import { pages } from '@/config/pages';
import { press } from '@/content/fr/press';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const path = pages.press.path;
const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path, title: press.seo.title, description: press.seo.description }),
  breadcrumbJsonLd('press'),
];
---

<Base title={press.seo.title} description={press.seo.description} path={path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero title={press.hero.title} intro={press.hero.intro}>
      <Breadcrumb slot="breadcrumb" key="press" tone="dark" />
      <Button slot="cta" position={press.cta.position} variant="light" size="lg">
        {press.cta.label}
      </Button>
      {
        /* LE TABLEAU DES MÉDIAS EST RETIRÉ de l'en-tête le 16/09/2026, demande de l'équipe. Il listait
          les trois médias cités et leur date dans la moitié droite. Les mêmes médias et les mêmes
          dates restent lisibles juste en dessous, sur chaque citation : l'information n'est pas perdue,
          elle n'est plus annoncée deux fois.
          `press.labels.quotesListLabel` reste lu : c'est le nom accessible de la liste des
          citations (Quotes.astro). */
      }
    </PageHero>
    <Quotes />
    <Coverage />

    {
      /* ZONE 4 (15/09/2026). Cette place portait un renvoi vers /salle-de-presse. L'équipe a demandé de
        ne pas encore ouvrir cette page aux journalistes, faute de communiqués à y mettre : la route
        a été désactivée ce jour-là, puis la salle de presse supprimée le 22/09/2026. Les contacts
        sont servis ici, par le composant écrit pour elle, déplacé sous components/pages/presse/. */
    }
    <Contacts tone="paper" />

    <LegalNotes notes={press.notes} />
  </main>

  {/* Pastille d'appel : rendue au niveau de la page, jamais dans une section. */}
  {
    /* Pastille d'appel : elle prend le RELAIS du CTA de l'en-tête, dès que celui-ci n'est plus à
      l'écran, et reste jusqu'au bas de page. Accrochée à une section, elle laissait un trou pendant
      lequel la page ne portait plus aucun appel. */
  }
  <StickyCta
    label={press.cta.label}
    position={press.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
