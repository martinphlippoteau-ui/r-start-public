---
/**
 * Page /presse, « La presse en parle » (grand public) : SiteNav collée en haut → main#contenu
 * (PageHero avec le fil d'Ariane dans son slot et le CTA, sans ligne risques → citations mises en
 * avant → revue de presse → contacts presse, zone 4) → Footer. Les notes légales et la salle de
 * presse (communiqués, kit média) ont quitté l'écran le 14 et le 15/09/2026 à la demande de
 * l'équipe, puis le code le 22/09/2026 ; seuls les contacts presse sont rendus ici. L'avertissement
 * de la revue a quitté sa bande sombre le 16/09/2026 (voir press.ts). Métadonnées (title,
 * description, canonical) depuis press.seo, chemin depuis src/config/pages.ts ; JSON-LD
 * Organization + WebPage + BreadcrumbList via src/lib/seo.ts. Aucun texte en dur.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Coverage from '@/components/pages/presse/Coverage.astro';
import Quotes from '@/components/pages/presse/Quotes.astro';
import Contacts from '@/components/pages/presse/Contacts.astro';
import { pages } from '@/config/pages';
import { press } from '@/content/fr/press';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const path = pages.press.path;
const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path, title: press.seo.title, description: press.seo.description }),
  breadcrumbJsonLd('press'),
];
---

<Base title={press.seo.title} description={press.seo.description} path={path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero title={press.hero.title} intro={press.hero.intro}>
      <Breadcrumb slot="breadcrumb" key="press" tone="dark" />
      <Button slot="cta" position={press.cta.position} variant="light" size="lg">
        {press.cta.label}
      </Button>
      {
        /* Plus de tableau des médias dans l'en-tête (16/09/2026, demande de l'équipe) : les mêmes
          médias et les mêmes dates restent lisibles sur chaque citation, l'information n'est plus
          annoncée deux fois. `press.labels.quotesListLabel` reste lu : c'est le nom accessible de
          la liste des citations (Quotes.astro). */
      }
    </PageHero>
    <Quotes />
    <Coverage />

    {
      /* Zone 4 : les contacts presse, servis par le composant écrit pour la salle de presse
        (components/pages/presse/). L'équipe a demandé de ne pas ouvrir cette page aux journalistes
        faute de communiqués (15/09/2026) ; elle a été supprimée le 22/09/2026. */
    }
    <Contacts tone="paper" />
  </main>

  {
    /* Pastille d'appel (au niveau de la page, voir StickyCta.astro) : relais du CTA de l'en-tête
      dès qu'il n'est plus à l'écran, jusqu'au bas de page. Accrochée à une section, elle laissait
      un trou pendant lequel la page ne portait plus aucun appel. */
  }
  <StickyCta
    label={press.cta.label}
    position={press.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
