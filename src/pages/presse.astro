---
/**
 * Page /presse, « La presse en parle » (grand public) : SiteNav collée en haut → main#contenu
 * (PageHero avec le fil d'Ariane dans son slot et la ligne risques visible sans scroller → citations
 * mises en avant → revue de presse → avertissement dans sa propre bande sombre → renvoi vers la salle
 * de presse → notes propres à la page) → Footer.
 * Les communiqués, les contacts et le kit média ont quitté cette page : ils vivent sur /salle-de-presse,
 * accessible depuis le pied de page (arbitrage du 10/09/2026).
 * Métadonnées (title, description, canonical) depuis press.seo, chemin depuis src/config/pages.ts ;
 * JSON-LD Organization + WebPage + BreadcrumbList via src/lib/seo.ts. Aucun texte en dur.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Coverage from '@/components/pages/presse/Coverage.astro';
import Quotes from '@/components/pages/presse/Quotes.astro';
/* Zone 4 : le composant vit sous salle-de-presse/ parce qu'il y est né. Sa page est désactivée,
   lui reste, c'est /presse qui le rend maintenant. */
import Contacts from '@/components/pages/salle-de-presse/Contacts.astro';
import { pages } from '@/config/pages';
import { press } from '@/content/fr/press';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const path = pages.press.path;
const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path, title: press.seo.title, description: press.seo.description }),
  breadcrumbJsonLd('press'),
];
---

<Base title={press.seo.title} description={press.seo.description} path={path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero eyebrow={press.hero.eyebrow} title={press.hero.title} intro={press.hero.intro}>
      <Breadcrumb slot="breadcrumb" key="press" tone="dark" />
      <Button slot="cta" position={press.cta.position} variant="light" size="lg">
        {press.cta.label}
      </Button>
      {
        /* Les médias des citations mises en avant, avec leur date : sur grand écran ils occupent la
          moitié droite restée vide et annoncent qui parle, avant même la première citation. Aucun
          logo (aucune licence) : les noms sont en typographie, comme dans le reste de la page. */
      }
      <ul
        slot="aside"
        role="list"
        aria-label={press.labels.quotesListLabel}
        class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur-sm sm:p-8"
      >
        {
          press.quotes.items.map((quote) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-white/15 py-3 first:pt-0 last:border-0 last:pb-0">
              <span class="text-base font-semibold text-white sm:text-lg">{quote.media}</span>
              <time datetime={quote.dateIso} class="shrink-0 text-base text-white/80">
                {quote.date}
              </time>
            </li>
          ))
        }
      </ul>
    </PageHero>
    <Quotes />
    <Coverage />

    {
      /* ZONE 4 (15/09/2026). Cette place portait un renvoi vers /salle-de-presse. L'équipe a demandé de
        ne pas encore ouvrir cette page aux journalistes, faute de communiqués à y mettre : la route est
        désactivée et les contacts sont servis ici, par le composant déjà écrit pour eux. */
    }
    <Contacts tone="paper" />

    <LegalNotes notes={press.notes} />
  </main>

  {
    /* Pastille d'appel : elle arrive avec la première section de contenu et reste jusqu'au bas de page.
      Rendue au niveau de la page, jamais dans une section. */
  }
  {
    /* Pastille d'appel : elle prend le RELAIS du CTA de l'en-tête, dès que celui-ci n'est plus à
      l'écran, et reste jusqu'au bas de page. Accrochée à une section, elle laissait un trou pendant
      lequel la page ne portait plus aucun appel. */
  }
  <StickyCta
    label={press.cta.label}
    position={press.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
