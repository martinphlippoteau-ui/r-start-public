---
/**
 * Une page par outil, sous /outil (12/09/2026).
 * SiteNav → main#contenu : PageHero (fil d'Ariane à trois niveaux, H1, ligne risques visible sans
 * défiler) → l'outil, avec son sélecteur de niveau → renvois vers les trois autres → notes → Footer,
 * puis la fenêtre d'acceptation, en dernier enfant du document.
 *
 * Le chemin, le libellé et le fil d'Ariane viennent de src/config/pages.ts par `pageKey` : aucune URL
 * n'est écrite ici. Le composant d'outil est choisi par ce même `pageKey`, l'association est donc
 * vérifiée à la compilation.
 *
 * Règle de la page : aucun outil ne projette de performance. La fenêtre d'acceptation (ToolsGate) le
 * dit sur chaque page et demande un accusé de lecture, parce qu'un visiteur peut arriver ici sans être
 * passé par /outils.
 */
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import ToolsGate from '@/components/pages/outils/ToolsGate.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import EnjoymentTool from '@/components/pages/outils/EnjoymentTool.astro';
import ExitTool from '@/components/pages/outils/ExitTool.astro';
import FeeTool from '@/components/pages/outils/FeeTool.astro';
import SavingsTool from '@/components/pages/outils/SavingsTool.astro';
import ToolCard from '@/components/pages/outils/ToolCard.astro';
import { pages, type PageKey } from '@/config/pages';
import { notes, toolCards, toolsPage } from '@/content/fr/toolsPage';
import { withBase } from '@/lib/href';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

/** Un composant par outil. La clé est celle de src/config/pages.ts : rien à synchroniser à la main. */
const composants = {
  toolFees: FeeTool,
  toolEnjoyment: EnjoymentTool,
  toolExit: ExitTool,
  toolSavings: SavingsTool,
} as const;

export const getStaticPaths = (() =>
  toolCards.map((outil) => ({
    /* Le slug est la dernière portion du chemin déclaré dans src/config/pages.ts. */
    params: { slug: pages[outil.pageKey].path.split('/').pop() },
    props: { pageKey: outil.pageKey },
  }))) satisfies GetStaticPaths;

const { pageKey } = Astro.props as { pageKey: keyof typeof composants };
const page = pages[pageKey as PageKey];
const outil = toolCards.find((o) => o.pageKey === pageKey)!;
const Outil = composants[pageKey];
const { elsewhere, index } = toolsPage;

const titre = `${page.label} | ${toolsPage.seo.title}`;
const description = outil.card.teaser;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: titre, description }),
  breadcrumbJsonLd(pageKey as PageKey),
];

/** Les trois autres outils, dans l'ordre, pour le renvoi de bas de page. */
const autres = toolCards.filter((o) => o.pageKey !== pageKey);
---

<Base title={titre} description={description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    {
      /* PAS DE HERO (13/09/2026, demande de l'équipe) : on entre dans l'outil tout de suite. Reste un
        en-tête compact, fil d'Ariane et H1 unique.
        La LIGNE RISQUES n'y est plus, elle a été déplacée dans la colonne de gauche de l'outil, sous son
        introduction (ToolFunnel). Elle ne pouvait pas simplement disparaître : toute sous-page produit
        doit la porter (scripts/check-compliance.mjs), et elle reste ici au-dessus de la ligne de
        flottaison sur grand écran. */
    }
    {
      /* La barre flottante est collée en haut et recouvre le début de la page : sa hauteur est réservée
        dans la marge haute, faute de quoi le fil d'Ariane passe dessous. */
    }
    <Section
      id="en-tete"
      tone="paper"
      spacing="none"
      labelledBy="en-tete-title"
      class="pt-[calc(var(--spacing-nav-total)+1rem)] pb-2 sm:pb-4 lg:pt-[calc(var(--spacing-nav-total)+1.5rem)] lg:pb-6"
    >
      <Container size="wide">
        <Breadcrumb key={pageKey as PageKey} tone="light" />
        <h1 id="en-tete-title" class="text-display-md mt-3 text-balance">{page.label}</h1>
      </Container>
    </Section>

    <Outil />

    <Section id="autres-outils" tone="paper" labelledBy="autres-outils-title">
      <Container size="wide">
        <h2 id="autres-outils-title" class="text-display-sm">{elsewhere.title}</h2>

        <ul class="mt-8 grid gap-6 sm:grid-cols-3" role="list">
          {
            autres.map((o) => (
              <li class="h-full">
                <ToolCard
                  href={pages[o.pageKey].path}
                  eyebrow={o.card.eyebrow}
                  title={pages[o.pageKey].label}
                  question={o.card.question}
                  teaser={o.card.teaser}
                  cta={index.cardCta}
                />
              </li>
            ))
          }
        </ul>

        <p class="mt-8">
          <a href={withBase(pages.tools.path)} class="text-base font-semibold text-navy">
            {elsewhere.backLabel}
          </a>
        </p>
      </Container>
    </Section>

    <LegalNotes notes={notes} />
  </main>
  <Footer />

  {
    /* Fenêtre d'acceptation : rendue APRÈS le pied de page, en dernier enfant du document. Une modale
      rend le reste inerte, elle n'a donc aucune raison de vivre dans le contenu, et hors de `main` elle
      ne s'intercale pas dans la lecture linéaire de la page une fois acceptée. */
  }
  <ToolsGate />
</Base>
