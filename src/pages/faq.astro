---
/**
 * Page /faq (16/09/2026) : LES DIX-HUIT QUESTIONS, avec un champ de recherche. Les autres pages
 * n'en rendent que quatre et renvoient ici (faq.moreLink). Hors menu, comme /documentation.
 * ELLE RÉUTILISE LA SECTION DE L'ACCUEIL, paramétrée : l'accordéon, ses transitions
 * `::details-content` et le découpage avantage / contre-poids sont écrits une seule fois, les deux
 * surfaces ne peuvent donc pas diverger. Le renvoi est masqué ici, la page EST la destination.
 * LA RECHERCHE N'INTERROGE RIEN : les questions sont toutes dans le HTML et le script se contente
 * de masquer celles qui ne correspondent pas. La page se lit donc entière sans JavaScript, et le
 * champ n'apparaît que si le script s'exécute.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import StickyCta from '@/components/StickyCta.astro';
import Faq from '@/components/sections/10-Faq.astro';
import { pages } from '@/config/pages';
import { faq } from '@/content/fr/faq';
import { breadcrumbJsonLd, faqJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.faq;
const titre = faq.pageTitle ?? faq.title;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: titre, description: faq.pageDescription }),
  breadcrumbJsonLd('faq'),
  /* Le JSON-LD porte les DIX-HUIT questions, et non les quatre de l'accueil : c'est cette page que les
     moteurs doivent associer à la FAQ du site. */
  faqJsonLd(faq.allItems ?? faq.items),
];
---

<Base title={titre} description={faq.pageDescription} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero title={titre}>
      <Breadcrumb slot="breadcrumb" key="faq" tone="dark" />
      <Button slot="cta" position={faq.cta.position} variant="light" size="lg">
        {faq.cta.label}
      </Button>
    </PageHero>

    {
      /* `showMoreLink` à false : cette page est la destination du renvoi, il n'a rien à pointer.
        Le titre de la liste est son libellé propre, l'en-tête de la page étant juste au-dessus. */
    }
    <Faq
      items={faq.allItems ?? faq.items}
      showMoreLink={false}
      search
      title={faq.listLabel ?? titre}
      tone="white"
      revealTitle={false}
    />
  </main>

  <StickyCta label={faq.cta.label} position={faq.cta.position} from="#faq" />
  <Footer />
</Base>
