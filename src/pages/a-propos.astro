---
/**
 * Page /a-propos, la société de gestion (contenu fourni par l'équipe le 14/09/2026). SiteNav →
 * main#contenu : PageHero (fil d'Ariane, H1 « R Start, une innovation signée CORUM », deux
 * paragraphes d'introduction, CTA souscrire, SANS ligne risques) → les cinq chiffres du groupe
 * (#corum), la bande illustrée et la gamme des autres SCPI (#gamme, CorumRange.astro) → le bloc
 * Risques commun (#risques, 08-Risks.astro) → les avis Trustpilot (#avis) → Footer. Les notes
 * légales, les trois savoir-faire et le bloc #histoire ont quitté la page à la demande de l'équipe
 * (14 et 16/09/2026), puis le code le 22/09/2026 (archivés hors du dépôt, .claude/audits).
 * Métadonnées et JSON-LD depuis aboutPage.ts, config/pages.ts et src/lib/seo.ts : aucun texte en
 * dur.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import TrustpilotReviews from '@/components/ui/TrustpilotReviews.astro';
import TrustpilotScript from '@/components/TrustpilotScript.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CorumRange from '@/components/pages/a-propos/CorumRange.astro';
import Risks from '@/components/sections/08-Risks.astro';
import { pages } from '@/config/pages';
import { aboutPage } from '@/content/fr/aboutPage';
import { breadcrumbJsonLd, socleJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.about;
const { seo, hero } = aboutPage;

const jsonLd = [
  ...socleJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description, type: 'AboutPage' }),
  breadcrumbJsonLd('about'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  {
    /* Script d'amorçage des TrustBox : sans lui, le carrousel d'avis en bas de page ne
      s'initialisait jamais et retombait sur son lien de repli (audit du 16/09/2026). */
  }
  <TrustpilotScript slot="head" />
  <SiteNav />
  <main id="contenu">
    <PageHero title={hero.title} intro={hero.intro} sousPlan>
      <Breadcrumb slot="breadcrumb" key="about" tone="dark" />
      <Button slot="cta" position={aboutPage.cta.position} variant="light" size="lg">
        {aboutPage.cta.label}
      </Button>
    </PageHero>
    {
      /* La page enchaîne l'en-tête sur les chiffres du groupe : le bloc « En 2011, CORUM a une
        conviction » qui les séparait a été retiré le 16/09/2026 à la demande de l'équipe (archivé
        hors du dépôt, .claude/audits). */
    }
    <CorumRange />

    {
      /* BLOC RISQUES sous la gamme (16/09/2026, demande de l'équipe) : le bloc commun, celui de
        l'accueil et de /strategie, un seul texte de risques sur tout le site, jamais une variante
        écrite pour une page. Il vient juste après les chiffres et les SCPI qu'il qualifie, avant
        les avis. */
    }
    {/* `rideau={false}` : la transition en rideau est un effet GSAP, et cette page doit rester sans
      GSAP (tests/performance.spec.ts). Le contenu du bloc est identique. */}
    <Risks />
    {
      /* Les avis Trustpilot ferment la page (15/09/2026, demande de l'équipe : « mettre les avis
        trustpilot dans la page à propos tout en bas ») : la page dit qui gère R Start, les avis
        disent ce qu'on pense de ce gestionnaire, leur portée étant bien CORUM L'Épargne et non R
        Start. `paper` après le bloc Risques (ink) : le carrousel pose ses propres cartes
        blanches. `niveau={2}` : le bloc est seul dans sa section et en porte le titre. */
    }
    <Section id="avis" tone="paper" labelledBy="avis-title" plan="haut">
      <Container size="wide">
        <TrustpilotReviews titleId="avis-title" />
      </Container>
    </Section>
  </main>

  {
    /* Pastille d'appel (au niveau de la page, voir StickyCta.astro) : relais du CTA de l'en-tête
      dès qu'il n'est plus à l'écran, jusqu'au bas de page. Accrochée à la première section, elle
      doublait un CTA encore visible à quelques centimètres. */
  }
  <StickyCta
    label={aboutPage.cta.label}
    position={aboutPage.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
