---
/**
 * Page /a-propos, la société de gestion. Contenu fourni par l'équipe le 14/09/2026.
 * SiteNav → main#contenu : PageHero (fil d'Ariane, H1 « L'expérience derrière R Start », deux
 * paragraphes d'introduction, CTA souscrire, SANS ligne risques) → #histoire, la conviction de 2011 et
 * les cinq transformations du modèle (CorumHistory.astro) → les cinq chiffres du groupe (#corum), la
 * photo des bureaux en pleine largeur et la gamme des cinq SCPI (#gamme) (CorumRange.astro) → Footer.
 * La section des trois savoir-faire et le bloc de notes ont été retirés le même jour.
 * Métadonnées et JSON-LD depuis aboutPage.ts, config/pages.ts et src/lib/seo.ts : aucun texte en dur.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import TrustpilotReviews from '@/components/ui/TrustpilotReviews.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CorumRange from '@/components/pages/a-propos/CorumRange.astro';
import Risks from '@/components/sections/08-Risks.astro';
import { pages } from '@/config/pages';
import { aboutPage } from '@/content/fr/aboutPage';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.about;
const { seo, hero, notes } = aboutPage;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('about'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero eyebrow={hero.eyebrow} title={hero.title} intro={hero.intro}>
      <Breadcrumb slot="breadcrumb" key="about" tone="dark" />
      <Button slot="cta" position={aboutPage.cta.position} variant="light" size="lg">
        {aboutPage.cta.label}
      </Button>
    </PageHero>
    {
      /*
       * BLOC « En 2011, CORUM a une conviction » RETIRÉ le 16/09/2026, demande de l'équipe. Il racontait
       * d'où vient CORUM et pourquoi R Start arrive maintenant, entre l'en-tête et les chiffres du
       * groupe. Le composant et son contenu restent en place (components/pages/a-propos/CorumHistory.astro
       * et corum.ts) : une ligne suffit à le remettre.
       * La page enchaîne donc l'en-tête sur les chiffres, qui portent le même propos en plus court.
       */
    }
    <CorumRange notes={notes} />

    {
      /* BLOC RISQUES sous la gamme (16/09/2026, demande de l'équipe). C'est le bloc commun, celui de
        l'accueil et de /strategie : un seul texte de risques sur tout le site, jamais une variante
        écrite pour une page. Il vient après la gamme et avant les avis, c'est-à-dire juste après les
        chiffres et les SCPI qu'il qualifie. */
    }
    {/* `rideau={false}` : la transition en rideau est un effet GSAP, et cette page doit rester sans
      GSAP (tests/performance.spec.ts). Le contenu du bloc est identique. */}
    <Risks rideau={false} />
    {
      /* LES AVIS TRUSTPILOT FERMENT LA PAGE (15/09/2026, demande de l'équipe : « mettre les avis
        trustpilot dans la page à propos tout en bas »). Ils occupaient la section « L'expérience
        derrière R Start » de l'accueil, où le bandeau des chiffres du groupe les a remplacés.
        Ils tombent bien ici : la page dit qui gère R Start, les avis disent ce qu'on pense de ce
        gestionnaire. Leur portée est d'ailleurs celle-là, CORUM L'Épargne et non R Start.
        `paper` après le `white` de la gamme : le carrousel pose ses propres cartes blanches, il lui
        faut un fond clair mais distinct du leur. `niveau={2}` parce que le bloc est seul dans sa
        section et doit donc en porter le titre. */
    }
    <Section id="avis" tone="paper" labelledBy="avis-title">
      <Container size="wide">
        <TrustpilotReviews notes={notes} niveau={2} titleId="avis-title" />
      </Container>
    </Section>
    <LegalNotes notes={notes} />
  </main>

  {
    /* Pastille d'appel : elle arrive avec la première section de contenu et reste jusqu'au bas de page.
      Rendue au niveau de la page, jamais dans une section. */
  }
  {
    /* Pastille d'appel : elle prend le RELAIS du CTA de l'en-tête, dès que celui-ci n'est plus à
      l'écran, et reste jusqu'au bas de page. Accrochée à la première section de contenu, elle
      s'affichait alors que le CTA de l'en-tête était encore visible : deux appels identiques à quelques
      centimètres l'un de l'autre. */
  }
  <StickyCta
    label={aboutPage.cta.label}
    position={aboutPage.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
