---
/**
 * Page /simulateur (19/09/2026, demande de Martin) : l'en-tête, puis le simulateur. Rien d'autre.
 * CE QUE LA PAGE NE FAIT PAS, et c'est ce qui la rend publiable : elle ne suppose AUCUN taux à R
 * Start, qui n'a pas d'historique. Le visiteur fixe lui-même l'hypothèse qu'il teste ; deux repères
 * de marché, sourcés et datés, l'aident à la situer, et l'avertissement accompagne chaque résultat
 * (src/content/fr/simulator.ts ; scripts/check-compliance.mjs tient ces conditions au build).
 * UN EN-TÊTE DE PRÉ-TUNNEL, PAS UN HERO (21/09/2026, Martin : « j'aimerais que le hero soit
 * beaucoup plus discret, c'est une sorte de pré-tunnel ») : fond clair, fil d'Ariane, titre de
 * taille moyenne comme les pages légales, la première question juste dessous, et pas de bouton
 * « Souscrire en ligne » : on ne propose pas de souscrire avant d'avoir simulé, le bouton de la
 * barre reste à l'écran et le résultat mène à la souscription. PAS DE PASTILLE FLOTTANTE ICI : sur
 * téléphone, le bas de l'écran est occupé par la barre de synthèse du simulateur. Aucun texte en
 * dur.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Container from '@/components/ui/Container.astro';
import Simulator from '@/components/pages/simulateur/Simulator.astro';
import SimulatorGate from '@/components/pages/simulateur/SimulatorGate.astro';
import { pages } from '@/config/pages';
import { simulator } from '@/content/fr/simulator';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.simulator;
const { seo, hero } = simulator;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('simulator'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  {
    /* La barre flottante recouvre le haut de la page : sa hauteur est réservée ici, comme sur les
      pages légales (les pages à en-tête sombre la réservent dans leur en-tête). */
  }
  <main id="contenu" class="pt-nav-total bg-paper">
    <Container size="wide" class="pt-5 sm:pt-8">
      <Breadcrumb key="simulator" tone="light" />
      <h1 class="text-display-md mt-3 sm:mt-4">{hero.title}</h1>
    </Container>
    <Simulator />
  </main>
  <Footer />
  {
    /* HORS DE <main>, EN DERNIER : elle recouvre la page dès le premier pixel, et le verrou de page
      rend inerte tout ce qui n'est pas elle, <main> compris (SimulatorGate.astro dit pourquoi). */
  }
  <SimulatorGate />
</Base>
