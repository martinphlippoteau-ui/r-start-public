---
/**
 * Page /simulateur (19/09/2026, demande de Martin) : l'en-tête, puis le simulateur. Rien d'autre.
 *
 * CE QUE LA PAGE NE FAIT PAS, et c'est ce qui la rend publiable : elle ne suppose AUCUN taux à R Start,
 * qui n'a pas d'historique. Le visiteur fixe lui-même l'hypothèse qu'il teste ; deux repères de marché,
 * sourcés et datés, l'aident à la situer, et l'avertissement accompagne chaque résultat. Le détail est
 * dans src/content/fr/simulator.ts, et scripts/check-compliance.mjs tient ces conditions au build.
 *
 * PAS DE PASTILLE FLOTTANTE ICI, contrairement aux autres sous-pages : le bas de l'écran est occupé,
 * sur téléphone, par la barre de synthèse du simulateur. L'appel à souscrire est dans l'en-tête.
 * Contenu : src/content/fr/simulator.ts (aucun texte en dur).
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Simulator from '@/components/pages/simulateur/Simulator.astro';
import { pages } from '@/config/pages';
import { simulator } from '@/content/fr/simulator';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.simulator;
const { seo, hero, cta } = simulator;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('simulator'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero eyebrow={hero.eyebrow} title={hero.title} compact>
      <Breadcrumb slot="breadcrumb" key="simulator" tone="dark" />
      <Button slot="cta" position={cta.position} variant="light" size="lg">{cta.label}</Button>
    </PageHero>
    <Simulator />
  </main>
  <Footer />
</Base>
