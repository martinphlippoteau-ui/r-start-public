---
/**
 * Page d'accueil : SiteNav collée en haut → main#contenu (sections de la trame, HOME_ORDER) →
 * Footer. Les sections viennent de src/components/sections/NN-Nom.astro ; l'ordre est celui de
 * HOME_ORDER, qui fait foi (src/config/sections.ts ne donne que les ancres). Métadonnées et JSON-LD
 * depuis seo.ts, legal.ts, facts.ts et faq.ts via src/lib/seo.ts (rien en dur). Aucun préchargement
 * d'image : le hero n'a pas d'image de fond, le LCP est le logo ou l'accroche.
 */
import Base from '@/layouts/Base.astro';
import TrustpilotScript from '@/components/TrustpilotScript.astro';
import IntroOnce from '@/components/IntroOnce.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import { seo } from '@/content/fr/seo';
import { faq } from '@/content/fr/faq';
import { difference } from '@/content/fr/difference';
import { subscribe } from '@/content/fr/subscribe';
import { faqJsonLd, socleJsonLd, webPageJsonLd } from '@/lib/seo';
/* 04-Strategy EST EXCLUE DU MOTIF (audit du 18/09/2026) : elle n'est rendue que par /strategie, qui
   l'importe directement. Astro rattache à une page la CSS de tout module qu'elle importe : l'accueil
   chargeait donc en bloquant les 20 Ko de sa feuille (31 @keyframes), dont aucun sélecteur n'existe
   ici. Même piège que pour les images (src/lib/images.ts) : un glob n'est pas gratuit. */
const modules = import.meta.glob<{ default: any }>(
  ['/src/components/sections/*.astro', '!/src/components/sections/04-*.astro'],
  { eager: true }
);
const all = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ path, Component: mod.default }));
/**
 * Trame de l'accueil, par préfixe de fichier ; HOME_ORDER fait foi, dans cet ordre exact : 01 Hero
 * → 01b Qui a envie de payer avant de gagner ? → 01c Points essentiels à connaître (22/09/2026,
 * ink) → 02 R Start en un clin d'œil (white depuis le 22/09/2026) → 03 Comparateur de
 * frais → 07 Le groupe CORUM en quelques chiffres → 03a Immeuble → 06 Souscrire → 08 Risques → 10 FAQ. Aucune
 * section n'existe sans être rendue, sauf 04 Stratégie, importée directement par /strategie.
 */
const HOME_ORDER = ['01-', '01b-', '01c-', '02-', '03-', '07-', '03a-', '06-', '08-', '10-'];
const byPrefix = (prefix: string) => all.find((s) => s.path.includes('/sections/' + prefix));
const hero = byPrefix('01-');
const rest = HOME_ORDER.slice(1)
  .map(byPrefix)
  .filter((s): s is NonNullable<typeof s> => s !== undefined);

const jsonLd = [
  ...socleJsonLd(),
  webPageJsonLd({
    path: '/',
    title: seo.title,
    description: seo.description,
    keywords: seo.keywords,
  }),
  faqJsonLd(faq.items),
];
---

<Base
  title={seo.title}
  description={seo.description}
  path="/"
  ogImageAlt={seo.ogImageAlt}
  jsonLd={jsonLd}
>
  {
    /* Script d'amorçage des TrustBox Trustpilot : une seule fois, dans le <head> (consigne de
      Trustpilot). Seules les pages qui portent un widget le chargent, l'accueil et /a-propos. */
  }
  <TrustpilotScript slot="head" />
  {
    /* Ouverture jouée une seule fois par session : le script retire la classe `intro` au retour depuis
      une autre page du site. Accueil uniquement, voir public/intro-once.js. */
  }
  <IntroOnce slot="head" />
  <SiteNav />
  <main id="contenu">
    {hero && <hero.Component />}
    {rest.map(({ Component }) => <Component />)}
    {
      /* Plus de section « Notes et sources » ni d'appels de note (14/09/2026, demande de l'équipe ;
        archivés hors du dépôt, .claude/audits). */
    }
  </main>
  {
    /* Pastilles d'appel flottantes : au niveau de la page, jamais dans une section (les sections de
      l'accueil sont épinglées au défilement, un ancêtre transformé capturerait un enfant `fixed`).
      `href` SANS `withBase` : StickyCta le pose lui-même, et l'appliquer des deux côtés doublait
      le préfixe en production (voir src/lib/href.ts). */
  }
  <StickyCta
    label={difference.cta.label}
    href={difference.cta.href}
    watch="[data-hero-scroll-hint]"
    until="#corum"
  />

  {
    /* Seconde pastille, celle de la souscription : elle arrive AVEC la section qui la propose et reste
      jusqu'en bas de page. Les deux ne se croisent jamais, la première se repliant à « Le groupe
      CORUM en quelques chiffres » (#corum), qui précède « 4 étapes pour souscrire ». */
  }
  <StickyCta label={subscribe.cta.label} from="#souscrire" />
  <Footer />
</Base>
