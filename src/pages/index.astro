---
/**
 * Page d'accueil : SiteNav collée en haut → main#contenu (sections de la trame, voir HOME_ORDER ;
 * plus de Notes depuis le 14/09/2026) → Footer. Les sections viennent de
 * src/components/sections/NN-Nom.astro ; l'ordre est celui de HOME_ORDER, qui fait foi
 * (src/config/sections.ts ne donne plus que les ancres). Métadonnées et JSON-LD depuis seo.ts,
 * legal.ts, facts.ts et faq.ts via src/lib/seo.ts (rien en dur).
 * Plus d'image de fond dans le hero depuis le 11/09/2026 : aucun préchargement d'image (le LCP est le logo ou l'accroche).
 */
import Base from '@/layouts/Base.astro';
import TrustpilotScript from '@/components/TrustpilotScript.astro';
import IntroOnce from '@/components/IntroOnce.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import { seo } from '@/content/fr/seo';
import { faq } from '@/content/fr/faq';
import { difference } from '@/content/fr/difference';
import { subscribe } from '@/content/fr/subscribe';
import { faqJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';
/* 04-Strategy EST EXCLUE DU MOTIF (audit du 18/09/2026) : elle n'est rendue que par /strategie, qui
   l'importe directement. Astro rattache à une page la CSS de tout module qu'elle importe : l'accueil
   chargeait donc en bloquant les 20 Ko de sa feuille (31 @keyframes), dont aucun sélecteur n'existe
   ici. Même piège que pour les images (src/lib/images.ts) : un glob n'est pas gratuit. */
const modules = import.meta.glob<{ default: any }>(
  ['/src/components/sections/*.astro', '!/src/components/sections/04-*.astro'],
  { eager: true }
);
const all = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ path, Component: mod.default }));
/**
 * Trame de l'accueil, par préfixe de fichier. HOME_ORDER ci-dessous fait foi, dans cet ordre exact :
 * 01 Hero → 01b Qui a envie de payer avant de gagner ? → 02 R Start en un clin d'œil
 * → 03 Comparateur de frais → 07 Le groupe CORUM en quelques chiffres → 03a Immeuble
 * (illustration pleine largeur) → 06 Souscrire (chapitre court) → 08 Risques → 10 FAQ.
 *
 * PLUS AUCUNE SECTION N'EXISTE SANS ÊTRE RENDUE : 05 Revenus, 08b La presse en parle et 09
 * Documents, restées hors de HOME_ORDER, ont été supprimées le 15/09/2026 (commit deec83a), avec
 * l'ancienne 03-Fees ; 03 Frais est revenue le même jour sous la forme de 03-Frais.astro.
 * 04 Stratégie, seul fichier du dossier absent de HOME_ORDER, est importée directement par
 * /strategie.
 */
/* « 03- » réinséré le 15/09/2026, JUSTE APRÈS « 02- » (« R Start en un clin d'œil ») : le
   comparateur de frais revient sur l'accueil. Les tons s'enchaînent ink puis white puis white,
   aucune rupture. */
const HOME_ORDER = ['01-', '01b-', '02-', '03-', '07-', '03a-', '06-', '08-', '10-'];
const byPrefix = (prefix: string) => all.find((s) => s.path.includes('/sections/' + prefix));
const hero = byPrefix('01-');
const rest = HOME_ORDER.slice(1)
  .map(byPrefix)
  .filter((s): s is NonNullable<typeof s> => s !== undefined);

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({
    path: '/',
    title: seo.title,
    description: seo.description,
    keywords: seo.keywords,
  }),
  faqJsonLd(faq.items),
];
---

<Base
  title={seo.title}
  description={seo.description}
  path="/"
  ogImageAlt={seo.ogImageAlt}
  jsonLd={jsonLd}
>
  {
    /* Script d'amorçage des TrustBox Trustpilot : une seule fois, dans le <head> (consigne de
      Trustpilot). Les pages qui portent un widget le chargent, l'accueil et /a-propos (le carrousel
      d'avis y vit depuis le 15/09/2026) ; les autres non. */
  }
  <TrustpilotScript slot="head" />
  {
    /* Ouverture jouée une seule fois par session : le script retire la classe `intro` au retour depuis
      une autre page du site. Accueil uniquement, voir public/intro-once.js. */
  }
  <IntroOnce slot="head" />
  <SiteNav />
  <main id="contenu">
    {hero && <hero.Component />}
    {rest.map(({ Component }) => <Component />)}
    {
      /* PLUS DE SECTION « Notes et sources » SUR L'ACCUEIL (14/09/2026, demande de l'équipe), et plus
        aucun appel de note en exposant : le registre de l'accueil (content/fr/notes.ts) est vide, et
        NoteRef ne rend rien pour un identifiant qu'il n'y trouve pas. Les notes elles-mêmes vivent
        toujours dans les fichiers de contenu ; aucune page ne les rend plus, LegalNotes et NoteRef
        étant coupés (AFFICHER = false) sur tout le site. */
    }
  </main>
  {
    /* Pastille d'appel flottante : au niveau de la page, jamais dans une section, les sections de
      l'accueil sont épinglées au défilement, et un ancêtre transformé capturerait un enfant `fixed`. */
  }
  {/* `href` SANS `withBase` : StickyCta le pose lui-même, et l'appliquer des deux côtés doublait le
    préfixe en production (« /r-start-public/r-start-public/frais »). Voir src/lib/href.ts. */}
  <StickyCta
    label={difference.cta.label}
    href={difference.cta.href}
    watch="[data-hero-scroll-hint]"
    until="#corum"
  />

  {
    /* Seconde pastille, celle de la souscription : elle arrive AVEC la section qui la propose et reste
      jusqu'en bas de page. Les deux ne se croisent jamais, la première se repliant à « Le groupe
      CORUM en quelques chiffres » (#corum), qui précède « 4 étapes pour souscrire ». */
  }
  <StickyCta label={subscribe.cta.label} from="#souscrire" />
  <Footer />
</Base>
