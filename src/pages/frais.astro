---
/**
 * Page /frais (périmètre v2, plan §12) : version complète de la section « Frais » de l'accueil.
 * SiteNav collée en haut (barre unique, entrées de pages) → fil d'Ariane (slot du PageHero) → PageHero
 * (H1, intro, ligne risques visible sans scroller, jamais animée) → sections :
 *  1. les trois « 0 % » et leur contre-poids dans le même bloc (data-advantage + RiskNote, text-lead) ;
 *  2. le barème en quatre tableaux accessibles (caption = titre H3 + introduction, th scope="col" /
 *     scope="row", nature du frais en pastille depuis FeeRow.kind, assiette et précisions repliées sous le
 *     libellé aux largeurs étroites, taux jamais coupé : `valueShort` sous 640 px) ;
 *  3. la commission de retrait : frise des cinq paliers (10-7-5-3-0), cas d'exonération (avantage) et
 *     leur note (risque), même taille ;
 *  4. sur fond ink : mécanisme de réserve en cas de moins-value (avantage en paragraphes + RiskNote),
 *     puis l'avertissement commission d'arbitrage, reproduit à l'identique depuis legal.ts, jamais animé
 *     (l'encadré « Une innovation, pas une révolution » accompagne désormais la bascule, en 6) ;
 *  5. l'incidence des coûts du DIC (trois durées, méthode, risque : coûts, jamais de performance) ;
 *  6. la bascule pédagogique des frais (FeeSwitcher, brochure p.6), rendue uniquement si
 *     SHOW_MARKET_COMPARISON et marketComparison.enabled ;
 *  7. le document de référence (carte PDF data-doc, ou lien externe vers corum.fr tant que le DIC est en
 *     attente : rel noopener noreferrer, mention « nouvelle fenêtre ») ;
 *  8. la FAQ en accordéons natifs <details data-faq> (JSON-LD FAQPage émis par la page) ;
 *  9. la précision HT = TTC et le CTA tunnel (position « frais ») ;
 * puis les notes de la page (feesPage.notes, appels de note locaux FeesNoteRef) et le Footer.
 * Animations déclaratives sobres uniquement (data-animate clip / stagger / fade-up) ; aucun [data-risk],
 * aucun avertissement et aucun H1 sous un data-animate.
 * Contenu : src/content/fr/feesPage.ts (aucun texte en dur ; micro-textes dans feesPage.labels).
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Pill from '@/components/ui/Pill.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import FeeComparator from '@/components/pages/frais/FeeComparator.astro';
import FeesNoteRef from '@/components/pages/frais/FeesNoteRef.astro';
import { pages } from '@/config/pages';
import { feesPage, notes } from '@/content/fr/feesPage';
import { breadcrumbJsonLd, faqJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.fees;
const {
  seo,
  hero,
  labels,
  zeroHighlights,
  counterweight,
  counterweightRates,
  groups,
  lossMechanism,
  arbitrageWarning,
  faq,
  htNote,
  cta,
} = feesPage;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('fees'),
  faqJsonLd(faq.items),
];

/** Ancres des sections de la page (ids HTML, pas des textes affichés). */
const ids = {
  zero: 'zero-frais',
  schedule: 'bareme',
  withdrawal: 'retrait',
  loss: 'moins-value',
  cost: 'incidence-des-couts',
  comparison: 'comparatif',
  document: 'document-de-reference',
  faq: 'faq-frais',
  cta: 'souscrire-frais',
};

/** Frise de retrait : le dernier palier (0 %) est mis en avant. */

/** FAQ : découpage avantage / risque de chaque réponse (item.riskFrom), comme sur l'accueil. */
const faqItems = faq.items.map((item) => {
  const from = Math.min(Math.max(item.riskFrom ?? item.answer.length, 0), item.answer.length);
  return { ...item, advantage: item.answer.slice(0, from), risks: item.answer.slice(from) };
});
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    {
      /* Plus d'introduction dans l'en-tête (12/09/2026, demande de l'équipe) : titre, ligne risques, puis
        le comparateur. `hero.intro` reste dans le contenu, elle n'est simplement plus rendue ici. */
    }
    <PageHero eyebrow={hero.eyebrow} title={hero.title} riskLine={hero.riskLine}>
      <Breadcrumb slot="breadcrumb" key="fees" tone="dark" />
      {
        /* En-tête MINIMALISTE (11/09/2026, demande de l'équipe) : le tableau des taux qui l'occupait est
          parti, pour qu'on arrive au comparateur sans défiler. Les 0 % ne sont donc plus annoncés seuls
          en haut de page, c'est justement ce que l'AMF reproche, et le comparateur qui suit les montre
          avec les frais réellement prélevés, dans le même tableau. */
      }
    </PageHero>

    <!-- 1. Les trois 0 % et leur contre-poids, dans le même bloc -->
    {
      /* Comparateur SCPI par SCPI, PREMIER ÉLÉMENT de la page (11/09/2026, demande de l'équipe) : on
        compare d'abord des taux, on comprend ensuite ce qu'ils recouvrent. Tout ce qui suit explique les
        frais de R Start à partir de la brochure partenaires et du document d'informations clés.
        NON PUBLIABLE tant que les taux des autres SCPI ne sont pas relevés, le composant l'affiche et le
        script de conformité le signale. */
    }
    <FeeComparator id="comparateur" />

    <Section id={ids.zero} tone="white" labelledBy={ids.zero + '-title'}>
      <Container size="wide">
        <h2 id={ids.zero + '-title'} class="visually-hidden">{labels?.zeroHighlights}</h2>
        <ul
          role="list"
          aria-label={labels?.zeroHighlights}
          class="grid gap-10 sm:grid-cols-3 sm:gap-8 lg:gap-12"
        >
          {
            zeroHighlights.map((item, i) => (
              <li class="flex flex-col gap-3 border-t border-navy/15 pt-6 sm:pt-8">
                <p class="flex flex-col gap-3">
                  <span
                    class="text-stat text-navy"
                    data-fee-value
                    data-fee-block="apercu-frais"
                    data-animate="clip"
                    data-animate-delay={String(i * 0.12)}
                  >
                    {item.value}
                  </span>
                  <span class="text-lead font-medium text-ink">{item.label}</span>
                </p>
                <p class="text-base leading-relaxed text-slate-700">{item.base}</p>
              </li>
            ))
          }
        </ul>

        <!-- Frais réellement prélevés, même taille (text-stat) que les trois 0 % ci-dessus : exigence AMF -->
        <ul
          role="list"
          aria-hidden="true"
          class="mt-6 grid grid-cols-3 gap-3 border-t border-coral/40 pt-6 sm:gap-8 sm:pt-8"
        >
          {
            counterweightRates.map((item) => (
              <li class="flex flex-col gap-3">
                <span
                  class="text-stat text-coral-700 tabular-nums"
                  data-fee-value
                  data-fee-block="apercu-frais"
                >
                  {item.value}
                </span>
                <span class="text-lead font-medium text-ink">{item.label}</span>
              </li>
            ))
          }
        </ul>

        <div
          class="mt-10 grid gap-6 border-t border-navy/15 pt-8 lg:mt-14 lg:grid-cols-2 lg:gap-12 lg:pt-10"
        >
          <p data-advantage class="text-lead">
            {counterweight.advantage}<span class="whitespace-nowrap"
              ><FeesNoteRef id="frais-page-distributeur" /></span
            >
          </p>
          <RiskNote text={counterweight.risk} size="lead" />
        </div>
      </Container>
    </Section>

    <!-- 2. Le barème complet, en quatre tableaux -->
    <Section id={ids.schedule} tone="paper" labelledBy={ids.schedule + '-title'}>
      <Container size="wide">
        <h2 id={ids.schedule + '-title'} class="text-display-lg max-w-4xl">
          {labels?.eyebrows.schedule}
        </h2>

        <div class="mt-14 space-y-16 lg:mt-20 lg:space-y-24">
          {
            groups.map((group) => (
              <div
                class="overflow-x-auto focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-navy"
                tabindex="0"
                role="region"
                aria-label={group.title}
              >
                <table class="w-full border-collapse text-left">
                  <caption class="mb-6 text-left sm:mb-8">
                    <h3 class="text-display-sm text-ink">
                      {group.title}
                      {group.noteId && (
                        <span class="whitespace-nowrap">
                          <FeesNoteRef id={group.noteId} />
                        </span>
                      )}
                    </h3>
                    {group.intro && <p class="text-lead mt-3 max-w-3xl text-ink">{group.intro}</p>}
                  </caption>
                  {labels && (
                    <thead>
                      <tr class="border-b border-navy/20 text-caption font-semibold uppercase tracking-[0.12em] text-slate-700">
                        <th scope="col" class="py-3 pr-4">
                          {labels.columns.fee}
                        </th>
                        <th scope="col" class="hidden py-3 pr-4 sm:table-cell">
                          {labels.columns.base}
                        </th>
                        <th scope="col" class="py-3 text-right">
                          {labels.columns.value}
                        </th>
                        <th scope="col" class="hidden py-3 pl-6 lg:table-cell">
                          {labels.columns.detail}
                        </th>
                      </tr>
                    </thead>
                  )}
                  <tbody>
                    {group.rows.map((row) => (
                      <tr class="border-b border-navy/10 align-top" data-kind={row.kind}>
                        <th scope="row" class="py-4 pr-4 font-normal sm:py-5 lg:w-72">
                          <span class="block text-base font-semibold text-ink sm:text-xl">
                            {row.label}
                          </span>
                          {labels && (
                            <Pill tone="outline" class="mt-2 text-teal-700">
                              {labels.kinds[row.kind]}
                            </Pill>
                          )}
                          <span class="mt-2 block text-base leading-relaxed text-slate-700 sm:hidden">
                            {row.base}
                          </span>
                          {row.detail && (
                            <span class="mt-2 block text-base leading-relaxed text-slate-700 lg:hidden">
                              {row.detail}
                            </span>
                          )}
                        </th>
                        <td class="hidden py-4 pr-4 text-base leading-relaxed text-slate-700 sm:table-cell sm:py-5 lg:w-64">
                          {row.base}
                        </td>
                        <td
                          class="py-4 pl-3 text-right text-lg leading-tight font-bold tracking-tight whitespace-nowrap text-navy tabular-nums max-sm:w-[7.25rem] sm:py-5 sm:text-3xl"
                          data-fee-value
                          data-fee-block="bareme-frais"
                        >
                          {row.valueShort ? (
                            <>
                              <span class="sm:hidden">{row.valueShort}</span>
                              <span class="hidden sm:inline">{row.value}</span>
                            </>
                          ) : (
                            row.value
                          )}
                        </td>
                        <td class="hidden py-4 pl-6 text-base leading-relaxed text-slate-700 lg:table-cell lg:py-5">
                          {row.detail}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))
          }
        </div>
      </Container>
    </Section>

    {
      /* Section « À la sortie » retirée le 12/09/2026 à la demande de l'équipe. Le barème de retrait
        n'est pas perdu : le comparateur le porte, sous la valeur de la ligne « frais de retrait
        anticipé », avec tous ses paliers. Les cas d'exonération restent dans la note d'information,
        citée sur /documentation. */
    }
    <!-- 4. Moins-value, encadré et avertissement (jamais animés) -->
    <Section
      id={ids.loss}
      tone="ink"
      labelledBy={ids.loss + '-title'}
      class="brand-halo grain overflow-hidden"
    >
      <Container size="wide" class="relative">
        {
          labels?.eyebrows.lossMechanism && (
            <p class="text-eyebrow mb-4 text-teal-200">{labels.eyebrows.lossMechanism}</p>
          )
        }
        <h2 id={ids.loss + '-title'} class="text-display-lg max-w-4xl text-white">
          {lossMechanism.title}<span class="whitespace-nowrap"
            ><FeesNoteRef id="frais-page-moins-value" /></span
          >
        </h2>
        <div class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-2 lg:gap-12">
          <div data-advantage class="text-lead space-y-5 text-white">
            {lossMechanism.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <RiskNote text={lossMechanism.risk} tone="dark" size="lead" />
        </div>

        <!--
          L'encadré « Une innovation, pas une révolution » n'est plus rendu ici : il accompagne
          désormais la bascule des frais (FeeSwitcher, section 6), comme demandé par le plan §3 bis.
        -->
        <div class="mt-16 lg:mt-24">
          <Card lift={false} class="lg:p-10">
            <p class="text-lead font-medium">
              {arbitrageWarning.title}<span class="whitespace-nowrap"
                ><FeesNoteRef id="frais-page-commission-arbitrage" tone="light" /></span
              >
            </p>
            <ul class="mt-5 list-disc space-y-4 pl-6 text-lead marker:text-coral">
              {arbitrageWarning.bullets.map((bullet) => <li class="pl-1">{bullet}</li>)}
            </ul>
          </Card>
        </div>
      </Container>
    </Section>

    <!-- 5. Incidence des coûts selon le DIC (coûts, jamais de performance) -->
    {
      /* Retirés le 11/09/2026 à la demande de l'équipe : « L'incidence des coûts selon le DIC », la
        bascule des frais et le bloc « Document d'informations clés ». Les mentions que portait la bascule
       , périmètre du comparatif, sources et encadré « Une innovation, pas une révolution », ont suivi
        le comparateur, qui est désormais ce qui nomme d'autres SCPI sur la page. Le document
        d'informations clés reste accessible depuis /documentation et le pied de page. */
    }
    <Section id={ids.faq} tone="paper" labelledBy={ids.faq + '-title'}>
      <Container size="wide">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-24">
              {
                labels?.eyebrows.faq && (
                  <p class="text-eyebrow mb-4 text-teal-700">{labels.eyebrows.faq}</p>
                )
              }
              <h2 id={ids.faq + '-title'} class="text-display-lg">{faq.title}</h2>
            </div>
          </div>
          <div class="lg:col-span-7">
            <ul role="list" aria-label={labels?.faqList} class="border-t border-navy/15">
              {
                faqItems.map((item, i) => (
                  <li class="border-b border-navy/15">
                    <details name="faq-frais" data-faq={item.question} class="faq-item group">
                      <summary
                        class="block cursor-pointer list-none py-6 [&::-webkit-details-marker]:hidden sm:py-8"
                        data-animate="fade-up"
                      >
                        <h3 class="flex items-start justify-between gap-5 text-display-sm text-ink transition-colors duration-200 group-hover:text-navy sm:gap-8">
                          <span class="flex min-w-0 flex-col gap-2 sm:flex-row sm:gap-6">
                            <span
                              aria-hidden="true"
                              class="text-eyebrow pt-1.5 text-teal-700 tabular-nums sm:pt-2"
                            >
                              {String(i + 1).padStart(2, '0')}
                            </span>
                            <span>{item.question}</span>
                          </span>
                          <span
                            aria-hidden="true"
                            class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-full border border-navy/40 text-navy transition-[transform,background-color,border-color,color] duration-300 ease-out-expo group-hover:border-navy group-hover:bg-navy group-hover:text-white group-open:rotate-180 group-open:border-navy group-open:bg-navy group-open:text-white motion-reduce:transition-none sm:mt-1 sm:size-12"
                          >
                            <svg
                              class="size-5 sm:size-6"
                              viewBox="0 0 20 20"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                            >
                              <path
                                d="m5 8 5 5 5-5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </span>
                        </h3>
                      </summary>
                      <div class="faq-answer max-w-3xl space-y-5 pb-8 sm:pb-10 sm:pl-12">
                        {item.advantage.map((paragraph) => (
                          <p data-advantage class="text-lead text-ink">
                            {paragraph}
                          </p>
                        ))}
                        {item.risks.map((risk) => (
                          <RiskNote text={risk} size="lead" />
                        ))}
                      </div>
                    </details>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </Container>
    </Section>

    <!-- 9. HT = TTC et CTA -->
    <Section id={ids.cta} tone="white" spacing="compact" labelledBy={ids.cta + '-title'}>
      <Container size="wide">
        <h2 id={ids.cta + '-title'} class="visually-hidden">{cta.label}</h2>
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
          <p class="max-w-2xl text-base leading-relaxed text-slate-700">
            {htNote}<span class="whitespace-nowrap"><FeesNoteRef id="frais-page-ht" /></span>
          </p>
          <div class="flex flex-wrap items-center gap-3 sm:gap-4">
            <Button position={cta.position} size="lg">{cta.label}</Button>
          </div>
        </div>
      </Container>
    </Section>

    <LegalNotes notes={notes} />
  </main>
  <Footer />
</Base>

<style>
  /* Glissement de la réponse à l'ouverture (transform uniquement, opacité constante ; rien en reduced-motion). */
  @media (prefers-reduced-motion: no-preference) {
    .faq-item[open] > .faq-answer {
      animation: faq-reveal 450ms var(--ease-out-expo) both;
    }
    @keyframes faq-reveal {
      from {
        transform: translateY(-6px);
      }
    }
  }
</style>
