---
/**
 * PAGE D'ESSAI TYPOGRAPHIQUE, /test. Demande de l'équipe du 15/09/2026 : mettre « R Start » en avant
 * dans les titres avec une seconde typographie, et pouvoir choisir sur pièces plutôt que sur avis.
 *
 * Elle rend les NEUF TITRES DU SITE qui contiennent « R Start », relevés dans le HTML construit, aux
 * tailles réelles des paliers (H1 en display-lg, H2 en display-md), avec des réglages qu'on manipule en
 * direct : la fonte, la graisse, la compensation de corps, l'italique et les petites capitales.
 *
 * DEUX CANDIDATES SEULEMENT, et ce n'est pas un choix de goût. Adobe Caslon, FreightBig Pro et Kepler
 * sont des fontes Adobe : leur licence web passe par Adobe Fonts, qui interdit l'hébergement sur son
 * propre serveur et impose un script depuis use.typekit.net. Or la politique de sécurité du contenu du
 * site (src/layouts/Base.astro) n'autorise que `'self'`, googletagmanager et trustpilot pour les
 * scripts, et `'self'` pour les feuilles de style : ces trois-là ne peuvent pas être essayées sans une
 * décision d'infrastructure préalable. Source Serif 4 et EB Garamond sont sous licence libre (SIL OFL),
 * variables, et s'hébergent comme Plus Jakarta Sans.
 *
 * HORS MENU, hors plan du site, et `noindex` comme tout le reste de la prévisualisation. À SUPPRIMER
 * une fois le choix fait, avec la fonte non retenue.
 */
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/eb-garamond';
import Base from '@/layouts/Base.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import StoreBadge from '@/components/ui/StoreBadge.astro';
import IconExterne from '@/components/ui/IconExterne.astro';

/**
 * PICTOGRAMMES CANDIDATS pour la mention « Société de gestion agréée par l'AMF » du hero (16/09/2026).
 * Le logo de l'AMF a été retiré la veille : l'AMF ne le concède pas aux communications commerciales, et
 * un signe qui figure l'autorité, près d'une note Trustpilot, se lit comme une caution de cette
 * autorité. Ces six-là sont les nôtres, dessinés au trait, ils ne se confondent avec aucune marque.
 * Grille 24 × 24, trait 1,5, `currentColor` : la convention de ui/Picto.astro.
 * DEUX SONT SIGNALÉS COMME À ÉVITER, et ce n'est pas un avis de goût : le fronton et la balance
 * représentent l'institution et sa fonction, donc l'AMF, ce qui ramène la lecture qu'on vient d'écarter.
 */
const PICTOS: { id: string; nom: string; note: string; eviter?: true; d: string }[] = [
  {
    id: 'document',
    nom: 'Document validé',
    note: 'celui en place : un document et sa coche',
    d: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/><path d="m9 14 2 2 3.5-3.5"/>',
  },
  {
    id: 'ecusson',
    nom: 'Écusson à coche',
    note: 'le plus lu comme « protégé », sans réfléchir',
    d: '<path d="M12 2.8 4.8 5.4v6c0 4.2 2.9 7.6 7.2 9.8 4.3-2.2 7.2-5.6 7.2-9.8v-6L12 2.8Z"/><path d="m8.8 11.8 2.2 2.2 4.2-4.4"/>',
  },
  {
    id: 'sceau',
    nom: 'Sceau officiel',
    note: 'une rosette : agrément, contrôle. Se referme sous 20 px',
    d: '<path d="M12 2.6l2.2 1.5 2.6-.4 1 2.5 2.3 1.3-.6 2.6.6 2.6-2.3 1.3-1 2.5-2.6-.4L12 21.6l-2.2-1.5-2.6.4-1-2.5-2.3-1.3.6-2.6-.6-2.6 2.3-1.3 1-2.5 2.6.4L12 2.6Z"/><path d="m8.9 12.1 2.1 2.1 4.1-4.3"/>',
  },
  {
    id: 'coche',
    nom: 'Coche cerclée',
    note: 'irréprochable mais banal : le picto de validation de tout formulaire',
    d: '<circle cx="12" cy="12" r="9"/><path d="m8.2 12.2 2.6 2.6 5-5.2"/>',
  },
  {
    id: 'fronton',
    nom: 'Fronton',
    note: 'représente l’AMF elle-même : ramène la lecture « caution de l’autorité »',
    eviter: true,
    d: '<path d="M3.6 9.4 12 4.2l8.4 5.2"/><path d="M5.6 9.8v8M9.8 9.8v8M14.2 9.8v8M18.4 9.8v8"/><path d="M3.4 20.4h17.2"/>',
  },
  {
    id: 'balance',
    nom: 'Balance',
    note: 'même écueil que le fronton, en plus discret',
    eviter: true,
    d: '<path d="M12 4.2v15.6M7.4 19.8h9.2M4.6 7.2h14.8M12 4.2 6 7"/><path d="M6.2 7.4 3.4 13.6h5.6L6.2 7.4Z"/><path d="M17.8 7.4 15 13.6h5.6l-2.8-6.2Z"/>',
  },
];

/**
 * INVENTAIRE DES APPELS À L'ACTION ET DES LIENS (17/09/2026, demande de l'équipe : « fais un inventaire
 * de tous les CTA et liens dans /test, on va faire du tri, il y a beaucoup de choses différentes pour
 * rien, on va rationaliser »). Relevé sur le code le 17/09/2026 : 167 éléments rendus, 22 familles de
 * style, 13 doublons. Chaque famille est RENDUE CI-DESSOUS AVEC SES VRAIES CLASSES, copiées du composant
 * qui la porte (ou avec le composant lui-même quand il existe) : survol, focus et transitions sont ceux
 * du site, pas une maquette. Les réglages typographiques de la page ne s'y appliquent pas.
 * `SOURCES` renvoie au fichier d'origine de chaque famille ; les libellés sont ceux du site.
 */
const classesNavLien =
  'block rounded-full px-2.5 py-1.5 text-base font-medium whitespace-nowrap text-slate-700 no-underline transition-colors hover:text-navy aria-[current]:font-semibold aria-[current]:text-navy sm:px-3.5';
const classesTiroirLien =
  'block rounded-2xl px-3 py-2.5 text-base font-medium text-white/85 no-underline transition-colors hover:text-white aria-[current]:text-white aria-[current]:underline aria-[current]:decoration-2 aria-[current]:underline-offset-8';
const classesInfoClair =
  'inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-navy/30 text-xs font-semibold text-navy/70 transition-colors hover:border-navy/70 hover:text-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy';
const classesInfoSombre =
  'inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-white/35 text-xs font-semibold text-white/80 transition-colors hover:border-white/70 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
const classesChevronFaq =
  'faq-chevron mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-full border border-navy/40 text-navy transition-[transform,background-color,border-color,color] duration-300 ease-out-expo group-hover:border-navy group-hover:bg-navy group-hover:text-white group-open:rotate-180 group-open:border-navy group-open:bg-navy group-open:text-white motion-reduce:transition-none sm:mt-1 sm:size-12';

/** Le libellé exact du hero, pour juger sur pièce et non sur une phrase d'exemple. */
const MENTION_AMF = 'Société de gestion agréée par l’AMF';

/** Les neuf titres du site qui nomment R Start, relevés dans dist/ le 15/09/2026. */
const TITRES: { niveau: 1 | 2; avant: string; apres: string }[] = [
  { niveau: 2, avant: '', apres: ' table sur deux moteurs de performance' },
  { niveau: 2, avant: '', apres: ' : la seule SCPI qui ne prend des frais que si vous gagnez.' },
  { niveau: 2, avant: '', apres: ' en un clin d’œil' },
  { niveau: 2, avant: 'Investir dans ', apres: ' comporte des risques.' },
  { niveau: 2, avant: 'Vos questions sur la SCPI ', apres: '.' },
  { niveau: 2, avant: 'Société de gestion de ', apres: '' },
  { niveau: 1, avant: 'L’expérience derrière ', apres: '' },
  { niveau: 1, avant: 'Comment ', apres: ' investit l’argent de ses clients ?' },
];
---

<Base title="Essai typographique" description="Page d’essai interne, hors menu." path="/test">
  <main id="contenu">
    <Section id="essai" tone="paper">
      <Container size="wide">
        <p class="text-eyebrow text-teal-700">Page d’essai interne</p>
        <h1 id="essai-title" class="text-display-md mt-3 text-ink">
          Mettre « R Start » en avant dans les titres
        </h1>
        <p class="text-lead mt-5 max-w-3xl text-slate-700">
          Les neuf titres du site qui nomment R Start, aux tailles réelles. Les réglages
          s’appliquent en direct à tout ce qui suit.
        </p>

        {
          /* Un <div> et non un <form> : rien n'est soumis, tout se joue dans la cascade CSS. Un
            formulaire sans bouton d'envoi est d'ailleurs une erreur d'accessibilité (WCAG H32). */
        }
        <div
          class="mt-10 grid gap-6 rounded-3xl bg-white p-6 shadow-card sm:grid-cols-2 lg:grid-cols-3 lg:p-8"
          data-reglages
        >
          <fieldset>
            <legend class="text-caption font-semibold text-navy">Fonte</legend>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['pjs', 'Plus Jakarta Sans (actuelle)'],
                  ['ss', 'Source Serif 4'],
                  ['ga', 'EB Garamond'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="fonte" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-caption font-semibold text-navy">Graisse</legend>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['400', 'Normale (400)'],
                  ['600', 'Demi-grasse (600)'],
                  ['700', 'Grasse (700)'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="graisse" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-caption font-semibold text-navy">Corps</legend>
            <p class="text-caption mt-1 text-slate-700">
              Les serifs ont une hauteur d’x plus basse : sans compensation, le mot paraît plus
              petit que ses voisins.
            </p>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['1', 'Identique'],
                  ['1.06', '+ 6 %'],
                  ['1.12', '+ 12 %'],
                  ['1.18', '+ 18 %'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="corps" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="sm:col-span-2 lg:col-span-3">
            <legend class="text-caption font-semibold text-navy">Style</legend>
            <div class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="italique" /> Italique
              </label>
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="petitescaps" /> Petites capitales
              </label>
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="teinte" /> Teinte turquoise
              </label>
            </div>
          </fieldset>
        </div>
      </Container>
    </Section>

    <Section id="titres" tone="white">
      <Container size="wide">
        <h2 id="titres-title" class="visually-hidden">Les titres, sur fond clair</h2>
        <div class="flex flex-col gap-12 lg:gap-16" data-titres>
          {
            /*
             * `set:html` plutôt que du JSX : entre `{t.avant}` et le <span>, Prettier réintroduit un
             * retour à la ligne, donc une espace, et « R Start . » se lisait avec une espace avant le
             * point. Les trois morceaux sont des littéraux de ce fichier, rien ne vient de l'extérieur.
             */
            TITRES.map((t) => (
              <p
                class={t.niveau === 1 ? 'text-display-lg text-ink' : 'text-display-md text-ink'}
                set:html={`${t.avant}<span data-marque>R Start</span>${t.apres}`}
              />
            ))
          }
        </div>
      </Container>
    </Section>

    <Section id="sombre" tone="ink">
      <Container size="wide">
        <h2 id="sombre-title" class="text-eyebrow text-teal-200">Sur fond sombre</h2>
        <div class="mt-8 flex flex-col gap-12" data-titres>
          <p class="text-display-md text-white">
            Investir dans <span data-marque>R Start</span> comporte des risques.
          </p>
          <p class="text-display-lg text-white">
            Comment <span data-marque>R Start</span> investit l’argent de ses clients ?
          </p>
        </div>
      </Container>
    </Section>

    <Section id="pictos" tone="ink">
      <Container size="wide">
        <h2 id="pictos-title" class="text-eyebrow text-teal-200">Pictogramme de la mention AMF</h2>
        <p class="text-lead mt-4 max-w-3xl text-white/80">
          Les six candidats, au libellé et à la taille du hero, sur son fond. Les réglages agissent sur
          tous en même temps.
        </p>

        <div
          class="mt-8 flex flex-wrap items-end gap-x-10 gap-y-5 rounded-3xl bg-white/5 p-6 ring-1 ring-white/15"
          data-reglages-picto
        >
          <fieldset>
            <legend class="text-caption font-semibold text-teal-200">Taille</legend>
            <div class="mt-3 flex gap-4">
              {
                ['16', '20', '24'].map((v, i) => (
                  <label class="flex items-center gap-2 text-base text-white/85">
                    <input type="radio" name="picto-taille" value={v} checked={i === 1} /> {v} px
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset>
            <legend class="text-caption font-semibold text-teal-200">Opacité</legend>
            <div class="mt-3 flex gap-4">
              {
                ['0.45', '0.65', '1'].map((v, i) => (
                  <label class="flex items-center gap-2 text-base text-white/85">
                    <input type="radio" name="picto-opacite" value={v} checked={i === 0} />
                    {Math.round(Number(v) * 100)} %
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset>
            <legend class="text-caption font-semibold text-teal-200">Teinte</legend>
            <div class="mt-3 flex gap-4">
              {
                [
                  ['currentColor', 'Comme le texte'],
                  ['var(--color-teal-200)', 'Turquoise clair'],
                  ['var(--color-sand)', 'Sable'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base text-white/85">
                    <input type="radio" name="picto-teinte" value={v} checked={i === 0} /> {l}
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <ul role="list" class="mt-10 grid gap-4 lg:grid-cols-2 lg:gap-x-10">
          {
            PICTOS.map((p, i) => (
              <li class="flex items-center gap-4 rounded-2xl bg-white/5 px-5 py-4">
                <span class="text-caption w-6 shrink-0 tabular-nums text-white/40">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flex items-center gap-2 text-sm leading-snug text-white/80">
                  <svg
                    class="shrink-0"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    data-picto
                    set:html={p.d}
                  />
                  {MENTION_AMF}
                </span>
                <span class="text-caption ml-auto max-w-[15rem] text-right text-white/45">
                  <b class="block font-semibold text-white/75">
                    {p.nom}
                    {p.eviter && <span class="ml-1 font-normal text-teal-200">(à éviter)</span>}
                  </b>
                  {p.note}
                </span>
              </li>
            ))
          }
        </ul>
      </Container>
    </Section>

    <Section id="cta" tone="paper">
      <Container size="wide">
        <p class="text-eyebrow text-teal-700">Inventaire du 17 septembre 2026</p>
        <h2 id="cta-title" class="text-display-md mt-3 text-ink">
          Appels à l’action et liens : 167 éléments, 22 familles de style
        </h2>
        <p class="text-lead mt-5 max-w-3xl text-slate-700">
          Chaque famille est rendue ici avec ses vraies classes : survol, focus et transitions sont
          ceux du site. À droite de chaque échantillon, où elle sert et combien de fois. Les doublons à
          trancher sont réunis en bas de page.
        </p>

        <ol class="mt-10 grid gap-6" aria-label="Familles sur fond clair">
          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <Button href="/frais" variant="primary" size="sm">Souscrire</Button>
              <Button href="/frais" variant="primary" size="md">Souscrire</Button>
              <Button href="/frais" variant="primary" size="lg">Souscrire en ligne</Button>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink"><span class="text-teal-700">F1</span> · Pilule pleine navy, composant Button « primary »</p>
              <p class="mt-1">Fond navy, texte blanc, élévation et halo au survol (btn-motion), appui à 0,98. Trois tailles : 40, 48 et 62 px.</p>
              <p class="mt-2"><b class="font-semibold text-navy">3 occurrences</b> : « Souscrire » dans la barre (md), « Souscrire en ligne » sous les 4 étapes et en bas de /documentation (lg).</p>
            </div>
          </li>

          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <Button href="/a-propos" variant="secondary" size="lg">Découvrir le groupe CORUM</Button>
              <Button href="https://www.corum.fr" variant="secondary" size="lg" target="_blank">Découvrir CORUM<span class="visually-hidden"> (nouvelle fenêtre)</span></Button>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink"><span class="text-teal-700">F3</span> · Pilule contour navy, composant Button « secondary »</p>
              <p class="mt-1">Filet navy à 60 %, se remplit en navy au survol, btn-motion. La flèche diagonale s’ajoute seule sur un lien externe.</p>
              <p class="mt-2"><b class="font-semibold text-navy">2 occurrences</b> : « Découvrir le groupe CORUM » (accueil, section Confiance, posée sur fond sombre alors que la variante est prévue pour fond clair) et « Découvrir CORUM » (/a-propos).</p>
            </div>
          </li>

          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <Button href="/frais" variant="ghost">Voir notre comparateur de frais</Button>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink"><span class="text-teal-700">F5</span> · Composant Button « ghost »</p>
              <p class="mt-1">Texte navy souligné au survol, sans pilule ni taille. Déclaré dans Button.astro.</p>
              <p class="mt-2"><b class="font-semibold text-coral-700">0 occurrence</b> : son seul point d’appel (le lien du premier bloc de l’accueil) a été retiré le 16/09. Variante morte.</p>
            </div>
          </li>

          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <button type="button" class="btn-motion inline-flex items-center justify-center rounded-full bg-navy px-6 py-3 font-semibold text-white hover:bg-teal-700">Fermer</button>
              <button type="button" class="min-h-10 rounded-full bg-navy px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-700 sm:px-5">Tout accepter</button>
              <button type="button" class="min-h-10 rounded-full bg-navy px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-700 sm:px-5">Tout refuser</button>
              <span class="inline-flex rounded-full bg-navy px-5 py-3 font-semibold text-white">Aller au contenu</span>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink"><span class="text-teal-700">F6 · F7 · F8</span> · Pilules pleines navy écrites à la main</p>
              <p class="mt-1">« Fermer » (fenêtre souscription) copie Button primary md à l’identique, sur un &lt;button&gt;. « Tout accepter » et « Tout refuser » (bandeau cookies) : 14 px, 40 px de haut, sans élévation ni halo. « Aller au contenu » : lien d’évitement, visible au clavier seulement.</p>
              <p class="mt-2"><b class="font-semibold text-navy">4 occurrences</b>, sur toutes les pages.</p>
            </div>
          </li>

          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <a href="#cta" class="footer-top group inline-flex items-center gap-2.5 rounded-full border border-navy/25 px-5 py-3 text-base font-semibold text-navy no-underline transition-colors hover:border-navy hover:bg-navy hover:text-white">Haut de page <span aria-hidden="true">↑</span></a>
              <a href="#cta" class="inline-flex rounded-full border border-navy/25 px-5 py-2.5 font-semibold text-navy no-underline transition-colors hover:border-navy hover:bg-navy hover:text-white">Comparateur de frais</a>
              <button type="button" class="nav-link inline-flex items-center gap-2 rounded-full border border-navy/60 px-4 py-2.5 text-sm font-medium text-navy hover:border-navy hover:bg-navy hover:text-white">Gérer les cookies</button>
              <button type="button" class="rounded-full border border-navy px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-navy hover:text-white">Enregistrer mes choix</button>
              <button type="button" class="rounded-full border border-navy px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-navy hover:text-white">Gérer les cookies</button>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink"><span class="text-teal-700">F9</span> · Pilule contour navy « qui se remplit », cinq écritures</p>
