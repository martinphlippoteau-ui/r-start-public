---
/**
 * Page d'essai interne, /test : HORS MENU, hors plan du site, `noindex` (tests/qualite.spec.ts le
 * vérifie). Depuis le 24/09/2026 elle ne porte plus que l'essai d'animation retenu pour les deux
 * moteurs de /strategie (MoteursEssais.astro). Les variantes du hero avec CORUM L'Épargne (tranché
 * le jour même : la phrase du distributeur sous Trustpilot, dans 01-Hero.astro) et l'essai
 * typographique du 15/09/2026 ont été retirés avec leur code. À supprimer une fois l'essai reporté.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import MoteursEssais from '@/components/pages/test/MoteursEssais.astro';
import MoteursVariations from '@/components/pages/test/MoteursVariations.astro';
---

<Base title="Essai des moteurs" description="Page d’essai interne, hors menu." path="/test" noindex>
  <SiteNav />
  <main id="contenu">
    <MoteursEssais />
    {/* Dix variations de la piste retenue (24/09/2026). */}
    <MoteursVariations />
  </main>
  <Footer />
</Base>
