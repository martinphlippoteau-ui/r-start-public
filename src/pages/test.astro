---
/**
 * PAGE D'ESSAI TYPOGRAPHIQUE, /test. Demande de l'équipe du 15/09/2026 : mettre « R Start » en avant
 * dans les titres avec une seconde typographie, et pouvoir choisir sur pièces plutôt que sur avis.
 *
 * Elle rend les NEUF TITRES DU SITE qui contiennent « R Start », relevés dans le HTML construit, aux
 * tailles réelles des paliers (H1 en display-lg, H2 en display-md), avec des réglages qu'on manipule en
 * direct : la fonte, la graisse, la compensation de corps, l'italique et les petites capitales.
 *
 * DEUX CANDIDATES SEULEMENT, et ce n'est pas un choix de goût. Adobe Caslon, FreightBig Pro et Kepler
 * sont des fontes Adobe : leur licence web passe par Adobe Fonts, qui interdit l'hébergement sur son
 * propre serveur et impose un script depuis use.typekit.net. Or la politique de sécurité du contenu du
 * site (src/layouts/Base.astro) n'autorise que `'self'`, googletagmanager et trustpilot pour les
 * scripts, et `'self'` pour les feuilles de style : ces trois-là ne peuvent pas être essayées sans une
 * décision d'infrastructure préalable. Source Serif 4 et EB Garamond sont sous licence libre (SIL OFL),
 * variables, et s'hébergent comme Plus Jakarta Sans.
 *
 * HORS MENU, hors plan du site, et `noindex` comme tout le reste de la prévisualisation. À SUPPRIMER
 * une fois le choix fait, avec la fonte non retenue.
 */
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/eb-garamond';
import Base from '@/layouts/Base.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';

/** Les neuf titres du site qui nomment R Start, relevés dans dist/ le 15/09/2026. */
const TITRES: { niveau: 1 | 2; avant: string; apres: string }[] = [
  { niveau: 2, avant: '', apres: ' table sur deux moteurs de performance' },
  { niveau: 2, avant: '', apres: ' : la seule SCPI qui ne prend des frais que si vous gagnez.' },
  { niveau: 2, avant: '', apres: ' en un clin d’œil' },
  { niveau: 2, avant: 'Investir dans ', apres: ' comporte des risques.' },
  { niveau: 2, avant: 'Vos questions sur la SCPI ', apres: '.' },
  { niveau: 2, avant: 'Société de gestion de ', apres: '' },
  { niveau: 1, avant: 'L’expérience derrière ', apres: '' },
  { niveau: 1, avant: 'Comment ', apres: ' investit l’argent de ses clients ?' },
];
---

<Base title="Essai typographique" description="Page d’essai interne, hors menu." path="/test">
  <main id="contenu">
    <Section id="essai" tone="paper">
      <Container size="wide">
        <p class="text-eyebrow text-teal-700">Page d’essai interne</p>
        <h1 id="essai-title" class="text-display-md mt-3 text-ink">
          Mettre « R Start » en avant dans les titres
        </h1>
        <p class="text-lead mt-5 max-w-3xl text-slate-700">
          Les neuf titres du site qui nomment R Start, aux tailles réelles. Les réglages
          s’appliquent en direct à tout ce qui suit.
        </p>

        {
          /* Un <div> et non un <form> : rien n'est soumis, tout se joue dans la cascade CSS. Un
            formulaire sans bouton d'envoi est d'ailleurs une erreur d'accessibilité (WCAG H32). */
        }
        <div
          class="mt-10 grid gap-6 rounded-3xl bg-white p-6 shadow-card sm:grid-cols-2 lg:grid-cols-3 lg:p-8"
          data-reglages
        >
          <fieldset>
            <legend class="text-caption font-semibold text-navy">Fonte</legend>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['pjs', 'Plus Jakarta Sans (actuelle)'],
                  ['ss', 'Source Serif 4'],
                  ['ga', 'EB Garamond'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="fonte" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-caption font-semibold text-navy">Graisse</legend>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['400', 'Normale (400)'],
                  ['600', 'Demi-grasse (600)'],
                  ['700', 'Grasse (700)'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="graisse" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-caption font-semibold text-navy">Corps</legend>
            <p class="text-caption mt-1 text-slate-700">
              Les serifs ont une hauteur d’x plus basse : sans compensation, le mot paraît plus
              petit que ses voisins.
            </p>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['1', 'Identique'],
                  ['1.06', '+ 6 %'],
                  ['1.12', '+ 12 %'],
                  ['1.18', '+ 18 %'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="corps" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="sm:col-span-2 lg:col-span-3">
            <legend class="text-caption font-semibold text-navy">Style</legend>
            <div class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="italique" /> Italique
              </label>
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="petitescaps" /> Petites capitales
              </label>
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="teinte" /> Teinte turquoise
              </label>
            </div>
          </fieldset>
        </div>
      </Container>
    </Section>

    <Section id="titres" tone="white">
      <Container size="wide">
        <h2 id="titres-title" class="visually-hidden">Les titres, sur fond clair</h2>
        <div class="flex flex-col gap-12 lg:gap-16" data-titres>
          {
            /*
             * `set:html` plutôt que du JSX : entre `{t.avant}` et le <span>, Prettier réintroduit un
             * retour à la ligne, donc une espace, et « R Start . » se lisait avec une espace avant le
             * point. Les trois morceaux sont des littéraux de ce fichier, rien ne vient de l'extérieur.
             */
            TITRES.map((t) => (
              <p
                class={t.niveau === 1 ? 'text-display-lg text-ink' : 'text-display-md text-ink'}
                set:html={`${t.avant}<span data-marque>R Start</span>${t.apres}`}
              />
            ))
          }
        </div>
      </Container>
    </Section>

    <Section id="sombre" tone="ink">
      <Container size="wide">
        <h2 id="sombre-title" class="text-eyebrow text-teal-200">Sur fond sombre</h2>
        <div class="mt-8 flex flex-col gap-12" data-titres>
          <p class="text-display-md text-white">
            Investir dans <span data-marque>R Start</span> comporte des risques.
          </p>
          <p class="text-display-lg text-white">
            Comment <span data-marque>R Start</span> investit l’argent de ses clients ?
          </p>
        </div>
      </Container>
    </Section>
  </main>
</Base>

<style is:global>
  /* Les trois candidates, appliquées au seul mot « R Start » via [data-marque]. */
  [data-marque] {
    font-family: var(--essai-fonte, 'Source Serif 4 Variable', serif);
    font-weight: var(--essai-graisse, 600);
    font-size: calc(1em * var(--essai-corps, 1.06));
    font-style: var(--essai-style, normal);
    font-variant-caps: var(--essai-caps, normal);
    color: var(--essai-couleur, inherit);
    /* Le corps augmenté ne doit pas décaler la ligne de base des mots voisins. */
    line-height: 0;
  }
</style>

<script>
  /**
   * Les réglages écrivent des propriétés personnalisées sur <html> : aucun rendu n'est recalculé en
   * JavaScript, c'est la cascade qui fait le travail. Le choix est gardé d'une visite à l'autre, sans
   * quoi on reperd son réglage à chaque rechargement.
   */
  const FONTES: Record<string, string> = {
    pjs: 'inherit',
    ss: "'Source Serif 4 Variable', serif",
    ga: "'EB Garamond Variable', serif",
  };

  const init = (): void => {
    const form = document.querySelector<HTMLElement>('[data-reglages]');
    if (!form) return;
    const racine = document.documentElement;

    const appliquer = (): void => {
      const coches = [...form.querySelectorAll<HTMLInputElement>('input')].filter((i) => i.checked);
      const d = new Map(coches.map((i) => [i.name, i.value]));
      const fonte = String(d.get('fonte') ?? 'ss');
      racine.style.setProperty('--essai-fonte', FONTES[fonte] ?? 'inherit');
      racine.style.setProperty('--essai-graisse', String(d.get('graisse') ?? '600'));
      /* Sans seconde fonte, aucune compensation de corps : le mot est déjà à la bonne hauteur. */
      racine.style.setProperty(
        '--essai-corps',
        fonte === 'pjs' ? '1' : String(d.get('corps') ?? '1')
      );
      racine.style.setProperty('--essai-style', d.get('italique') ? 'italic' : 'normal');
      racine.style.setProperty('--essai-caps', d.get('petitescaps') ? 'small-caps' : 'normal');
      racine.style.setProperty(
        '--essai-couleur',
        d.get('teinte') ? 'var(--color-teal-700)' : 'inherit'
      );
      try {
        localStorage.setItem('essai-typo', JSON.stringify([...d.entries()]));
      } catch {
        /* stockage indisponible : le réglage vaudra pour cette page seulement */
      }
    };

    try {
      const garde = localStorage.getItem('essai-typo');
      if (garde) {
        const entrees = JSON.parse(garde) as [string, string][];
        const vus = new Set(entrees.map(([k]) => k));
        for (const c of form.querySelectorAll<HTMLInputElement>('input')) {
          if (c.type === 'checkbox') c.checked = vus.has(c.name);
          else if (c.type === 'radio')
            c.checked = entrees.some(([k, v]) => k === c.name && v === c.value);
        }
      }
    } catch {
      /* réglage illisible : on garde celui du HTML */
    }

    form.addEventListener('change', appliquer);
    appliquer();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
