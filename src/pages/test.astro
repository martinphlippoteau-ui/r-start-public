<style is:global>
  /* Les trois candidates, appliquées au seul mot « R Start » via [data-marque]. */
  [data-marque] {
    font-family: var(--essai-fonte, 'Source Serif 4 Variable', serif);
    font-weight: var(--essai-graisse, 600);
    font-size: calc(1em * var(--essai-corps, 1.06));
    font-style: var(--essai-style, normal);
    font-variant-caps: var(--essai-caps, normal);
    color: var(--essai-couleur, inherit);
    /* Le corps augmenté ne doit pas décaler la ligne de base des mots voisins. */
    line-height: 0;
  }
</style>

<script>
  /**
   * Les réglages écrivent des propriétés personnalisées sur <html> : aucun rendu n'est recalculé en
   * JavaScript, c'est la cascade qui fait le travail. Le choix est gardé d'une visite à l'autre, sans
   * quoi on reperd son réglage à chaque rechargement.
   */
  const FONTES: Record<string, string> = {
    pjs: 'inherit',
    ss: "'Source Serif 4 Variable', serif",
    ga: "'EB Garamond Variable', serif",
  };

  const init = (): void => {
    const form = document.querySelector<HTMLElement>('[data-reglages]');
    if (!form) return;
    const racine = document.documentElement;

    const appliquer = (): void => {
      const coches = [...form.querySelectorAll<HTMLInputElement>('input')].filter((i) => i.checked);
      const d = new Map(coches.map((i) => [i.name, i.value]));
      const fonte = String(d.get('fonte') ?? 'ss');
      racine.style.setProperty('--essai-fonte', FONTES[fonte] ?? 'inherit');
      racine.style.setProperty('--essai-graisse', String(d.get('graisse') ?? '600'));
      /* Sans seconde fonte, aucune compensation de corps : le mot est déjà à la bonne hauteur. */
      racine.style.setProperty(
        '--essai-corps',
        fonte === 'pjs' ? '1' : String(d.get('corps') ?? '1')
      );
      racine.style.setProperty('--essai-style', d.get('italique') ? 'italic' : 'normal');
      racine.style.setProperty('--essai-caps', d.get('petitescaps') ? 'small-caps' : 'normal');
      racine.style.setProperty(
        '--essai-couleur',
        d.get('teinte') ? 'var(--color-teal-700)' : 'inherit'
      );
      try {
        localStorage.setItem('essai-typo', JSON.stringify([...d.entries()]));
      } catch {
        /* stockage indisponible : le réglage vaudra pour cette page seulement */
      }
    };

    try {
      const garde = localStorage.getItem('essai-typo');
      if (garde) {
        const entrees = JSON.parse(garde) as [string, string][];
        const vus = new Set(entrees.map(([k]) => k));
        for (const c of form.querySelectorAll<HTMLInputElement>('input')) {
          if (c.type === 'checkbox') c.checked = vus.has(c.name);
          else if (c.type === 'radio')
            c.checked = entrees.some(([k, v]) => k === c.name && v === c.value);
        }
      }
    } catch {
      /* réglage illisible : on garde celui du HTML */
    }

    form.addEventListener('change', appliquer);
    appliquer();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>

<script>
  /**
   * Réglages des pictogrammes candidats (16/09/2026) : taille, opacité et teinte, appliqués aux six en
 * même temps. LES NOMS SONT PRÉFIXÉS `picto-` : l'essai typographique, plus haut dans la MÊME page,
 * a déjà une commande nommée « teinte », et deux groupes de même nom dans un document sont une
 * erreur html-validate (form-dup-name), en plus d'être ambigus pour les technologies d'assistance.
   * même temps pour qu'ils se comparent à conditions égales. Rien n'est écrit dans le HTML des SVG, on
   * ne touche qu'à trois propriétés d'un style en ligne.
   */
  const initPicto = (): void => {
    const form = document.querySelector<HTMLElement>('[data-reglages-picto]');
    if (!form) return;
    const pictos = [...document.querySelectorAll<SVGElement>('[data-picto]')];

    const appliquer = (): void => {
      const coches = [...form.querySelectorAll<HTMLInputElement>('input')].filter((i) => i.checked);
      const d = new Map(coches.map((i) => [i.name, i.value]));
      const taille = d.get('picto-taille') ?? '20';
      for (const p of pictos) {
        p.setAttribute('width', taille);
        p.setAttribute('height', taille);
        p.style.opacity = d.get('picto-opacite') ?? '0.45';
        p.style.color = d.get('picto-teinte') ?? 'currentColor';
      }
    };

    form.addEventListener('change', appliquer);
    appliquer();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPicto);
  else initPicto();
</script>
