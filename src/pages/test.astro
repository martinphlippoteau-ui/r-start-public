---
/**
 * Page d'essai interne, /test : HORS MENU, hors plan du site, `noindex`. Depuis le 25/09/2026 elle
 * porte les dix façons d'afficher les barèmes à paliers du comparateur (BaremesEssais.astro). À
 * supprimer une fois tranché.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import BaremesEssais from '@/components/pages/test/BaremesEssais.astro';
---

<Base title="Essai des barèmes" description="Page d’essai interne, hors menu." path="/test" noindex>
  <SiteNav />
  <main id="contenu">
    <BaremesEssais />
  </main>
  <Footer />
</Base>
