---
/**
 * Page d'essai typographique, /test (demande de l'équipe du 15/09/2026 : mettre « R Start » en
 * avant dans les titres avec une seconde typographie, et choisir sur pièces) : les neuf titres du
 * site qui contiennent « R Start », aux tailles réelles des paliers (H1 en display-lg, H2 en
 * display-md), avec des réglages manipulés en direct (fonte, graisse, compensation de corps,
 * italique, petites capitales). DEUX CANDIDATES SEULEMENT, et ce n'est pas un choix de goût : Adobe
 * Caslon, FreightBig Pro et Kepler passent par Adobe Fonts, qui interdit l'auto-hébergement et
 * impose un script depuis use.typekit.net, or la politique de sécurité du contenu
 * (src/layouts/Base.astro) n'autorise que `'self'`, googletagmanager et trustpilot pour les
 * scripts, et `'self'` pour les styles. Source Serif 4 et EB Garamond sont sous licence libre (SIL
 * OFL), variables, hébergées comme Plus Jakarta Sans. HORS MENU, hors plan du site, `noindex`. À
 * SUPPRIMER une fois le choix fait, avec la fonte non retenue.
 */
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/eb-garamond';
import Base from '@/layouts/Base.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import IconExterne from '@/components/ui/IconExterne.astro';

/**
 * Le système de boutons retenu (17/09/2026, tranché par l'équipe) : quatre rôles (global.css, « Les
 * quatre rôles de bouton ») et six composants à part. La page montre ce qui reste, rendu avec les
 * vrais utilitaires.
 */

/** Les neuf titres du site qui nomment R Start, relevés dans dist/ le 15/09/2026. */
const TITRES: { niveau: 1 | 2; avant: string; apres: string }[] = [
  { niveau: 2, avant: '', apres: ' table sur deux moteurs de performance' },
  { niveau: 2, avant: '', apres: ' : la seule SCPI qui ne prend des frais que si vous gagnez.' },
  { niveau: 2, avant: '', apres: ' en un clin d’œil' },
  { niveau: 2, avant: 'Investir dans ', apres: ' comporte des risques.' },
  { niveau: 2, avant: 'Vos questions sur la SCPI ', apres: '.' },
  { niveau: 2, avant: 'Société de gestion de ', apres: '' },
  { niveau: 1, avant: 'L’expérience derrière ', apres: '' },
  { niveau: 1, avant: 'Comment ', apres: ' investit l’argent de ses clients ?' },
];
---

{/* `noindex` : le bandeau de ce fichier le promettait, la prop n'était pas passée. Hors
  prévisualisation, cette page interne sortait en « index, follow » (audit du 18/09/2026). */}
<Base
  title="Essai typographique"
  description="Page d’essai interne, hors menu."
  path="/test"
  noindex
>
  <main id="contenu">
    <Section id="essai" tone="paper">
      <Container size="wide">
        <p class="text-eyebrow text-teal-700">Page d’essai interne</p>
        <h1 id="essai-title" class="text-display-md mt-3 text-ink">
          Mettre « R Start » en avant dans les titres
        </h1>
        <p class="text-lead mt-5 max-w-3xl text-slate-700">
          Les neuf titres du site qui nomment R Start, aux tailles réelles. Les réglages
          s’appliquent en direct à tout ce qui suit.
        </p>

        {
          /* Un <div> et non un <form> : rien n'est soumis, tout se joue dans la cascade CSS. Un
            formulaire sans bouton d'envoi est d'ailleurs une erreur d'accessibilité (WCAG H32). */
        }
        <div
          class="mt-10 grid gap-6 rounded-3xl bg-white p-6 shadow-card sm:grid-cols-2 lg:grid-cols-3 lg:p-8"
          data-reglages
        >
          <fieldset>
            <legend class="text-caption font-semibold text-navy">Fonte</legend>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['pjs', 'Plus Jakarta Sans (actuelle)'],
                  ['ss', 'Source Serif 4'],
                  ['ga', 'EB Garamond'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="fonte" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-caption font-semibold text-navy">Graisse</legend>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['400', 'Normale (400)'],
                  ['600', 'Demi-grasse (600)'],
                  ['700', 'Grasse (700)'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="graisse" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-caption font-semibold text-navy">Corps</legend>
            <p class="text-caption mt-1 text-slate-700">
              Les serifs ont une hauteur d’x plus basse : sans compensation, le mot paraît plus
              petit que ses voisins.
            </p>
            <div class="mt-3 flex flex-col gap-2">
              {
                [
                  ['1', 'Identique'],
                  ['1.06', '+ 6 %'],
                  ['1.12', '+ 12 %'],
                  ['1.18', '+ 18 %'],
                ].map(([v, l], i) => (
                  <label class="flex items-center gap-2 text-base">
                    <input type="radio" name="corps" value={v} checked={i === 1} />
                    {l}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="sm:col-span-2 lg:col-span-3">
            <legend class="text-caption font-semibold text-navy">Style</legend>
            <div class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="italique" /> Italique
              </label>
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="petitescaps" /> Petites capitales
              </label>
              <label class="flex items-center gap-2 text-base">
                <input type="checkbox" name="teinte" /> Teinte turquoise
              </label>
            </div>
          </fieldset>
        </div>
      </Container>
    </Section>

    <Section id="titres" tone="white">
      <Container size="wide">
        <h2 id="titres-title" class="visually-hidden">Les titres, sur fond clair</h2>
        <div class="flex flex-col gap-12 lg:gap-16" data-titres>
          {
            /* `set:html` plutôt que du JSX : entre `{t.avant}` et le <span>, Prettier réintroduit
               un retour à la ligne, donc une espace, et « R Start . » se lisait avec une espace
               avant le point. Les trois morceaux sont des littéraux de ce fichier, rien ne vient de
               l'extérieur. */
            TITRES.map((t) => (
              <p
                class={t.niveau === 1 ? 'text-display-lg text-ink' : 'text-display-md text-ink'}
                set:html={`${t.avant}<span data-marque>R Start</span>${t.apres}`}
              />
            ))
          }
        </div>
      </Container>
    </Section>

    <Section id="sombre" tone="ink">
      <Container size="wide">
        <h2 id="sombre-title" class="text-eyebrow text-teal-200">Sur fond sombre</h2>
        <div class="mt-8 flex flex-col gap-12" data-titres>
          <p class="text-display-md text-white">
            Investir dans <span data-marque>R Start</span> comporte des risques.
          </p>
          <p class="text-display-lg text-white">
            Comment <span data-marque>R Start</span> investit l’argent de ses clients ?
          </p>
        </div>
      </Container>
    </Section>

    <Section id="cta" tone="paper">
      <Container size="wide">
        <p class="text-eyebrow text-teal-700">Décisions du 17 septembre 2026</p>
        <h2 id="cta-title" class="text-display-md mt-3 text-ink">
          Le système retenu : quatre rôles, six composants à part
        </h2>
        <p class="text-lead mt-5 max-w-3xl text-slate-700">
          Vingt-deux familles de boutons et de liens ont été ramenées à ceci. Tout est rendu avec les
          utilitaires de global.css (« Les quatre rôles de bouton ») que Button.astro compose et que
          les boutons écrits à la main reprennent tels quels.
        </p>

        <ol class="mt-10 grid gap-6" aria-label="Les rôles sur fond clair">
          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <Button href="/frais" variant="primary" size="sm">Souscrire</Button>
              <Button href="/frais" variant="primary" size="md">Souscrire</Button>
              <Button href="/frais" variant="primary" size="lg">Souscrire en ligne</Button>
              <button type="button" class="btn btn-motion btn-primary btn-sm">Tout accepter</button>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink">Principal · Button primary, `btn-primary`</p>
              <p class="mt-1">L’action que la page attend. Souscrire, et les actions d’une fenêtre : Fermer, Tout accepter et Tout refuser (bandeau cookies), Aller au contenu.</p>
            </div>
          </li>
          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <Button href="/a-propos" variant="secondary" size="sm">Gérer les cookies</Button>
              <Button href="/a-propos" variant="secondary" size="md">Haut de page</Button>
              <Button href="https://www.corum.fr" variant="secondary" size="lg" target="_blank">Découvrir CORUM<span class="visually-hidden"> (nouvelle fenêtre)</span></Button>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink">Secondaire · Button secondary, `btn-secondary`</p>
              <p class="mt-1">Un contour ; au survol, le contour se renforce et un fond translucide se pose, le texte ne change pas. Haut de page, gérer les cookies, enregistrer mes choix, les six liens de la 404, Découvrir CORUM.</p>
            </div>
          </li>
          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
              <a href="#cta" class="link-underline text-sm text-slate-700 hover:text-navy">Accueil</a>
              <a href="#cta" class="link-underline inline-flex min-h-11 items-center gap-1.5 py-1.5 text-base text-slate-700 hover:text-navy">Mentions légales</a>
              <a href="#cta" class="link-underline inline-flex items-center gap-2 text-base font-semibold text-navy hover:text-teal-700 sm:text-lg">Voir toutes les questions <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></a>
              <a href="https://fr.trustpilot.com/review/www.corum.fr" target="_blank" rel="noopener noreferrer" class="link-underline inline-flex items-center gap-2 text-base font-semibold text-navy hover:text-teal-700">Lire les avis sur Trustpilot<span class="visually-hidden"> (nouvelle fenêtre)</span> <IconExterne class="size-4 shrink-0" /></a>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink">Lien de contenu · `link-underline`</p>
              <p class="mt-1">Souligné au survol, deux corps : 14 px en liste (fil d’Ariane, pied de page), 16 px en semi-gras pour une suite de lecture, flèche diagonale s’il sort du site. Plus aucun lien souligné en permanence.</p>
            </div>
          </li>
          <li class="grid gap-6 rounded-3xl bg-white p-6 shadow-card lg:grid-cols-[1fr_22rem] lg:gap-10 lg:p-8">
            <div class="flex flex-wrap items-center gap-4">
              <ul class="flex items-center gap-1" aria-label="Entrées de la barre">
                <li><a href="#cta" class="block rounded-full px-3.5 py-1.5 text-base font-medium whitespace-nowrap text-slate-700 no-underline transition-colors hover:text-navy">Comparateur de frais</a></li>
                <li><a href="#cta" class="block rounded-full px-3.5 py-1.5 text-base font-semibold whitespace-nowrap text-navy no-underline">Notre approche</a></li>
              </ul>
              <a href="#cta" class="nav-link inline-flex items-center rounded-full px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-navy no-underline transition-colors hover:bg-teal-100 sm:text-base">Réglementaire</a>
            </div>
            <div class="text-caption text-slate-700">
              <p class="text-base font-semibold text-ink">Lien de navigation · `nav-link`, pastille</p>
              <p class="mt-1">Barre (pastille de verre glissante), tiroir (même pastille, fond blanc à 12 % pour la page courante) et barres d’ancres : une seule forme, sans contour.</p>
            </div>
          </li>
        </ol>
      </Container>
    </Section>

    <Section id="cta-sombre" tone="ink">
      <Container size="wide">
        <h2 id="cta-sombre-title" class="text-eyebrow text-teal-200">Les mêmes rôles sur fond sombre</h2>
        <div class="mt-8 grid gap-6 rounded-3xl bg-ink-800 p-6 lg:p-8">
          <div class="flex flex-wrap items-center gap-4">
            <Button href="/frais" variant="light" size="md">Souscrire</Button>
            <Button href="/frais" variant="light" size="lg">Souscrire en ligne</Button>
            <Button href="/strategie" variant="outline-light" size="sm">En savoir plus</Button>
            <Button href="/strategie" variant="outline-light" size="md">Découvrir notre approche</Button>
            <Button href="/frais" variant="outline-light" size="lg">Comparer les frais</Button>
          </div>
          <div class="flex flex-wrap items-center gap-6">
            <a href="#cta" class="link-underline text-sm text-white/85 hover:text-white">Accueil</a>
            <a href="#cta" class="block rounded-full px-3.5 py-2.5 text-base font-semibold text-white no-underline bg-white/12">Notre approche</a>
            <span class="text-white">Horizon <button type="button" class="info-bouton info-bouton-sombre" aria-label="Expliquer"><span aria-hidden="true">i</span></button></span>
            <span class="text-ink"><button type="button" class="info-bouton bg-white" aria-label="Définition"><span aria-hidden="true">i</span></button></span>
          </div>
          <p class="text-caption text-white/70">Principal en blanc plein, Secondaire en contour blanc (dont « En savoir plus » et « Fermer » des cartes de /strategie), lien de contenu en blanc, entrée de tiroir en pastille, bouton « i » en deux tons.</p>
        </div>
      </Container>
    </Section>
  </main>
</Base>

<style is:global>
  /* Les trois candidates, appliquées au seul mot « R Start » via [data-marque]. */
  [data-marque] {
    font-family: var(--essai-fonte, 'Source Serif 4 Variable', serif);
    font-weight: var(--essai-graisse, 600);
    font-size: calc(1em * var(--essai-corps, 1.06));
    font-style: var(--essai-style, normal);
    font-variant-caps: var(--essai-caps, normal);
    color: var(--essai-couleur, inherit);
    /* Le corps augmenté ne doit pas décaler la ligne de base des mots voisins. */
    line-height: 0;
  }
</style>

<script>
  /**
   * Les réglages écrivent des propriétés personnalisées sur <html> : aucun rendu n'est recalculé en
   * JavaScript, c'est la cascade qui fait le travail. Le choix est gardé d'une visite à l'autre
   * (localStorage).
   */
  const FONTES: Record<string, string> = {
    pjs: 'inherit',
    ss: "'Source Serif 4 Variable', serif",
    ga: "'EB Garamond Variable', serif",
  };

  const init = (): void => {
    const form = document.querySelector<HTMLElement>('[data-reglages]');
    if (!form) return;
    const racine = document.documentElement;

    const appliquer = (): void => {
      const coches = [...form.querySelectorAll<HTMLInputElement>('input')].filter((i) => i.checked);
      const d = new Map(coches.map((i) => [i.name, i.value]));
      const fonte = String(d.get('fonte') ?? 'ss');
      racine.style.setProperty('--essai-fonte', FONTES[fonte] ?? 'inherit');
      racine.style.setProperty('--essai-graisse', String(d.get('graisse') ?? '600'));
      /* Sans seconde fonte, aucune compensation de corps : le mot est déjà à la bonne hauteur. */
      racine.style.setProperty(
        '--essai-corps',
        fonte === 'pjs' ? '1' : String(d.get('corps') ?? '1')
      );
      racine.style.setProperty('--essai-style', d.get('italique') ? 'italic' : 'normal');
      racine.style.setProperty('--essai-caps', d.get('petitescaps') ? 'small-caps' : 'normal');
      racine.style.setProperty(
        '--essai-couleur',
        d.get('teinte') ? 'var(--color-teal-700)' : 'inherit'
      );
      try {
        localStorage.setItem('essai-typo', JSON.stringify([...d.entries()]));
      } catch {
        /* stockage indisponible : le réglage vaudra pour cette page seulement */
      }
    };

    try {
      const garde = localStorage.getItem('essai-typo');
      if (garde) {
        const entrees = JSON.parse(garde) as [string, string][];
        const vus = new Set(entrees.map(([k]) => k));
        for (const c of form.querySelectorAll<HTMLInputElement>('input')) {
          if (c.type === 'checkbox') c.checked = vus.has(c.name);
          else if (c.type === 'radio')
            c.checked = entrees.some(([k, v]) => k === c.name && v === c.value);
        }
      }
    } catch {
      /* réglage illisible : on garde celui du HTML */
    }

    form.addEventListener('change', appliquer);
    appliquer();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
