---
/**
 * Pages légales (/mentions-legales, /politique-de-confidentialite, /cookies) générées depuis
 * src/content/fr/pages.ts (legalPages) : SiteNav, fil d'Ariane, H1, sections H2, aucun texte en
 * dur. /cookies est en noindex : son contenu double le bandeau de consentement. Les mentions
 * légales et la politique de confidentialité restent indexables À DESSEIN : un site réglementé
 * gagne à ce qu'on les trouve, l'écart n'est pas un oubli.
 */
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Container from '@/components/ui/Container.astro';
import { legalPages } from '@/content/fr/pages';
import { consent } from '@/content/fr/consent';
import { pages, type PageKey } from '@/config/pages';
import { slug } from '@/lib/ancre';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

export const getStaticPaths = (() =>
  legalPages.map((page) => ({
    params: { slug: page.path.replace(/^\//, '') },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageKey = ((Object.keys(pages) as PageKey[]).find((k) => pages[k].path === page.path) ??
  'legal') as PageKey;
const noindex = pageKey === 'cookies';
const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: page.title, description: page.description }),
  breadcrumbJsonLd(pageKey),
];
---

<Base
  title={page.title}
  description={page.description}
  path={page.path}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <SiteNav />
  {
    /* La navigation flottante recouvre le haut de la page : sa hauteur est réservée ici (les pages
    à en-tête sombre la réservent dans leur en-tête). */
  }
  <main id="contenu" class="pt-nav-total bg-paper">
    <Container size="narrow" class="py-10 sm:py-14">
      <Breadcrumb key={pageKey} tone="light" />
      <h1 class="text-display-md mt-8">{page.title}</h1>
      <p class="text-lead mt-4 text-slate-700">{page.description}</p>
      <div class="mt-12 space-y-12">
        {
          page.sections.map((section) => (
            <section
              aria-labelledby={'s-' + slug(section.title)}
            >
              <h2
                id={'s-' + slug(section.title)}
                class="text-display-sm"
              >
                {section.title}
              </h2>
              <div class="mt-4 space-y-4 text-base leading-relaxed">
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      {
        pageKey === 'cookies' && (
          <p class="mt-12">
            <button
              type="button"
              data-consent-open
              class="btn btn-motion btn-secondary btn-sm"
            >
              {consent.manageLabel}
            </button>
          </p>
        )
      }
    </Container>
  </main>
  <Footer />
</Base>
