---
/**
 * Page /strategie, « Stratégie d'investissement » (menu, décision du 10/09/2026 : la stratégie quitte
 * l'accueil, qui n'en garde que le chapitre court). SiteNav → main#contenu : PageHero (fil d'Ariane, H1,
 * CTA souscrire, SANS ligne risques depuis le 14/09/2026) → les trois sections de la stratégie
 * (04-Strategy.astro : #strategie, #quoi, #ou, contenu strategy.ts) → Footer. PLUS DE BLOC « Notes »
 * depuis le 14/09/2026 : le texte fourni par l'équipe ne porte aucun appel de note, et le bloc affichait
 * un « Sources et précisions (0) » à déplier sur rien. Métadonnées et
 * JSON-LD (Organization, WebPage, BreadcrumbList) depuis strategyPage.ts, config/pages.ts et src/lib/seo.ts.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Strategy from '@/components/sections/04-Strategy.astro';
import { pages } from '@/config/pages';
import { strategyPage } from '@/content/fr/strategyPage';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.strategy;
const { seo, hero } = strategyPage;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('strategy'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero eyebrow={hero.eyebrow} title={hero.title}>
      <Breadcrumb slot="breadcrumb" key="strategy" tone="dark" />
      <Button slot="cta" position={strategyPage.cta.position} variant="light" size="lg">
        {strategyPage.cta.label}
      </Button>
    </PageHero>
    <Strategy />
  </main>

  {
    /* Pastille d'appel : elle prend le RELAIS du CTA de l'en-tête, dès que celui-ci n'est plus à
      l'écran, et reste jusqu'au bas de page. Accrochée à la première section de contenu, elle
      s'affichait alors que le CTA de l'en-tête était encore visible : deux appels identiques à
      quelques centimètres l'un de l'autre. Rendue au niveau de la page, jamais dans une section. */
  }
  <StickyCta
    label={strategyPage.cta.label}
    position={strategyPage.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
