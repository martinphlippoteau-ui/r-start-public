---
/**
 * Page /strategie, « Stratégie d'investissement » (menu, décision du 10/09/2026 : la stratégie quitte
 * l'accueil, qui n'en garde plus de chapitre depuis le 11/09/2026). SiteNav → main#contenu :
 * PageHero (fil d'Ariane, H1, chute, CTA souscrire, SANS ligne risques depuis le 14/09/2026) → les
 * trois sections de la stratégie (04-Strategy.astro : #strategie, #quoi, #ou, #comment, contenu
 * strategy.ts) → #risques (08-Risks.astro, le bloc de l'accueil) → FAQ courte (10-Faq.astro,
 * 16/09/2026) → Footer. Plus de bloc « Notes » depuis le 14/09/2026 : le texte fourni par l'équipe
 * ne porte aucun appel de note, et le bloc affichait un « Sources et précisions (0) » à déplier sur
 * rien. Métadonnées et JSON-LD (Organization, WebPage, BreadcrumbList) depuis strategyPage.ts, config/pages.ts et src/lib/seo.ts.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Strategy from '@/components/sections/04-Strategy.astro';
import Risks from '@/components/sections/08-Risks.astro';
import Faq from '@/components/sections/10-Faq.astro';
import { pages } from '@/config/pages';
import { strategyPage } from '@/content/fr/strategyPage';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.strategy;
const { seo, hero } = strategyPage;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('strategy'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero title={hero.title} punchline={hero.punchline}>
      <Breadcrumb slot="breadcrumb" key="strategy" tone="dark" />
      <Button slot="cta" position={strategyPage.cta.position} variant="light" size="lg">
        {strategyPage.cta.label}
      </Button>
    </PageHero>
    <Strategy />

    {
      /* Bloc des risques de l'accueil, rendu TEL QUEL en fin de page (14/09/2026, demande de l'équipe :
        « ajoute le même bloc de risques à la fin que sur la homepage »). Même composant, même contenu,
        mêmes risques (quatre depuis le 16/09/2026) : c'est la seule façon qu'ils ne divergent
        jamais d'une page à l'autre.
        Il porte son rideau de chapitre : la section qui le précède ici est « Comment », sur fond clair,
        et le bloc sombre monte par-dessus, comme sur l'accueil. */
    }
    <Risks />
    {
      /*
       * FAQ COURTE EN FIN DE PAGE (16/09/2026) : quatre questions, comme sur l'accueil et
       * /documentation, avec le renvoi vers /faq. Elle vient APRÈS les risques, jamais avant : le
       * contre-poids doit être lu avant qu'on reparte vers d'autres réponses.
       * `revealTitle` reste à sa valeur par défaut : /strategie charge déjà GSAP, pour ses titres mot à
       * mot (`data-reveal-text`) et le rideau des Risques (`data-curtain`), et ne figure pas dans les
       * sous-pages que tests/performance.spec.ts en protège.
       */
    }
    <Faq tone="paper" />
  </main>

  {
    /* Pastille d'appel : elle prend le RELAIS du CTA de l'en-tête, dès que celui-ci n'est plus à
      l'écran, et reste jusqu'au bas de page. Accrochée à la première section de contenu, elle
      s'affichait alors que le CTA de l'en-tête était encore visible : deux appels identiques à
      quelques centimètres l'un de l'autre. Rendue au niveau de la page, jamais dans une section. */
  }
  <StickyCta
    label={strategyPage.cta.label}
    position={strategyPage.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
