---
/**
 * Page /strategie, « Stratégie d'investissement » (la stratégie a quitté l'accueil le 10/09/2026).
 * SiteNav → main#contenu : PageHero (fil d'Ariane, H1, chute, CTA souscrire, SANS ligne risques) →
 * les trois sections de la stratégie (04-Strategy.astro : #strategie, #quoi, #ou, #comment, contenu
 * strategy.ts) → #risques (08-Risks.astro, le bloc de l'accueil) → FAQ courte (10-Faq.astro) →
 * Footer. Plus de bloc « Notes » (14/09/2026) : le texte de l'équipe ne porte aucun appel de note.
 * Métadonnées et JSON-LD (Organization, WebPage, BreadcrumbList) depuis strategyPage.ts,
 * config/pages.ts et src/lib/seo.ts.
 */
import Base from '@/layouts/Base.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Button from '@/components/ui/Button.astro';
import StickyCta from '@/components/StickyCta.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Strategy from '@/components/sections/04-Strategy.astro';
import Risks from '@/components/sections/08-Risks.astro';
import Faq from '@/components/sections/10-Faq.astro';
import { pages } from '@/config/pages';
import { strategyPage } from '@/content/fr/strategyPage';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const page = pages.strategy;
const { seo, hero } = strategyPage;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path: page.path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('strategy'),
];
---

<Base title={seo.title} description={seo.description} path={page.path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    {
      /* PREMIER PLAN (24/09/2026, Martin : « les sections à fond bleu comme sous les autres »),
        essayé ici puis étendu à tout le site : les sections claires passent au premier plan des
        sombres, coins arrondis et ombre (ui/Section.astro `plan` / `sous`). L'en-tête et les
        Risques sont recouverts. */
    }
    <PageHero title={hero.title} punchline={hero.punchline} sousPlan>
      <Breadcrumb slot="breadcrumb" key="strategy" tone="dark" />
      <Button slot="cta" position={strategyPage.cta.position} variant="light" size="lg">
        {strategyPage.cta.label}
      </Button>
    </PageHero>
    <Strategy />

    {
      /* Bloc des risques de l'accueil, rendu TEL QUEL en fin de page (14/09/2026, demande de
        l'équipe : « ajoute le même bloc de risques à la fin que sur la homepage ») : même
        composant, même contenu, la seule façon qu'ils ne divergent jamais d'une page à l'autre.
        Depuis le 24/09/2026 il passe SOUS les sections claires qui l'entourent (volets avant, FAQ
        après), plus de rideau. */
    }
    <Risks />
    {
      /* FAQ courte en fin de page (16/09/2026) : quatre questions, comme sur l'accueil et
        /documentation, avec le renvoi vers /faq. Elle vient APRÈS les risques, jamais avant : le
        contre-poids doit être lu avant qu'on reparte vers d'autres réponses. `revealTitle` reste à
        sa valeur par défaut : /strategie charge déjà GSAP (titres mot à mot, rideau des Risques)
        et ne figure pas dans les sous-pages que tests/performance.spec.ts en protège. */
    }
    <Faq tone="paper" />
  </main>

  {
    /* Pastille d'appel (au niveau de la page, voir StickyCta.astro) : relais du CTA de l'en-tête
      dès qu'il n'est plus à l'écran, jusqu'au bas de page. Accrochée à la première section, elle
      doublait un CTA encore visible. */
  }
  <StickyCta
    label={strategyPage.cta.label}
    position={strategyPage.cta.position}
    watch="#en-tete a[data-cta='souscrire']"
  />
  <Footer />
</Base>
