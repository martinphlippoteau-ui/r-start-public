---
/**
 * Page /documentation (périmètre v2, plan §12) : centre de documents de R Start.
 * SiteNav collée en haut → main#contenu : PageHero (fil d'Ariane, H1, intro, ligne
 * risques visible sans scroller) → navigation d'ancres collante → un groupe de documents par section
 * (#reglementaire, #frais, #formulaire ; seuls les groupes publiant au moins un document existent) →
 * guide de souscription en quatre étapes (avec le bloc MyCORUM, trame du 10/09/2026) → FAQ → mention 2 + renvoi corum.fr + CTA → notes de la page →
 * Footer. Métadonnées et JSON-LD (Organization, WebPage, BreadcrumbList) depuis documentation.ts,
 * config/pages.ts et src/lib/seo.ts : aucun texte en dur.
 * Les notes légales sont celles de la page (documentation.notes), numérotées par DocNoteRef.
 */
import Base from '@/layouts/Base.astro';
import AppMyCorum from '@/components/AppMyCorum.astro';
import RegulatoryFrame from '@/components/pages/documentation/RegulatoryFrame.astro';
import SiteNav from '@/components/SiteNav.astro';
import Footer from '@/components/Footer.astro';
import LegalNotes from '@/components/LegalNotes.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import PageHero from '@/components/ui/PageHero.astro';
import DocumentGroup from '@/components/pages/documentation/DocumentGroup.astro';
import DocumentationFaq from '@/components/pages/documentation/DocumentationFaq.astro';
import DocumentsMention from '@/components/pages/documentation/DocumentsMention.astro';
import DocumentsNav from '@/components/pages/documentation/DocumentsNav.astro';
import HowTo from '@/components/pages/documentation/HowTo.astro';
import { pages } from '@/config/pages';
import { documentation } from '@/content/fr/documentation';
import { breadcrumbJsonLd, organizationJsonLd, webPageJsonLd } from '@/lib/seo';

const { seo, hero, groups, howTo, faq, corumLink, mention, cta, notes } = documentation;
const labels = documentation.labels ?? {};
const path = pages.documentation.path;

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd({ path, title: seo.title, description: seo.description }),
  breadcrumbJsonLd('documentation'),
];

/** Détail lu par les lecteurs d'écran après le titre de chaque lien de document (ex. « PDF, nouvelle fenêtre »). */
const linkHint = [labels.fileTypeLabel, labels.newTabHint].filter(Boolean).join(', ');
const linkHintId = linkHint ? 'documentation-link-hint' : undefined;
---

<Base title={seo.title} description={seo.description} path={path} jsonLd={jsonLd}>
  <SiteNav />
  <main id="contenu">
    <PageHero
      eyebrow={hero.eyebrow}
      title={hero.title}
      intro={hero.intro}
      riskLine={hero.riskLine}
      asideOnLarge
    >
      <Breadcrumb slot="breadcrumb" key="documentation" tone="dark" />
      {
        /* Sommaire des groupes publiés, avec leur décompte : sur grand écran il occupe la moitié droite
          restée vide et dit d'emblée ce que la page contient. Sous `lg`, la barre d'ancres collante
          juste dessous rend le même service : l'aside n'y est pas rendu. */
      }
      <nav slot="aside" aria-label={labels.anchorsAsideLabel ?? labels.anchorsLabel}>
        <ul role="list" class="rounded-3xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur-sm">
          {
            groups.map((group) => (
              <li class="border-b border-white/15 last:border-0">
                <a
                  href={'#' + group.key}
                  class="nav-link flex items-baseline justify-between gap-4 rounded-2xl px-4 py-3 text-white no-underline transition-colors hover:bg-white/10"
                >
                  <span class="text-base font-semibold sm:text-lg">{group.title}</span>
                  <span class="text-base text-white/80 tabular-nums">
                    {(labels.anchorsCountLabel ?? '{n}')
                      .replace('{n}', String(group.items.length))
                      .replace('{s}', group.items.length > 1 ? 's' : '')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </PageHero>

    <DocumentsNav groups={groups} label={labels.anchorsLabel} />
    {
      linkHintId && (
        <span id={linkHintId} hidden>
          {linkHint}
        </span>
      )
    }

    {
      groups.map((group, i) => (
        <DocumentGroup
          group={group}
          tone={i % 2 === 0 ? 'paper' : 'white'}
          labels={labels}
          hintId={linkHintId}
        />
      ))
    }

    <HowTo howTo={howTo} labels={labels} tone={groups.length % 2 === 0 ? 'paper' : 'white'}>
      <AppMyCorum slot="aside" class="mt-10" />
    </HowTo>
    <DocumentationFaq
      faq={faq}
      labels={labels}
      tone={groups.length % 2 === 0 ? 'white' : 'paper'}
    />
    {
      /* Cadre réglementaire descendu de l'accueil (11/09/2026) : visa, agrément, dépositaire, SFDR. */
    }
    <RegulatoryFrame tone={groups.length % 2 === 0 ? 'paper' : 'white'} />
    <DocumentsMention
      mention={mention}
      corumLink={corumLink}
      cta={cta}
      newTabHint={labels.newTabHint}
    />
    <LegalNotes notes={notes} />
  </main>
  <Footer />
</Base>
