---
/**
 * Charge le script qui joue l'ouverture de l'accueil une seule fois par session, dans le <head> de
 * l'accueil UNIQUEMENT (`<IntroOnce slot="head" />`, voir public/intro-once.js). `is:inline` :
 * servi tel quel depuis public/, hors bundle, donc classique et bloquant, exécuté avant le rendu du
 * corps.
 */
import { withBase } from '@/lib/href';
---

<script is:inline src={withBase('/intro-once.js')}></script>
