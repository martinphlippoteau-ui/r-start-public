---
import { site } from '@/config/site';
import { withBase } from '@/lib/href';

/** Prévisualisation : aucune page n'est indexable, quelle que soit la valeur passée par la page. */
/* Lu par src/config/site.ts, qui refuse une valeur qu'il ne comprend pas au lieu de la lire « faux ». */
const preview = site.noindex;

interface Props {
  title: string;
  description: string;
  /** Chemin canonique (ex. "/"). Par défaut : chemin courant. */
  path?: string;
  noindex?: boolean;
  ogImageAlt?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  ogImageAlt = site.name + ', ' + site.publisher,
} = Astro.props;

/* La barre finale RESTE (18/09/2026) : c'est la forme que l'hébergeur sert et que le sitemap liste. Elle
   était retirée ici, et la page servie en « /frais/ » déclarait canonique « /frais », qui redirige. */
const canonical = new URL(withBase(path), site.url + '/').toString();
const ogImageUrl = new URL(withBase(site.ogImagePath), site.url + '/').toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="fr" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<meta
  name="robots"
  content={noindex || preview ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
/>

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
