---
/**
 * Fenêtre « la souscription arrive bientôt ». Rendue uniquement quand l'URL du tunnel n'est pas
 * encore configurée (Base.astro teste `site.subscribeIsPlaceholder`) : le jour où la vraie URL est
 * fournie, le composant disparaît et les boutons reprennent leur navigation normale.
 *
 * Élément <dialog> natif : piège à focus, fermeture par Échap et retour du focus au bouton d'origine
 * assurés par le navigateur. Sans JavaScript, le lien conserve son comportement d'origine.
 * Contenu : src/content/fr/subscribeSoon.ts.
 */
import { subscribeSoon } from '@/content/fr/subscribeSoon';
---

<dialog
  id="subscribe-soon"
  data-subscribe-soon
  aria-labelledby="subscribe-soon-title"
  class="m-auto w-[min(32rem,calc(100vw-2rem))] rounded-3xl border border-mist bg-white p-0 text-ink shadow-float backdrop:bg-ink/60 backdrop:backdrop-blur-sm"
>
  <div class="p-6 sm:p-8">
    <p class="text-eyebrow text-teal-700">{subscribeSoon.eyebrow}</p>
    <h2 id="subscribe-soon-title" class="text-display-sm mt-3">{subscribeSoon.title}</h2>
    <div class="mt-4 space-y-3 text-base leading-relaxed text-slate-700">
      {subscribeSoon.body.map((p) => <p>{p}</p>)}
    </div>
    {
      /*
       * PLUS DE RENVOI VERS LA DOCUMENTATION depuis le 16/09/2026, demande de l'équipe. La fenêtre
       * s'ouvrait sur deux boutons : « Voir la documentation » puis « Fermer ». Il ne reste que le
       * second, qui devient donc le bouton principal de la fenêtre.
       * `documentsLabel` et `documentsHref` restent dans subscribeSoon.ts, non lus : le jour où le
       * renvoi revient, il n'y a qu'à rétablir ce bouton.
       */
    }
    <div class="mt-7 flex flex-wrap gap-3">
      <button
        type="button"
        data-subscribe-soon-close
        class="btn-motion inline-flex items-center justify-center rounded-full bg-navy px-6 py-3 font-semibold text-white hover:bg-teal-700"
      >
        {subscribeSoon.closeLabel}
      </button>
    </div>
  </div>
</dialog>

<style>
  /*
   * OUVERTURE ET FERMETURE EN FONDU (audit du 16/09/2026) : la fenêtre apparaissait d'un coup, alors que
   * le tiroir du menu, l'autre dialogue modal du site, glisse en 420 ms. Elle se pose maintenant en
   * montant d'un cheveu, son voile se fond, et les deux repartent de même.
   * `@starting-style` donne l'état de départ d'un élément qui vient d'être affiché ; `display` et
   * `overlay` en transition discrète le gardent affiché et dans la couche supérieure le temps de la
   * sortie. Un navigateur qui ignore ces règles ouvre et ferme d'un coup, comme avant.
   */
  @media (prefers-reduced-motion: no-preference) {
    [data-subscribe-soon] {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.98);
      transition:
        opacity 240ms var(--ease-out-expo),
        transform 320ms var(--ease-out-expo),
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }
    [data-subscribe-soon][open] {
      opacity: 1;
      transform: none;
    }
    [data-subscribe-soon]::backdrop {
      opacity: 0;
      transition:
        opacity 320ms var(--ease-out-expo),
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }
    [data-subscribe-soon][open]::backdrop {
      opacity: 1;
    }
    @starting-style {
      [data-subscribe-soon][open] {
        opacity: 0;
        transform: translateY(0.75rem) scale(0.98);
      }
      [data-subscribe-soon][open]::backdrop {
        opacity: 0;
      }
    }
  }
</style>

<script>
  /* Intercepte les boutons « Souscrire » tant que le tunnel n'est pas configuré. */
  const dialog = document.querySelector<HTMLDialogElement>('[data-subscribe-soon]');
  if (dialog && typeof dialog.showModal === 'function') {
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const cta = target?.closest<HTMLAnchorElement>('[data-cta="souscrire"]');
      if (!cta) return;
      event.preventDefault();
      const dataLayer = ((window as unknown as { dataLayer?: unknown[] }).dataLayer ??= []);
      dataLayer.push({
        event: 'souscription_indisponible',
        cta_position: cta.dataset.ctaPosition || 'unknown',
      });
      if (!dialog.open) dialog.showModal();
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      // Bouton de fermeture, ou clic sur l'arrière-plan (la cible est alors le <dialog> lui-même).
      if (target?.closest('[data-subscribe-soon-close]') || target === dialog) dialog.close();
    });
  }
</script>
