---
/**
 * En-tête de sous-page (/frais, /strategie, /a-propos, /documentation, /presse, /salle-de-presse) :
 * fond ink + halo de marque, sans image. Surtitre, H1 (text-display-lg), puis, dans une seule et même
 * taille (text-lead) : l'introduction, la phrase-clé en gras et la ligne risques (RiskNote size 'lead',
 * jamais animée). Le tout visible sans scroller à 375×812 comme à 1440×900. Le fil d'Ariane se place
 * dans le slot « breadcrumb » (au-dessus du surtitre).
 *
 * `intro`, `punchline` et `riskLine` sont TOUTES LES TROIS FACULTATIVES, et depuis le 14/09/2026 plus
 * aucune sous-page ne porte de ligne risques : l'équipe a demandé de retirer le « Bon à savoir : … »
 * de tous les en-têtes sauf celui de l'accueil (01-Hero.astro, qui a le sien). Voir types-v2.ts.
 *
 * SLOT « aside » (audit UX) : le texte est borné à 4xl pour rester lisible, ce qui laissait la moitié
 * droite de l'écran vide sur grand écran, un demi-écran de dégradé avant le premier contenu utile.
 * À partir de `lg`, la grille passe à 12 colonnes : le texte en occupe 7, l'aside 5, aligné en bas sur
 * la ligne risques. L'aside ne dit rien de neuf : il remonte une information déjà présente plus bas
 * dans la page (repère chiffré, sommaire, médias, contacts), jamais un texte inventé pour l'occasion.
 * Sous `lg`, il passe sous le texte, ou n'est simplement pas fourni par la page quand l'information
 * se trouve juste en dessous (cas de /documentation et /salle-de-presse, où la barre d'ancres et la
 * section contacts suivent immédiatement).
 * L'aside n'est jamais animé : sur /frais il porte des valeurs de frais, qui ne peuvent ni bouger ni
 * apparaître dans une taille différente les unes des autres.
 *
 * Rythme vertical calibré pour la navigation collée (bandeau blanc dans le flux, non superposé).
 * Sous `sm`, les marges hautes sont resserrées et l'introduction comme la ligne risques passent
 * ensemble à `text-base` : avec le bandeau cookies déplié au premier chargement, la ligne risques
 * passait dessous sur plusieurs sous-pages. LES TROIS PARAGRAPHES changent de taille ENSEMBLE, et
 * portent les mêmes classes : l'égalité entre un texte qui met en avant et son contre-poids est une
 * exigence AMF, et seule la graisse distingue la phrase-clé. Attention, AUCUN TEST ne mesure cette
 * égalité sur un en-tête de sous-page : les deux tests de tests/conformite.spec.ts qui la vérifient
 * ciblent `#apercu`, donc l'accueil seul. Ici, la garantie tient aux classes écrites côte à côte.
 * Contenu : props issues du fichier de contenu de la page (PageHero de types-v2.ts).
 */
import RiskNote from '@/components/ui/RiskNote.astro';
import Container from '@/components/ui/Container.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Facultative ; un tableau rend un paragraphe par entrée. */
  intro?: string | string[];
  /** Phrase-clé sous l'introduction, en gras, MÊME TAILLE que l'introduction et la ligne risques. */
  punchline?: string;
  /** Facultative depuis le 14/09/2026 : voir PageHero dans types-v2.ts. Une seule page s'en passe. */
  riskLine?: string;
  tone?: 'ink' | 'brand';
  /** Ancre de la section (par défaut « en-tete »). */
  id?: string;
  /**
   * `true` : l'aside n'est rendu qu'à partir de `lg`. À réserver aux pages dont l'information de
   * l'aside se trouve immédiatement sous l'en-tête sur petit écran (barre d'ancres de /documentation,
   * section contacts de /salle-de-presse) : l'y répéter ferait défiler deux fois la même chose.
   */
  asideOnLarge?: boolean;
  /**
   * En-tête encore plus court sur grand écran. Réservé aux pages qui ne sont qu'un sommaire, où le
   * contenu doit être sous les yeux tout de suite. C'est une PROP et non une classe passée de
   * l'extérieur : deux utilitaires de même propriété se départagent par leur ordre dans la feuille
   * compilée, pas par l'ordre de l'attribut, et le surclassement ne prenait pas.
   */
  compact?: boolean;
  class?: string;
}
const {
  eyebrow,
  title,
  intro,
  punchline,
  riskLine,
  tone = 'ink',
  id = 'en-tete',
  asideOnLarge = false,
  compact = false,
  class: className = '',
} = Astro.props;
const titleId = id + '-title';
/** Une chaîne ou plusieurs : le rendu ne connaît qu'un tableau, vide quand il n'y a pas d'intro. */
const intros = intro === undefined ? [] : Array.isArray(intro) ? intro : [intro];
const tones = { ink: 'bg-ink', brand: 'bg-brand-gradient-dark' };
const hasAside = Astro.slots.has('aside');
/*
 * `eyebrow` est REÇU MAIS JAMAIS RENDU : le fil d'Ariane, juste au-dessus, tient ce rôle depuis le 13/09/2026. La prop reste acceptée pour ne pas
 * casser les six pages qui la passent, et les valeurs `eyebrow` des fichiers de contenu ne s'affichent
 * donc nulle part (audit du 14/09/2026). À trancher : les rendre, ou retirer la prop et les valeurs.
 */
void eyebrow;
---

<section
  id={id}
  data-section={id}
  data-page-header="dark"
  aria-labelledby={titleId}
  class:list={[
    'brand-halo grain relative overflow-hidden text-white',
    tones[tone],
    /* La navigation flottante recouvre le haut de l'en-tête : sa hauteur est réservée ici.
       RESSERRÉ SUR GRAND ÉCRAN (13/09/2026, demande de l'équipe) : 5 rem au-dessus du titre et 6 en
       dessous poussaient l'en-tête à 700 px sur un écran de 900, et tout le contenu utile sous la ligne
       de flottaison. 2 rem et 3, soit une centaine de pixels rendus à la page. Le téléphone et la
       tablette ne changent pas, ils n'avaient pas ce défaut. */
    'pt-[calc(var(--spacing-nav-total)+0.75rem)] pb-10 sm:pt-[calc(var(--spacing-nav-total)+3.5rem)] sm:pb-20',
    compact
      ? 'lg:pt-[calc(var(--spacing-nav-total)+1rem)] lg:pb-8'
      : 'lg:pt-[calc(var(--spacing-nav-total)+2rem)] lg:pb-12',
    className,
  ]}
>
  <Container size="wide" class="relative">
    <slot name="breadcrumb" />
    <div
      class:list={[
        'mt-2 sm:mt-8 lg:mt-5',
        hasAside && 'lg:grid lg:grid-cols-12 lg:items-end lg:gap-12',
      ]}
    >
      {
        /* 64 rem à partir de « lg » (13/09/2026) : à 80 px, un H1 de deux lignes voyait sa première
          ligne se couper en deux et tenait sur trois lignes. Les titres courts ne changent pas de
          largeur pour autant, ils n'atteignaient déjà pas la borne. */
      }
      <div class:list={['max-w-4xl lg:max-w-5xl', hasAside && 'lg:col-span-7 lg:max-w-none']}>
        {
          /* Un saut de ligne dans le titre est respecté : la césure d'un H1 est une décision de mise en
            page, elle appartient au contenu et non au hasard de la largeur disponible. PLUS AUCUN titre
            n'en pose depuis le 14/09/2026 et la réécriture de l'en-tête de /frais ; le mécanisme reste,
            il ne coûte rien et c'est la seule façon de fixer une césure. Le texte reste
            entier pour le nom accessible, `<br>` ne fait qu'y marquer une pause. */
        }
        <h1 id={titleId} class="text-display-lg text-white">
          {
            title.split('\n').map((ligne, i, lignes) => (
              <Fragment>
                {i > 0 && <br />}
                {/* L'espace de fin de ligne est CONSERVÉ dans le texte : `<br>` n'en introduit aucun, et
                    tout ce qui lit le titre en texte brut, du contrôle de conformité aux moteurs, aurait
                    recollé « comprendreles ». Il ne se voit pas, il précède un saut de ligne. */}
                {i < lignes.length - 1 ? ligne + ' ' : ligne}
              </Fragment>
            ))
          }
        </h1>
        {
          intros.map((paragraphe, i) => (
            <p
              class:list={[
                'text-lead max-w-3xl text-pretty text-white max-sm:text-base max-sm:leading-snug',
                i === 0 ? 'mt-3 sm:mt-6' : 'mt-3 sm:mt-4',
              ]}
            >
              {paragraphe}
            </p>
          ))
        }
        {
          /* Phrase-clé : même taille que l'introduction et que la ligne risques qui suit, seule la
            graisse change. Une phrase qui insiste sur l'avantage ne doit pas s'afficher plus grande
            que son contre-poids, c'est précisément le reproche fait à la brochure. */
        }
        {
          punchline && (
            <p class="text-lead mt-3 max-w-3xl text-pretty font-semibold text-white max-sm:text-base max-sm:leading-snug sm:mt-5">
              {punchline}
            </p>
          )
        }
        {
          riskLine && (
            <RiskNote
              text={riskLine}
              tone="dark"
              size="lead"
              class="mt-2 max-w-3xl max-sm:text-base max-sm:leading-snug sm:mt-5"
            />
          )
        }
        {
          /* Appel à l'action de l'en-tête, APRÈS la ligne risques : on ne propose pas de souscrire
            avant d'avoir dit ce qu'on risque. */
        }
        <div class="empty:hidden mt-8 sm:mt-10">
          <slot name="cta" />
        </div>
      </div>
      {
        hasAside && (
          <div class:list={[asideOnLarge ? 'max-lg:hidden' : 'mt-10', 'lg:col-span-5 lg:mt-0']}>
            <slot name="aside" />
          </div>
        )
      }
    </div>
    <slot />
  </Container>
</section>
