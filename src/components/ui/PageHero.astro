---
/**
 * En-tête de sous-page (/frais, /strategie, /a-propos, /documentation, /presse, /faq) : fond ink +
 * halo de marque, sans image. Fil d'Ariane (slot « breadcrumb »), H1 (text-display-lg), puis, dans
 * une seule et même taille (text-lead), l'introduction et la phrase-clé en gras, toutes deux
 * facultatives ; seule la graisse les distingue, et sous `sm` elles passent ENSEMBLE à `text-base`
 * (avec le bandeau cookies déplié, le bas de l'en-tête passait dessous). Le tout visible sans
 * scroller à 375×812 comme à 1440×900. Plus de ligne risques (14/09/2026, l'équipe a demandé de
 * retirer tous les « Bon à savoir » du site ; archivée hors du dépôt, .claude/audits).
 * SLOT « aside » : à partir de `lg`, la grille passe à 12 colonnes, 7 pour le texte et 5 pour
 * l'aside, aligné en bas, faute de quoi la moitié droite restait vide. L'aside ne dit rien de neuf,
 * il remonte une information déjà présente plus bas dans la page ; sous `lg`, il passe sous le
 * texte ou n'est pas rendu (`asideOnLarge`) quand l'information se trouve juste en dessous. Seule
 * /documentation en fournit un, son sommaire. Jamais animé : il a porté des valeurs de frais, qui
 * ne peuvent ni bouger ni apparaître dans des tailles différentes. Contenu : props issues du
 * fichier de contenu de la page (PageHero de types-v2.ts).
 */
import Container from '@/components/ui/Container.astro';

interface Props {
  title: string;
  /** Facultative ; un tableau rend un paragraphe par entrée. */
  intro?: string | string[];
  /** Phrase-clé sous l'introduction, en gras, MÊME TAILLE que l'introduction. */
  punchline?: string;
  /**
   * `true` : l'aside n'est rendu qu'à partir de `lg`, quand son information se trouve immédiatement
   * sous l'en-tête sur petit écran (barre d'ancres de /documentation) : l'y répéter ferait défiler
   * deux fois la même chose.
   */
  asideOnLarge?: boolean;
}
const { title, intro, punchline, asideOnLarge = false } = Astro.props;
/** Ancre de l'en-tête, la même sur toutes les pages (les tests la visent). */
const id = 'en-tete';
const titleId = id + '-title';
/** Une chaîne ou plusieurs : le rendu ne connaît qu'un tableau, vide quand il n'y a pas d'intro. */
const intros = intro === undefined ? [] : Array.isArray(intro) ? intro : [intro];
const hasAside = Astro.slots.has('aside');
/* Plus de surtitre (13/09/2026) : le fil d'Ariane tient ce rôle. */
---

<section
  id={id}
  data-section={id}
  aria-labelledby={titleId}
  class:list={[
    'brand-halo grain relative overflow-hidden text-white',
    'bg-ink',
    /* La navigation flottante recouvre le haut de l'en-tête : sa hauteur est réservée ici. Resserré
       sur grand écran (13/09/2026, demande de l'équipe) : 5 rem au-dessus du titre et 6 en dessous
       poussaient l'en-tête à 700 px sur un écran de 900 ; 2 rem et 3 rendent une centaine de pixels
       à la page. */
    'pt-[calc(var(--spacing-nav-total)+0.75rem)] pb-10 sm:pt-[calc(var(--spacing-nav-total)+3.5rem)] sm:pb-20',
    'lg:pt-[calc(var(--spacing-nav-total)+2rem)] lg:pb-12',
  ]}
>
  <Container size="wide" class="relative">
    <slot name="breadcrumb" />
    <div
      class:list={[
        'mt-2 sm:mt-8 lg:mt-5',
        hasAside && 'lg:grid lg:grid-cols-12 lg:items-end lg:gap-12',
      ]}
    >
      {
        /* 64 rem à partir de « lg » (13/09/2026) : à 80 px, un H1 de deux lignes voyait sa première
          ligne se couper en deux et tenait sur trois lignes. Les titres courts ne changent pas de
          largeur pour autant, ils n'atteignaient déjà pas la borne. */
      }
      <div class:list={['max-w-4xl lg:max-w-5xl', hasAside && 'lg:col-span-7 lg:max-w-none']}>
        {
          /* Un saut de ligne dans le titre est respecté : la césure d'un H1 est une décision de
             mise en page, elle appartient au contenu. Aucun titre n'en pose aujourd'hui ; le
             mécanisme reste, c'est la seule façon de fixer une césure. Le texte reste entier pour
             le nom accessible, `<br>` n'y marque qu'une pause. */
        }
        <h1 id={titleId} class="text-display-lg text-white">
          {
            title.split('\n').map((ligne, i, lignes) => (
              <Fragment>
                {i > 0 && <br />}
                {/* L'espace de fin de ligne est CONSERVÉ dans le texte : `<br>` n'en introduit aucun, et
                    tout ce qui lit le titre en texte brut, du contrôle de conformité aux moteurs, aurait
                    recollé « comprendreles ». Il ne se voit pas, il précède un saut de ligne. */}
                {i < lignes.length - 1 ? ligne + ' ' : ligne}
              </Fragment>
            ))
          }
        </h1>
        {
          intros.map((paragraphe, i) => (
            <p
              class:list={[
                'text-lead max-w-3xl text-pretty text-white max-sm:text-base max-sm:leading-snug',
                i === 0 ? 'mt-3 sm:mt-6' : 'mt-3 sm:mt-4',
              ]}
            >
              {paragraphe}
            </p>
          ))
        }
        {
          /* Phrase-clé : même taille que l'introduction, seule la graisse change. Une phrase qui
            insiste sur l'avantage ne doit pas s'afficher plus grande que le reste, c'est précisément
            le reproche fait à la brochure. */
        }
        {
          punchline && (
            <p class="text-lead mt-3 max-w-3xl text-pretty font-semibold text-white max-sm:text-base max-sm:leading-snug sm:mt-5">
              {punchline}
            </p>
          )
        }
        <div class="empty:hidden mt-8 sm:mt-10">
          <slot name="cta" />
        </div>
      </div>
      {
        hasAside && (
          <div class:list={[asideOnLarge ? 'max-lg:hidden' : 'mt-10', 'lg:col-span-5 lg:mt-0']}>
            <slot name="aside" />
          </div>
        )
      }
    </div>
    <slot />
  </Container>
</section>
