---
/**
 * TrustBox Trustpilot, widget OFFICIEL (code d'intégration remis par l'équipe le 11/09/2026). Le
 * contenu (logo, note, étoiles, avis) est rendu par Trustpilot dans une iframe : ni composé ni
 * sélectionné par CORUM, il n'entre pas dans le périmètre du contrôle des formulations du site
 * (scripts/check-compliance.mjs ne voit que le lien de repli).
 * CE QU'IL FAUT SAVOIR CÔTÉ CONFORMITÉ. CARROUSEL FILTRÉ depuis le 15/09/2026 : `data-stars` vaut
 * « 4,5 », le widget ne présente que les avis favorables. C'est un réglage de l'équipe, et ce n'est
 * plus un flux non trié. L'obligation d'information sur les avis en ligne (art. L111-7-2 du code de
 * la consommation) devait reposer sur un texte de portée et une note de source disant que le
 * carrousel est filtré et renvoyant au profil Trustpilot ; NI L'UN NI L'AUTRE N'A ÉTÉ AFFICHÉ, et
 * tous deux ont quitté le code le 22/09/2026 (archivés hors du dépôt, .claude/audits). La seule
 * trace à l'écran du filtre est la mention que Trustpilot écrit lui-même au bas du carrousel (« Nos
 * avis 4 et 5 étoiles ») : un réglage qui la masquait (`PUBLIC_TRUSTBOX_CROP`) a été retiré le
 * 22/09/2026 et ne doit pas revenir. Voir facts.ts, `trustpilot.widgets`.
 * Le script d'amorçage est chargé UNE SEULE FOIS par page, dans le <head>
 * (components/TrustpilotScript.astro, slot « head » de Base.astro) ; sans lui, le <div> reste tel
 * quel, d'où le lien de repli vers le profil public. Identifiants : src/content/fr/facts.ts
 * (`trust.trustpilot.widgets`), propres au compte Trustpilot de CORUM, jamais inventés.
 */
import { trust as trustFacts } from '@/content/fr/facts';

type TemplateKey = keyof typeof trustFacts.trustpilot.widgets.templates;

interface Props {
  /** Gabarit Trustpilot à afficher : « horizontal » (bandeau note + étoiles) ou « carousel » (avis). */
  template: TemplateKey;
  /** « dark » sur fond sombre (Trustpilot y compose son texte en clair). */
  theme?: 'light' | 'dark';
  /** Nom accessible de la zone, faute de quoi l'iframe arrive sans contexte dans la page. */
  label: string;
  class?: string;
}
const { template, theme, label, class: className = '' } = Astro.props as Props;
const tp = trustFacts.trustpilot;
const widget = tp.widgets.templates[template];
---

{
  /* Attributs repris à l'identique du code d'intégration Trustpilot : les renommer casse le widget. */
}
{
  /* L'enveloppe ne porte PAS la classe `trustpilot-widget` : le script d'amorçage initialise tout élément
    qui la porte, et un conteneur sans identifiants le fait échouer (erreur remontée à Trustpilot). */
}
{
  /* `min-height` : LA PLACE DE L'IFRAME EST RÉSERVÉE (audit du 18/09/2026). Avant l'amorçage du script
    tiers, l'enveloppe ne contenait que le lien de repli, une ligne de 24 px ; l'iframe arrivait ensuite
    à `data-style-height`, 140 px pour le carrousel de /a-propos, et poussait tout ce qui suit. */
}
<div class={className} role="group" aria-label={label} style={`min-height:${widget.height}`}>
  <div
    class="trustpilot-widget"
    data-locale={tp.widgets.locale}
    data-template-id={widget.templateId}
    data-businessunit-id={tp.widgets.businessUnitId}
    data-style-height={widget.height}
    data-style-width="100%"
    data-token={widget.token}
    data-theme={theme}
    data-stars={widget.stars}
    data-review-languages={widget.reviewLanguages}
  >
    <a href={tp.url} target="_blank" rel="noopener noreferrer">Trustpilot</a>
  </div>
</div>
