---
import { riskLabel, riskPrefix } from '@/content/fr/legal';
import NoteRef from '@/components/ui/NoteRef.astro';

/**
 * Contre-poids risque d'un avantage. Même corps de texte et même couleur d'encre que le texte
 * qu'il accompagne (règle AMF : avantages et risques dans une taille et une forme identiques).
 * Ne jamais l'animer, ne jamais le réduire en note de bas de page.
 * Depuis le 11/09/2026, plus de pictogramme d'alerte : un libellé visible « Bon à savoir : » (legal.ts,
 * riskLabel) en gras et en couleur d'accent ouvre le texte ; le préfixe « Risque : » reste lu par les
 * lecteurs d'écran (riskPrefix) pour que l'avertissement conserve sa nature.
 * `size` : 'base' (corps de texte) ou 'lead' (même taille que le texte courant qu'il accompagne).
 * `noteId` optionnel : appel de note accolé au texte.
 */
interface Props {
  text: string;
  class?: string;
  tone?: 'light' | 'dark';
  size?: 'base' | 'lead';
  noteId?: string;
}
const { text, class: className = '', tone = 'light', size = 'base', noteId } = Astro.props;
---

<p
  data-risk
  class:list={[
    size === 'lead' ? 'text-lead' : 'text-base leading-relaxed',
    tone === 'dark' ? 'text-white' : 'text-ink',
    className,
  ]}
>
  <strong class:list={['font-semibold', tone === 'dark' ? 'text-sand' : 'text-coral-700']}
    >{riskLabel}</strong
  >
  <span class="visually-hidden">{riskPrefix}</span>
  {text}{noteId && <NoteRef id={noteId} tone={tone === 'dark' ? 'dark' : 'light'} />}
</p>
