---
/**
 * Contre-poids risque d'un avantage. NE REND PLUS RIEN depuis le 14/09/2026.
 *
 * DÉCISION DE L'ÉQUIPE, mot pour mot : « supprime tous les bon à savoir du site. Le service conformité
 * va les placer manuellement plus tard. » Les soixante et un « Bon à savoir : … » du site disparaissent
 * donc d'un coup, de l'accueil aux fiches de documents.
 *
 * CE QUE CELA VEUT DIRE, ET QUI DOIT ÊTRE SU. Le site ne porte plus AUCUN contre-poids de risque à côté
 * des avantages qu'il présente. Ce qui subsiste : les mentions du pied de page (caractère commercial,
 * visa AMF, renvoi au DIC et à la note d'information), présentes sur toutes les pages, et les textes
 * réglementaires qui ne passent pas par ce composant (avertissement commission d'arbitrage de /frais,
 * encadré « Une innovation, pas une révolution », mentions légales). L'égalité de traitement entre
 * avantages et risques exigée par l'AMF ne peut plus être vérifiée par le site : elle repose entièrement
 * sur ce que la Conformité replacera.
 *
 * RIEN N'EST PERDU. Les textes restent intégralement dans les fichiers de contenu (src/content/fr/*.ts),
 * et les appels <RiskNote text={…} /> restent en place : onze appels dans dix fichiers au
 * 22/09/2026 (RiskPair compris, qui le relaie pour les options de Souscrire). C'est la carte de ce
 * que la Conformité a à replacer, et l'endroit où chaque mention se trouvait ; certains de ces
 * appels sont eux-mêmes dans des blocs qui ne sont plus rendus (mode complet de 06-Subscribe,
 * EN VEILLE).
 *
 * POUR TOUT RÉTABLIR : décommenter le bloc ci-dessous et supprimer le `return`. Un seul fichier.
 * Les garde-fous correspondants ont été neutralisés au même moment, chacun avec un commentaire qui
 * renvoie ici : tests/conformite.spec.ts (trois tests), tests/qualite.spec.ts (fenêtre d'attente) et
 * scripts/check-compliance.mjs (ligne risques de l'accueil).
 */
import { riskLabel, riskPrefix } from '@/content/fr/legal';
import NoteRef from '@/components/ui/NoteRef.astro';

interface Props {
  text: string;
  class?: string;
  tone?: 'light' | 'dark';
  size?: 'base' | 'lead';
  noteId?: string;
}
/* Les props sont volontairement lues : elles documentent le contrat du composant, et le typage
   continue de vérifier les appels des pages, qui n'ont pas bougé. */
const { text, class: className = '', tone = 'light', size = 'base', noteId } = Astro.props;
void [text, className, tone, size, noteId, riskLabel, riskPrefix, NoteRef];
---

{
  /*
  Le rendu d'origine, conservé tel quel pour le jour où la Conformité rend son arbitrage :

  <p data-risk class:list={[size === 'lead' ? 'text-lead' : 'text-base leading-relaxed',
      tone === 'dark' ? 'text-white' : 'text-ink', className]}>
    <strong class:list={['font-semibold', tone === 'dark' ? 'text-sand' : 'text-coral-700']}>
      {riskLabel}</strong>
    <span class="visually-hidden">{riskPrefix}</span>
    {text}{noteId && <NoteRef id={noteId} tone={tone === 'dark' ? 'dark' : 'light'} />}
  </p>
*/
}
