---
/**
 * En-tête de section façon page produit : H2 très grand, introduction en texte lead. Trois
 * appelants : 06-Subscribe, 07-Trust et 08-Risks. `motion` (défaut false) : signature d'entrée
 * commune des chapitres de l'accueil (src/scripts/motion.ts), H2 mot à mot (data-reveal-text, ≤ 12
 * mots) et introduction en fade-up ; laisser à false quand l'en-tête ne doit pas bouger
 * (08-Risques, contre-poids global de la page). Le surtitre et l'alignement centré, sans appelant,
 * ont été retirés le 22/09/2026.
 */
interface Props {
  id: string;
  title: string;
  intro?: string;
  class?: string;
  motion?: boolean;
}
const { id, title, intro, class: className = '', motion = false } = Astro.props;
/** Délai de l'introduction après le titre (s) : même valeur que dans les en-têtes rendus à la main. */
const INTRO_DELAY = '0.1';
---

{
  /* Plus de cap de largeur sur l'en-tête depuis le 11/09/2026 : bridé à 56 rem, un titre comme
    « Pourquoi gagnant-gagnant ? » se coupait en deux alors qu'il tient sur une ligne dans le conteneur.
    L'introduction, elle, garde sa mesure : une ligne de texte courant sur 1 150 px ne se lit pas. */
}
<header class={className}>
  <h2
    id={id + '-title'}
    class="text-display-lg text-balance"
    data-reveal-text={motion ? '' : undefined}
  >
    {title}
  </h2>
  {
    intro && (
      <p
        class="mt-6 max-w-3xl text-lead opacity-90"
        data-animate={motion ? 'fade-up' : undefined}
        data-animate-delay={motion ? INTRO_DELAY : undefined}
      >
        {intro}
      </p>
    )
  }
</header>
