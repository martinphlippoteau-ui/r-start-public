---
/**
 * En-tête de section façon page produit : surtitre court (utilitaire text-eyebrow), H2 très grand,
 * introduction en texte lead.
 * `motion` (défaut false) : signature d'entrée commune des chapitres de l'accueil (src/scripts/motion.ts) —
 * H2 mot à mot (data-reveal-text, ≤ 12 mots) et introduction en fade-up ; le surtitre reste statique.
 * Laisser à false quand l'en-tête ne doit pas bouger (ex. 08-Risques, contre-poids global de la page).
 */
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  class?: string;
  motion?: boolean;
}
const {
  id,
  eyebrow,
  title,
  intro,
  align = 'left',
  class: className = '',
  motion = false,
} = Astro.props;
/** Délai de l'introduction après le titre (s) : même valeur que dans les en-têtes rendus à la main. */
const INTRO_DELAY = '0.1';
---

<header class:list={['max-w-4xl', align === 'center' && 'mx-auto text-center', className]}>
  {
    eyebrow && (
      <p class="text-eyebrow mb-4 text-teal-700 in-[.text-white]:text-teal-200">{eyebrow}</p>
    )
  }
  <h2 id={id + '-title'} class="text-display-lg" data-reveal-text={motion ? '' : undefined}>
    {title}
  </h2>
  {
    intro && (
      <p
        class="mt-6 text-lead opacity-90"
        data-animate={motion ? 'fade-up' : undefined}
        data-animate-delay={motion ? INTRO_DELAY : undefined}
      >
        {intro}
      </p>
    )
  }
</header>
