---
/**
 * Bandeau « Points essentiels à connaître » (22/09/2026, demande de Martin : « un bandeau simple »,
 * puis « tous les blocs sur le même modèle, pleine largeur », « tout le contenu en sable ») : bande
 * sombre compacte sur toute la largeur, titre en capitales espacées et GRASSES (14 px, graisse 700 :
 * « pour montrer que c'est un titre » ; la graisse 600 de text-eyebrow ne se voyait pas) et contenu
 * dans le slot, le tout en sable comme le bloc Risques (11,54:1 sur le fond ink). Interligne resserré
 * (leading-snug) et marges verticales propres, plus courtes que celles d'une section compacte
 * (22/09/2026, « réduire l'espace que prennent les blocs risques et disclaimers », sans toucher à
 * la police) : la bande fait ce que fait son texte, pas plus.
 * Deux emplois : la mention de CORUM L'Épargne sur l'accueil (01c-Essentiels.astro) et
 * l'avertissement sur la commission d'arbitrage sous le comparateur de frais (FeeComparator.astro).
 * Jamais animé : c'est une mention de risque, elle se lit en place.
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';

interface Props {
  /** Ancre de la bande ; son H2 porte `${id}-title`. */
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<Section id={id} tone="ink" spacing="none" class="py-8 sm:py-10">
  <Container size="wide">
    <h2 id={id + '-title'} class="text-sm font-bold tracking-[0.16em] text-sand uppercase">{title}</h2>
    <div class="mt-3 max-w-4xl text-base leading-snug text-sand sm:text-lg">
      <slot />
    </div>
  </Container>
</Section>
