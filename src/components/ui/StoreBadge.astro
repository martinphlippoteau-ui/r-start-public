---
/**
 * Badge de magasin d'applications (App Store, Google Play), dessiné en SVG inline : cartouche noir à
 * coins arrondis, liseré clair, logo de la plateforme et libellé sur deux lignes, aux proportions des
 * badges officiels (ratio 10:3, hauteur de référence 40 px).
 *
 * ATTENTION MARQUES : Apple et Google imposent l'emploi de LEURS fichiers officiels et de leurs chartes
 * (« Télécharger dans l'App Store », « Disponible sur Google Play », zones de protection, tailles
 * minimales). Ce composant est une reproduction fidèle destinée à la maquette : avant mise en ligne,
 * remplacer les deux dessins par les badges officiels téléchargés sur les ressources marketing d'Apple
 * et de Google, en conservant l'enveloppe <a> et ses attributs d'accessibilité.
 *
 * Accessibilité : le SVG est décoratif (aria-hidden), le nom du lien vient du texte masqué `label`, et
 * `hintId` permet d'y accoler la mention « nouvelle fenêtre » commune au bloc.
 */
interface Props {
  store: 'apple' | 'google';
  href: string;
  /** Nom accessible complet du lien (ex. « Télécharger MyCORUM dans l'App Store »). */
  label: string;
  /** Id d'un texte masqué décrivant l'ouverture dans un nouvel onglet. */
  hintId?: string;
  class?: string;
}
const { store, href, label, hintId, class: className = '' } = Astro.props as Props;

const copy = {
  apple: { top: 'Télécharger dans l’', bottom: 'App Store' },
  google: { top: 'Disponible sur', bottom: 'Google Play' },
}[store];

/**
 * Largeur du cartouche, par magasin (11/09/2026) : « Google Play » court jusqu'à 132,8 unités et frôlait
 * le bord d'un cartouche de 135, ce qui se lisait comme un logo coupé. Chaque badge prend donc la largeur
 * de son texte plus la même retombée de 11 unités qu'à gauche — c'est aussi le cas des badges officiels,
 * où celui de Google est plus large que celui d'Apple.
 */
const width = store === 'apple' ? 135 : 146;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-describedby={hintId}
  class:list={[
    'inline-flex rounded-xl outline-offset-4 transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-3 focus-visible:outline-navy',
    className,
  ]}
>
  <span class="visually-hidden">{label}</span>
  <svg viewBox={`0 0 ${width} 40`} role="presentation" aria-hidden="true" class="h-10 w-auto">
    <rect x=".5" y=".5" width={width - 1} height="39" rx="7" fill="#000"></rect>
    <rect
      x=".5"
      y=".5"
      width={width - 1}
      height="39"
      rx="7"
      fill="none"
      stroke="#fff"
      stroke-opacity=".35"></rect>

    {
      store === 'apple' ? (
        /* Pomme : silhouette pleine, feuille détachée. */
        <g fill="#fff" transform="translate(11 8.5)">
          <path d="M13.6 12.2c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.8-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .8 1.1 1.7 2.3 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-1.1 2.8-2.2c.9-1.2 1.2-2.4 1.3-2.5-.1 0-2.5-1-2.5-3.7z" />
          <path d="M11.3 5.5c.6-.8 1-1.8.9-2.9-.9 0-2 .6-2.6 1.4-.6.7-1.1 1.8-.9 2.8 1 .1 2-.5 2.6-1.3z" />
        </g>
      ) : (
        /* Google Play : triangle en quatre facettes, aux couleurs de la marque. */
        <g transform="translate(11 8)">
          <path
            d="M.7.6C.3 1 0 1.6 0 2.4v19.2c0 .8.3 1.4.7 1.8l.1.1L11.5 12.7v-.3L.8.5z"
            fill="#00a0ff"
          />
          <path
            d="M15 16.3l-3.5-3.6v-.3L15 8.9l.1.1 4.2 2.4c1.2.7 1.2 1.8 0 2.5l-4.3 2.4z"
            fill="#ffbc00"
          />
          <path d="M15.1 16.2L11.5 12.5.7 23.4c.4.4 1.1.5 1.8.1l12.6-7.3" fill="#ff3a44" />
          <path d="M15.1 8.8L2.5.5C1.8.1 1.1.2.7.6l10.8 10.9z" fill="#00d06c" />
        </g>
      )
    }

    <text x="43" y="16" fill="#fff" font-family="system-ui, sans-serif" font-size="8.5">
      {copy.top}
    </text>
    <text
      x="43"
      y="30"
      fill="#fff"
      font-family="system-ui, sans-serif"
      font-size="16"
      font-weight="600"
    >
      {copy.bottom}
    </text>
  </svg>
</a>
