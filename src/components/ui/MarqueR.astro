---
/**
 * La marque R Start seule, sans le mot « start » (16/09/2026).
 *
 * Le tracé est celui de src/assets/logos/r-start-blanc.svg, sa PREMIÈRE forme : une goutte dont le R
 * est évidé, d'un seul tenant. Les deux autres formes du fichier dessinent le mot, qui n'a rien à
 * faire aux tailles où cette marque sert.
 * Le viewBox est la boîte exacte du tracé, mesurée (94,08 × 88,98) et non devinée : la marque se cale
 * donc sans marge parasite ni déformation.
 *
 * `currentColor` : l'appelant décide de la teinte, comme pour les pictos.
 * Décorative par défaut. Un appelant qui en ferait un vrai logo doit lui donner un rôle et un nom.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props as Props;
