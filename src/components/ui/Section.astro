---
/**
 * Enveloppe standard d'une section de la page : ancre, data-section (analytics), rythme vertical.
 * tone : 'paper' (clair), 'white', 'ink' (sombre) ; spacing : 'default' (py-section), 'compact'
 * (py-section-sm), 'none' (la section gère ses marges). Les attributs `data-*` sont transmis à la
 * balise <section> (vocabulaire motion : data-in-view, data-curtain…).
 * PREMIER PLAN (24/09/2026, demande de Martin : « les sections à fond bleu comme sous les
 * autres », essayé sur /strategie puis étendu partout) : `plan="haut"` pose une section CLAIRE
 * par-dessus le bloc sombre qui la PRÉCÈDE, coins arrondis en haut et ombre (`.plan-haut`,
 * global.css) ; `sous="bas"` se pose sur le bloc SOMBRE ainsi recouvert, pour que son contenu
 * reste hors de la zone recouverte (`.sous-bas`). Un seul sens : le haut d'un bloc sombre est un
 * bord droit (Martin : « le radius que sur la partie basse des sections bleues »).
 */
interface Props {
  id: string;
  tone?: 'paper' | 'white' | 'ink';
  spacing?: 'default' | 'compact' | 'none';
  plan?: 'haut';
  sous?: 'bas';
  class?: string;
  labelledBy?: string;
  [key: `data-${string}`]: string | undefined;
}
const {
  id,
  tone = 'paper',
  spacing = 'default',
  plan,
  sous,
  class: className = '',
  labelledBy,
  ...rest
} = Astro.props;
const tones = {
  paper: 'bg-paper text-ink',
  white: 'bg-white text-ink',
  ink: 'bg-ink text-white',
};
const spacings = { default: 'py-section', compact: 'py-section-sm', none: '' };
---

<section
  id={id}
  data-section={id}
  aria-labelledby={labelledBy ?? id + '-title'}
  class:list={[
    'relative',
    spacings[spacing],
    tones[tone],
    plan && 'plan-haut',
    sous && 'sous-bas',
    className,
  ]}
  {...rest}
>
  <slot />
</section>
