---
/**
 * Grand chiffre façon page produit, statique : `value` est affichée telle quelle, unité comprise.
 * Le compteur animé, en sommeil depuis le 14/09/2026 (aucun appelant ne passait `numeric`), a été
 * retiré le 22/09/2026 avec ses props (`numeric`, `prefix`, `suffix`, `decimals`, `from`, `duration`),
 * ainsi que la taille `display`, qu'aucun appelant ne demandait.
 */
interface Props {
  value: string;
  /**
   * `solid` : encre pleine, chiffres à chasse fixe, pour une grille de chiffres que l'on
   * compare du regard (11/09/2026 : à 86 px et en dégradé, la grille CORUM était illisible).
   * `solid-compact` : même encre, un cran plus bas, pour une grille SERRÉE. Introduit le 14/09/2026,
   * quand le groupe CORUM est passé à cinq chiffres : à cinq colonnes, « 9,6 Md€ » et « + 160 000 »
   * passaient à la ligne en `solid` et les cinq libellés ne s'alignaient plus.
   */
  size: 'solid' | 'solid-compact';
  label: string;
  class?: string;
}
const { value, size, label, class: className = '' } = Astro.props;
---

{
  /*
   * HIÉRARCHIE RÉTABLIE LE 16/09/2026. Le chiffre était en `text-display-sm` (20 à 24 px) et son
   * libellé en `text-lead` (18 à 24 px) : sur grand écran ils faisaient la MÊME TAILLE, et rien ne
   * disait lequel des deux était le chiffre. Un bloc de chiffres clés dont les chiffres ne dominent
   * pas manque sa raison d'être.
   * Le chiffre monte donc d'un cran et le libellé descend, dans les deux tailles pleines. L'écart
   * passe de 1 à 1,5 environ, ce qui suffit à ce que l'œil attrape le nombre d'abord.
   */
}
<div class:list={['flex flex-col gap-1.5', className]}>
  <span
    class:list={[
      size === 'solid' && 'text-display-lg tabular-nums text-navy',
      size === 'solid-compact' && 'text-display-md tabular-nums text-navy',
    ]}
  >
    {value}
  </span>
  <span class="text-base leading-snug text-slate-700">
    {label}
  </span>
</div>
