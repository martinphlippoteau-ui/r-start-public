---
/**
 * Grand chiffre façon page produit, statique : `value` est affichée telle quelle, unité comprise.
 * Le compteur animé et la taille `display`, sans appelant, ont été retirés le 22/09/2026.
 */
interface Props {
  value: string;
  /**
   * `solid` : encre pleine, chiffres à chasse fixe, pour une grille de chiffres que l'on compare du
   * regard (à 86 px et en dégradé, la grille CORUM était illisible). `solid-compact` : même encre,
   * un cran plus bas, pour une grille SERRÉE : à cinq colonnes, « 9,6 Md€ » et « + 160 000 »
   * passaient à la ligne en `solid`.
   */
  size: 'solid' | 'solid-compact';
  label: string;
  class?: string;
}
const { value, size, label, class: className = '' } = Astro.props;
---

{
  /* Hiérarchie rétablie le 16/09/2026 : le chiffre en `text-display-sm` et son libellé en
    `text-lead` faisaient la MÊME TAILLE sur grand écran, rien ne disait lequel était le chiffre.
    Le chiffre monte d'un cran et le libellé descend ; l'écart passe de 1 à 1,5 environ, assez pour
    que l'œil attrape le nombre d'abord. */
}
<div class:list={['flex flex-col gap-1.5', className]}>
  <span
    class:list={[
      size === 'solid' && 'text-display-lg tabular-nums text-navy',
      size === 'solid-compact' && 'text-display-md tabular-nums text-navy',
    ]}
  >
    {value}
  </span>
  <span class="text-base leading-snug text-slate-700">
    {label}
  </span>
</div>
