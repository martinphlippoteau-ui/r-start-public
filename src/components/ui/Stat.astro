---
/**
 * Grand chiffre façon page produit, avec compteur animé optionnel (valeur finale toujours dans le
 * HTML ; `numeric` déclenche `data-counter` : ease power3, format fr-FR, préfixe/suffixe/décimales,
 * départ à 85 % du viewport, une seule fois, voir src/scripts/motion.ts). Le moteur réserve la
 * largeur finale du chiffre pendant le comptage (aucun décalage autour).
 * `from` : valeur de départ du compteur (défaut 0) ; `duration` : secondes (défaut 1,6).
 */
interface Props {
  value: string;
  /**
   * `display` : très grand chiffre en dégradé de marque (scène d'ouverture).
   * `solid` : plus petit, encre pleine, chiffres à chasse fixe, pour une grille de chiffres que l'on
   * compare du regard (11/09/2026 : à 86 px et en dégradé, la grille CORUM était illisible).
   * `solid-compact` : même encre, un cran plus bas, pour une grille SERRÉE. Introduit le 14/09/2026,
   * quand le groupe CORUM est passé à cinq chiffres : à cinq colonnes, « 9,6 Md€ » et « + 160 000 »
   * passaient à la ligne en `solid` et les cinq libellés ne s'alignaient plus.
   */
  size?: 'display' | 'solid' | 'solid-compact';
  label: string;
  numeric?: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  from?: number;
  duration?: number;
  class?: string;
}
const {
  value,
  size = 'display',
  label,
  numeric,
  prefix,
  suffix,
  decimals,
  from,
  duration,
  class: className = '',
} = Astro.props;
---

{
  /*
   * HIÉRARCHIE RÉTABLIE LE 16/09/2026. Le chiffre était en `text-display-sm` (20 à 24 px) et son
   * libellé en `text-lead` (18 à 24 px) : sur grand écran ils faisaient la MÊME TAILLE, et rien ne
   * disait lequel des deux était le chiffre. Un bloc de chiffres clés dont les chiffres ne dominent
   * pas manque sa raison d'être.
   * Le chiffre monte donc d'un cran et le libellé descend, dans les deux tailles pleines. L'écart
   * passe de 1 à 1,5 environ, ce qui suffit à ce que l'œil attrape le nombre d'abord.
   */
}
<div class:list={['flex flex-col gap-1.5', className]}>
  <span
    class:list={[
      size === 'display' && 'text-stat text-brand-gradient',
      size === 'solid' && 'text-display-lg tabular-nums text-navy',
      size === 'solid-compact' && 'text-display-md tabular-nums text-navy',
    ]}
    data-counter={numeric}
    data-counter-prefix={prefix}
    data-counter-suffix={suffix}
    data-counter-decimals={decimals}
    data-counter-from={from}
    data-counter-duration={duration}
  >
    {value}
  </span>
  <span class:list={[size === 'display' ? 'text-lead font-medium' : 'text-base leading-snug text-slate-700']}>
    {label}
  </span>
</div>
