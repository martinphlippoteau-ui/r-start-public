---
/**
 * Pictogrammes R Start. Trois appelants : la mention AMF du hero (01-Hero, `institution`), les puces
 * de la stratégie (04-Strategy, champ `icon` de strategy.ts) et la fenêtre d'accès du simulateur.
 *
 * Pictogrammes R Start : dessins au TRAIT PLAT, vus de face, sans support ni volume (la tuile de verre et
 * l'isométrie ont été abandonnées le 11/09/2026 : illisibles à petite taille, et le support jurait avec le
 * trait). Grille 24 × 24, trait de 1,5 pour la forme et 1,25 à 55 % d'opacité pour les détails (fenêtres,
 * lignes, jours) : ce second niveau évite l'effet « gros trait » d'une épaisseur unique. `currentColor` :
 * la couleur vient de la classe reçue, contraste tenu sur fond clair comme sur fond sombre.
 * Formes volontairement archi-connues (fronton, billet, calendrier, immeubles, globe, loupe) : un
 * pictogramme se reconnaît, il ne s'interprète pas.
 * Clés : institution (fronton à colonnes), argent, calendrier, equipe (deux immeubles et flèche
 * montante), exploration (globe et repère), analyse (immeuble et loupe). `alerte` et
 * `document-valide`, jamais employés, ont été retirés le 22/09/2026.
 * Accessibilité : toujours décoratif (aria-hidden), le texte voisin porte le sens.
 * Aucun attribut motion ici : l'animation se pose sur l'enveloppe.
 */
export const PICTO_KEYS = [
  'institution',
  'argent',
  'calendrier',
  'equipe',
  'exploration',
  'analyse',
] as const;
export type PictoKey = (typeof PICTO_KEYS)[number];

interface Props {
  name: PictoKey;
  /**
   * Taille ET couleur : classes Tailwind (`size-14 text-teal-700`).
   * NE PAS Y METTRE `shrink-0` : le composant le pose déjà lui-même, et html-validate refuse une
   * classe répétée dans un même attribut (no-dup-class). L'oubli a fait échouer la validation deux
   * fois, le 15 et le 16/09/2026.
   */
  class?: string;
}
const { name, class: className } = Astro.props as Props;

/**
 * Dessins sur une grille 24 × 24, en DEUX niveaux : `trait` porte la forme principale, `detail` les
 * éléments secondaires (fenêtres, lignes de texte, jours) rendus plus fins et à 55 % d'opacité. C'est ce
 * second niveau qui évite l'effet « gros trait » d'un pictogramme tout en épaisseur unique.
 */
const glyphs: Record<PictoKey, { trait: string; detail?: string }> = {
  /*
   * Fronton à colonnes : le bâtiment d'une autorité. AJOUTÉ LE 16/09/2026 pour la mention AMF du hero,
   * choisi par l'équipe parmi six candidats présentés sur /test.
   *
   * IL Y AVAIT UNE RÉSERVE, elle était affichée à côté du picto au moment du choix et elle est
   * consignée ici pour la Conformité : ce dessin REPRÉSENTE L'INSTITUTION, donc l'AMF. Posé près d'une
   * note Trustpilot, il peut se lire comme une caution de l'autorité, ce que la mention standard du
   * pied de page dit explicitement ne pas être le cas, et c'est la raison pour laquelle le logo de
   * l'AMF a été retiré la veille. L'équipe a tranché en connaissance de cause.
   * Le libellé, lui, n'a jamais bougé : « société de gestion agréée », jamais « R Start agréé ».
   *
   * Le toit est tracé en deux segments ouverts plutôt qu'en triangle fermé : à 24 px, un tympan plein
   * se referme en tache. Les quatre colonnes sont le second niveau, plus fines et atténuées.
   */
  institution: {
    trait: [
      '<path d="M3.6 9.4 12 4.2l8.4 5.2"/>',
      '<path d="M3.4 20.4h17.2"/>',
      '<path d="M5.2 9.9v9.2M18.8 9.9v9.2"/>',
    ].join(''),
    detail: '<path d="M9.8 10.2v8.6M14.2 10.2v8.6"/>',
  },
  // Billet et pièce.
  argent: {
    trait: [
      '<rect x="2" y="6.5" width="13.5" height="8.5" rx="2.25"/>',
      '<circle cx="17" cy="16" r="5"/>',
    ].join(''),
    detail: ['<circle cx="8.75" cy="10.75" r="1.9"/>', '<path d="M17 13.9v4.2M15.4 16h3.2"/>'].join(
      ''
    ),
  },
  // Calendrier, un jour cerclé.
  calendrier: {
    trait: [
      '<rect x="3" y="5.25" width="18" height="15.75" rx="2.25"/>',
      '<path d="M3 10.25h18"/>',
    ].join(''),
    detail: [
      '<path d="M8 3.2v4M16 3.2v4"/>',
      '<path d="M7.6 14h.01M12 14h.01M16.4 14h.01M7.6 17.4h.01M12 17.4h.01"/>',
      '<circle cx="16.4" cy="17.4" r="1.7"/>',
    ].join(''),
  },
  // Deux immeubles de hauteurs différentes, flèche montante.
  equipe: {
    trait: [
      '<path d="M2.5 21h19"/>',
      '<path d="M4.5 21v-8.75A1.25 1.25 0 0 1 5.75 11h3.5A1.25 1.25 0 0 1 10.5 12.25V21"/>',
      '<path d="M10.5 21V6.25A1.25 1.25 0 0 1 11.75 5h4.5A1.25 1.25 0 0 1 17.5 6.25V21"/>',
    ].join(''),
    detail: [
      '<path d="M6.4 14.5h.01M8.6 14.5h.01M6.4 17.5h.01M8.6 17.5h.01"/>',
      '<path d="M12.6 8.4h.01M15.4 8.4h.01M12.6 11.6h.01M15.4 11.6h.01M12.6 14.8h.01M15.4 14.8h.01"/>',
      '<path d="M20 12.5V7.6M18.2 9.4 20 7.6l1.8 1.8"/>',
    ].join(''),
  },
  // Globe et repère : la zone d'investissement.
  exploration: {
    trait: [
      '<circle cx="11" cy="11" r="8.5"/>',
      '<path d="M17.5 15.6c1.8 0 3.3 1.5 3.3 3.3 0 2.2-3.3 4.4-3.3 4.4s-3.3-2.2-3.3-4.4c0-1.8 1.5-3.3 3.3-3.3z" fill="var(--picto-bg, #fff)"/>',
    ].join(''),
    detail: [
      '<path d="M2.6 11h16.8"/>',
      '<path d="M11 2.6a13 13 0 0 1 0 16.8 13 13 0 0 1 0-16.8z"/>',
      '<circle cx="17.5" cy="18.9" r="1.1"/>',
    ].join(''),
  },
  // Immeuble et loupe.
  analyse: {
    trait: [
      '<path d="M2.5 21h9.5"/>',
      '<path d="M4.5 21V4.25A1.25 1.25 0 0 1 5.75 3h5.5A1.25 1.25 0 0 1 12.5 4.25V10"/>',
      '<circle cx="16.5" cy="14.5" r="5"/>',
    ].join(''),
    detail: [
      '<path d="M6.6 7h.01M9.6 7h.01M6.6 11h.01M9.6 11h.01M6.6 15h.01M9.6 15h.01"/>',
      '<path d="M20.1 18.1 22.4 20.4"/>',
    ].join(''),
  },
};

const glyph = glyphs[name];
if (!glyph) throw new Error(`Pictogramme inconnu : ${name}`);
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  aria-hidden="true"
  data-picto={name}
  class:list={['shrink-0', className]}
>
  <Fragment set:html={glyph.trait} />
  {
    glyph.detail && (
      <g stroke-width="1.25" opacity=".55">
        <Fragment set:html={glyph.detail} />
      </g>
    )
  }
</svg>
