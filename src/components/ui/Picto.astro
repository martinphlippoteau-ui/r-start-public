---
/**
 * Pictogrammes R Start, style ISOMÉTRIQUE AU TRAIT (demande du 11/09/2026) : chaque objet est dessiné en
 * volume, vu sous un angle fixe, en contour seul. L'uniformité ne tient pas à une consigne mais à la
 * GÉOMÉTRIE : tous les dessins sont projetés par la même fonction `iso()` depuis des coordonnées 3D, avec
 * la même échelle, le même angle (projection 2:1, arêtes horizontales à 26,6°) et la même épaisseur de
 * trait. Deux pictogrammes ne peuvent donc pas diverger de style.
 *
 * Primitives : `cuboid()` un pavé (face supérieure fermée, deux arêtes verticales, deux arêtes au sol),
 * `face()` une surface plane, `disc()` un disque à plat (ellipse 2:1). Les accents pleins se limitent à la
 * face supérieure, à 14 % d'opacité : le volume se lit sans alourdir le trait.
 *
 * La tuile de verre translucide (utilitaire `picto-glass`, global.css) est conservée : elle floute le fond
 * et porte la teinte de la clé ; le dessin isométrique est tracé en blanc par-dessus.
 * Clés (champ `icon` de strategy.ts / highlights.ts) : argent, alerte, document-valide, calendrier,
 * equipe (deux volumes et flèche montante), exploration (carte et repère), analyse (immeuble et loupe).
 * Accessibilité : décoratif par défaut ; avec `title`, la tuile devient une image nommée (role="img").
 * Aucun attribut motion ici : l'animation se pose sur l'enveloppe.
 */
export const PICTO_KEYS = [
  'argent',
  'alerte',
  'document-valide',
  'calendrier',
  'equipe',
  'exploration',
  'analyse',
] as const;
export type PictoKey = (typeof PICTO_KEYS)[number];
export const isPictoKey = (value: string): value is PictoKey =>
  (PICTO_KEYS as readonly string[]).includes(value);

interface Props {
  name: PictoKey;
  /** Taille de la tuile : classes Tailwind (`size-16 sm:size-20`). */
  class?: string;
  /** Nom accessible facultatif ; sans lui, le picto est purement décoratif. */
  title?: string;
}
const { name, class: className, title } = Astro.props as Props;

/**
 * Teinte du verre par clé (halo interne et lueur portée) : le verre reste très transparent, la teinte ne
 * fait que le colorer légèrement, comme un filtre. Valeurs en RGB pour composer les opacités en CSS.
 */
const tints: Record<PictoKey, string> = {
  argent: '43 184 196',
  alerte: '224 138 109',
  'document-valide': '79 195 201',
  calendrier: '111 168 201',
  equipe: '53 194 177',
  exploration: '90 182 224',
  analyse: '47 176 216',
};

/* --- Projection isométrique commune (2:1) : (x, y, z) du monde → (X, Y) de la grille 48 × 48 --- */
const OX = 24;
const OY = 32;
const U = 1.5;
const iso = (x: number, y: number, z: number): [number, number] => [
  +(OX + (x - y) * U).toFixed(2),
  +(OY - ((x + y) * U) / 2 - z * U).toFixed(2),
];
const pt = (a: [number, number]) => `${a[0]} ${a[1]}`;
const poly = (pts: [number, number][]) => `M${pts.map(pt).join('L')}Z`;
const line = (a: [number, number], b: [number, number]) => `M${pt(a)}L${pt(b)}`;

/** Surface plane à la hauteur z, de (x0,y0) à (x1,y1). */
const face = (x0: number, y0: number, x1: number, y1: number, z = 0) =>
  poly([iso(x0, y0, z), iso(x1, y0, z), iso(x1, y1, z), iso(x0, y1, z)]);

/** Pavé de (x0,y0,0) à (x1,y1,h) : dessus fermé, deux arêtes verticales, deux arêtes au sol. */
const cuboid = (x0: number, y0: number, x1: number, y1: number, h: number) =>
  [
    face(x0, y0, x1, y1, h),
    line(iso(x1, y0, h), iso(x1, y0, 0)),
    line(iso(x1, y1, h), iso(x1, y1, 0)),
    line(iso(x0, y1, h), iso(x0, y1, 0)),
    line(iso(x1, y0, 0), iso(x1, y1, 0)),
    line(iso(x1, y1, 0), iso(x0, y1, 0)),
  ].join('');

/** Disque à plat (ellipse 2:1) centré en (x,y) à la hauteur z. */
const disc = (x: number, y: number, z: number, r: number) => {
  const [cx, cy] = iso(x, y, z);
  return `<ellipse cx="${cx}" cy="${cy}" rx="${(r * U * 2).toFixed(2)}" ry="${(r * U).toFixed(2)}"/>`;
};

/** Accent : face supérieure remplie à 14 %. */
const topAccent = (x0: number, y0: number, x1: number, y1: number, h: number) =>
  `<path d="${face(x0, y0, x1, y1, h)}" fill="#fff" fill-opacity=".14" stroke="none"/>`;

const p = (d: string) => `<path d="${d}"/>`;
const dot = (x: number, y: number, z: number, r = 0.9) => {
  const [cx, cy] = iso(x, y, z);
  return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#fff" stroke="none"/>`;
};

/* --- Les sept dessins, bâtis sur les mêmes primitives --- */
const glyphs: Record<PictoKey, string> = {
  // Liasse posée à plat et pile de deux jetons : ce que l'on verse.
  argent: [
    topAccent(-5.5, -3, 2, 3, 0.6),
    p(cuboid(-5.5, -3, 2, 3, 0.6)),
    disc(4.5, 0, 2.4, 2.2),
    disc(4.5, 0, 1.2, 2.2),
    p(line(iso(6.5, 0, 1.2), iso(6.5, 0, 2.4))),
    p(line(iso(2.5, 0, 1.2), iso(2.5, 0, 2.4))),
  ].join(''),
  // Panneau triangulaire dressé sur un socle : l'avertissement.
  alerte: [
    topAccent(-3.2, -3.2, 3.2, 3.2, 0.5),
    p(cuboid(-3.2, -3.2, 3.2, 3.2, 0.5)),
    p(poly([iso(0, 0, 1.1), iso(-3.6, 3.6, 8), iso(3.6, -3.6, 8)])),
    p(line(iso(0, 0, 4.2), iso(0, 0, 6.2))),
    dot(0, 0, 3.1, 0.85),
  ].join(''),
  // Feuille à plat, deux lignes de texte, coche en relief : le document validé.
  'document-valide': [
    topAccent(-5, -4, 2.5, 4, 0.35),
    p(cuboid(-5, -4, 2.5, 4, 0.35)),
    p(line(iso(-3.4, -2.4, 0.35), iso(0.9, -2.4, 0.35))),
    p(line(iso(-3.4, 0, 0.35), iso(-0.3, 0, 0.35))),
    p(`M${pt(iso(-1.4, 2.6, 2.6))}L${pt(iso(-0.2, 3.8, 1.9))}L${pt(iso(2.8, 0.8, 4.6))}`),
  ].join(''),
  // Bloc de dates, grille sur la face supérieure, un jour marqué, deux anneaux.
  calendrier: [
    topAccent(-4.4, -4.4, 4.4, 4.4, 0.7),
    p(cuboid(-4.4, -4.4, 4.4, 4.4, 0.7)),
    p(line(iso(-1.5, -4.4, 0.7), iso(-1.5, 4.4, 0.7))),
    p(line(iso(1.5, -4.4, 0.7), iso(1.5, 4.4, 0.7))),
    p(line(iso(-4.4, -1.5, 0.7), iso(4.4, -1.5, 0.7))),
    p(line(iso(-4.4, 1.5, 0.7), iso(4.4, 1.5, 0.7))),
    `<path d="${face(1.5, 1.5, 4.4, 4.4, 0.7)}" fill="#fff" fill-opacity=".45" stroke="none"/>`,
    p(line(iso(-2.9, -4.4, 1.3), iso(-2.9, -4.4, 2.3))),
    p(line(iso(2.9, -4.4, 1.3), iso(2.9, -4.4, 2.3))),
  ].join(''),
  // Deux volumes de hauteurs différentes et une flèche montante : le double potentiel.
  equipe: [
    topAccent(-4.8, -1.4, -1.2, 2.2, 4),
    p(cuboid(-4.8, -1.4, -1.2, 2.2, 4)),
    topAccent(0.4, -2.4, 4, 1.2, 7),
    p(cuboid(0.4, -2.4, 4, 1.2, 7)),
    p(line(iso(5.6, -4, 6.2), iso(5.6, -4, 9.2))),
    p(`M${pt(iso(4.9, -4, 8.4))}L${pt(iso(5.6, -4, 9.2))}L${pt(iso(6.3, -4, 8.4))}`),
  ].join(''),
  // Carte dépliée en trois volets et repère planté : la zone d'investissement.
  exploration: [
    topAccent(-5.6, -4.2, 5.6, 4.2, 0.3),
    p(cuboid(-5.6, -4.2, 5.6, 4.2, 0.3)),
    p(line(iso(-1.9, -4.2, 0.3), iso(-1.9, 4.2, 0.3))),
    p(line(iso(1.9, -4.2, 0.3), iso(1.9, 4.2, 0.3))),
    p(line(iso(0, 0, 1.2), iso(0, 0, 4.4))),
    `<circle cx="${iso(0, 0, 5.4)[0]}" cy="${iso(0, 0, 5.4)[1]}" r="2"/>`,
  ].join(''),
  // Immeuble en volume et loupe au premier plan : les bons immeubles au bon prix.
  analyse: [
    topAccent(-4.8, -2.8, -0.4, 1.6, 7),
    p(cuboid(-4.8, -2.8, -0.4, 1.6, 7)),
    p(line(iso(-3.6, -2.8, 2.2), iso(-1.6, -2.8, 2.2))),
    p(line(iso(-3.6, -2.8, 4.2), iso(-1.6, -2.8, 4.2))),
    `<circle cx="${iso(3.4, -0.8, 3.2)[0]}" cy="${iso(3.4, -0.8, 3.2)[1]}" r="4.3"/>`,
    p(line(iso(3.4, -0.8, 0.4), iso(4.6, 0.4, -0.8))),
  ].join(''),
};

const glyph = glyphs[name];
if (!glyph) throw new Error(`Pictogramme inconnu : ${name}`);
const tint = tints[name];

/* Identifiant du <title> : unique par tuile rendue (le frontmatter s'exécute une fois par instance). */
const g = globalThis as { __pictoSeq?: number };
g.__pictoSeq = (g.__pictoSeq ?? 0) + 1;
const titleId = title ? `picto-title-${name}-${g.__pictoSeq}` : undefined;
---

<span
  class:list={['picto-glass', className]}
  style={`--picto-tint: ${tint};`}
  role={title ? 'img' : undefined}
  aria-labelledby={title ? titleId : undefined}
  aria-hidden={title ? undefined : 'true'}
  data-picto={name}
>
  {
    title && (
      <span id={titleId} class="visually-hidden">
        {title}
      </span>
    )
  }
  <svg
    viewBox="0 0 48 48"
    fill="none"
    stroke="#fff"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
    aria-hidden="true"
    class="picto-glass-glyph"
  >
    <Fragment set:html={glyph} />
  </svg>
</span>
