---
import IconExterne from '@/components/ui/IconExterne.astro';
import { ctaHref, site } from '@/config/site';
import { withBase } from '@/lib/href';
import type { CtaPosition } from '@/content/types';

/**
 * Bouton / lien. Sans `href`, c'est un CTA de souscription : data-cta pour l'analytics, même
 * onglet, et tant que `site.subscribeOpen` est faux il n'emmène PAS vers le tunnel : le clic ouvre
 * la fenêtre « la souscription arrive bientôt » (SubscribeSoon.astro), et sans JavaScript il mène à
 * la documentation réglementaire (config/site.ts, ctaHref). Variantes, les deux rôles du site sur
 * leurs deux fonds (17/09/2026, décisions de l'équipe) : primary (navy plein) et light (blanc plein
 * sur fond sombre) ; secondary (contour navy) et outline-light (contour blanc). LA PEAU N'EST PAS
 * ICI : elle vit dans global.css, utilitaires `btn`, `btn-<variante>` et `btn-<taille>` (« Les
 * quatre rôles de bouton »), qu'un <button> écrit à la main reprend tels quels. Tailles : sm
 * (40 px, cible tactile minimale), md (48 px), lg (62 px), bordure comprise, les variantes pleines
 * portant une bordure transparente pour mesurer comme les contours. Micro-interactions :
 * `btn-motion` (global.css), rien en reduced-motion.
 */
interface Props {
  href?: string;
  position?: CtaPosition;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  /**
   * Ouverture dans un nouvel onglet, pour les liens qui SORTENT DU SITE ; `rel` suit (`noopener
   * noreferrer`, obligatoire avec `_blank` : la page ouverte pourrait sinon manipuler celle qui l'a
   * ouverte via `window.opener`). Jamais posé sur un CTA de souscription. Une flèche en diagonale
   * est ajoutée au libellé, le même dessin que sur les liens Trustpilot et du pied de page : elle
   * prévient qu'on quitte le site. Décorative (aria-hidden), l'information étant portée par la
   * mention de nouvelle fenêtre que l'appelant place en `visually-hidden`.
   */
  target?: '_blank';
}
const {
  href,
  position = 'hero',
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
} = Astro.props;
/* CLASSES ÉCRITES EN TOUTES LETTRES (17/09/2026) : Tailwind ne génère un utilitaire que s'il en
   trouve le nom tel quel dans les sources, et `btn-${variant}` ne lui montre que « btn- ».
   `btn-light` et `btn-lg`, qu'aucun autre fichier n'écrivait, manquaient au CSS : le « Souscrire en
   ligne » du hero s'affichait en texte nu. Toute nouvelle variante ou taille s'ajoute ici, en
   entier. */
const VARIANTES = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  light: 'btn-light',
  'outline-light': 'btn-outline-light',
} as const;
const TAILLES = { sm: 'btn-sm', md: 'btn-md', lg: 'btn-lg' } as const;
const isSubscribe = !href;
// Un lien interne est préfixé par le chemin de base ; les ancres et les URL absolues passent telles
// quelles. Sans `href`, c'est un CTA de souscription : tunnel externe si la souscription est ouverte,
// sinon la documentation (repli sans JavaScript, le clic ouvrant la fenêtre d'attente).
const finalHref = href ? withBase(href) : ctaHref(position);
---

<a
  href={finalHref}
  class:list={[
    // `btn-motion` définit sa propre transition (transform, ombre, couleurs) : ne pas la doubler par
    // `transition-colors`, qui l'écraserait (même spécificité) et figerait l'élévation au survol.
    'btn btn-motion',
    VARIANTES[variant],
    TAILLES[size],
    className,
  ]}
  data-cta={isSubscribe ? 'souscrire' : undefined}
  data-cta-position={isSubscribe ? position : undefined}
  target={target}
  rel={target === '_blank'
    ? 'noopener noreferrer'
    : isSubscribe && site.subscribeOpen
      ? 'noopener'
      : undefined}
>
  <slot />
  {target === '_blank' && (
    <IconExterne class="size-4 shrink-0" />
  )}
</a>
