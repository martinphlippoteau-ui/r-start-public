---
/**
 * Section 2, « Pourquoi gagnant-gagnant ? » (id « ce-qui-change »), zone 2 de la V2.
 * Réduite au texte fourni par l'équipe le 11/09/2026 : H2, question d'accroche en H3, la phrase qui
 * annonce les deux situations, les deux situations en liste, la conclusion, l'allégation de rang et un
 * lien vers le comparateur. Plus de cartes, plus de sur-titre, plus de mécanisme de réserve : la section
 * tient en un écran.
 * Le bouton qui la fermait est devenu une PASTILLE FLOTTANTE (components/StickyCta.astro, rendue par la
 * page) : le lien vers le comparateur reste atteignable pendant toute la lecture.
 * Équilibre AMF : la section ne porte PLUS de couple avantage / risque depuis le 11/09/2026, le
 * contre-poids chiffré a été retiré sur demande réitérée de l'équipe, et le marquage `data-advantage`
 * avec lui, faute de frère. Les risques de l'accueil reposent sur la ligne du hero et sur la section
 * Risques ; le détail des frais vit sur /frais, atteinte par le lien de fin de section.
 * Deux formulations sont à défendre en compliance (voir l'en-tête de src/content/fr/difference.ts) ;
 * scripts/check-compliance.mjs les signale en avertissement à chaque exécution.
 * Motion (sobriété) : H2 mot à mot, H3 en fade-up. Rien d'autre ne bouge.
 * Contenu : src/content/fr/difference.ts.
 */
import { Picture } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { difference } from '@/content/fr/difference';
import Button from '@/components/ui/Button.astro';
import { media, AFFICHER_LEGENDES } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

const id = sections.difference.id;
const titleId = id + '-title';
/**
 * Photo d'illustration à droite de la démonstration. Changée le 12/09/2026 : la précédente venait du jeu
 * `strategy`, déjà employé par la section Stratégie, ce qui faisait doublon sur le site. Celle-ci n'est
 * utilisée nulle part ailleurs.
 * Purement décorative pour la conformité, elle n'énonce aucun avantage, elle n'entre donc dans aucun
 * couple avantage / risque. Crédit visible : R Start n'a pas de patrimoine, la photo ne représente aucun
 * immeuble détenu.
 */
const photo = await resolveImage(media.documents.src);

/**
 * Les deux situations, découpées autour du mot à mettre en valeur : le contenu reste du texte brut
 * (aucun balisage dans src/content), le gras est posé ici.
 */
const situations = (difference.situations ?? []).map((s) => {
  const i = s.strong ? s.text.indexOf(s.strong) : -1;
  return i < 0
    ? { before: s.text, strong: '', after: '' }
    : { before: s.text.slice(0, i), strong: s.strong!, after: s.text.slice(i + s.strong!.length) };
});
/*
 * La phrase d'annonce coupée autour du terme défini : [avant, après], ou `null` si le terme n'y est pas
 * (la phrase est alors rendue entière, sans bouton). Coupée à la PREMIÈRE occurrence seulement.
 */
const morceaux = (() => {
  const d = difference.definition;
  const lead = difference.lead;
  if (!d || !lead) return null;
  const i = lead.indexOf(d.term);
  return i === -1 ? null : ([lead.slice(0, i), lead.slice(i + d.term.length)] as const);
})();
---

{
  /* `data-curtain` (11/09/2026, transition « à la Revolut ») : le hero, section précédente, est épinglé pendant
    que celle-ci glisse par-dessus (coins arrondis et ombre posés par la CSS [data-curtain]). Le hero contient
    la ligne risques : le moteur se limite à épingler et recouvrir, sans recul ni fondu (scroll.ts). Sous 64 rem,
    aucun épinglage : défilement normal. */
}
<Section id={id} tone="paper" data-curtain>
  <Container size="wide">
    <header>
      <h2 id={titleId} class="text-display-lg text-balance" data-reveal-text>{difference.title}</h2>
    </header>

    {
      /* Le contre-poids chiffré (frais de gestion, cessions, retrait, coût total inconnu) a été retiré de
        cette section le 11/09/2026, sur demande réitérée de l'équipe après signalement. Le bloc ne porte
        donc plus `data-advantage` : sans contre-poids frère, le marquage serait faux et le contrôle
        d'équilibre AMF le refuserait. Les risques de l'accueil reposent désormais sur la ligne du hero et
        sur la section Risques ; le détail des frais reste sur /frais, atteinte par le lien ci-dessous. */
    }
    {
      /* CORPS À 18 PX FIXES depuis le 15/09/2026, et espacements resserrés d'un cran.
        `text-lead` montait de 18 à 24 px avec la largeur d'écran : sur grand écran, la
        démonstration était rendue au corps d'une introduction, alors qu'elle se lit comme du
        texte courant. `text-lg` la fixe à 18 px partout. */
    }
    {
      /* LE H3 EST DANS LA GRILLE depuis le 15/09/2026, et non plus dans l'en-tête au-dessus d'elle
        (« remonte la photo du bloc 2 pour qu'elle s'aligne avec R Start, un modèle de frais
        gagnant-gagnant »). C'est la seule façon propre d'aligner la photo sur lui : tant qu'il vivait
        au-dessus, la colonne de droite ne pouvait commencer qu'après. Une marge négative sur la figure
        aurait donné le même résultat à une largeur donnée et se serait décalée à toutes les autres.
        Rien ne change sous `lg`, où la grille est en une colonne : le H3 reste au même endroit, suivi
        du corps puis de la photo, dans cet ordre. */
    }
    {
      /* LE TITRE SE DÉTACHE DU BLOC (16/09/2026 au soir, « remonte un peu "Qui a envie de payer avant de
        gagner" pour le détacher un peu du bloc ») : la grille descend d'un cran, `mt-10` et `sm:mt-14`
        au lieu de `mt-6` et `sm:mt-8`. Le titre garde sa place en tête de section, c'est l'air sous lui
        qui grandit. */
    }
    <div class="mt-10 grid items-start gap-8 sm:mt-14 lg:grid-cols-12 lg:gap-14">
      <div class="text-lg text-ink lg:col-span-7">
        {
          /* La question d'accroche est un H3 (11/09/2026) : mise en valeur et nettement détachée du H2,
            elle ouvre la démonstration au lieu de la commenter. */
        }
        <h3
          data-animate="fade-up"
          data-animate-delay="0.1"
          class="text-display-sm max-w-3xl text-ink"
        >
          {difference.intro}
        </h3>
        {
          /* LA PHRASE D'ANNONCE, avec un « i » collé au mot « SCPI » (17/09/2026) : la définition se
            déplie dessous, même mécanisme que les repères de l'accueil et le comparateur
            (scripts/infoToggle.ts, utilitaire `info-panneau`). Sans script, la définition est lue en
            clair et le bouton n'existe pas. La phrase est coupée à la première occurrence du terme :
            si le terme en sortait un jour, la phrase s'affiche entière et sans bouton. */
        }
        {difference.lead && (
          <p class="mt-6">
            {morceaux ? (
              <>
                {morceaux[0]}
                <span class="whitespace-nowrap">
                  <dfn class="not-italic">{difference.definition!.term}</dfn>
                  <button
                    type="button"
                    data-info-bouton
                    hidden
                    aria-expanded="false"
                    aria-controls="info-scpi"
                    class="ml-1.5 inline-flex size-5 shrink-0 translate-y-[-0.1em] items-center justify-center rounded-full border border-navy/30 align-middle text-xs font-semibold text-navy/70 transition-colors hover:border-navy/70 hover:text-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy"
                  >
                    <span aria-hidden="true">i</span>
                    <span class="visually-hidden">
                      {difference.definition!.label} : {difference.definition!.term}
                    </span>
                  </button>
                </span>
                {morceaux[1]}
              </>
            ) : (
              difference.lead
            )}
          </p>
        )}
        {morceaux && (
          <div id="info-scpi" data-info-panneau class="info-panneau">
            <p class="text-base leading-snug text-slate-700">
              <strong class="font-semibold text-ink">{difference.definition!.term}</strong> :{' '}
              {difference.definition!.text}
            </p>
          </div>
        )}

        <ul role="list" class="mt-4 space-y-2">
          {
            situations.map((s) => (
              <li class="flex gap-3">
                <span
                  aria-hidden="true"
                  class="mt-[0.62em] size-1.5 shrink-0 rounded-full bg-teal-700"
                />
                <span>
                  {s.before}
                  {s.strong && <strong class="font-semibold">{s.strong}</strong>}
                  {s.after}
                </span>
              </li>
            ))
          }
        </ul>

        {
          /* Conclusion de l'équipe. La note détaille la rémunération réellement perçue. */
          difference.counterweight.pedagogy?.map((phrase) => (
            <p class="mt-5 font-semibold">
              {phrase}
              {difference.counterweight.noteId && (
                <span class="whitespace-nowrap">
                  <NoteRef id={difference.counterweight.noteId} />
                </span>
              )}
            </p>
          ))
        }

        {
          /* Allégation de rang de l'équipe, retirée du contenu le 15/09/2026 : le rendu reste, il ne
            trouve simplement plus rien à afficher. Voir difference.ts pour ce que son retrait emporte
            du côté de la Conformité. */
          difference.counterweight.claim && (
            <p class="mt-6 flex gap-3 font-medium">
              <span aria-hidden="true" class="text-teal-700">
                →
              </span>
              <span>
                {difference.counterweight.claim.text}
                {difference.counterweight.claim.noteId && (
                  <span class="whitespace-nowrap">
                    <NoteRef id={difference.counterweight.claim.noteId} />
                  </span>
                )}
              </span>
            </p>
          )
        }

        {
          /* Appel à l'action du bloc (15/09/2026). `ghost` et non `primary` : la page porte déjà deux
            boutons de souscription au premier écran et une pastille flottante ; celui-ci mène à une
            page du site, pas au tunnel, et ne doit pas leur disputer l'attention. */
          difference.secondaryCta && (
            <p class="mt-6">
              <Button href={difference.secondaryCta.href} variant="ghost" size="md">
                {difference.secondaryCta.label}
              </Button>
            </p>
          )
        }
      </div>

      <figure class="lg:col-span-5" data-animate="clip">
        <div class="img-frame aspect-[4/3]">
          <Picture
            src={photo}
            alt={media.documents.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 26rem, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block h-full w-full' }}
            class="h-full w-full object-cover"
          />
        </div>
        {
          AFFICHER_LEGENDES && media.documents.credit && (
            <figcaption class="text-caption mt-3 text-slate-700">
              {media.documents.credit}
            </figcaption>
          )
        }
      </figure>
    </div>
  </Container>
</Section>

<script>
  /* Dépliage de la définition « SCPI » : le module des repères de l'accueil et du comparateur, importé
     une seule fois par page quel que soit le nombre de composants qui s'en servent. */
  import '@/scripts/infoToggle';
</script>
