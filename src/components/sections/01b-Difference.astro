---
/**
 * Section 2 — « Pourquoi gagnant-gagnant ? » (id « ce-qui-change »), zone 2 de la V2.
 * Réduite au texte fourni par l'équipe le 11/09/2026 : H2, question d'accroche en H3, la phrase qui
 * annonce les deux situations, les deux situations en liste, la conclusion, l'allégation de rang et un
 * lien vers le comparateur. Plus de cartes, plus de photos, plus de sur-titre, plus de mécanisme de
 * réserve : la section tient en un écran.
 * Équilibre AMF : la section ne porte PLUS de couple avantage / risque depuis le 11/09/2026 — le
 * contre-poids chiffré a été retiré sur demande réitérée de l'équipe, et le marquage `data-advantage`
 * avec lui, faute de frère. Les risques de l'accueil reposent sur la ligne du hero et sur la section
 * Risques ; le détail des frais vit sur /frais, atteinte par le lien de fin de section.
 * Deux formulations sont à défendre en compliance (voir l'en-tête de src/content/fr/difference.ts) ;
 * scripts/check-compliance.mjs les signale en avertissement à chaque exécution.
 * Motion (sobriété) : H2 mot à mot, H3 en fade-up. Rien d'autre ne bouge.
 * Contenu : src/content/fr/difference.ts.
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { difference } from '@/content/fr/difference';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

const id = sections.difference.id;
const titleId = id + '-title';
/**
 * Photo d'illustration à droite de la démonstration (11/09/2026) : la section n'avait plus aucune image
 * depuis qu'elle a été réduite au texte. Purement décorative pour la conformité — elle n'énonce aucun
 * avantage, elle n'entre donc dans aucun couple avantage / risque. Crédit visible : R Start n'a pas de
 * patrimoine, la photo ne représente aucun immeuble détenu.
 */
const photo = await resolveImage(media.strategy[0].src);

/**
 * Les deux situations, découpées autour du mot à mettre en valeur : le contenu reste du texte brut
 * (aucun balisage dans src/content), le gras est posé ici.
 */
const situations = (difference.situations ?? []).map((s) => {
  const i = s.strong ? s.text.indexOf(s.strong) : -1;
  return i < 0
    ? { before: s.text, strong: '', after: '' }
    : { before: s.text.slice(0, i), strong: s.strong, after: s.text.slice(i + s.strong.length) };
});
---

{
  /* `data-curtain` (11/09/2026, transition « à la Revolut ») : le hero, section précédente, est épinglé pendant
    que celle-ci glisse par-dessus (coins arrondis et ombre posés par la CSS [data-curtain]). Le hero contient
    la ligne risques : le moteur se limite à épingler et recouvrir, sans recul ni fondu (scroll.ts). Sous 64 rem,
    aucun épinglage : défilement normal. */
}
<Section id={id} tone="paper" data-curtain>
  <Container size="wide">
    <header>
      <h2 id={titleId} class="text-display-lg text-balance" data-reveal-text>{difference.title}</h2>
      {
        /* La question d'accroche est un H3 (11/09/2026) : mise en valeur et nettement détachée du H2,
          elle ouvre la démonstration au lieu de la commenter. */
      }
      <h3
        data-animate="fade-up"
        data-animate-delay="0.1"
        class="text-display-sm mt-10 max-w-3xl text-ink sm:mt-14"
      >
        {difference.intro}
      </h3>
    </header>

    {
      /* Le contre-poids chiffré (frais de gestion, cessions, retrait, coût total inconnu) a été retiré de
        cette section le 11/09/2026, sur demande réitérée de l'équipe après signalement. Le bloc ne porte
        donc plus `data-advantage` : sans contre-poids frère, le marquage serait faux et le contrôle
        d'équilibre AMF le refuserait. Les risques de l'accueil reposent désormais sur la ligne du hero et
        sur la section Risques ; le détail des frais reste sur /frais, atteinte par le lien ci-dessous. */
    }
    <div class="mt-8 grid items-start gap-10 sm:mt-12 lg:grid-cols-12 lg:gap-16">
      <div class="text-lead text-ink lg:col-span-7">
        {difference.lead && <p>{difference.lead}</p>}

        <ul role="list" class="mt-5 space-y-3">
          {
            situations.map((s) => (
              <li class="flex gap-3">
                <span
                  aria-hidden="true"
                  class="mt-[0.62em] size-1.5 shrink-0 rounded-full bg-teal-700"
                />
                <span>
                  {s.before}
                  {s.strong && <strong class="font-semibold">{s.strong}</strong>}
                  {s.after}
                </span>
              </li>
            ))
          }
        </ul>

        {
          /* Conclusion de l'équipe. La note détaille la rémunération réellement perçue. */
          difference.counterweight.pedagogy?.map((phrase) => (
            <p class="mt-6 font-semibold">
              {phrase}
              {difference.counterweight.noteId && (
                <span class="whitespace-nowrap">
                  <NoteRef id={difference.counterweight.noteId} />
                </span>
              )}
            </p>
          ))
        }

        {
          /* Allégation de rang de l'équipe : elle n'est PAS bornée au périmètre du groupe CORUM, c'est
            l'appel de note qui le porte. Jamais affichée sans lui. */
          difference.counterweight.claim && (
            <p class="mt-6 flex gap-3 font-medium">
              <span aria-hidden="true" class="text-teal-700">
                →
              </span>
              <span>
                {difference.counterweight.claim.text}
                <span class="whitespace-nowrap">
                  <NoteRef id={difference.counterweight.claim.noteId} />
                </span>
              </span>
            </p>
          )
        }
      </div>

      <figure class="lg:col-span-5" data-animate="clip">
        <div class="img-frame aspect-[4/3]">
          <Picture
            src={photo}
            alt={media.strategy[0].alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 26rem, 100vw"
            formats={['avif', 'webp']}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block h-full w-full' }}
            class="h-full w-full object-cover"
          />
        </div>
        {
          media.strategy[0].credit && (
            <figcaption class="text-caption mt-3 text-slate-700">
              {media.strategy[0].credit}
            </figcaption>
          )
        }
      </figure>
    </div>

    <div class="mt-10 sm:mt-14">
      <Button href={difference.cta.href} variant="secondary" size="lg">
        {difference.cta.label}
      </Button>
    </div>
  </Container>
</Section>
