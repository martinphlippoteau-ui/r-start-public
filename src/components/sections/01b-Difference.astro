---
/**
 * Section 2 — « Ce qui change vraiment » (id « ce-qui-change »), zone 2 de la V2 (plan §2, §3 ter p.4).
 * Fond paper, entre Points forts (white, lu d'abord pour comprendre le produit) et Confiance (ink) :
 * alternance ink → white → paper → ink ; ses cartes sont white. Deux façons dont la société de gestion se rémunère (loyers
 * encaissés, plus-value à la vente), la formule d'alignement (les deux phrases « Payer des frais… » vivent
 * dans le hero depuis la trame du 10/09/2026) avec son contre-poids
 * chiffré (frais de gestion, cessions, retrait), puis le mécanisme de réserve en cas de moins-value
 * (brochure partenaires 2026, p.4). Un lien interne (pas un CTA de souscription) renvoie vers /frais.
 * Équilibre AMF : chaque façon porte son risque dans la même carte et à la même taille ; le
 * contre-poids chiffré et le risque du mécanisme de réserve sont rendus en RiskNote, jamais animés,
 * jamais enveloppés par un ancêtre animé. Motion (sobriété du 11/09/2026, un effet par bloc) : H2 mot à
 * mot et introduction en fade-up (0,1 s) ; dans chaque carte, seul le H3 entre en fade-up (délai
 * par colonne 0 / 0,08 s), description et RiskNote en place d'emblée ; surtitres statiques ; rien sur
 * l'enveloppe qui contient le RiskNote.
 * Aucune donnée de performance, aucun exemple d'investissement, aucune allégation de rang (portée par
 * le hero avec son périmètre).
 * Contenu : src/content/fr/difference.ts.
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { difference } from '@/content/fr/difference';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

const id = sections.difference.id;
/** Respiration visuelle de fin de section (11/09/2026) : bande panoramique, purement décorative. */
const bandPhoto = await resolveImage(media.income.src);
const titleId = id + '-title';
/** Décalage de cascade entre les deux cartes (secondes) : la seconde colonne suit la première. */
const ENGINE_STAGGER = 0.08;
---

<Section id={id} tone="paper">
  <Container size="wide">
    <header class="max-w-4xl">
      <p class="text-eyebrow mb-4 text-teal-700">{difference.eyebrow}</p>
      <h2 id={titleId} class="text-display-lg" data-reveal-text>{difference.title}</h2>
      <p data-animate="fade-up" data-animate-delay="0.1" class="mt-6 text-lead opacity-90">
        {difference.intro}
      </p>
    </header>

    <!-- Les deux façons de se rémunérer : chaque carte porte son risque, hors de tout ancêtre animé -->
    <div class="mt-12 sm:mt-16 lg:mt-24">
      {
        difference.enginesTitle && (
          <p class="text-eyebrow mb-4 text-teal-700">{difference.enginesTitle}</p>
        )
      }
      <ul
        role="list"
        aria-label={difference.enginesLabel}
        class="grid gap-5 sm:grid-cols-2 lg:gap-6"
      >
        {
          difference.engines.map((engine, i) => (
            <Card as="li" tone="white" class="flex flex-col ring-1 ring-navy/5 lg:p-10">
              <h3
                class="text-display-sm text-ink"
                data-animate="fade-up"
                data-animate-delay={String(i * ENGINE_STAGGER)}
              >
                {engine.title}
                {engine.noteId && (
                  <span class="whitespace-nowrap">
                    <NoteRef id={engine.noteId} />
                  </span>
                )}
              </h3>
              <p data-advantage class="mt-4 text-base leading-relaxed text-ink">
                {engine.description}
              </p>
              <RiskNote text={engine.risk} class="mt-4 border-t border-navy/10 pt-4" />
            </Card>
          ))
        }
      </ul>
    </div>

    <!-- Formule d'alignement et son contre-poids chiffré, même bloc, même taille -->
    <div
      class="mt-12 grid gap-6 border-t border-navy/15 pt-8 sm:mt-16 lg:mt-20 lg:grid-cols-2 lg:gap-12 lg:pt-10"
    >
      <div data-advantage class="text-lead">
        {
          difference.counterweight.title && (
            <h3 class="text-display-sm text-ink">{difference.counterweight.title}</h3>
          )
        }
        {
          /* Définition descendue du hero (allégation de rang), jamais sans son appel de note ; les frais réels
            (RiskNote ci-contre) sont dans le même bloc et la même taille. */
          difference.counterweight.claim && (
            <p class="mt-3 font-medium text-ink">
              {difference.counterweight.claim.text}
              <span class="whitespace-nowrap">
                <NoteRef id={difference.counterweight.claim.noteId} />
              </span>
            </p>
          )
        }
        {
          /* Les deux phrases de la trame, en tête du bloc : même bloc, même taille, même contre-poids chiffré. */
          difference.counterweight.pedagogy?.map((phrase) => (
            <p class="mt-3 font-semibold text-ink">{phrase}</p>
          ))
        }
        <p class="mt-3">
          {difference.counterweight.advantage}
          {
            difference.counterweight.noteId && (
              <span class="whitespace-nowrap">
                <NoteRef id={difference.counterweight.noteId} />
              </span>
            )
          }
        </p>
      </div>
      <RiskNote text={difference.counterweight.risk} size="lead" />
    </div>

    <!-- Mécanisme de réserve en cas de moins-value (brochure p.4), jamais animé -->
    <div
      class="mt-12 grid gap-6 border-t border-navy/15 pt-8 sm:mt-16 lg:mt-20 lg:grid-cols-2 lg:gap-12 lg:pt-10"
    >
      <div data-advantage class="text-lead space-y-3">
        <h3 class="text-display-sm text-ink">
          {difference.lossMechanism.title}
          {
            difference.lossMechanism.noteId && (
              <span class="whitespace-nowrap">
                <NoteRef id={difference.lossMechanism.noteId} />
              </span>
            )
          }
        </h3>
        {difference.lossMechanism.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <RiskNote text={difference.lossMechanism.risk} size="lead" />
    </div>

    <div class="mt-10 sm:mt-14 lg:mt-16">
      <Button href={difference.cta.href} variant="secondary" size="lg">
        {difference.cta.label}
      </Button>
    </div>

    {
      /* Bande panoramique : coupe les deux écrans de texte du modèle de frais. Aucune allégation, aucun
        avantage : elle n'entre dans aucun couple avantage / risque. Crédit visible (R Start n'a pas encore
        de patrimoine : la photo ne représente aucun immeuble détenu). */
    }
    <figure class="mt-10 sm:mt-14 lg:mt-16" data-animate="clip">
      <div class="img-frame aspect-[3/2] sm:aspect-[21/9]">
        <div
          class="absolute inset-x-0 -top-[12%] h-[124%]"
          data-parallax="0.05"
          data-parallax-trigger="parent"
        >
          <Picture
            src={bandPhoto}
            alt={media.income.alt}
            widths={[640, 1024, 1600, 2400]}
            sizes="(min-width: 80rem) 72rem, 100vw"
            formats={['avif', 'webp']}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block h-full w-full' }}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      {
        media.income.credit && (
          <figcaption class="text-caption mt-3 text-slate-700">{media.income.credit}</figcaption>
        )
      }
    </figure>
  </Container>
</Section>
