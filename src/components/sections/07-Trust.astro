---
/**
 * Section 7 — « L'expérience derrière R Start » (id « corum »). Allégée le 11/09/2026 : le cadre
 * réglementaire est passé sur /documentation et le bloc « rémunération sur les ventes » (doublon de la
 * zone 2 et de /frais) a été retiré. Trame du 10/09/2026 : 02 Points
 * forts (white) → 01b Ce qui change (paper) → 07 → 03a Immeuble (photo pleine largeur) → 03 Frais. Deux
 * bandes contrastées avec les voisines : une bande ink (en-tête + cadre réglementaire en cartes label / valeur,
 * réserve AMF et RiskNote), puis une bande white (avis Trustpilot en grand chiffre compteur + lien externe
 * + périmètre en RiskNote ; chiffres du groupe CORUM en quatre compteurs 2 × 2, RiskNote puis source ;
 * gamme des cinq SCPI avec logos ; rémunération de CORUM sur les ventes). Les cinq blocs sont des H3 de
 * même niveau sous le H2.
 * Aucun logo AMF, aucune étoile ni logo Trustpilot, aucune photo (droits media.corum non confirmés).
 * Les chiffres viennent de trust.stats (corum.stats n'est pas rendu ici pour ne pas doubler) : les quatre
 * chiffres de la trame (zone 4) sont tous rendus, dans l'ordre du contenu ; leur contre-poids et leur source
 * ont quitté le bloc le 11/09/2026 (voir le commentaire dans le gabarit).
 * Équilibre AMF : chaque bloc avantage ([data-advantage]) partage son parent avec son contre-poids
 * ([data-risk]) rendu à la même taille de texte visible (text-lead face aux valeurs des cartes, aux libellés
 * de Stat et aux descriptions) ; ni le H2, ni les blocs risque, ni la réserve AMF ne portent data-animate.
 * Motion (src/scripts/motion.ts ; sobriété du 11/09/2026 : un seul effet d'entrée par bloc) :
 *  - en-tête : H2 mot à mot et introduction en fade-up (SectionHeading `motion`), surtitre statique ;
 *  - les titres H3 des trois blocs entrent par `fade-up` : 24 px (valeur titre) quand un compteur suit
 *    (avis, chiffres), 12 px seulement quand le paragraphe sous le titre est visible d'emblée (gamme) pour
 *    ne pas chevaucher sa première ligne ;
 *  - les quatre chiffres du groupe sont FIXES (size="solid") : le compteur faisait varier leur largeur
 *    et décalait la grille. La note Trustpilot reste un compteur (`<Stat numeric>`) qui monte de 0 à la note en
 *    1,4 s avec une décimale : c'est le seul effet de son bloc (plus de fade-up sur l'enveloppe) ; le
 *    périmètre / risque à côté reste visible d'emblée ;
 *  - les chiffres du groupe comptent depuis 0, en place (plus de `stagger` sur la liste : le compteur est
 *    l'entrée), avec une durée proportionnelle à l'ordre de grandeur (1,4 s pour 9,6 → 2,2 s pour
 *    160 000) : les grands nombres finissent en dernier. Chiffres non réglementaires (clients, encours,
 *    immeubles, avis), jamais un frais ni un indicateur de risque ;
 *  - les logos de la gamme cascadent (`stagger`, pas de 0,08 s).
 *  Jamais animés : la réserve AMF et sa RiskNote, le périmètre Trustpilot, le contre-poids des chiffres,
 *  la source, le disclaimer de la gamme et le paragraphe équilibré sur la rémunération.
 *  Aucun rideau ne la recouvre plus : la section suivante est la photo 03a-Immeuble (le rideau de 08-Risques
 *  recouvre désormais 08b-Presse, celui de 04-Stratégie recouvre 03-Frais).
 * Surtitre via SectionHeading (teal-200 sous l'ancêtre .text-white de la bande ink, AA). Dans la bande
 * white, NoteRef reçoit tone="light" car l'ancêtre Section porte text-white.
 * Notes (corum.notes, ordre de lecture) : cadre réglementaire (confiance-agrement), carte Société de gestion
 * (item.noteId → corum-agrement), réserve visa (confiance-visa), avis (confiance-trustpilot), chiffres
 * (confiance-chiffres), gamme (corum-gamme), rémunération (corum-compensation).
 * Contenu : src/content/fr/trust.ts et src/content/fr/corum.ts.
 */
import { Picture } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Stat from '@/components/ui/Stat.astro';
import { sections } from '@/config/sections';
import { resolveImage } from '@/lib/images';
import { corum } from '@/content/fr/corum';
import { media } from '@/content/fr/media';
import { trust } from '@/content/fr/trust';
import { product } from '@/content/fr/facts';

/** Ambiance des bureaux CORUM (11/09/2026) : la seule image de la page qui montre QUI gère. Décorative. */
const officePhoto = await resolveImage(media.corum[0].src);
const id = sections.corum.id;
const { trustpilot, stats } = trust;

/** Gamme en texte (décision du 09/09/2026 : seuls les logos R Start et CORUM L'Épargne sont utilisés sur le site). */
const range = corum.range.scpiNames.map((name) => ({ name, current: name === product.name }));

/** Décimales du compteur : 1 pour une valeur non entière (ex. 9,6), sinon aucune. */
const decimalsOf = (n?: number): number | undefined =>
  n === undefined || Number.isInteger(n) ? undefined : 1;
const hint = trustpilot.externalLinkHint;

/** Compteur Trustpilot : départ à 0, 1,4 s (une décimale via decimalsOf). */
const TRUSTPILOT_COUNTER = { from: 0, duration: 1.4 };
{
  /* Quatre chiffres fixes (11/09/2026) : plus de compteur — la largeur du nombre changeait pendant
            l'animation et décalait toute la grille. Une seule entrée en cascade sur la liste. */
}
const LOGO_STAGGER = 0.08;
/** Amplitude du fade-up d'un H3 suivi d'un paragraphe visible d'emblée (px), au lieu des 28 px d'un titre. */
const QUIET_TITLE_Y = 12;
---

<Section id={id} tone="ink" spacing="none">
  <!-- Bande ink : en-tête + cadre réglementaire -->
  <div class="py-section">
    <Container size="wide">
      {
        /* Zone 4 de la trame : en-tête de corum.ts (« L'expérience derrière R Start »), dont l'introduction porte
          l'avantage et son contre-poids dans la même phrase. trust.ts garde les cartes, chiffres et sources. */
      }
      <SectionHeading
        id={id}
        eyebrow={corum.eyebrow}
        title={corum.title}
        intro={corum.intro}
        motion
      />

      {
        /* Le cadre réglementaire (visa, agrément, dépositaire, autorité, SFDR) a quitté l'accueil le
          11/09/2026 : il vit sur /documentation (RegulatoryFrame.astro), avec les documents qu'il décrit.
          Le visa et l'agrément restent dans le pied de page, sur toutes les pages. */
      }
    </Container>
  </div>

  <!-- Bande white : avis clients + groupe CORUM -->
  <div class="bg-white py-section text-ink">
    <Container size="wide">
      <!-- Avis clients -->
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
        <h3 class="text-display-sm lg:col-span-12" data-animate="fade-up">
          {trustpilot.title}
          <NoteRef id="confiance-trustpilot" tone="light" />
        </h3>
        <!-- La note compte de 0 à sa valeur (seul effet du bloc). -->
        <div class="lg:col-span-12">
          <Stat
            value={trustpilot.scoreLabel}
            numeric={trustpilot.score}
            decimals={decimalsOf(trustpilot.score)}
            suffix={trustpilot.scoreSuffix}
            from={TRUSTPILOT_COUNTER.from}
            duration={TRUSTPILOT_COUNTER.duration}
            label={`${trustpilot.reviewsLabel} ${trustpilot.dateLabel}`}
          />
          <a
            href={trustpilot.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-teal-700 no-underline hover:text-navy hover:underline"
          >
            {trustpilot.linkLabel}
            {hint && <span class="visually-hidden">({hint})</span>}
            <svg
              aria-hidden="true"
              class="size-4"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path d="M4 12 12 4M6 4h6v6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        {
          /* La note de périmètre Trustpilot (« avis sur CORUM L'Épargne, distributeur… ne réduisent pas les
            risques ») a été retirée le 11/09/2026 (décision de l'équipe) ; le titre du bloc garde le périmètre
            (« Les avis sur CORUM L'Épargne ») et la note légale confiance-trustpilot reste appelée. Le bloc n'est
            donc plus marqué [data-advantage]. */
        }
      </div>

      <!-- Le groupe CORUM en chiffres -->
      <div class="mt-10 sm:mt-16 border-t border-mist pt-10 sm:pt-16 lg:mt-24 lg:pt-24">
        <h3 class="text-display-sm" data-animate="fade-up">
          {stats.title}
          <NoteRef id="confiance-chiffres" tone="light" />
        </h3>
        <!--
          Grille 2 × 2 sur 8/12 : en 4 colonnes, « 160 000 » en text-stat déborde de sa cellule (texte dégradé
          tronqué) ; sur 7/12, « 9,6 Md€ » (328 px à 1440 px) dépasse la cellule de 325 px et se replie sur deux lignes.
        -->
        <div class="mt-10 grid gap-10 lg:mt-12 lg:grid-cols-12 lg:gap-16">
          <!-- Les quatre chiffres comptent depuis 0, en place, avec une durée liée à leur ordre de grandeur. -->
          <ul
            role="list"
            class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:col-span-12 lg:grid-cols-4"
          >
            {
              stats.items.map((s) => (
                <li>
                  <Stat size="solid" value={s.value} suffix={s.suffix} label={s.label} />
                </li>
              ))
            }
          </ul>
          {
            /* Le contre-poids « Ces chiffres sont ceux du groupe CORUM… » et la ligne de source ont été retirés
              d'ici le 11/09/2026 (décision de l'équipe). Le rappel « cette expérience ne préjuge pas des résultats
              de R Start, qui n'a pas d'historique propre » reste porté par l'introduction de la section
              (corum.intro), dans le même chapitre. Les chiffres ne sont donc plus marqués [data-advantage]. */
          }
        </div>
      </div>

      {
        /* Photo d'ambiance des bureaux : respiration visuelle de la bande blanche, et seule image de la page
          qui illustre la société de gestion. Décorative — aucun avantage, donc aucun contre-poids attendu. */
      }
      <figure class="mt-16 lg:mt-24" data-animate="clip">
        <div class="img-frame aspect-[3/2] sm:aspect-[21/9]">
          <div
            class="absolute inset-x-0 -top-[12%] h-[124%]"
            data-parallax="0.05"
            data-parallax-trigger="parent"
          >
            <Picture
              src={officePhoto}
              alt={media.corum[0].alt}
              widths={[640, 1024, 1600, 2400]}
              sizes="(min-width: 80rem) 72rem, 100vw"
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
              pictureAttributes={{ class: 'block h-full w-full' }}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </figure>

      <!-- La gamme -->
      <div class="mt-10 sm:mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <!-- Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. -->
          <h3 class="text-display-sm" data-animate="fade-up" data-animate-y={String(QUIET_TITLE_Y)}>
            {corum.range.title}
            <NoteRef id="corum-gamme" tone="light" />
          </h3>
          <p class="mt-4 text-lead">{corum.range.description}</p>
        </div>
        <div class="lg:col-span-7">
          <ul
            role="list"
            class="grid grid-cols-2 gap-4 sm:grid-cols-3"
            data-animate="stagger"
            data-animate-stagger={String(LOGO_STAGGER)}
          >
            {
              range.map(({ name, current }) => (
                <li
                  class:list={[
                    'flex min-h-24 items-center justify-center rounded-2xl border p-5 text-center text-lg font-semibold sm:p-6',
                    current
                      ? 'border-teal-400 bg-teal-100 text-navy'
                      : 'border-mist bg-paper text-navy',
                  ]}
                  aria-current={current ? 'true' : undefined}
                >
                  <span class="flex flex-col items-center gap-1.5">
                    {current && corum.range.currentBadge && (
                      <span class="inline-flex items-center rounded-full bg-navy px-2.5 py-0.5 text-[0.7rem] font-semibold tracking-wider text-white uppercase">
                        {corum.range.currentBadge}
                      </span>
                    )}
                    <span>{name}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <RiskNote text={corum.disclaimer} size="lead" class="mt-6" />
        </div>
      </div>

      {
        /* « La rémunération de CORUM sur les ventes » a quitté l'accueil le 11/09/2026 : la zone 2
          (« Ce qui change vraiment », moteur 2 et son contre-poids) porte déjà le sujet, et /frais le détaille. */
      }
    </Container>
  </div>
</Section>
