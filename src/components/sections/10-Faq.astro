---
/**
 * Section 10, FAQ (id « faq »). Sur l'accueil, une sélection courte (faq.items, liste HOME_FAQ de
 * faq.ts) ; la FAQ complète a sa page, /faq, atteinte par `faq.moreLink`. AUCUN NOMBRE DE QUESTIONS
 * N'EST ÉCRIT DANS CES COMMENTAIRES : ils en donnaient quatre différents, tous périmés (audit du
 * 18/09/2026). Le compte est celui de faq.ts. Fond paper (après Risques, ink) ;
 * DERNIÈRE SECTION de l'accueil depuis le retrait du bloc « Notes et sources » (14/09/2026).
 * Deux colonnes sur grand écran : en-tête collant (surtitre, H2 en text-display-md : la FAQ clôt la page, un
 * cran sous les chapitres) face à la liste des questions en accordéons natifs <details name="faq"> (un
 * seul ouvert à la fois), chevron animé en CSS, questions en text-xl (text-display-sm dès sm : une question
 * longue tient sur deux lignes à 375 px), réponse en paragraphes text-lead. Le découpage des réponses
 * en avantage et contre-poids (`riskFrom`), que plus aucune question ne portait, a quitté le code le
 * 22/09/2026. Le CTA tunnel ferme la colonne des questions. Le JSON-LD FAQPage est émis par la
 * page (src/lib/seo.ts), pas ici.
 *
 * L'en-tête est rendu ici (et non par SectionHeading) pour poser les attributs motion sur le H2 ; le
 * surtitre est en teal-700 (AA sur paper).
 *
 * Motion (src/scripts/motion.ts, attributs seulement), même signature que 02-Highlights :
 *  - en-tête, dans son enveloppe collante (les attributs sont sur les enfants, jamais sur l'élément
 *    sticky) : H2 mot à mot (data-reveal-text, titre court) ;
 *  - questions : statiques (sobriété du 11/09/2026 : les <summary> entrant un à un formaient une cascade
 *    de plus de quatre éléments). Le mouvement de la FAQ est celui de l'accordéon (CSS ci-dessous) ;
 *  - chevron : rotation 180° et inversion des couleurs en CSS à l'ouverture (transform, couleurs) ;
 *  - ouverture / fermeture d'une réponse : transition de hauteur en CSS pur, sans JS, sur le pseudo-élément
 *    `::details-content` (grille `grid-template-rows` 0fr → 1fr sous `@supports selector(::details-content)`,
 *    `content-visibility` en transition discrète pour rester peint pendant la fermeture). L'enfant direct
 *    de <details> (.faq-answer, l'élément de grille) ne porte NI padding NI marge : avec `min-height: 0`,
 *    la rangée 0fr vaut alors exactement 0 px (un padding sur l'élément de grille lui donnait un plancher
 *    de 32-40 px : plateau puis saut de 40 px à la fin de chaque fermeture). L'espacement (pb, pl, space-y)
 *    est porté par un enfant intérieur. Aucune opacité ni transform sur la réponse : son texte est à
 *    opacité 1 à tout instant et, une fois la réponse ouverte, plus rien ne bouge. Navigateurs sans
 *    `::details-content` : ouverture instantanée native. Rien de tout cela en reduced-motion (@media).
 * Le <summary> a pour unique enfant un H3 (modèle de contenu de summary) : le numéro d'ordre et le
 * chevron y sont des spans décoratifs (aria-hidden). <summary> a un rôle interactif implicite : aucun
 * lien n'y est jamais imbriqué (violation d'accessibilité « nested-interactive », HTML invalide de
 * surcroît).
 * Contenu : src/content/fr/faq.ts.
 */
import { ancreQuestion } from '@/lib/ancre';
import { withBase } from '@/lib/href';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { faq } from '@/content/fr/faq';

/*
 * PARAMÉTRÉ LE 16/09/2026 pour servir aussi la page /faq, qui rend toutes les questions avec un champ
 * de recherche. Le composant lisait `faq.items` en dur. Le rendre paramétrable plutôt que le recopier :
 * l'accordéon et ses transitions `::details-content` sont écrits une fois, et les deux surfaces ne
 * peuvent pas diverger.
 */
interface Props {
  /** Questions à rendre. Par défaut la sélection courte de l'accueil (faq.items). */
  items?: typeof faq.allItems;
  /** Renvoi vers la FAQ complète. Masqué sur la page qui EST la FAQ complète. */
  showMoreLink?: boolean;
  /** Champ de recherche : seulement là où il y a assez de questions pour qu'il serve. */
  search?: boolean;
  /** Titre, remplaçable par la page hôte. Pas d'introduction depuis le 16/09/2026. */
  title?: string;
  tone?: 'paper' | 'white';
  /**
   * Révélation mot à mot du titre (`data-reveal-text`). À LAISSER À FALSE HORS DE L'ACCUEIL : cet
   * attribut figure dans BESOIN_GSAP (src/scripts/motion.ts) et suffit à faire télécharger les 45 Ko
   * de GSAP. tests/performance.spec.ts l'interdit sur les sous-pages, et c'est lui qui l'a attrapé
   * quand /faq est entrée dans la liste.
   */
  revealTitle?: boolean;
}
const {
  items: rendus = faq.items,
  showMoreLink = true,
  search = false,
  title = faq.title,
  tone = 'paper',
  revealTitle = true,
} = Astro.props as Props;

const id = sections.faq.id;
/** id du H2, référencé par aria-labelledby sur la section (convention de Section / SectionHeading). */
const titleId = id + '-title';
/*
 * RUBRIQUES (16/09/2026) : sur /faq, les questions sont groupées par rubrique. Le repère est posé
 * sur la PREMIÈRE question de chaque rubrique, dans son propre <li>, et non dans un sous-titre entre
 * deux listes : une liste coupée en morceaux casserait le comptage annoncé aux lecteurs d'écran, et le
 * filtre de recherche masque des <li>, pas des sections.
 * Les sélections courtes des autres pages ne les rendent pas : une poignée de questions n'a pas de plan.
 */
let rubriquePrecedente: string | undefined;
const items = rendus.map((item) => {
  const nouvelleRubrique = search && item.category && item.category !== rubriquePrecedente;
  if (item.category) rubriquePrecedente = item.category;
  return {
    ...item,
    rubrique: nouvelleRubrique ? item.category : undefined,
    /* Rubrique de CHAQUE question quand la liste se filtre : voir le commentaire du <li>. */
    categorie: search ? item.category : undefined,
  };
});
---

<Section id={id} tone={tone}>
  <Container size="wide">
    {
      /* En-tête PLEINE LARGEUR depuis le 11/09/2026 : dans sa colonne de cinq douzièmes, le titre ne
        pouvait pas prendre la taille commune aux autres sections sans se couper en quatre lignes. Il sort
        donc de la grille, comme partout ailleurs, et les questions occupent le reste. */
    }
    <header>
      <h2 id={titleId} class="text-display-lg text-balance" data-reveal-text={revealTitle || undefined}>
        {title}
      </h2>
    </header>

    <div class="mt-chapter grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Questions */}
      <div class="lg:col-span-8 lg:col-start-3">
        {
          /* CHAMP DE RECHERCHE (16/09/2026, page /faq). `type="search"` et non `text` : le navigateur
            y pose sa croix d'effacement et les lecteurs d'écran l'annoncent comme une recherche.
            Il FILTRE une liste déjà rendue, il n'interroge rien : toutes les questions sont dans le
            HTML, la page marche donc sans script, champ masqué comme les boutons « i ». */
        }
        {search && (
          <div class="mb-8" data-faq-recherche hidden>
            <label for={id + '-recherche'} class="text-caption font-semibold text-navy">
              {faq.searchLabel}
            </label>
            <input
              id={id + '-recherche'}
              type="search"
              autocomplete="off"
              placeholder={faq.searchPlaceholder}
              class="mt-2 block w-full rounded-full border border-navy/25 bg-white px-5 py-3 text-base text-ink transition-colors placeholder:text-slate-600 hover:border-navy/50 focus-visible:border-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy"
            />
            <p
              class="text-caption mt-2 text-slate-700"
              data-faq-compte
              data-gabarit={faq.searchCount}
              data-gabarit-un={faq.searchCountOne}
              data-vide={faq.searchEmpty}
              aria-live="polite"
            />
          </div>
        )}
        <ul role="list" aria-label={faq.listLabel} class="border-t border-navy/15" data-faq-liste>
          {
            items.map((item, i) => (
              <li class="border-b border-navy/15" data-rubrique={item.categorie}>
                {/* LE LIBELLÉ DE RUBRIQUE EST DANS CHAQUE <li>, masqué sauf sur la première question de la
                rubrique (audit du 18/09/2026). Il n'était que dans celle-ci, et le filtre masque des <li>
                entiers : dès que la première question d'une rubrique ne correspondait pas à la recherche,
                son libellé partait avec elle, et les suivantes s'affichaient sous l'intitulé de la
                rubrique PRÉCÉDENTE. Une réponse sur les frais rangée sous « Comprendre R Start ». Le
                script (faqSearch.ts) montre le libellé sur la première question VISIBLE de chaque
                rubrique. Sans script, le rendu ne change pas. */}
                {item.categorie && (
                  <p
                    class="text-eyebrow mt-10 mb-2 text-teal-700 first:mt-0"
                    data-faq-rubrique
                    hidden={!item.rubrique}
                  >
                    {item.categorie}
                  </p>
                )}
                {/* `id` : ancre de la question (src/lib/ancre.ts). Un résultat de la recherche du site
                  mène ici, et la question s'ouvre à l'arrivée (src/scripts/faqAncre.ts). */}
                <details
                  name="faq"
                  id={ancreQuestion(item.question)}
                  data-faq={item.question}
                  class="faq-item group"
                >
                  <summary class="block cursor-pointer list-none py-6 [&::-webkit-details-marker]:hidden sm:py-8">
                    <h3 class="flex items-start justify-between gap-5 text-xl font-semibold text-ink transition-colors duration-200 group-hover:text-navy sm:gap-8 sm:text-display-sm">
                      <span class="flex min-w-0 flex-col gap-2 sm:flex-row sm:gap-6">
                        <span
                          aria-hidden="true"
                          class="text-eyebrow pt-1.5 text-teal-700 tabular-nums sm:pt-2"
                        >
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span>{item.question}</span>
                      </span>
                      <span
                        aria-hidden="true"
                        class="faq-chevron mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-full border border-navy/40 text-navy transition-[transform,background-color,border-color,color] duration-300 ease-out-expo group-hover:border-navy group-hover:bg-navy group-hover:text-white group-open:rotate-180 group-open:border-navy group-open:bg-navy group-open:text-white motion-reduce:transition-none sm:mt-1 sm:size-12"
                      >
                        <svg
                          class="size-5 sm:size-6"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                        >
                          <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </h3>
                  </summary>
                  {/* .faq-answer = élément de la grille ::details-content : aucun padding ni marge ici (voir en-tête) */}
                  <div class="faq-answer">
                    <div class="max-w-3xl space-y-5 pb-8 sm:pb-10 sm:pl-12">
                      {item.answer.map((paragraph) => (
                        <p class="text-lead text-ink">
                          {paragraph}
                        </p>
                      ))}

                      {
                        /* Puces, puis tableau, puis conclusion : l'ordre du document de l'équipe.
                          La conclusion ne se lit qu'une fois le tableau vu, la mettre dans `answer`
                          l'aurait placée avant lui. */
                      }
                      {item.bullets && (
                        <ul role="list" class="space-y-2">
                          {item.bullets.map((puce) => (
                            <li class="flex items-start gap-3">
                              <span
                                aria-hidden="true"
                                class="mt-2.5 size-1.5 shrink-0 rounded-full bg-teal-700"
                              />
                              <span class="text-lead text-ink">{puce}</span>
                            </li>
                          ))}
                        </ul>
                      )}

                      {
                        /* VRAI TABLEAU, avec un en-tête de colonne : un barème de frais se lit aussi
                          au lecteur d'écran, et il doit pouvoir dire de quelle colonne vient chaque
                          valeur. Enveloppé dans un conteneur à défilement propre : à 390 px, deux
                          colonnes de texte peuvent dépasser, et c'est le tableau qui défile, jamais
                          la page. */
                      }
                      {item.table && (
                        <div class="-mx-1 overflow-x-auto px-1">
                          <table class="w-full min-w-[18rem] border-collapse text-left">
                            <thead>
                              <tr class="border-b border-navy/20">
                                {item.table.head.map((cellule) => (
                                  <th scope="col" class="py-3 pr-4 text-base font-semibold text-ink">
                                    {cellule}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody>
                              {item.table.rows.map((ligne) => (
                                <tr class="border-b border-navy/10 last:border-0">
                                  <th
                                    scope="row"
                                    class="py-3 pr-4 text-base font-normal text-slate-700"
                                  >
                                    {ligne[0]}
                                  </th>
                                  <td class="py-3 text-base font-semibold text-ink tabular-nums">
                                    {ligne[1]}
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      )}

                      {item.tableAfter?.map((paragraph) => (
                        <p class="text-lead text-ink">{paragraph}</p>
                      ))}
                    </div>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>

        {
          /* Le CTA de souscription qui fermait la FAQ est retiré (12/09/2026, demande de l'équipe) :
            la pastille flottante le porte désormais, de « Souscrire en 4 étapes » jusqu'au bas de la
            page, et il faisait doublon avec elle à quelques centaines de pixels d'intervalle.
            Le renvoi vers toutes les questions (/faq) reste, en LIEN et non en bouton : pas un appel à
            l'action, c'est la suite de la lecture. */
        }
        {
          showMoreLink && faq.moreLink && (
            <p class="mt-10 sm:mt-12">
              <a
                href={withBase(faq.moreLink.href)}
                class="link-underline inline-flex items-center gap-2 text-base font-semibold text-navy hover:text-teal-700 sm:text-lg"
              >
                {faq.moreLink.label}
                <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
              </a>
            </p>
          )
        }
      </div>
    </div>
  </Container>
</Section>

{
  /* L'ouverture animée de la réponse (`.faq-item::details-content`) vit dans global.css depuis le
    16/09/2026, sous « Accordéons » : la FAQ de /documentation (DocumentationFaq.astro) l'a en partage,
    au lieu d'un simple glissement sans hauteur animée. */
}

<script>
  /* Recherche interne de /faq : elle filtre la liste rendue, elle n'interroge rien. Le module ne fait
     rien sur les pages qui n'ont pas de champ, il sort au premier `querySelector` nul. */
  import '@/scripts/faqSearch';
  /* Question visée par l'ancre de l'adresse (/faq#question-…) : elle s'ouvre. */
  import '@/scripts/faqAncre';
</script>
