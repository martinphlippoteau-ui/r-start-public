---
/**
 * Section 8, Risques (id « risques »). Contre-poids global de la page : section pleine sur fond ink
 * avec le même poids typographique que les sections avantages (H2 text-display-lg, intro text-lead).
 * Six risques en grille (titre text-display-sm, description text-lead). Les avertissements reproduits
 * in extenso (bulletin de souscription, DIC, commission d'arbitrage) ont quitté cette section le
 * 11/09/2026 à la demande de l'équipe : ils sont désormais sur /documentation, à côté des documents
 * dont ils sont extraits (components/pages/documentation/MandatoryWarnings.astro).
 * Motion (src/scripts/motion.ts) :
 *  - transition de chapitre en rideau (`data-curtain` sur la section) : la section précédente, sur
 *    l'accueil « La presse en parle » (08b) depuis la trame du 10/09/2026 (src/pages/index.astro,
 *    HOME_ORDER), est épinglée quand son bas touche le bas du viewport pendant que cette section monte
 *    par-dessus (coins arrondis et ombre posés par la CSS `[data-curtain]`). Comme elle contient un
 *    [data-risk] (avertissement de la revue de presse), le moteur n'applique ni recul ni atténuation à
 *    la section recouverte : pin + recouvrement seuls ;
 *  - rien d'autre ne bouge (sobriété du 11/09/2026 : les six intitulés n'entrent plus en fade-up, le
 *    contre-poids global de la page est en place d'emblée) : ni le H2, ni l'intro, ni les six risques.
 * Sans JS ou en reduced-motion : aucun pin, aucun rideau, tout est visible et stable.
 * Contenu : src/content/fr/risks.ts (textes réglementaires reproduits à l'identique depuis legal.ts) ;
 * les appels de note des risques viennent du contenu (item.noteId).
 * Le surtitre est rendu ici en teal-200 (contraste AA sur ink) plutôt que par SectionHeading.
 */
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { sections } from '@/config/sections';
import { risks } from '@/content/fr/risks';

const id = sections.risks.id;
---

{
  /*
   * PLUS DE RIDEAU (14/09/2026) : « le bloc des risques apparaît trop tôt au scroll ».
   *
   * La règle d'emploi du rideau (src/scripts/motion/scroll.ts) prévoyait un seul rideau sur l'accueil,
   * celui-ci, POSÉ SUR 08b-Presse. Or 08b-Presse a quitté HOME_ORDER : la section qui précède est
   * maintenant 06-Souscrire, et le moteur épingle simplement `previousElementSibling`, sans savoir
   * laquelle c'est. Le rideau s'appliquait donc à une section qu'il n'a jamais visée.
   *
   * Mesuré sur 1440 × 900 : Souscrire fait 1 110 px, soit 1,23 écran. Son bas touche le bas du viewport
   * après 250 px de défilement seulement, l'épinglage se déclenche là, et les Risques commencent à
   * monter par-dessus dans la foulée. Le lecteur n'a jamais la section pour lui seul : à peine
   * encadrée, elle est déjà recouverte. Sans le rideau, Souscrire défile à son rythme et les Risques
   * arrivent normalement.
   *
   * Pour le rétablir : remettre 08b-Presse juste avant dans HOME_ORDER, ou n'appliquer le rideau que
   * si la section précédente tient dans un écran.
   */
}
<Section id={id} tone="ink">
  <Container size="wide" class="relative">
    <SectionHeading id={id} title={risks.title} intro={risks.intro} />

    <!-- Six risques, statiques : intitulé et description visibles d'emblée. -->
    <ul
      class="mt-10 sm:mt-16 grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:mt-24 lg:gap-x-16 lg:gap-y-16"
    >
      {
        risks.items.map((item) => (
          <li class="border-t border-white/25 pt-6 sm:pt-8">
            <h3 class="text-display-sm text-white">
              {item.title}
              {item.noteId && <NoteRef id={item.noteId} />}
            </h3>
            <p class="mt-4 text-lead text-white">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
