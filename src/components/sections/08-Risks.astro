---
/**
 * Section 8, Risques (id « risques »). Contre-poids global de la page : section pleine sur fond ink
 * avec le même poids typographique que les sections avantages (H2 text-display-lg, sans intro ni
 * surtitre), tout en sable. Rendue sur l'accueil, sur /strategie et, sans rideau, sur /a-propos.
 * Quatre risques en grille (titre text-display-sm, description text-base), puis un paragraphe de
 * clôture (`notice`, 24/09/2026, demande de Martin) dans le même corps. Les avertissements
 * reproduits in extenso (bulletin de souscription, DIC, commission d'arbitrage) ont quitté cette
 * section le 11/09/2026 à la demande de l'équipe : ils sont sur /documentation, à côté des
 * documents dont ils sont extraits (components/pages/documentation/MandatoryWarnings.astro).
 * PLAN (24/09/2026, demande de Martin) : le bloc passe SOUS la section claire qui le suit
 * (`sousPlan`, ui/Section.astro), qui mord dessus avec ses coins arrondis et son ombre ; son bord
 * haut reste droit sous la section qui le précède. Le
 * rideau (`data-curtain`, la section montant par-dessus la précédente épinglée) est coupé partout
 * depuis ce jour : il faisait l'inverse. Rien ne bouge, ni le H2 ni les quatre risques : le
 * contre-poids global de la page est en place d'emblée.
 * Contenu : src/content/fr/risks.ts (textes réglementaires reproduits à l'identique depuis legal.ts).
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { sections } from '@/config/sections';
import { risks } from '@/content/fr/risks';

const id = sections.risks.id;
/*
 * LE RIDEAU EST FACULTATIF : `data-curtain` est un attribut du moteur GSAP, et
 * tests/performance.spec.ts interdit GSAP sur cinq sous-pages, dont /a-propos (45 Ko pour une seule
 * transition). Une page qui doit rester sans GSAP passe `rideau={false}` : elle perd la transition
 * de chapitre, pas une ligne de contenu.
 */
interface Props {
  /** Rideau COUPÉ PARTOUT depuis le 24/09/2026 (demande de Martin : les sections sombres passent
      SOUS les claires) : il faisait monter ce bloc sombre par-dessus la section claire précédente.
      Le réglage reste, à `false`, au cas où. */
  rideau?: boolean;
  /** Recouvert par le bas par la section claire qui suit (ui/Section.astro `sous`), toujours. */
  sousPlan?: 'bas';
  /** Rend « Les performances passées ne préjugent pas… » (risks.pastPerformance) au-dessus du
      paragraphe de clôture : /strategie (24/09/2026, demande de Martin). */
  pastPerformance?: boolean;
}
const { rideau = false, sousPlan = 'bas', pastPerformance = false } = Astro.props as Props;

---

{
  /*
   * RIDEAU DÉCLENCHÉ PLUS TARD (14/09/2026, « le bloc des risques apparaît trop tôt au scroll »).
   * Le moteur épingle `previousElementSibling`, soit 06-Souscrire sur l'accueil, qui fait plus d'un
   * écran (1 110 px sur 1440 × 900). Avec le déclenchement par défaut, `bottom bottom`, l'épinglage
   * part dès que le bas de Souscrire touche le bas de l'écran, ce qui suppose qu'on l'a lue en
   * entier : vrai pour une section qui tient dans un écran, faux ici, les Risques montaient après
   * 250 px de défilement. `bottom center` repousse l'épinglage jusqu'à ce que le bas de Souscrire
   * atteigne le milieu de l'écran : elle défile normalement d'abord, le rideau ne couvre plus qu'un
   * demi-écran. Une section précédente qui tient dans un écran se contenterait de la valeur par
   * défaut.
   */
}
{
  /* MOINS DE VIDE (22/09/2026, demande de Martin : « réduire l'espace que prennent les blocs
    risques et disclaimers verticalement, pas sur la police, sur les espaces vides ») : marges de
    section compactes, liste et filets resserrés. Corps de texte inchangé. */
}
<Section
  id={id}
  tone="ink"
  spacing="compact"
  sous={sousPlan}
  data-curtain={rideau ? 'bottom center' : undefined}
>
  <Container size="wide" class="relative">
    {
      /* TOUT LE BLOC EN SABLE (16/09/2026, demande de l'équipe) : le titre par la classe passée à
        SectionHeading, dont le H2 hérite faute de couleur propre, les intitulés et les descriptions
        par leurs classes ci-dessous. Relevé à 11,54:1 sur le fond ink, contre 14,23 pour le blanc :
        très au-dessus des 4,5 exigés. */
    }
    <SectionHeading id={id} title={risks.title} intro={risks.intro} class="text-sand" />

    {/* Les risques, statiques : intitulé et description visibles d'emblée. */}
    <ul role="list"
      class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:mt-10 lg:gap-x-14 lg:gap-y-8"
    >
      {
        risks.items.map((item) => (
          <li class="border-t border-white/25 pt-5">
            <h3 class="text-display-sm text-sand">{item.title}</h3>
            {
              /* 16 PX FIXES ET INTERLIGNE RESSERRÉ (15/09/2026, demande de l'équipe) : en
                `text-lead`, les descriptions de risque prenaient deux écrans ; `text-base` les fixe
                à 16 px, `leading-snug` resserre à 1,375. Sable : contraste, voir plus haut.
                CE QUI NE CHANGE PAS : le titre du risque reste en `text-display-sm`, et les
                descriptions gardent le MÊME corps entre elles. Un risque affiché plus petit que ses
                voisins, ou plus petit que l'avantage qu'il contrebalance, est ce que l'AMF refuse ;
                ici aucun avantage ne partage cette section. */
            }
            <p class="mt-3 text-base leading-snug text-sand">{item.description}</p>
          </li>
        ))
      }
    </ul>
    {
      /* Paragraphe de clôture (24/09/2026, demande de Martin) : même corps et même couleur que les
        descriptions, même filet que les risques au-dessus, sur toute la largeur de la grille. */
    }
    {
      (risks.notice || (pastPerformance && risks.pastPerformance)) && (
        <div class="mt-6 border-t border-white/25 pt-5 text-base leading-snug text-sand lg:mt-8">
          {pastPerformance && risks.pastPerformance && <p>{risks.pastPerformance}</p>}
          {risks.notice && <p class:list={[pastPerformance && risks.pastPerformance && 'mt-3']}>{risks.notice}</p>}
        </div>
      )
    }
  </Container>
</Section>
