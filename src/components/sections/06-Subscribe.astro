---
/**
 * Section 6 — Souscrire (id « souscrire »). Deux rendus :
 *  - `compact` (accueil, trame du 11/09/2026 : entre Piliers 04 et La presse en parle 08b) : chapitre court
 *    qui raconte la souscription 100 % en ligne — surtitre, H2 `homeTitle`, `homeIntro`, le stepper des
 *    quatre étapes, puis le CTA. Le contre-poids qui suivait la liste (rappel du DIC, durée de placement,
 *    commission de retrait, rachat non garanti) a été retiré le 11/09/2026 à la demande de l'équipe ; la
 *    liste ne porte donc plus `data-advantage`, faute de contre-poids frère. Ni MyCORUM, ni options, ni
 *    « lisez le DIC » : ils vivent sur /documentation ;
 *  - complet (aucune page ne le rend aujourd'hui ; conservé pour réemploi) : le rendu historique ci-dessous.
 * Fond white. Le guide de souscription vit sur /documentation.
 * Stepper vertical en quatre étapes numérotées (liste ordonnée, ligne de progression) face au bloc
 * MyCORUM (application de suivi, capture officielle du store, icône, liens App Store et Google Play en
 * nouvel onglet ; il remplace la photo d'illustration depuis le 10/09/2026) — anciennement face à la photo
 * (collante sur grand écran), deux options facultatives en cartes (versements programmés avec le
 * minimum confirmé, réinvestissement des dividendes) rendues en paire avantage / risque, rappels
 * « lisez le DIC » et commission de retrait en RiskNote pleine largeur (jamais animés), puis le CTA
 * vers le tunnel de souscription. Les appels de note des étapes viennent du contenu (step.noteId).
 * Le surtitre est rendu ici en teal-700 (AA sur white) plutôt que par SectionHeading.
 * Motion (src/scripts/motion.ts) :
 *  - la ligne de progression du stepper est découpée en segments : chaque étape (sauf la dernière)
 *    porte un petit SVG vertical qui va du centre de sa pastille au centre de la suivante (hauteur
 *    100 % + espacement de la liste), tracé au fil du défilement (`data-draw` + `data-draw-scrub`, de
 *    « haut à 75 % » à « bas à 75 % » : la pointe du trait suit toujours la même hauteur d'écran et
 *    le tracé s'arrête exactement sur la dernière pastille). Dégradé continu navy → teal-700 →
 *    teal-500 (bornes de `text-brand-gradient`, lisibles sur white) réparti sur les segments : la
 *    pointe reste visible jusqu'au bout ;
 *  - chaque étape entre par `fade-up` à son arrivée dans le viewport, avec un léger décalage par rang
 *    (cascade si plusieurs entrent ensemble) : c'est le seul effet d'entrée de l'étape (sobriété du
 *    11/09/2026 : la pastille n'a plus son `scale`, un effet sur un bloc ET son contenu) ; la liste
 *    elle-même n'est pas animée : aucune révélation n'enveloppe un risque ;
 *  - en-tête : H2 mot à mot et introduction en fade-up (SectionHeading `motion`), surtitre statique ;
 *  - MyCORUM (complet) entre par `fade-up` ;
 *  - les options (complet) : chaque carte contient sa RiskPair, donc la carte elle-même n'est jamais animée ;
 *    seul son bloc titre + badge entre par un `fade-up` court (12 px, modèle 02-Highlights : l'avantage
 *    seul) — pas de `tilt`, réservé aux cartes entières ;
 *  - le CTA entre par `fade-up`. Les RiskNote restent intouchées.
 * Sans JS ou en reduced-motion : ligne dessinée, tout visible, rien ne bouge.
 * Contenu : src/content/fr/subscribe.ts (dont `app`). Le bloc MyCORUM dessine son téléphone en CSS :
 * plus aucune capture ni icône téléchargée depuis les magasins (AppMyCorum.astro).
 */
import Button from '@/components/ui/Button.astro';
import { Picture } from 'astro:assets';
import AppMyCorum from '@/components/AppMyCorum.astro';
import StoreBadge from '@/components/ui/StoreBadge.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import Pill from '@/components/ui/Pill.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import RiskPair from '@/components/ui/RiskPair.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { sections } from '@/config/sections';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';
import { subscribe } from '@/content/fr/subscribe';

interface Props {
  /** Accueil : chapitre court (en-tête, étapes, un contre-poids, CTA) ; sans lui, rendu complet. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
/**
 * Accueil (11/09/2026) : la photo d'immeuble laisse la place au téléphone affichant R Start — un parcours
 * 100 % en ligne se raconte mieux avec l'écran qu'avec une terrasse. C'est un visuel produit sur fond
 * clair : ni parallaxe, ni recadrage au centre, il serait coupé. Le cadre le rogne PAR LE BAS
 * (`object-top`, format 2/3) pour retirer les deux badges de magasins incrustés dans la photo : ils y
 * portent « Apple Store » et « Android Store », alors que les marques déposées sont « App Store » et
 * « Google Play ». À remplacer par un visuel corrigé avant mise en ligne.
 */
const photo = await resolveImage(media.app.src);
/** Les deux magasins, dans l'ordre du contenu (App Store puis Google Play). */
const stores = (subscribe.app?.stores ?? []).map((store, i) => ({
  ...store,
  platform: (i === 0 ? 'apple' : 'google') as 'apple' | 'google',
}));
/** Mention « nouvelle fenêtre » commune aux deux liens. */
const storeHintId = 'souscrire-stores-hint';

const id = sections.subscribe.id;
const title = compact && subscribe.homeTitle ? subscribe.homeTitle : subscribe.title;
const intro = compact && subscribe.homeIntro ? subscribe.homeIntro : subscribe.intro;
/** Contre-poids unique du chapitre court (≥ 60 % du texte cumulé des étapes, voir subscribe.ts). */
const OptionTitle = subscribe.optionsTitle ? 'h4' : 'h3';
/** Identifiant du dégradé SVG du segment de ligne d'une étape (unique dans la page). */
const lineGradientId = (i: number): string => `${id}-stepper-line-${i}`;
/**
 * Couleurs du dégradé de la ligne, une par pastille (la dernière est répétée au-delà) : le segment i va
 * de la couleur i à la couleur i + 1, ce qui donne un dégradé continu sur toute la ligne. Bornes de
 * `text-brand-gradient` (global.css) : teal-500 est la teinte la plus claire admise sur white.
 */
const LINE_COLORS = ['var(--color-navy)', 'var(--color-teal-700)', 'var(--color-teal-500)'];
const lineColor = (i: number): string => LINE_COLORS[Math.min(i, LINE_COLORS.length - 1)] as string;
const lastStep = subscribe.steps.length - 1;
/** Décalage de cascade entre deux étapes qui entreraient ensemble (secondes). */
const STEP_STAGGER = 0.06;
/** Décalage de cascade entre les deux cartes options (secondes). */
const OPTION_STAGGER = 0.1;
/** Amplitude du fade-up du bloc titre des options (px) : court, la carte autour est immobile. */
const OPTION_Y = 12;
---

<Section id={id} tone="white">
  <Container size="wide">
    <SectionHeading id={id} {title} {intro} motion />

    <!-- Compact : le stepper (avantage) et son contre-poids partagent ce parent ; complet : grille stepper / MyCORUM. -->
    <div
      data-subscribe-grid
      class:list={['mt-10 sm:mt-16 lg:mt-24', 'grid gap-12 lg:grid-cols-12 lg:gap-16']}
    >
      <!-- Stepper -->
      <ol
        aria-label={subscribe.stepsLabel}
        class:list={['relative space-y-10 sm:space-y-14', 'lg:col-span-7']}
      >
        {
          subscribe.steps.map((step, i) => (
            <li
              class="relative flex gap-5 sm:gap-8"
              data-animate="fade-up"
              data-animate-delay={String(i * STEP_STAGGER)}
            >
              {/* Segment de la ligne de progression : du centre de cette pastille (top-6) au centre de la suivante
                  (hauteur 100 % + espacement space-y-10 / sm:space-y-14 de la liste), tracé au scroll
                  (stroke-dashoffset), entièrement dessiné sans JS. Absent sur la dernière étape : la ligne s'y arrête. */}
              {i < lastStep && (
                <svg
                  aria-hidden="true"
                  class="pointer-events-none absolute top-6 left-6 h-[calc(100%+2.5rem)] w-px sm:h-[calc(100%+3.5rem)]"
                  width="1"
                  data-draw
                  data-draw-scrub
                  data-draw-start="top 75%"
                  data-draw-end="bottom 75%"
                >
                  <defs>
                    <linearGradient
                      id={lineGradientId(i)}
                      gradientUnits="userSpaceOnUse"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="100%"
                    >
                      <stop offset="0" style={`stop-color: ${lineColor(i)}`} />
                      <stop offset="1" style={`stop-color: ${lineColor(i + 1)}`} />
                    </linearGradient>
                  </defs>
                  <line
                    x1="0.5"
                    y1="0"
                    x2="0.5"
                    y2="100%"
                    stroke={`url(#${lineGradientId(i)})`}
                    stroke-width="1"
                  />
                </svg>
              )}
              <span
                aria-hidden="true"
                class="relative z-10 flex size-12 shrink-0 items-center justify-center rounded-full bg-navy text-lg font-bold text-white tabular-nums shadow-card ring-4 ring-white"
              >
                {i + 1}
              </span>
              <div class="pt-2">
                <h3 class="text-display-sm">
                  {subscribe.stepPrefix && (
                    <span class="visually-hidden">
                      {subscribe.stepPrefix} {i + 1} :{' '}
                    </span>
                  )}
                  {step.title}
                  {step.noteId && <NoteRef id={step.noteId} />}
                </h3>
                <p class="mt-3 max-w-xl text-base leading-relaxed sm:text-lg">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>

      {
        /* Le contre-poids des étapes (rappel du DIC, durée de placement, commission de retrait) a été
          retiré de l'accueil le 11/09/2026 à la demande de l'équipe. La liste ne porte donc plus
          `data-advantage` : sans contre-poids frère, le marquage serait faux et le contrôle d'équilibre
          AMF (tests/conformite.spec.ts) le refuserait. Les risques restent portés par la ligne du hero et
          par la section Risques ; le rappel complet vit sur /documentation. */
      }

      {
        /* Accueil : photo d'illustration à droite des étapes (11/09/2026, la page manquait d'images).
          Purement décorative pour la conformité : elle ne porte aucun avantage. */
        compact && (
          <figure
            class="mx-auto w-full max-w-[18rem] self-start sm:max-w-[22rem] lg:sticky lg:top-24 lg:col-span-5 lg:max-w-none"
            data-animate="clip"
          >
            <div class="photo-fade aspect-[2/3]">
              <Picture
                src={photo}
                alt={media.app.alt}
                widths={[420, 640, 900]}
                sizes="(min-width: 64rem) 26rem, 100vw"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
                pictureAttributes={{ class: 'block h-full w-full' }}
                class="h-full w-full object-cover object-top"
              />
            </div>

            {
              /* Les deux magasins sous le visuel : ce sont de vrais liens vers les fiches MyCORUM
                (src/content/fr/subscribe.ts). Ils remplacent les badges incrustés dans la photo, que le
                recadrage retire — ceux-là portaient des noms de marque erronés. */
              subscribe.app?.stores && (
                <figcaption class="mt-4">
                  <span id={storeHintId} hidden>
                    {subscribe.app.newTabHint}
                  </span>
                  <ul
                    role="list"
                    aria-label={subscribe.app.storesLabel}
                    class="flex flex-wrap justify-center gap-3"
                  >
                    {stores.map((store) => (
                      <li>
                        <StoreBadge
                          store={store.platform}
                          href={store.href}
                          label={store.label}
                          hintId={storeHintId}
                        />
                      </li>
                    ))}
                  </ul>
                </figcaption>
              )
            }
          </figure>
        )
      }

      <!-- Application MyCORUM (complet ; à la place de la photo d'illustration, 10/09/2026) -->
      {
        !compact && subscribe.app && (
          <aside
            class="self-start lg:sticky lg:top-24 lg:col-span-5"
            aria-labelledby="mycorum-app-title"
            data-animate="fade-up"
          >
            <AppMyCorum />
          </aside>
        )
      }
    </div>

    {
      !compact && (
        <Fragment>
          {/* Options facultatives */}
          <div class="mt-10 sm:mt-16 lg:mt-24">
            {subscribe.optionsTitle && (
              <h3 class="text-display-sm" data-animate="fade-up">
                {subscribe.optionsTitle}
                <NoteRef id="souscrire-non-eligible" />
              </h3>
            )}
            {/* Chaque carte contient sa RiskPair : la carte n'est jamais animée, seul son bloc titre entre (fade-up court). */}
            <ul class="mt-8 grid gap-6 sm:grid-cols-2">
              {subscribe.options.map((option, i) => (
                <Card as="li" tone="paper" class="lg:p-10">
                  <div
                    class="flex flex-wrap items-center gap-x-4 gap-y-2"
                    data-animate="fade-up"
                    data-animate-y={String(OPTION_Y)}
                    data-animate-delay={String(i * OPTION_STAGGER)}
                  >
                    <OptionTitle class="text-xl font-semibold tracking-tight sm:text-2xl">
                      {option.title}
                    </OptionTitle>
                    {option.badge && <Pill tone="teal">{option.badge}</Pill>}
                  </div>
                  {option.risk ? (
                    <RiskPair advantage={option.description} risk={option.risk} class="mt-4" />
                  ) : (
                    <p class="mt-4 text-base leading-relaxed">{option.description}</p>
                  )}
                </Card>
              ))}
            </ul>
          </div>

          {/* Avant de souscrire (jamais animé) */}
          <div class="mt-10 sm:mt-16 rounded-3xl bg-paper p-6 sm:p-10 lg:mt-24 lg:p-12">
            <div class="divide-y divide-mist">
              <RiskNote text={subscribe.beforeYouSubscribe} size="lead" class="pb-6 sm:pb-8" />
              <RiskNote text={subscribe.withdrawalReminder} size="lead" class="pt-6 sm:pt-8" />
            </div>
          </div>
        </Fragment>
      )
    }

    <!-- CTA -->
    <div
      class="mt-10 flex flex-col items-stretch sm:mt-12 sm:flex-row sm:items-center"
      data-animate="fade-up"
    >
      <Button position={subscribe.cta.position} variant="primary" size="lg"
        >{subscribe.cta.label}</Button
      >
    </div>
  </Container>
</Section>
