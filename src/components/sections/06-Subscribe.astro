---
/**
 * Section 6, Souscrire (id « souscrire »), sur l'accueil (trame du 11/09/2026 ; dans HOME_ORDER, entre
 * la bande 03a-Immeuble et Risques 08). Chapitre court qui raconte la souscription 100 % en ligne : H2,
 * le stepper des quatre étapes et son CTA, face au visuel de l'application et aux liens des deux
 * magasins. Pas d'introduction (retirée le 14/09/2026). Le contre-poids qui suivait la liste (rappel du
 * DIC, durée de placement, commission de retrait, rachat non garanti) a été retiré le 11/09/2026 à la
 * demande de l'équipe. Le guide de souscription et le bloc MyCORUM complet vivent sur /documentation.
 * LE RENDU COMPLET (introduction, options facultatives, rappels « lisez le DIC » et commission de
 * retrait), qu'aucune page n'affichait plus, a quitté le code le 22/09/2026 avec Pill et RiskPair ; ses
 * textes sont archivés hors du dépôt (.claude/audits).
 * Fond white.
 * Motion (src/scripts/motion.ts) :
 *  - la ligne de progression du stepper est découpée en segments : chaque étape (sauf la dernière)
 *    porte un petit SVG vertical qui va du centre de sa pastille au centre de la suivante (hauteur
 *    100 % + espacement de la liste), tracé au fil du défilement (`data-draw` + `data-draw-scrub`, de
 *    « haut à 75 % » à « bas à 75 % » : la pointe du trait suit toujours la même hauteur d'écran et
 *    le tracé s'arrête exactement sur la dernière pastille). Dégradé continu navy → teal-700 →
 *    teal-500 réparti sur les segments : la pointe reste visible jusqu'au bout ;
 *  - chaque étape entre par `fade-up` à son arrivée dans le viewport, avec un léger décalage par rang
 *    (cascade si plusieurs entrent ensemble) : c'est le seul effet d'entrée de l'étape (sobriété du
 *    11/09/2026 : la pastille n'a plus son `scale`, un effet sur un bloc ET son contenu) ; la liste
 *    elle-même n'est pas animée : aucune révélation n'enveloppe un risque ;
 *  - en-tête : H2 mot à mot (SectionHeading `motion`) ;
 *  - le CTA, dans la liste depuis le 15/09/2026, n'a pas d'effet d'entrée propre.
 * Sans JS ou en reduced-motion : ligne dessinée, tout visible, rien ne bouge.
 * Contenu : src/content/fr/subscribe.ts (dont `app`).
 */
import { Picture } from 'astro:assets';
import StoreBadge from '@/components/ui/StoreBadge.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { sections } from '@/config/sections';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';
import { subscribe } from '@/content/fr/subscribe';

/**
 * Accueil (11/09/2026) : la photo d'immeuble laisse la place au téléphone affichant R Start, un parcours
 * 100 % en ligne se raconte mieux avec l'écran qu'avec une terrasse.
 * Le visuel est un PNG DÉTOURÉ : il n'a pas de fond, donc ni cadre, ni masque de fondu, ni recadrage ,
 * ses bords sont la silhouette du téléphone, et un masque y mordrait.
 * Largeur bornée à 19 rem sur grand écran (11/09/2026) pour que le BAS DES BADGES tombe sur la dernière
 * étape : le visuel mesure 1,586 fois sa largeur, plus 16 px d'écart et 46 px de badges, à caler sur les
 * 559 px que couvrent les quatre étapes. Le téléphone démarre un peu plus bas que l'étape 1 : le fichier
 * porte 10,6 % de marge transparente en haut, que seule une marge négative effacerait, elle ferait
 * remonter le visuel sur l'introduction. La source ne fait de toute façon que 338 px de large.
 */
const photo = await resolveImage(media.app.src);
/** Les deux magasins, dans l'ordre du contenu (App Store puis Google Play). */
const stores = (subscribe.app?.stores ?? []).map((store, i) => ({
  ...store,
  platform: (i === 0 ? 'apple' : 'google') as 'apple' | 'google',
}));
/** Mention « nouvelle fenêtre » commune aux deux liens. */
const storeHintId = 'souscrire-stores-hint';

const id = sections.subscribe.id;
const title = subscribe.title;
/** Identifiant du dégradé SVG du segment de ligne d'une étape (unique dans la page). */
const lineGradientId = (i: number): string => `${id}-stepper-line-${i}`;
/**
 * Couleurs du dégradé de la ligne, une par pastille (la dernière est répétée au-delà) : le segment i va
 * de la couleur i à la couleur i + 1, ce qui donne un dégradé continu sur toute la ligne. teal-500 est
 * la teinte la plus claire admise sur white.
 */
const LINE_COLORS = ['var(--color-navy)', 'var(--color-teal-700)', 'var(--color-teal-500)'];
const lineColor = (i: number): string => LINE_COLORS[Math.min(i, LINE_COLORS.length - 1)] as string;
const lastStep = subscribe.steps.length - 1;
/** Décalage de cascade entre deux étapes qui entreraient ensemble (secondes). */
const STEP_STAGGER = 0.06;
---

<Section id={id} tone="white">
  <Container size="wide">
    <SectionHeading id={id} {title} motion />

    {/* Grille : le stepper, face au visuel de l'application. */}
    <div class="mt-10 sm:mt-16 lg:mt-24 grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Stepper */}
      <ol role="list"
        aria-label={subscribe.stepsLabel}
        class="relative space-y-10 sm:space-y-14 lg:col-span-7"
      >
        {
          subscribe.steps.map((step, i) => (
            <li
              class="relative flex gap-5 sm:gap-8"
              data-animate="fade-up"
              data-animate-delay={String(i * STEP_STAGGER)}
            >
              {/* Segment de la ligne de progression : du centre de cette pastille (top-6) au centre de la suivante
                  (hauteur 100 % + espacement space-y-10 / sm:space-y-14 de la liste), tracé au scroll
                  (stroke-dashoffset), entièrement dessiné sans JS. Absent sur la dernière étape : la ligne s'y arrête. */}
              {i < lastStep && (
                <svg
                  aria-hidden="true"
                  class="pointer-events-none absolute top-6 left-6 h-[calc(100%+2.5rem)] w-px sm:h-[calc(100%+3.5rem)]"
                  width="1"
                  data-draw
                  data-draw-scrub
                  data-draw-start="top 75%"
                  data-draw-end="bottom 75%"
                >
                  <defs>
                    <linearGradient
                      id={lineGradientId(i)}
                      gradientUnits="userSpaceOnUse"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="100%"
                    >
                      <stop offset="0" style={`stop-color: ${lineColor(i)}`} />
                      <stop offset="1" style={`stop-color: ${lineColor(i + 1)}`} />
                    </linearGradient>
                  </defs>
                  <line
                    x1="0.5"
                    y1="0"
                    x2="0.5"
                    y2="100%"
                    stroke={`url(#${lineGradientId(i)})`}
                    stroke-width="1"
                  />
                </svg>
              )}
              <span
                aria-hidden="true"
                class="relative z-10 flex size-12 shrink-0 items-center justify-center rounded-full bg-navy text-lg font-bold text-white tabular-nums shadow-card ring-4 ring-white"
              >
                {i + 1}
              </span>
              <div class="pt-2.5">
                <h3 class="text-display-sm max-w-xl">
                  {subscribe.stepPrefix && (
                    <span class="visually-hidden">
                      {subscribe.stepPrefix} {i + 1} :{' '}
                    </span>
                  )}
                  {step.title}
                </h3>
              </div>
            </li>
          ))
        }
        {
          /* APPEL À L'ACTION APRÈS LES ÉTAPES (15/09/2026, demande de l'équipe). `primary` : celui-ci
            mène au tunnel de souscription, contrairement aux appels secondaires des sections
            précédentes, et il arrive au terme du parcours qu'il conclut.
            Il porte `position` : c'est ce qui le rattache au plan de taggage, comme les autres CTA de
            souscription, et ce qui lui fait ouvrir la fenêtre d'attente tant que le tunnel n'est pas
            ouvert (tests/qualite.spec.ts le vérifie sur tous les CTA de souscription).
            DANS la liste plutôt qu'après elle : la colonne de droite porte la photo en `lg:sticky`, un
            frère de la liste se placerait sous elle et non sous les étapes. */
        }
        <li class="mt-12 list-none">
          <Button position={subscribe.cta.position} variant="primary" size="lg">
            {subscribe.cta.label}
          </Button>
        </li>
      </ol>

      {
        /* Le contre-poids des étapes (rappel du DIC, durée de placement, commission de retrait) a été
          retiré de l'accueil le 11/09/2026 à la demande de l'équipe. Les risques restent portés par la
          section Risques ; le rappel complet vit sur /documentation. */
      }

      {
        /* Photo d'illustration à droite des étapes (11/09/2026, la page manquait d'images).
          Purement décorative pour la conformité : elle ne porte aucun avantage. */
      }
      <figure
        class="mx-auto w-full max-w-[18rem] self-start sm:max-w-[20rem] lg:sticky lg:top-24 lg:col-span-5 lg:max-w-[19rem]"
        data-animate="clip"
      >
        <Picture
          src={photo}
          alt={media.app.alt}
          widths={[338, 676]}
          sizes="(min-width: 64rem) 24rem, 18rem"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
          pictureAttributes={{ class: 'block' }}
          class="mx-auto h-auto w-full"
        />

        {
          /* Les deux magasins sous le visuel : ce sont de vrais liens vers les fiches MyCORUM
            (src/content/fr/subscribe.ts). Ils remplacent les badges incrustés dans la photo, que le
            recadrage retire, ceux-là portaient des noms de marque erronés. */
          subscribe.app?.stores && (
            <figcaption class="mt-4">
              <span id={storeHintId} hidden>
                {subscribe.app.newTabHint}
              </span>
              <ul
                role="list"
                aria-label={subscribe.app.storesLabel}
                class="flex flex-wrap justify-center gap-3"
              >
                {stores.map((store) => (
                  <li>
                    <StoreBadge
                      store={store.platform}
                      href={store.href}
                      label={store.label}
                      hintId={storeHintId}
                    />
                  </li>
                ))}
              </ul>
            </figcaption>
          )
        }
      </figure>
    </div>

    {
      /* Le CTA qui fermait la section est retiré (12/09/2026, demande de l'équipe) : la pastille
        flottante le porte désormais, et elle apparaît précisément à l'arrivée de cette section. Deux
        boutons identiques à quelques centaines de pixels l'un de l'autre ne servaient qu'à se
        concurrencer. */
    }
  </Container>
</Section>
