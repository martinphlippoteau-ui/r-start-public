---
/**
 * Stratégie d'investissement : QUATRE sections, rendues uniquement par /strategie.
 *
 * REFONTE DU 14/09/2026. L'équipe a fourni le texte exact de la page, « ni plus ni moins ». Elle en
 * comptait cinq (mot d'ordre, deux leviers, trois piliers, zone + types d'actifs, effet de levier),
 * elle en compte quatre, ceux du document (le « Comment » est arrivé après les trois autres) :
 *  1. #strategie (paper) les deux moteurs de performance, numérotés, puis la phrase de méthode ;
 *  2. #quoi      (white) le double potentiel visé, puis la bande de trois photos d'immeubles ;
 *  3. #ou        (ink)   la zone d'investissement à gauche, le globe en rotation à droite ;
 *  4. #comment   (paper) la méthode d'achat en trois temps, et le mot de la fin.
 * La zone « Comment » est arrivée le 14/09/2026, après les trois autres : les images du document
 * fourni étaient coupées, elle n'y figurait pas.
 * Ce qui a disparu avec elles : le mot d'ordre en scène épinglée, les piliers et leurs pictos, la
 * CARTE (elle montrait le Conseil de l'Europe et le Canada, la page dit désormais « partout dans le
 * monde » : elle disait le contraire du texte), les pastilles de types d'actifs, l'effet de levier et
 * les quatre appels de note.
 *
 * FONDS. Un seul bloc sombre, le dernier. L'en-tête de la page est déjà sombre : une première section
 * ink enchaînerait deux pavés sombres sans coupure, et un test l'interdit sur toutes les sous-pages.
 * Le ton ink ferme ici la page au lieu de l'ouvrir, et porte la phrase la plus courte du document.
 *
 * UNE SEULE MENTION DE RISQUE, en fin de zone 2 : celle que la Conformité a placée elle-même le
 * 14/09/2026, rendue par ui/NoteConformite.astro et non par RiskNote, qui ne rend plus rien. L'en-tête
 * n'en porte plus. D'où l'absence de [data-advantage] et de RiskNote dans le reste de la page.
 *
 * Motion (src/scripts/motion.ts, tout par attributs) : aucun rideau, la section suit directement
 * l'en-tête ; H2 du premier chapitre mot à mot (data-reveal-text), les deux autres en
 * fade-up court ; filets qui s'étirent (data-draw="width") ; listes en cascade ; photos en cascade
 * avec parallaxe de sens alterné dans chaque cadre (élément surdimensionné de ±12 % pour ne jamais
 * découvrir le bord).
 * Contenu : src/content/fr/strategy.ts. Plus aucune photo depuis le 16/09/2026 : les deux moteurs et
 * les trois tuiles sont illustrés par des dessins animés, chacun dans son propre composant.
 * Aucune prop : la section n'appelle plus de note, elle n'a plus besoin du registre de la page.
 */
import Container from '@/components/ui/Container.astro';
import NoteConformite from '@/components/ui/NoteConformite.astro';
import Picto from '@/components/ui/Picto.astro';
import Section from '@/components/ui/Section.astro';
import EngineGain from '@/components/EngineGain.astro';
import EngineRent from '@/components/EngineRent.astro';
import StrategyDiversify from '@/components/StrategyDiversify.astro';
import StrategySelect from '@/components/StrategySelect.astro';
import StrategyTiming from '@/components/StrategyTiming.astro';
import { sections } from '@/config/sections';
import { strategy } from '@/content/fr/strategy';

const id = sections.strategy.id;
/** Ancres des deux autres chapitres (ids HTML, pas les textes affichés). */
const ids = { what: 'quoi', where: 'ou', how: 'comment' };

/** Une illustration par moteur, dans l'ordre des items de `strategy.engines`. */
/**
 * Les trois photos portent la même mention (« Photo d'illustration. Immeuble non détenu par R Start. ») :
 * une seule légende sous la bande suffit. Répétée trois fois côte à côte, elle occupait trois colonnes
 * pour dire la même chose. Si les crédits diffèrent un jour, chaque photo reprend le sien.
 */
/** Parallaxe des trois photos : douce, sens alterné (haut, bas, haut) ; cadres surdimensionnés de ±12 %. */
/** Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. */
const QUIET_TITLE_Y = 12;
---

{/* 1. Les deux moteurs de performance */}
<Section id={id} tone="paper" class="overflow-hidden">
  <Container size="wide">
    <header class="max-w-5xl">
      <h2 id={id + '-title'} class="text-display-lg text-ink" data-reveal-text>
        {strategy.engines.title}
      </h2>
    </header>

    <ul
      role="list"
      class="mt-chapter grid gap-8 sm:grid-cols-2 lg:gap-12"
      data-animate="stagger"
      data-animate-stagger="0.12"
    >
      {
        /*
         * CARTES ILLUSTRÉES depuis le 15/09/2026 (« créer des cards différentes avec des illustrations
         * pour illustrer »). Avant : un filet, un numéro, deux lignes de texte, à même le fond.
         * DESSINS ANIMÉS depuis le 16/09/2026, à la place des deux photos d'illustration : les deux
         * moteurs rejoignent la grammaire des trois tuiles de la sélection, trait clair sur fond ink.
         * Une photo de rue commerçante montrait un décor ; le dessin montre le MÉCANISME, et la
         * différence entre les deux moteurs se lit alors sans passer par les textes : flux régulier
         * d'un côté, échange ponctuel de l'autre.
         * Le bandeau garde le rapport 2,36, celui des illustrations qu'il remplace : les deux dessins
         * sont tracés dans un viewBox 236 × 100, le cadre de la carte ne bouge pas.
         * Le numéro reste SUR le bandeau, dans une pastille : sous lui, il répétait le rôle du filet
         * qu'il remplace, et la carte commençait par deux lignes de service avant son titre.
         */
      }
      {
        strategy.engines.items.map((item, i) => (
          <li class="card-lift flex flex-col overflow-hidden rounded-3xl bg-white shadow-card ring-1 ring-navy/5">
            <div class="relative aspect-[236/100] overflow-hidden bg-ink">
              {i === 0 && <EngineRent />}
              {i === 1 && <EngineGain />}
              <p
                class="text-caption absolute left-4 top-4 flex size-10 items-center justify-center rounded-full bg-white/95 font-semibold tabular-nums text-teal-700 shadow-card"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </p>
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <p class="text-display-sm text-navy">{item.lead}</p>
              {item.rest && <p class="text-lead mt-3 text-slate-700">{item.rest}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      /* La phrase de méthode ferme le chapitre : elle explique ce que les deux moteurs supposent de
        travail. Détachée par un filet plein largeur, dans la taille des introductions. */
    }
    {
      /* La phrase de méthode fermait ce chapitre ; elle ouvre maintenant « Tout commence par le
        choix des immeubles » (16/09/2026). Le rendu reste, conditionnel : si la Conformité ou
        l'équipe redonnent une chute aux deux moteurs, elle s'affichera sans rien changer ici. */
    }
    {strategy.engines.outro && (
      <p
      class="text-lead mt-12 max-w-4xl border-t border-navy/15 pt-8 text-pretty text-slate-700 lg:mt-16"
      data-animate="fade-up"
      data-animate-y={String(QUIET_TITLE_Y)}
    >
      {strategy.engines.outro}
    </p>
    )}

    {
      /* Mention de la Conformité, jamais animée : un avertissement ne dépend pas d'un défilement pour
        apparaître. Elle referme la zone, sous la phrase de méthode qu'elle qualifie. */
    }
    {
      strategy.engines.disclaimer && (
        <NoteConformite text={strategy.engines.disclaimer} class="mt-8 max-w-4xl" />
      )
    }
  </Container>
</Section>

{/* 2. Quoi : le double potentiel visé, illustré par les immeubles */}
{
  /*
   * TUILES À FENÊTRE (16/09/2026, demande de l'équipe : « j'aime bien le format de card sur le site
   * d'Apple qui ouvre une popup pour le contenu »). Elles remplacent trois cartes qui déroulaient tout
   * leur contenu : la page s'ouvre maintenant sur trois tuiles qui se lisent d'un coup d'œil, et le
   * détail vient à la demande.
   *
   * AUCUN TEXTE N'EST AJOUTÉ NI RETIRÉ par la fusion, la répartition change seulement : la tuile porte
   * le surtitre et le titre, la fenêtre porte l'introduction, la phrase d'annonce, la liste et la chute.
   * Les trois titres étaient des H2 ; ils sont passés en H3 le 16/09/2026, quand l'équipe a demandé un
   * titre commun au-dessus des trois volets (« Une approche en 3 volets pour les alimenter »), qui
   * prend le rang H2. C'est le seul texte ajouté à ce bloc depuis la fusion.
   *
   * SANS JAVASCRIPT, TOUT RESTE LISIBLE : le détail est écrit dans le flux, sous sa tuile, et le
   * bouton d'ouverture arrive `hidden`. Le script inverse les deux (src/scripts/carteDialog.ts). C'est
   * la seule façon de faire une fenêtre sans perdre les deux tiers du propos pour qui n'exécute pas de
   * script.
   *
   * FOND INK sur les trois. Le globe était sur blanc depuis la fusion et s'y lisait mal : c'est un
   * dessin au trait clair, il lui faut un fond sombre, celui qu'il avait avant. Les tuiles sombres sur
   * la section claire donnent au passage le contraste que trois cartes blanches sur blanc n'avaient
   * pas.
   */
}
<Section id={ids.what} tone="paper" labelledBy="volets-title">
  <Container size="wide">
    {
      /*
       * EN-TÊTE DU BLOC (16/09/2026, demande de l'équipe). Les trois tuiles n'en avaient pas : la
       * section empruntait son nom au premier volet, dont le H2 portait l'identifiant attendu par
       * <Section>. Elle a maintenant son titre, et `labelledBy` le désigne explicitement.
       * LES TROIS TITRES DE VOLET PASSENT DONC EN H3 : sous un H2 qui les annonce, trois H2 de même
       * rang auraient fait quatre sections de même niveau dans le plan du document. Leurs
       * identifiants ne bougent pas, ce sont eux qui servent d'ancres.
       */
    }
    <header class="max-w-5xl">
      <h2
        id="volets-title"
        class="text-display-lg text-ink"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {strategy.tilesTitle}
      </h2>
    </header>

    {
      /*
       * ENTRÉE DES TUILES, reprise le 16/09/2026 (« j'aimerais que ce soit plus spectaculaire »).
       * Elles montaient de 20 px en fondu, décalées d'un dixième de seconde : à trois tuiles côte à
       * côte, l'effet se voyait à peine.
       * `tilt` les fait maintenant basculer en perspective ; la distance passe à 44 px et le décalage
       * à 0,16 s, assez pour que les trois arrivent l'une après l'autre au lieu d'ensemble.
       * Le moteur léger suffit, aucun GSAP n'est tiré sur cette page (tests/performance.spec.ts), et
       * `prefers-reduced-motion` coupe tout dans le moteur lui-même.
       */
    }
    <ul
      role="list"
      class="mt-chapter grid gap-4 sm:gap-5 lg:grid-cols-3"
      data-animate="stagger"
      data-animate-child="tilt"
      data-animate-stagger="0.16"
      data-animate-y="44"
    >
      {
        [strategy.what, strategy.where, strategy.how].map((zone, z) => {
          const ancre = [ids.what, ids.where, ids.how][z];
          /* La PERSPECTIVE est portée par le <li> et non par la carte : une `perspective` posée sur
             l'élément qui tourne lui-même n'a aucun effet, le point de fuite doit venir du parent.
             Sans elle, le retournement n'est qu'une compression horizontale. */
          return (
            <li class="[perspective:1400px]">
              <article class="carte-face relative flex min-h-[20rem] flex-col overflow-hidden rounded-3xl bg-ink p-6 text-white sm:min-h-[24rem] sm:p-8">
                {zone.eyebrow && <p class="text-eyebrow text-teal-200">{zone.eyebrow}</p>}
                <h3 id={ancre + '-title'} class="text-display-sm mt-3 max-w-[16rem] text-sand">
                  {zone.title}
                </h3>

                {
                  /* UNE ILLUSTRATION PAR TUILE (16/09/2026). Le globe n'en avait plus qu'une sur trois,
                    les deux autres restaient nues. Les trois sont maintenant dans la même grammaire :
                    dessin au trait clair sur fond ink, carré, calé sur la largeur de la tuile, animé
                    en boucle lente et coupé en `prefers-reduced-motion`.
                    Les trois sont des SVG. Le globe en canvas a été retiré le 16/09/2026 : il ne
                    montrait que la moitié du propos de sa tuile, qui parle de secteurs autant que de
                    géographie. Son fichier reste au dépôt, il n'est simplement plus appelé.
                    Bornées à 11rem : en `aspect-ratio: 1`, elles pousseraient sinon la tuile hors de
                    sa rangée. */
                }
                <div class="mx-auto mt-4 w-full max-w-[11rem]">
                  {z === 0 && <StrategySelect />}
                  {z === 1 && <StrategyDiversify />}
                  {z === 2 && <StrategyTiming />}
                </div>

                {
                  /*
                   * « EN SAVOIR PLUS » EN TOUTES LETTRES depuis le 16/09/2026, demande de l'équipe.
                   * C'était un « + » rond : le libellé n'existait que pour les lecteurs d'écran, et un
                   * visiteur voyant devait deviner qu'il y avait quelque chose derrière.
                   * Le titre de la tuile reste lu, mais hors écran : à l'écran les trois boutons
                   * portent le même texte, ce qui est juste puisqu'on lit la tuile au-dessus ; pour un
                   * lecteur d'écran qui parcourt les boutons hors contexte, trois « En savoir plus »
                   * identiques seraient indiscernables.
                   */
                }
                <button
                  type="button"
                  data-carte-ouvrir
                  hidden
                  aria-controls={'detail-' + ancre}
                  data-carte-titre={zone.title}
                  data-carte-fermer={strategy.dialogClose}
                  class="carte-savoir mt-auto self-start"
                >
                  <span>{strategy.dialogOpen}</span>
                  <span class="visually-hidden"> : {zone.title}</span>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="carte-savoir-fleche">
                    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </article>

              {
                /* Hôte du détail : visible dans le flux tant que le script n'a pas déplacé son contenu
                  dans la fenêtre. Il est alors vidé, et le script le masque. */
              }
              <div data-carte-detail-hote>
                <div id={'detail-' + ancre} data-carte-detail class="mt-5 space-y-4">
                  <p class="text-eyebrow text-teal-700">{zone.eyebrow}</p>
                  <p class="text-display-sm text-ink">{zone.title}</p>
                  <p class="text-base leading-snug text-slate-700">{zone.intro}</p>
                  {zone.lead && <p class="text-base font-semibold text-ink">{zone.lead}</p>}

                  <ul role="list" class="space-y-3">
                    {zone.items.map((item) => (
                      <li class="flex items-start gap-3">
                        {item.icon ? (
                          <Picto name={item.icon} class="mt-0.5 size-6 text-teal-700" />
                        ) : (
                          <span
                            aria-hidden="true"
                            class="mt-2 size-2 shrink-0 rounded-full bg-teal-700"
                          />
                        )}
                        <p class="text-base leading-snug text-ink">
                          {item.lead}
                          {item.rest && <span class="mt-1 block text-slate-700">{item.rest}</span>}
                        </p>
                      </li>
                    ))}
                  </ul>

                  <p class="text-base leading-snug text-slate-700">{zone.outro}</p>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </Container>
</Section>

<script>
  /* Tuiles à fenêtre : le contenu arrive dans le flux, le script le déplace dans une <dialog>. */
  import '@/scripts/carteDialog';
</script>
