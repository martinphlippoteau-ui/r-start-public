---
/**
 * Stratégie d'investissement : DEUX sections, rendues uniquement par /strategie.
 *  1. #strategie (paper) les deux moteurs de performance : deux cartes qui se retournent, chacune
 *                        illustrée par son dessin animé (EngineRent, EngineGain) ;
 *  2. #quoi      (paper) « Une approche en 3 volets pour les alimenter » : trois tuiles ink,
 *                        Sélective, Diversifiée et Opportuniste (ex-Quoi, Où et Comment, d'où les
 *                        ancres #quoi, #ou, #comment), chacune avec son dessin (StrategySelect,
 *                        StrategyDiversify, StrategyTiming) et son détail au dos de la carte. Une
 *                        canalisation les relie aux deux moteurs sur grand écran.
 *
 * D'OÙ ELLE VIENT. Le 14/09/2026 l'équipe a fourni le texte exact de la page, « ni plus ni moins » :
 * quatre sections alors (moteurs, quoi, où, comment), avec trois photos d'immeubles et un globe en
 * rotation. Le 16/09/2026 les trois dernières ont fusionné en trois tuiles à détail, les photos et le
 * globe ont cédé la place aux dessins. Étaient déjà partis le 14/09 : le mot d'ordre en scène épinglée,
 * les piliers et leurs pictos, la CARTE (elle montrait le Conseil de l'Europe et le Canada quand la
 * page dit « partout dans le monde »), les pastilles de types d'actifs, l'effet de levier et les quatre
 * appels de note.
 *
 * FONDS. Les deux sections sont claires. L'en-tête de la page est déjà sombre : une première section
 * ink enchaînerait deux pavés sombres sans coupure, et un test l'interdit sur toutes les sous-pages.
 * Le sombre est porté par les trois tuiles, puis par le bloc des risques que la page rend ensuite.
 *
 * AUCUNE MENTION DE RISQUE DANS CES DEUX SECTIONS aujourd'hui : celle qui suivait les deux moteurs
 * (`strategy.engines.disclaimer`, rendue par ui/NoteConformite.astro) a été retirée de l'écran le
 * 16/09/2026 à la demande de l'équipe, strategy.ts dit comment la rétablir. Le gabarit la rend dès que
 * le contenu la porte, et la canalisation s'efface alors (`pontVisible`). Les risques sont portés par
 * le bloc Risques que la page rend ensuite. Aucun [data-advantage] ni RiskNote ici.
 *
 * Motion (src/scripts/motion.ts, tout par attributs) : aucun rideau ici, la section suit directement
 * l'en-tête ; H2 du premier chapitre mot à mot (data-reveal-text), celui des volets en fade-up court ;
 * les trois tuiles entrent en cascade, en bascule (`data-animate-child="tilt"`) ; la canalisation ne
 * s'anime qu'à l'écran (`data-in-view`). Ni tracé `data-draw` ni parallaxe : relevé sur dist le
 * 19/09/2026. Les dessins s'animent dans leurs propres composants.
 * Contenu : src/content/fr/strategy.ts. Plus aucune photo depuis le 16/09/2026.
 * Aucune prop : la section n'appelle plus de note, elle n'a plus besoin du registre de la page.
 */
import Container from '@/components/ui/Container.astro';
import NoteConformite from '@/components/ui/NoteConformite.astro';
import MarqueR from '@/components/ui/MarqueR.astro';
import Picto from '@/components/ui/Picto.astro';
import Section from '@/components/ui/Section.astro';
import EngineGain from '@/components/EngineGain.astro';
import EngineRent from '@/components/EngineRent.astro';
import StrategyDiversify from '@/components/StrategyDiversify.astro';
import StrategySelect from '@/components/StrategySelect.astro';
import StrategyTiming from '@/components/StrategyTiming.astro';
import { sections } from '@/config/sections';
import { strategy } from '@/content/fr/strategy';

const id = sections.strategy.id;
/** Ancres des deux autres chapitres (ids HTML, pas les textes affichés). */
const ids = { what: 'quoi', where: 'ou', how: 'comment' };

/** Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. */
const QUIET_TITLE_Y = 12;

/*
 * LA CANALISATION (16/09/2026, demande de l'équipe) : « une sorte de canalisation qui va des 3 volets
 * vers les deux moteurs pour montrer que les 3 volets alimentent les moteurs », discrète et subtile.
 *
 * DEUX TRACÉS, PAS UN, et c'est la décision qui porte tout le reste. Entre le bas des cartes moteurs
 * et le haut des tuiles, le titre « Une approche en 3 volets pour les alimenter » est planté au
 * milieu : un trait d'un seul tenant lui passerait forcément dessus. On dessine donc de part et
 * d'autre, et rien derrière lui. L'œil recolle les deux, et c'est le titre lui-même qui dit ce que la
 * coupure laisse entendre.
 *
 * LES ABSCISSES SONT CALCULÉES, JAMAIS MESURÉES. Les deux listes vivent dans le même
 * <Container size="wide"> : même boîte de contenu, donc un seul repère horizontal, exprimé en pour
 * mille dans un viewBox de 1000 de large. Un observateur de redimensionnement coûterait un reflow à
 * chaque poignée de pixels pour gagner les deux que les gouttières en pixels font dériver sous 1280.
 *
 * LES HAUTEURS NE SONT PAS ÉCRITES EN DUR NON PLUS : du bas des cartes au haut du titre il y a
 * exactement deux fois `--spacing-section` (la marge basse d'une section plus la marge haute de la
 * suivante), et du bas du titre au haut des tuiles exactement `--spacing-chapter`, le `mt-chapter` de
 * la liste. Le CSS reprend ces variables. Un titre qui passe d'une à deux lignes ne déplace donc rien :
 * tout est ancré sur des BORDS.
 *
 * NE JAMAIS POSER `overflow-hidden` SUR LA SECTION DES VOLETS : c'est son débordement vers le haut qui
 * va chercher les cartes moteurs.
 */
const LARGEUR_REF = 1216; // max-w-7xl (1280 px) moins deux fois sm:px-8
const centreColonne = (i: number, n: number, gouttiere: number): number => {
  const colonne = (LARGEUR_REF - (n - 1) * gouttiere) / n;
  return Math.round(((i * (colonne + gouttiere) + colonne / 2) / LARGEUR_REF) * 10000) / 10;
};
/** Deux moteurs : `sm:grid-cols-2` et `lg:gap-12` (48 px). */
const MOTEUR_G = centreColonne(0, 2, 48);
const MOTEUR_D = centreColonne(1, 2, 48);
/** Trois volets : `lg:grid-cols-3` et `sm:gap-5` (20 px). */
const VOLET_G = centreColonne(0, 3, 20);
const VOLET_C = centreColonne(1, 3, 20);
const VOLET_D = centreColonne(2, 3, 20);
const NOEUD_X = 500;
const NOEUD_Y = 150;

/*
 * Tous les chemins sont écrits du BAS vers le HAUT : le sens du tracé est le sens du flux, et c'est lui
 * que suit l'impulsion. Les trois volets rejoignent un nœud unique, d'où repartent deux conduites vers
 * les deux moteurs. Un nœud plutôt que cinq brins appariés : apparier dirait « ce volet-là alimente ce
 * moteur-là », ce que personne n'a écrit. Le nœud dit ce qui a été demandé, les trois ensemble
 * alimentent les deux.
 * Les deux derniers points de contrôle d'une conduite partagent l'abscisse de son moteur : elle y
 * arrive à la verticale, jamais en biais.
 */
const montees = [
  { d: `M${VOLET_G} 300C${VOLET_G} 250 ${NOEUD_X} 210 ${NOEUD_X} ${NOEUD_Y}`, rang: 0 },
  { d: `M${VOLET_C} 300V${NOEUD_Y}`, rang: 1 },
  { d: `M${VOLET_D} 300C${VOLET_D} 250 ${NOEUD_X} 210 ${NOEUD_X} ${NOEUD_Y}`, rang: 2 },
];
const departs = [
  `M${NOEUD_X} ${NOEUD_Y}C${NOEUD_X} 110 ${MOTEUR_G} 80 ${MOTEUR_G} 0`,
  `M${NOEUD_X} ${NOEUD_Y}C${NOEUD_X} 110 ${MOTEUR_D} 80 ${MOTEUR_D} 0`,
];
/** Les trois amorces, du haut des tuiles au bas du titre. Même rang que leur montée : un seul fil. */
const tiges = [VOLET_G, VOLET_C, VOLET_D].map((x, i) => ({ d: `M${x} 60V0`, rang: i }));

/*
 * GARDE-FOU. strategy.ts documente noir sur blanc comment redonner une chute ou une mention de
 * Conformité aux deux moteurs. Le jour où quelqu'un le fait, la canalisation se tracerait EN TRAVERS
 * de ce texte, puisqu'elle compte les deux marges de section pour atteindre le bas des cartes. Elle
 * disparaît alors, au lieu de mentir.
 */
const pontVisible = !strategy.engines.outro && !strategy.engines.disclaimer;
---

{/* 1. Les deux moteurs de performance */}
<Section id={id} tone="paper" class="overflow-hidden">
  <Container size="wide">
    <header class="max-w-5xl">
      <h2 id={id + '-title'} class="text-display-lg text-ink" data-reveal-text>
        {strategy.engines.title}
      </h2>
    </header>

    <ul
      role="list"
      class="mt-chapter grid gap-8 sm:grid-cols-2 lg:gap-12"
      data-animate="stagger"
      data-animate-stagger="0.12"
    >
      {
        /*
         * CARTES ILLUSTRÉES depuis le 15/09/2026 (« créer des cards différentes avec des illustrations
         * pour illustrer »). Avant : un filet, un numéro, deux lignes de texte, à même le fond.
         * DESSINS ANIMÉS depuis le 16/09/2026, à la place des deux photos d'illustration : une photo de
         * rue commerçante montrait un décor, le dessin montre le MÉCANISME, et la différence entre les
         * deux moteurs se lit alors sans passer par les textes.
         *
         * MÊME DIRECTION ARTISTIQUE QUE LES TROIS VOLETS depuis le 16/09/2026, demande de l'équipe.
         * Les moteurs étaient des cartes BLANCHES à ombre et filet, avec un bandeau sombre en haut et
         * le numéro en pastille posée dessus ; les volets, plus bas, étaient des tuiles ink sans ombre.
         * Deux grammaires pour deux rangées qui se lisent l'une après l'autre.
         * Les cinq cartes partagent maintenant la même : fond ink, coins arrondis, surtitre en
         * teal-200, titre en sable, dessin au trait centré, texte en blanc à 80 %. Le numéro redevient
         * un surtitre au lieu d'une pastille flottante, à la place exacte qu'occupe « SÉLECTIVE » sur
         * les volets.
         * Le sens de lecture est conservé : ombre et filet ne portaient rien que le fond ink ne porte
         * mieux, puisque c'est lui qui détache la carte du fond paper de la section.
         */
      }
      {
        strategy.engines.items.map((item, i) => {
          const numero = String(i + 1).padStart(2, '0');
          const cible = 'detail-moteur-' + numero;
          /* Même perspective que les volets : sans elle, le retournement n'est qu'un écrasement. */
          return (
            <li class="[perspective:1400px]">
            <div class="carte-face relative h-full">
              <article
                class="carte-recto carte-lueur relative flex min-h-[24rem] flex-col overflow-hidden rounded-3xl bg-ink p-6 text-white sm:min-h-[26rem] sm:p-8"
              >
                <p class="text-eyebrow text-teal-200 tabular-nums" aria-hidden="true">{numero}</p>
                <p class="text-display-sm mt-3 text-sand">{item.lead}</p>
                {
                  /* CE QUE LE MOTEUR APPORTE, sous le titre (17/09/2026, demande de l'équipe). Petit
                    texte en blanc à 80 %, la couleur des textes des cartes : le titre reste le repère,
                    cette ligne le traduit pour l'épargnant. Recto seulement : le dos porte déjà
                    l'explication complète. */
                }
                {item.benefit && (
                  <p class="mt-2 text-base leading-snug text-pretty text-white/80">
                    {item.benefit}
                  </p>
                )}

                {
                  /* L'ILLUSTRATION REMPLIT LA CARTE (16/09/2026 au soir, « je veux que les animations
                    prennent une bonne partie de la carte pour la remplir ») : pleine largeur, et
                    centrée dans tout l'espace qui reste entre le titre et le bouton (`flex-1`). Elle
                    était bornée à 24 rem et posée sous le titre, le bas de la carte restait vide.
                    `--illus-decalage` : le dessin de la seconde carte part un tiers de seconde après
                    le premier ; deux dessins voisins qui battraient à l'unisson auraient l'air d'un
                    seul mécanisme (grammaire commune en tête de StrategySelect.astro). */
                }
                <div class="flex w-full flex-1 items-center py-6" style={`--illus-decalage:${i * 0.35}s`}>
                  {i === 0 && <EngineRent />}
                  {i === 1 && <EngineGain />}
                </div>

                <button
                  type="button"
                  data-carte-ouvrir
                  hidden
                  aria-controls={cible}
                  data-carte-fermer={strategy.dialogClose}
                  class="carte-savoir btn btn-motion btn-outline-light btn-sm mt-auto self-start"
                >
                  <span>{strategy.dialogOpen}</span>
                  <span class="visually-hidden"> : {item.lead}</span>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="carte-savoir-fleche">
                    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </article>
              {
                /* LE DOS PORTE LE CONTENU depuis le 16/09/2026 (« je veux que le contenu soit au dos
                  des cards en fait, pas de zoom ni de popup »). Il arrive vide : c'est le script qui y
                  déplace le texte écrit plus bas dans le flux, pour que la page se lise entière sans
                  JavaScript. La marque reste, petite et en coin, hors du chemin du texte. */
              }
              <div class="carte-verso carte-lueur">
                <MarqueR class="carte-verso-marque w-12 text-white/10" />
              </div>
            </div>

              {
                /* Le texte du moteur passe DERRIÈRE la carte, comme celui des volets : sans script il
                  reste lu dans le flux, juste sous sa carte. Aucun mot n'est ajouté ni retiré, il
                  change seulement de place. */
              }
              <div data-carte-detail-hote>
                <div id={cible} data-carte-detail class="mt-5 space-y-4">
                  <p class="text-eyebrow text-teal-200 tabular-nums">{numero}</p>
                  <p class="text-display-sm text-sand">{item.lead}</p>
                  {item.rest && <p class="text-base leading-relaxed text-white/80">{item.rest}</p>}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      /* Chute des deux moteurs (`engines.outro`), quand le contenu en porte une : détachée par un
        filet plein largeur, dans la taille des introductions. */
    }
    {
      /* La phrase de méthode fermait ce chapitre ; elle ouvre maintenant « Tout commence par le
        choix des immeubles » (16/09/2026). Le rendu reste, conditionnel : si la Conformité ou
        l'équipe redonnent une chute aux deux moteurs, elle s'affichera sans rien changer ici. */
    }
    {strategy.engines.outro && (
      <p
      class="text-lead mt-12 max-w-4xl border-t border-navy/15 pt-8 text-pretty text-slate-700 lg:mt-16"
      data-animate="fade-up"
      data-animate-y={String(QUIET_TITLE_Y)}
    >
      {strategy.engines.outro}
    </p>
    )}

    {
      /* Mention de la Conformité, jamais animée : un avertissement ne dépend pas d'un défilement pour
        apparaître. Absente du contenu depuis le 16/09/2026, rien n'est rendu ; rétablie, elle
        refermerait la zone, sous la chute s'il y en a une. */
    }
    {
      strategy.engines.disclaimer && (
        <NoteConformite text={strategy.engines.disclaimer} class="mt-8 max-w-4xl" />
      )
    }
  </Container>
</Section>

{/* 2. Les trois volets : Sélective, Diversifiée, Opportuniste (ex-Quoi, Où, Comment) */}
{
  /*
   * TUILES À FENÊTRE (16/09/2026, demande de l'équipe : « j'aime bien le format de card sur le site
   * d'Apple qui ouvre une popup pour le contenu »). Elles remplacent trois cartes qui déroulaient tout
   * leur contenu : la page s'ouvre maintenant sur trois tuiles qui se lisent d'un coup d'œil, et le
   * détail vient à la demande.
   *
   * AUCUN TEXTE N'EST AJOUTÉ NI RETIRÉ par la fusion, la répartition change seulement : la tuile porte
   * le surtitre et le titre, son dos l'introduction, la phrase d'annonce, la liste et la chute
   * (plus de fenêtre depuis le même jour, voir src/scripts/carteRetournee.ts).
   * Les trois titres étaient des H2 ; ils sont passés en H3 le 16/09/2026, quand l'équipe a demandé un
   * titre commun au-dessus des trois volets (« Une approche en 3 volets pour les alimenter »), qui
   * prend le rang H2. C'est le seul texte ajouté à ce bloc depuis la fusion.
   *
   * SANS JAVASCRIPT, TOUT RESTE LISIBLE : le détail est écrit dans le flux, sous sa tuile, et le
   * bouton d'ouverture arrive `hidden`. Le script le déplace au DOS de la carte et révèle le bouton
   * (src/scripts/carteRetournee.ts). C'est la seule façon de cacher un texte derrière un mouvement sans
   * le perdre pour qui n'exécute pas de script.
   *
   * FOND INK sur les trois. Le globe était sur blanc depuis la fusion et s'y lisait mal : dessin au
   * trait clair, il lui fallait un fond sombre, celui qu'il avait avant ; les dessins qui l'ont
   * remplacé sont au trait clair eux aussi. Les tuiles sombres sur la section claire donnent au
   * passage le contraste que trois cartes blanches sur blanc n'avaient pas.
   */
}
{
  /* MARGE HAUTE RÉDUITE le 16/09/2026 (« rapproche un peu le titre et les blocs du dessus ») :
    `pt-section-sm` à la place du `py-section` de la section, soit environ un tiers de moins. La marge
    basse ne bouge pas, c'est elle qui sépare les volets du bloc des risques.
    ATTENTION : la hauteur de la canalisation se calcule sur ces deux marges. Elle lit la même paire de
    variables, plus bas dans ce fichier (`--pont-bande`) ; changer l'une sans l'autre décollerait le
    tracé du bas des cartes. */
}
<Section id={ids.what} tone="paper" labelledBy="volets-title" class="pt-section-sm">
  <Container size="wide">
    {
      /* La confluence occupe la bande vide qui sépare les deux sections, sans rien y ajouter : la boîte
        fait zéro pixel de haut et le tracé est en absolu. Hauteur de la section inchangée. */
    }
    {pontVisible && (
      <div class="pont pont--confluence" aria-hidden="true">
        <svg viewBox="0 0 1000 300" preserveAspectRatio="none" fill="none" data-in-view="pont-en-vue">
          {montees.map((m) => <path class="pont-fil" d={m.d} />)}
          {departs.map((d) => <path class="pont-fil" d={d} />)}
          {montees.map((m) => (
            <path class="pont-flux pont-flux--montee" pathLength="100" d={m.d} style={`--rang:${m.rang}`} />
          ))}
          {departs.map((d) => <path class="pont-flux pont-flux--depart" pathLength="100" d={d} />)}
        </svg>
        {
          /* Nœud et pointes en CSS, hors du viewBox : celui-ci est étiré horizontalement d'environ un
            quart, un cercle y deviendrait un ovale et un chevron changerait de forme avec la largeur
            de la fenêtre. Ce sont aussi eux qui portent le sens quand l'animation est coupée. */
        }
        <span class="pont-noeud" />
        {
          /* DIVISÉ PAR DIX : les abscisses sont en POUR MILLE, l'unité du viewBox de 1000 de large, et
            `left` attend des pour cent. Sans la conversion, les chevrons partaient à deux mille pixels
            du bord. */
        }
        <span class="pont-pointe" style={`--x:${MOTEUR_G / 10}%`} />
        <span class="pont-pointe" style={`--x:${MOTEUR_D / 10}%`} />
      </div>
    )}

    {
      /*
       * EN-TÊTE DU BLOC (16/09/2026, demande de l'équipe). Les trois tuiles n'en avaient pas : la
       * section empruntait son nom au premier volet, dont le H2 portait l'identifiant attendu par
       * <Section>. Elle a maintenant son titre, et `labelledBy` le désigne explicitement.
       * LES TROIS TITRES DE VOLET PASSENT DONC EN H3 : sous un H2 qui les annonce, trois H2 de même
       * rang auraient fait quatre sections de même niveau dans le plan du document. Leurs
       * identifiants ne bougent pas, ce sont eux qui servent d'ancres.
       */
    }
    {
      /* PLEINE LARGEUR, et non `max-w-5xl` comme les autres en-têtes (16/09/2026, « sans retour à la
        ligne ») : à 1024 px de colonne, ce titre-là se coupait en deux. Il tient sur une ligne dès que
        la boîte de contenu fait sa largeur pleine, soit 1216 px à partir de 1280 px d'écran. En
        dessous, il se coupe encore, et c'est la seule issue : on ne va pas réduire la taille commune
        des titres de la page pour un seul d'entre eux. */
    }
    <header>
      <h2
        id="volets-title"
        class="text-display-lg text-ink"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {strategy.tilesTitle}
      </h2>
    </header>

    {
      /* Les trois amorces tiennent dans le `mt-chapter` de la liste sans l'agrandir. Elles ne peuvent
        pas être posées DANS le <ul> : la cascade `data-animate="stagger"` révèle tous ses enfants, elles
        compteraient pour une quatrième tuile, et un <ul> n'admet que des <li>. */
    }
    {pontVisible && (
      <div class="pont pont--tiges" aria-hidden="true">
        <svg viewBox="0 0 1000 60" preserveAspectRatio="none" fill="none" data-in-view="pont-en-vue">
          {tiges.map((t) => <path class="pont-fil" d={t.d} />)}
          {tiges.map((t) => (
            <path class="pont-flux pont-flux--tige" pathLength="100" d={t.d} style={`--rang:${t.rang}`} />
          ))}
        </svg>
      </div>
    )}

    {
      /*
       * ENTRÉE DES TUILES, reprise le 16/09/2026 (« j'aimerais que ce soit plus spectaculaire »).
       * Elles montaient de 20 px en fondu, décalées d'un dixième de seconde : à trois tuiles côte à
       * côte, l'effet se voyait à peine.
       * `tilt` les fait maintenant basculer en perspective ; la distance passe à 44 px et le décalage
       * à 0,16 s, assez pour que les trois arrivent l'une après l'autre au lieu d'ensemble.
       * CETTE PAGE EST SERVIE PAR LE MOTEUR GSAP, pas par le moteur léger : ses titres mot à mot et le
       * rideau des Risques l'exigent (tests/performance.spec.ts la sort de la liste des pages sans
       * GSAP). Ce commentaire disait l'inverse jusqu'au 18/09/2026, et `data-animate-child` n'était lu
       * que par le moteur léger : la bascule n'a donc jamais été jouée ici. Les deux moteurs le lisent
       * maintenant. `prefers-reduced-motion` coupe tout dans le moteur lui-même.
       */
    }
    <ul
      role="list"
      class="mt-chapter grid gap-4 sm:gap-5 lg:grid-cols-3"
      data-animate="stagger"
      data-animate-child="tilt"
      data-animate-stagger="0.16"
      data-animate-y="44"
    >
      {
        [strategy.what, strategy.where, strategy.how].map((zone, z) => {
          const ancre = [ids.what, ids.where, ids.how][z];
          /* La PERSPECTIVE est portée par le <li> et non par la carte : une `perspective` posée sur
             l'élément qui tourne lui-même n'a aucun effet, le point de fuite doit venir du parent.
             Sans elle, le retournement n'est qu'une compression horizontale. */
          return (
            <li class="[perspective:1400px]">
              {
                /* Hauteurs relevées le 16/09/2026 : 20 → 24 rem, 24 → 28 rem. Le dessin et le bouton
                  se serraient contre le titre, et la carte n'avait plus de respiration.
                  L'ENVELOPPE `.carte-face` EST CE QUI TOURNE, et non plus l'article : depuis le
                  16/09/2026 la carte a un DOS, qui reste à l'écran derrière la fenêtre ouverte. Il faut
                  donc deux faces dans un même élément en `preserve-3d`, chacune masquée quand elle
                  présente son envers. */
              }
            <div class="carte-face relative h-full">
              <article class="carte-recto carte-lueur relative flex min-h-[24rem] flex-col overflow-hidden rounded-3xl bg-ink p-6 text-white sm:min-h-[28rem] sm:p-8">
                {zone.eyebrow && <p class="text-eyebrow text-teal-200">{zone.eyebrow}</p>}
                <h3 id={ancre + '-title'} class="text-display-sm mt-3 max-w-[16rem] text-sand">
                  {zone.title}
                </h3>

                {
                  /* UNE ILLUSTRATION PAR TUILE (16/09/2026). Le globe n'en avait plus qu'une sur trois,
                    les deux autres restaient nues. Les trois sont maintenant dans la même grammaire
                    (en tête de StrategySelect.astro) : dessin au trait clair sur fond ink, en boucle
                    lente, en pause hors écran, complet en `prefers-reduced-motion`.
                    Les trois sont des SVG. Le globe en canvas a été retiré le 16/09/2026 : il ne
                    montrait que la moitié du propos de sa tuile, qui parle de secteurs autant que de
                    géographie. Son fichier a été supprimé le 19/09/2026 ; le globe filaire de
                    StrategyDiversify, lui, porte un secteur sur chaque épingle.
                    PLEINE LARGEUR ET AU FORMAT PAYSAGE (160 × 120) depuis le 16/09/2026 au soir, pour
                    remplir la tuile ; `flex-1` centre le dessin dans tout l'espace qui reste. Elles
                    étaient carrées et bornées à 11 rem, la moitié basse de la tuile restait vide. */
                }
                <div class="flex w-full flex-1 items-center py-5" style={`--illus-decalage:${z * 0.35}s`}>
                  {z === 0 && <StrategySelect />}
                  {z === 1 && <StrategyDiversify />}
                  {z === 2 && <StrategyTiming />}
                </div>

                {
                  /*
                   * « EN SAVOIR PLUS » EN TOUTES LETTRES depuis le 16/09/2026, demande de l'équipe.
                   * C'était un « + » rond : le libellé n'existait que pour les lecteurs d'écran, et un
                   * visiteur voyant devait deviner qu'il y avait quelque chose derrière.
                   * Le titre de la tuile reste lu, mais hors écran : à l'écran les trois boutons
                   * portent le même texte, ce qui est juste puisqu'on lit la tuile au-dessus ; pour un
                   * lecteur d'écran qui parcourt les boutons hors contexte, trois « En savoir plus »
                   * identiques seraient indiscernables.
                   */
                }
                <button
                  type="button"
                  data-carte-ouvrir
                  hidden
                  aria-controls={'detail-' + ancre}
                  data-carte-fermer={strategy.dialogClose}
                  class="carte-savoir btn btn-motion btn-outline-light btn-sm mt-auto self-start"
                >
                  <span>{strategy.dialogOpen}</span>
                  <span class="visually-hidden"> : {zone.title}</span>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="carte-savoir-fleche">
                    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </article>
              {
                /* LE DOS PORTE LE CONTENU depuis le 16/09/2026 (« je veux que le contenu soit au dos
                  des cards en fait, pas de zoom ni de popup »). Il arrive vide : c'est le script qui y
                  déplace le texte écrit plus bas dans le flux, pour que la page se lise entière sans
                  JavaScript. La marque reste, petite et en coin, hors du chemin du texte. */
              }
              <div class="carte-verso carte-lueur">
                <MarqueR class="carte-verso-marque w-12 text-white/10" />
              </div>
            </div>

              {
                /* Hôte du détail : visible dans le flux tant que le script n'a pas déplacé son contenu
                  au dos de la carte. Il est alors vidé, et le script le masque. */
              }
              <div data-carte-detail-hote>
                <div id={'detail-' + ancre} data-carte-detail class="mt-5 space-y-4">
                  <p class="text-eyebrow text-teal-200">{zone.eyebrow}</p>
                  <p class="text-display-sm text-sand">{zone.title}</p>
                  <p class="text-base leading-snug text-white/80">{zone.intro}</p>
                  {zone.lead && <p class="text-base font-semibold text-white">{zone.lead}</p>}

                  <ul role="list" class="space-y-3">
                    {zone.items.map((item) => (
                      <li class="flex items-start gap-3">
                        {item.icon ? (
                          <Picto name={item.icon} class="mt-0.5 size-6 text-teal-200" />
                        ) : (
                          <span
                            aria-hidden="true"
                            class="mt-2 size-2 shrink-0 rounded-full bg-teal-200"
                          />
                        )}
                        <p class="text-base leading-snug text-white">
                          {item.lead}
                          {item.rest && <span class="mt-1 block text-white/75">{item.rest}</span>}
                        </p>
                      </li>
                    ))}
                  </ul>

                  <p class="text-base leading-snug text-white/80">{zone.outro}</p>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </Container>
</Section>

<style>
  /*
   * LA CANALISATION. Deux tracés en absolu dans des bandes DÉJÀ VIDES : les deux marges de section
   * entre les moteurs et les volets, puis le `mt-chapter` sous le titre. Aucun pixel ajouté à la page,
   * la hauteur de la section est identique avec et sans.
   */
  .pont {
    /* Sous `lg`, les cinq cartes sont empilées en une seule colonne : trois traits qui convergeraient
       vers deux n'auraient plus rien à relier, et surtout rien à tenter à 390 px. Rendu supprimé, pas
       masqué : aucune surface, aucun calcul, aucun risque de débordement. */
    display: none;
  }

  @media (min-width: 64rem) {
    .pont {
      display: block;
      /* Boîte de HAUTEUR NULLE : elle ne sert que de repère, elle ne pousse rien. */
      position: relative;
      --pont-cycle: 8s;
      /*
       * HAUTEUR DE LA BANDE, écrite UNE SEULE FOIS parce que trois règles en dépendent : le tracé, le
       * nœud à mi-hauteur et les chevrons tout en haut. C'est la marge basse de la section des moteurs
       * plus la marge haute de celle des volets, moins un rem pour dégager l'ombre portée des cartes,
       * qui descend sous leur bord.
       * Les deux marges sont DIFFÉRENTES depuis le 16/09/2026 : la section des volets est passée en
       * `pt-section-sm` pour rapprocher son titre des cartes.
       */
      --pont-bande: calc(var(--spacing-section) + var(--spacing-section-sm) - 1rem);
    }
    .pont svg {
      position: absolute;
      /* La boîte de contenu du Container : les colonnes des deux listes tombent aux mêmes abscisses. */
      inset-inline: 0;
      display: block;
      width: 100%;
      pointer-events: none;
    }
    /* Du bas des cartes moteurs au haut du titre. */
    .pont--confluence svg {
      bottom: 0;
      height: var(--pont-bande);
    }
    .pont--tiges svg {
      top: 0;
      height: var(--spacing-chapter);
    }

    /* DISCRÉTION : le filet est à peine plus marqué que les séparateurs de la page, et l'impulsion
       n'est qu'un court segment. Vu de loin, on voit une conduite ; on ne la lit que si on la cherche. */
    .pont-fil {
      stroke: rgb(2 75 103 / 0.13);
      stroke-width: 1.5;
    }
    .pont-flux {
      stroke: var(--color-teal-400);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-opacity: 0.7;
      /* `pathLength="100"` normalise chaque tracé : la même impulsion met le même temps sur une courbe
         longue et sur une amorce courte, et les longueurs ci-dessous sont des pour-cent. */
      stroke-dasharray: 11 100;
      /* Au repos, le segment est AVANT le départ du tracé, donc hors de lui : rien ne se voit tant que
         l'animation n'a pas commencé. C'est aussi l'état sans JavaScript et en mouvement réduit. */
      stroke-dashoffset: 14;
    }

    .pont-noeud,
    .pont-pointe {
      position: absolute;
      pointer-events: none;
    }
    /*
     * Le nœud est à mi-hauteur de la bande de confluence, là où les trois montées se rejoignent, soit
     * y = 150 sur les 300 du viewBox.
     * ANCRÉ PAR LE BAS, ET NON EN POURCENTAGE : son parent `.pont` a une hauteur NULLE, un `top: 50 %`
     * s'y calculerait sur zéro et poserait le nœud au bas de la bande. C'est la hauteur du tracé qu'il
     * faut reprendre, la même expression que celle du SVG, divisée par deux.
     */
    .pont-noeud {
      left: 50%;
      bottom: calc(var(--pont-bande) / 2);
      width: 0.6rem;
      height: 0.6rem;
      border-radius: 9999px;
      background: rgb(2 75 103 / 0.3);
      transform: translate(-50%, 50%);
    }
    /* Les deux pointes marquent l'arrivée, et disent le sens quand rien ne bouge. Un carré tourné d'un
       huitième de tour, deux bords seulement : le chevron le plus court à écrire. */
    .pont-pointe {
      left: var(--x);
      top: calc(-1 * var(--pont-bande));
      width: 0.6rem;
      height: 0.6rem;
      border-top: 2.5px solid rgb(2 75 103 / 0.38);
      border-left: 2.5px solid rgb(2 75 103 / 0.38);
      transform: translate(-50%, 0) rotate(45deg);
    }
  }

  /*
   * LES ANIMATIONS SONT POSÉES SEULEMENT SI LE MOUVEMENT EST ACCEPTÉ, au lieu d'être annulées ensuite :
   * en `reduce`, rien n'est déclaré, donc rien à défaire. Il reste alors le dessin complet — trois
   * amorces, trois montées, un nœud, deux conduites, deux pointes vers le haut — et le sens est porté
   * par la forme, pas par le mouvement.
   */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .pont-flux {
      animation-duration: var(--pont-cycle);
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
      animation-delay: calc(var(--rang, 0) * 0.12s);
      /* En pause hors écran : `data-in-view` pose la classe sur le SVG lui-même, et non sur la section.
         La bande de confluence est peinte deux marges de section AU-DESSUS de la section des volets :
         quand le lecteur regarde les cartes moteurs, elle est à l'écran alors que la section ne l'est
         pas encore. C'est le SVG qu'il faut surveiller. */
      animation-play-state: paused;
    }
    .pont-en-vue .pont-flux {
      animation-play-state: running;
    }
    .pont-flux--tige {
      animation-name: pont-tige;
    }
    .pont-flux--montee {
      animation-name: pont-montee;
    }
    .pont-flux--depart {
      animation-name: pont-depart;
    }
    .pont-noeud::after {
      content: '';
      position: absolute;
      inset: -0.35rem;
      border-radius: 9999px;
      border: 2px solid var(--color-teal-400);
      opacity: 0;
      animation: pont-eclat var(--pont-cycle) ease-out infinite;
      animation-play-state: paused;
    }
    .pont-en-vue ~ .pont-noeud::after {
      animation-play-state: running;
    }
  }

  /*
   * UN SEUL CYCLE DE HUIT SECONDES, celui des cinq dessins des cartes, pour que la page n'ait pas deux
   * pouls (six secondes jusqu'au 16/09/2026, quand les dessins ont été alignés sur un tempo unique ;
   * les pour-cent ci-dessous n'ont pas bougé, l'impulsion est seulement un quart moins rapide).
   * Les proportions suivent les distances réelles, environ 110 px par seconde partout :
   *   0 à 6 %    l'amorce, de la tuile au bas du titre ;
   *   6 à 16 %   le temps de passer derrière le titre, où rien n'est dessiné ;
   *   16 à 40 %  la montée, du haut du titre au nœud ;
   *   38 à 46 %  le nœud s'allume, les trois viennent d'arriver ;
   *   44 à 68 %  les deux conduites, du nœud aux cartes ;
   *   68 à 100 % silence. Une page qui vend un placement ne clignote pas.
   * Le pas de 0,01 % après chaque fin remet le segment hors du tracé d'un coup : sans lui, il
   * remonterait lentement à sa place de départ, en sens inverse du flux.
   */
  @keyframes pont-tige {
    0% {
      stroke-dashoffset: 14;
    }
    6% {
      stroke-dashoffset: -100;
    }
    6.01%,
    100% {
      stroke-dashoffset: 14;
    }
  }
  @keyframes pont-montee {
    0%,
    16% {
      stroke-dashoffset: 14;
    }
    40% {
      stroke-dashoffset: -100;
    }
    40.01%,
    100% {
      stroke-dashoffset: 14;
    }
  }
  @keyframes pont-depart {
    0%,
    44% {
      stroke-dashoffset: 14;
    }
    68% {
      stroke-dashoffset: -100;
    }
    68.01%,
    100% {
      stroke-dashoffset: 14;
    }
  }
  @keyframes pont-eclat {
    0%,
    38% {
      opacity: 0;
      transform: scale(0.5);
    }
    42% {
      opacity: 0.55;
      transform: scale(1);
    }
    46%,
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }
</style>

<script>
  /* Cartes qui se retournent : le détail arrive dans le flux, le script le déplace au dos de la carte. */
  import '@/scripts/carteRetournee';
</script>
