---
/**
 * Stratégie d'investissement : TROIS sections, rendues uniquement par /strategie.
 *
 * REFONTE DU 14/09/2026. L'équipe a fourni le texte exact de la page, « ni plus ni moins ». Elle en
 * comptait cinq (mot d'ordre, deux leviers, trois piliers, zone + types d'actifs, effet de levier),
 * elle en compte trois, ceux du document :
 *  1. #strategie (paper) les deux moteurs de performance, numérotés, puis la phrase de méthode ;
 *  2. #quoi      (white) le double potentiel visé, puis la bande de trois photos d'immeubles ;
 *  3. #ou        (ink)   la zone d'investissement, en très grand, et le mot de la fin.
 * Ce qui a disparu avec elles : le mot d'ordre en scène épinglée, les piliers et leurs pictos, la
 * CARTE (elle montrait le Conseil de l'Europe et le Canada, la page dit désormais « partout dans le
 * monde » : elle disait le contraire du texte), les pastilles de types d'actifs, l'effet de levier et
 * les quatre appels de note.
 *
 * FONDS. Un seul bloc sombre, le dernier. L'en-tête de la page est déjà sombre : une première section
 * ink enchaînerait deux pavés sombres sans coupure, et un test l'interdit sur toutes les sous-pages.
 * Le ton ink ferme ici la page au lieu de l'ouvrir, et porte la phrase la plus courte du document.
 *
 * AUCUN CONTRE-POIDS dans la page, sur demande expresse de l'équipe : la seule mention de risque est
 * celle de l'en-tête, visible sans défiler. D'où l'absence de [data-advantage] et de RiskNote ici.
 *
 * Motion (src/scripts/motion.ts, tout par attributs) : aucun rideau, la section suit l'en-tête qui
 * porte la ligne risques ; H2 du premier chapitre mot à mot (data-reveal-text), les deux autres en
 * fade-up court ; filets qui s'étirent (data-draw="width") ; listes en cascade ; photos en cascade
 * avec parallaxe de sens alterné dans chaque cadre (élément surdimensionné de ±12 % pour ne jamais
 * découvrir le bord).
 * Contenu : src/content/fr/strategy.ts ; photos : src/content/fr/media.ts.
 * Aucune prop : la section n'appelle plus de note, elle n'a plus besoin du registre de la page.
 */
import { Picture } from 'astro:assets';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { media } from '@/content/fr/media';
import { strategy } from '@/content/fr/strategy';
import { resolveImage } from '@/lib/images';

const id = sections.strategy.id;
/** Ancres des deux autres chapitres (ids HTML, pas les textes affichés). */
const ids = { what: 'quoi', where: 'ou' };

const photos = await Promise.all(
  media.strategy.map(async (m) => ({ ...m, image: await resolveImage(m.src) }))
);
const photoSizes = '(min-width: 1024px) 400px, 33vw';
/**
 * Les trois photos portent la même mention (« Photo d'illustration. Immeuble non détenu par R Start. ») :
 * une seule légende sous la bande suffit. Répétée trois fois côte à côte, elle occupait trois colonnes
 * pour dire la même chose. Si les crédits diffèrent un jour, chaque photo reprend le sien.
 */
const credits = photos.map((p) => p.credit).filter(Boolean);
const sharedCredit =
  credits.length === photos.length && new Set(credits).size === 1 ? credits[0] : null;
/** Parallaxe des trois photos : douce, sens alterné (haut, bas, haut) ; cadres surdimensionnés de ±12 %. */
const PHOTO_PARALLAX = [0.035, -0.03, 0.04];
/** Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. */
const QUIET_TITLE_Y = 12;
---

{/* 1. Les deux moteurs de performance */}
<Section id={id} tone="paper" class="overflow-hidden">
  <Container size="wide">
    <header class="max-w-5xl">
      <h2 id={id + '-title'} class="text-display-lg text-ink" data-reveal-text>
        {strategy.engines.title}
      </h2>
    </header>

    <ul
      role="list"
      class="mt-chapter grid gap-8 sm:grid-cols-2 lg:gap-12"
      data-animate="stagger"
      data-animate-stagger="0.12"
    >
      {
        strategy.engines.items.map((item, i) => (
          <li>
            <span aria-hidden="true" data-draw="width" class="block h-px w-full bg-navy/15" />
            <div class="pt-6">
              <p class="text-caption font-semibold tabular-nums text-teal-700" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <p class="text-display-sm mt-3 text-navy">{item.lead}</p>
              {item.rest && <p class="text-lead mt-3 text-slate-700">{item.rest}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      /* La phrase de méthode ferme le chapitre : elle explique ce que les deux moteurs supposent de
        travail. Détachée par un filet plein largeur, dans la taille des introductions. */
    }
    <p
      class="text-lead mt-12 max-w-4xl border-t border-navy/15 pt-8 text-pretty text-slate-700 lg:mt-16"
      data-animate="fade-up"
      data-animate-y={String(QUIET_TITLE_Y)}
    >
      {strategy.engines.outro}
    </p>
  </Container>
</Section>

{/* 2. Quoi : le double potentiel visé, illustré par les immeubles */}
<Section id={ids.what} tone="white">
  <Container size="wide">
    <header class="max-w-4xl">
      <p class="text-eyebrow text-teal-700">{strategy.what.eyebrow}</p>
      <h2
        id={ids.what + '-title'}
        class="text-display-md mt-3 text-ink"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {strategy.what.title}
      </h2>
      <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">{strategy.what.intro}</p>
    </header>

    <ul
      role="list"
      class="mt-10 grid gap-5 sm:grid-cols-2 lg:mt-12 lg:gap-6"
      data-animate="stagger"
      data-animate-stagger="0.1"
    >
      {
        strategy.what.items.map((item) => (
          <Card as="li" tone="paper" class="flex items-start gap-4">
            <span
              aria-hidden="true"
              class="mt-2 size-2.5 shrink-0 rounded-full bg-teal-700 sm:mt-2.5"
            />
            <p class="text-display-sm text-ink">
              {item.lead}
              {item.rest && <span class="text-lead block mt-2 text-slate-700">{item.rest}</span>}
            </p>
          </Card>
        ))
      }
    </ul>

    <p class="text-lead mt-8 max-w-4xl text-pretty text-slate-700 lg:mt-10">
      {strategy.what.outro}
    </p>

    {
      /* Trois photos d'immeubles en bande de même largeur, parallaxe de sens alterné dans chaque cadre.
        TROIS COLONNES DÈS LE TÉLÉPHONE : empilées, elles ajoutaient à elles seules près de deux écrans. */
    }
    <figure class="mt-12 lg:mt-16">
      <ul
        role="list"
        class="grid grid-cols-3 gap-3 sm:gap-5 lg:gap-6"
        data-animate="stagger"
        data-animate-stagger="0.1"
      >
        {
          photos.map((photo, i) => (
            <li>
              <div class="img-frame aspect-[3/4] sm:aspect-[4/5]">
                <div
                  class="absolute inset-x-0 -top-[12%] h-[124%]"
                  data-parallax={String(PHOTO_PARALLAX[i] ?? PHOTO_PARALLAX[0])}
                  data-parallax-trigger="parent"
                >
                  <Picture
                    src={photo.image}
                    alt={photo.alt}
                    widths={[480, 800, 1200]}
                    sizes={photoSizes}
                    formats={['avif', 'webp']}
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'block h-full w-full' }}
                    class={
                      i === 1
                        ? 'h-full w-full object-cover object-[70%_50%]'
                        : 'h-full w-full object-cover'
                    }
                  />
                </div>
              </div>
              {!sharedCredit && photo.credit && (
                <p class="text-caption mt-3 text-slate-700">{photo.credit}</p>
              )}
            </li>
          ))
        }
      </ul>
      {
        sharedCredit && (
          <figcaption class="text-caption mt-3 text-slate-700">{sharedCredit}</figcaption>
        )
      }
    </figure>
  </Container>
</Section>

{/* 3. Où : la zone d'investissement, et le mot de la fin */}
<Section id={ids.where} tone="ink" class="overflow-hidden">
  <Container size="wide">
    <header class="max-w-4xl">
      <p class="text-eyebrow text-teal-200">{strategy.where.eyebrow}</p>
      <h2
        id={ids.where + '-title'}
        class="text-display-md mt-3 text-white"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {strategy.where.title}
      </h2>
      <p class="text-lead mt-5 text-pretty text-white sm:mt-6">{strategy.where.intro}</p>
    </header>

    {
      /* Les deux réponses en très grand, l'une sous l'autre : c'est le seul endroit de la page où le
        texte tient en trois mots, autant lui laisser toute la largeur. Chacune est précédée d'un filet
        qui s'étire à l'arrivée. */
    }
    <ul
      role="list"
      class="mt-10 grid gap-8 lg:mt-14 lg:gap-10"
      data-animate="stagger"
      data-animate-stagger="0.12"
    >
      {
        strategy.where.items.map((item) => (
          <li>
            <span aria-hidden="true" data-draw="width" class="block h-px w-full bg-white/20" />
            <p class="text-display-md max-w-5xl pt-6 text-white">
              {item.lead}
              {item.rest && <span class="text-lead block mt-3 text-white/85">{item.rest}</span>}
            </p>
          </li>
        ))
      }
    </ul>

    <p
      class="text-display-sm mt-12 text-teal-200 lg:mt-16"
      data-animate="fade-up"
      data-animate-y={String(QUIET_TITLE_Y)}
    >
      {strategy.where.outro}
    </p>
  </Container>
</Section>
