---
/**
 * Stratégie d'investissement : QUATRE sections, rendues uniquement par /strategie.
 *
 * REFONTE DU 14/09/2026. L'équipe a fourni le texte exact de la page, « ni plus ni moins ». Elle en
 * comptait cinq (mot d'ordre, deux leviers, trois piliers, zone + types d'actifs, effet de levier),
 * elle en compte quatre, ceux du document (le « Comment » est arrivé après les trois autres) :
 *  1. #strategie (paper) les deux moteurs de performance, numérotés, puis la phrase de méthode ;
 *  2. #quoi      (white) le double potentiel visé, puis la bande de trois photos d'immeubles ;
 *  3. #ou        (ink)   la zone d'investissement à gauche, le globe en rotation à droite ;
 *  4. #comment   (paper) la méthode d'achat en trois temps, et le mot de la fin.
 * La zone « Comment » est arrivée le 14/09/2026, après les trois autres : les images du document
 * fourni étaient coupées, elle n'y figurait pas.
 * Ce qui a disparu avec elles : le mot d'ordre en scène épinglée, les piliers et leurs pictos, la
 * CARTE (elle montrait le Conseil de l'Europe et le Canada, la page dit désormais « partout dans le
 * monde » : elle disait le contraire du texte), les pastilles de types d'actifs, l'effet de levier et
 * les quatre appels de note.
 *
 * FONDS. Un seul bloc sombre, le dernier. L'en-tête de la page est déjà sombre : une première section
 * ink enchaînerait deux pavés sombres sans coupure, et un test l'interdit sur toutes les sous-pages.
 * Le ton ink ferme ici la page au lieu de l'ouvrir, et porte la phrase la plus courte du document.
 *
 * UNE SEULE MENTION DE RISQUE, en fin de zone 2 : celle que la Conformité a placée elle-même le
 * 14/09/2026, rendue par ui/NoteConformite.astro et non par RiskNote, qui ne rend plus rien. L'en-tête
 * n'en porte plus. D'où l'absence de [data-advantage] et de RiskNote dans le reste de la page.
 *
 * Motion (src/scripts/motion.ts, tout par attributs) : aucun rideau, la section suit directement
 * l'en-tête ; H2 du premier chapitre mot à mot (data-reveal-text), les deux autres en
 * fade-up court ; filets qui s'étirent (data-draw="width") ; listes en cascade ; photos en cascade
 * avec parallaxe de sens alterné dans chaque cadre (élément surdimensionné de ±12 % pour ne jamais
 * découvrir le bord).
 * Contenu : src/content/fr/strategy.ts ; photos : src/content/fr/media.ts.
 * Aucune prop : la section n'appelle plus de note, elle n'a plus besoin du registre de la page.
 */
import { Picture } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import NoteConformite from '@/components/ui/NoteConformite.astro';
import Picto from '@/components/ui/Picto.astro';
import Section from '@/components/ui/Section.astro';
import StrategyGlobe from '@/components/StrategyGlobe.astro';
import { sections } from '@/config/sections';
import { media, AFFICHER_LEGENDES } from '@/content/fr/media';
import { strategy } from '@/content/fr/strategy';
import { resolveImage } from '@/lib/images';

const id = sections.strategy.id;
/** Ancres des deux autres chapitres (ids HTML, pas les textes affichés). */
const ids = { what: 'quoi', where: 'ou', how: 'comment' };

/** Une illustration par moteur, dans l'ordre des items de `strategy.engines`. */
const enginePhotos = await Promise.all(
  media.engines.map(async (m) => ({ ...m, image: await resolveImage(m.src) }))
);
/**
 * Les trois photos portent la même mention (« Photo d'illustration. Immeuble non détenu par R Start. ») :
 * une seule légende sous la bande suffit. Répétée trois fois côte à côte, elle occupait trois colonnes
 * pour dire la même chose. Si les crédits diffèrent un jour, chaque photo reprend le sien.
 */
/** Parallaxe des trois photos : douce, sens alterné (haut, bas, haut) ; cadres surdimensionnés de ±12 %. */
/** Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. */
const QUIET_TITLE_Y = 12;
---

{/* 1. Les deux moteurs de performance */}
<Section id={id} tone="paper" class="overflow-hidden">
  <Container size="wide">
    <header class="max-w-5xl">
      <h2 id={id + '-title'} class="text-display-lg text-ink" data-reveal-text>
        {strategy.engines.title}
      </h2>
    </header>

    <ul
      role="list"
      class="mt-chapter grid gap-8 sm:grid-cols-2 lg:gap-12"
      data-animate="stagger"
      data-animate-stagger="0.12"
    >
      {
        /*
         * CARTES ILLUSTRÉES depuis le 15/09/2026 (« créer des cards différentes avec des illustrations
         * pour illustrer »). Avant : un filet, un numéro, deux lignes de texte, à même le fond.
         * Le bandeau garde le RAPPORT NATIF des illustrations (2,36) : posé dans un cadre 16/9 il se
         * ferait rogner sur les côtés, or ces images se lisent dans la largeur, c'est leur perspective
         * qui porte le sujet.
         * Le numéro passe SUR l'image, dans une pastille : sous elle, il répétait le rôle du filet qu'il
         * remplace, et la carte commençait par deux lignes de service avant son titre.
         */
      }
      {
        strategy.engines.items.map((item, i) => (
          <li class="card-lift flex flex-col overflow-hidden rounded-3xl bg-white shadow-card ring-1 ring-navy/5">
            <div class="relative aspect-[236/100] overflow-hidden">
              {enginePhotos[i] && (
                <Picture
                  src={enginePhotos[i].image}
                  alt={enginePhotos[i].alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 40rem) 45vw, 100vw"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpeg"
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'block h-full w-full' }}
                  class="h-full w-full object-cover"
                />
              )}
              <p
                class="text-caption absolute left-4 top-4 flex size-10 items-center justify-center rounded-full bg-white/95 font-semibold tabular-nums text-teal-700 shadow-card"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </p>
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <p class="text-display-sm text-navy">{item.lead}</p>
              {item.rest && <p class="text-lead mt-3 text-slate-700">{item.rest}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      /* La phrase de méthode ferme le chapitre : elle explique ce que les deux moteurs supposent de
        travail. Détachée par un filet plein largeur, dans la taille des introductions. */
    }
    {
      /* La phrase de méthode fermait ce chapitre ; elle ouvre maintenant « Tout commence par le
        choix des immeubles » (16/09/2026). Le rendu reste, conditionnel : si la Conformité ou
        l'équipe redonnent une chute aux deux moteurs, elle s'affichera sans rien changer ici. */
    }
    {strategy.engines.outro && (
      <p
      class="text-lead mt-12 max-w-4xl border-t border-navy/15 pt-8 text-pretty text-slate-700 lg:mt-16"
      data-animate="fade-up"
      data-animate-y={String(QUIET_TITLE_Y)}
    >
      {strategy.engines.outro}
    </p>
    )}

    {
      /* Mention de la Conformité, jamais animée : un avertissement ne dépend pas d'un défilement pour
        apparaître. Elle referme la zone, sous la phrase de méthode qu'elle qualifie. */
    }
    {
      strategy.engines.disclaimer && (
        <NoteConformite text={strategy.engines.disclaimer} class="mt-8 max-w-4xl" />
      )
    }
  </Container>
</Section>

{/* 2. Quoi : le double potentiel visé, illustré par les immeubles */}
{
  /*
   * LES TROIS ZONES SONT RÉUNIES EN UN SEUL BLOC (16/09/2026, demande de l'équipe : « que le contenu
   * des blocs QUOI OÙ et COMMENT soient dans un même bloc avec plusieurs cards »). C'étaient trois
   * sections pleine page, #quoi en blanc, #ou en ink, #comment en paper : trois écrans pour un propos
   * qui se lit d'un coup.
   *
   * AUCUN TEXTE N'EST AJOUTÉ NI RETIRÉ. Les trois surtitres, les trois titres, les introductions, les
   * listes et les chutes sont ceux de strategy.ts, dans le même ordre. Les trois titres restent des
   * H2, comme avant la fusion : le plan du document ne change pas.
   * La section elle-même n'a donc PAS de titre à elle, il aurait fallu l'inventer.
   *
   * MOBILE D'ABORD, et c'est ce qui commande la mise en page : une colonne, chaque carte entière et
   * lisible sans un geste. Pas d'onglets, qui auraient caché deux tiers du propos derrière une
   * pression du doigt et cessé de fonctionner sans script. Trois colonnes seulement à partir de `lg`,
   * où la largeur le permet.
   * `items-start` sur la grille : sans lui les trois cartes prennent la hauteur de la plus haute, et
   * « Où » traînerait un tiers de vide sous sa liste de deux items.
   * La chute est poussée en bas par `mt-auto` : les trois se posent alors sur la même ligne de fond
   * quand les cartes ont la même hauteur, et restent collées à leur liste sinon.
   */
}
<Section id={ids.what} tone="paper">
  <Container size="wide">
    <ul
      role="list"
      class="grid items-start gap-6 lg:grid-cols-3 lg:gap-8"
      data-animate="stagger"
      data-animate-stagger="0.1"
    >
      {
        [strategy.what, strategy.where, strategy.how].map((zone, z) => (
          <li class="flex h-full flex-col rounded-3xl bg-white p-6 shadow-card ring-1 ring-navy/5 sm:p-8">
            {zone.eyebrow && <p class="text-eyebrow text-teal-700">{zone.eyebrow}</p>}
            <h2 id={[ids.what, ids.where, ids.how][z] + '-title'} class="text-display-sm mt-3 text-ink">
              {zone.title}
            </h2>
            <p class="mt-4 text-base leading-snug text-slate-700">{zone.intro}</p>
            {zone.lead && <p class="mt-4 text-base font-semibold text-ink">{zone.lead}</p>}

            <ul role="list" class="mt-4 space-y-3">
              {zone.items.map((item) => (
                <li class="flex items-start gap-3">
                  {
                    /* Puce dessinée quand l'item porte une icône, point turquoise sinon : c'est le
                      contenu qui décide, pas la zone (strategy.ts, champ `icon`). */
                  }
                  {item.icon ? (
                    <Picto name={item.icon} class="mt-0.5 size-6 text-teal-700" />
                  ) : (
                    <span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-teal-700" />
                  )}
                  <p class="text-base leading-snug text-ink">
                    {item.lead}
                    {item.rest && <span class="mt-1 block text-slate-700">{item.rest}</span>}
                  </p>
                </li>
              ))}
            </ul>

            {
              /* LE GLOBE RESTE DANS SA ZONE, « Où ». Il est en `aspect-ratio: 1` et suit donc la
                largeur de sa carte ; borné à 13rem pour qu'il ne prenne pas un écran entier sur
                téléphone, où la carte occupe toute la largeur. */
            }
            {zone.map && (
              <div class="mx-auto mt-6 w-full max-w-[13rem]">
                <StrategyGlobe>
                  {AFFICHER_LEGENDES && (
                    <figcaption class="text-caption mt-4 text-center text-slate-700">
                      {zone.map.legend}
                    </figcaption>
                  )}
                </StrategyGlobe>
              </div>
            )}

            <p class="mt-auto pt-6 text-base leading-snug text-slate-700">{zone.outro}</p>
          </li>
        ))
      }
    </ul>

    {
      /*
       * BANDE DE TROIS PHOTOS RETIRÉE le 16/09/2026, demande de l'équipe. Elle fermait la zone « Quoi »
       * avant la fusion, puis le bloc entier après elle : trois cadres en 4/5, parallaxe de sens
       * alterné, trois colonnes dès le téléphone.
       * Les trois illustrations restent dans media.ts (`strategy`) et dans src/assets/images : rien
       * n'est perdu, et elles continuent d'être livrées au navigateur tant qu'elles sont dans ce
       * dossier. À déplacer vers src/assets/vivier si elles ne doivent plus servir du tout.
       */
    }
  </Container>
</Section>
