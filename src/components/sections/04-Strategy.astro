---
/**
 * Section 4 — Stratégie (id « strategie »). Chapitre sur fond ink (alternance avec Points forts et Frais).
 * En-tête, mot d'ordre en très grand, introduction (data-advantage) et son contre-poids (mottoRisk,
 * RiskNote de même taille), deux leviers en deux colonnes, trois photos d'immeubles (avec crédit
 * visible), trois piliers avec leur contre-poids, zone d'investissement avec carte stylisée (Canada +
 * Europe, SVG décoratif aria-hidden), types d'actifs en liste de pastilles (texte courant), effet de
 * levier en paire avantage / risque (text-lead).
 * Motion (src/scripts/motion.ts, tout par attributs) :
 *  - en-tête : surtitre en fade-up, H2 mot à mot (data-reveal-text) ;
 *  - mot d'ordre en scène épinglée à trois temps (data-scene) : la formule « Acheter décoté,
 *    valoriser, revendre » est découpée sur ses virgules en trois [data-step] en très grand, chacun
 *    restant affiché (data-step-stay) — à la fin de la scène la formule complète est lisible, avec ses
 *    virgules, et le HTML statique la contient intégralement (sans JS, tout est visible) ; pas de
 *    scene-stack : les temps s'empilent ligne à ligne. L'introduction (avantage) et son contre-poids
 *    sont dans la scène mais HORS des steps : visibles du premier au dernier temps, dans le même bloc
 *    et la même taille. Si la formule n'a pas exactement trois temps, rendu statique classique ;
 *  - leviers : filet qui s'étire (data-draw="width") puis numéro + titre + texte en cascade (stagger) ;
 *  - photos : cascade des cadres, et dans chaque cadre une parallaxe de sens alterné (data-parallax,
 *    élément surdimensionné de ±12 % pour ne jamais découvrir le bord) ;
 *  - piliers : seul le bloc picto + titre arrive en cascade (data-animate="tilt", délai incrémental)
 *    et le picto flotte doucement au scroll (data-scrub) ; description et RiskNote restent statiques,
 *    aucun ancêtre d'un [data-risk] n'est animé ;
 *  - carte : contours du Canada et de l'Europe tracés au fil du défilement (data-draw + data-draw-scrub),
 *    aplats et trame en fondu, puis points lumineux qui s'allument en cascade (data-animate="stagger",
 *    cercles décoratifs sans signification géographique) ;
 *  - pastilles des types d'actifs en cascade rapide ; effet de levier : filet étiré + titre en fade-up,
 *    paire avantage / risque intacte.
 * Contenu : src/content/fr/strategy.ts ; visuels : src/content/fr/media.ts.
 */
import { Image, Picture } from 'astro:assets';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { media, pictos, type PictoKey } from '@/content/fr/media';
import { strategy } from '@/content/fr/strategy';
import { resolveImage } from '@/lib/images';

const id = sections.strategy.id;
const titleId = id + '-title';
const pillars = await Promise.all(
  strategy.pillars.map(async (pillar) => {
    const picto = pictos[pillar.icon as PictoKey];
    if (!picto) throw new Error(`Pictogramme inconnu dans strategy.ts : ${pillar.icon}`);
    return { ...pillar, picto: await resolveImage(picto.src) };
  })
);
const photos = await Promise.all(media.strategy.map(async (m) => ({ ...m, image: await resolveImage(m.src) })));
const photoSizes = '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw';
/** Décalage de la cascade entre deux piliers (secondes). */
const STAGGER = 0.09;
/** Parallaxe des trois photos : douce, sens alterné (haut, bas, haut) ; cadres surdimensionnés de ±12 %. */
const PHOTO_PARALLAX = [0.035, -0.03, 0.04];
/** Flottement des pictos des piliers au scroll (px, sens alterné). */
const PICTO_FLOAT = ['y:10,-10', 'y:-8,8', 'y:12,-12'];

/**
 * Mot d'ordre en trois temps : la formule de facts.ts est découpée sur ses virgules (« Acheter
 * décoté, valoriser, revendre »). La scène n'est montée que si l'on obtient exactement trois temps ;
 * chaque temps est rendu avec sa virgule pour conserver la formule exacte.
 */
const mottoSteps = strategy.motto ? strategy.motto.split(',').map((s) => s.trim()).filter(Boolean) : [];
const mottoScene = mottoSteps.length === 3;

/**
 * Carte stylisée : silhouettes simplifiées du Canada et de l'Europe (polygones lon/lat approximatifs
 * projetés en Mercator atténué), remplies d'une trame de points teal. Purement décorative.
 */
const MAP_W = 960;
const MAP_H = 420;
const MAP_CANADA =
  'M20.1 250.2L20.1 176.1L50.3 175.2L85.4 170L115.6 175.2L145.8 183.8L175.9 186.3L206.1 184.6L236.2 185.5L261.4 180.4L276.4 188.8L296.5 201.1L286.5 220.6L271.4 231.9L261.4 250.2L256.3 260.8L266.4 271.2L286.5 276.7L301.6 283.4L314.1 298.1L324.2 307.8L331.7 301.3L331.7 288.1L339.3 274.6L336.8 257.3L339.3 234.2L361.9 231.9L382 246.6L402.1 253.7L412.1 262.9L422.2 278L432.3 288.1L447.3 304.6L444.8 317.5L434.8 327L422.2 336.4L407.1 339.5L397.1 333.3L402.1 323.8L387 325.1L404.6 342.6L422.2 345.7L409.6 353.1L397.1 351.9L392 345.7L377 346.9L356.9 348.8L341.8 354.9L329.2 359.8L311.6 365.8L314.1 345.7L304.1 339.5L281.5 330.2L251.3 323.8L175.9 323.8L110.6 323.8L100.5 317.5L88 307.8L77.9 294.8L67.9 284.8L55.3 267.7L42.7 257.3L27.6 250.2ZM402.1 235.6L371.9 220.6L341.8 201.1L326.7 180.4L306.6 158.4L336.8 144.3L366.9 158.4L397.1 180.4L417.2 201.1L412.1 220.6ZM135.7 176.1L165.9 170L201 167.4L216.1 153.7L196 144.3L160.8 142.4L130.7 149.1L140.7 162.9ZM306.6 111.6L326.7 113.8L346.8 96.9L366.9 84.9L377 65.5L356.9 43.8L316.6 51.3L296.5 78.6L301.6 102.7ZM105.5 157.4L130.7 142.4L155.8 128.5L175.9 122.3L160.8 113.8L125.7 118.1L110.6 134.5L103 148.1Z';
const MAP_EUROPE =
  'M681.5 359.8L684.6 373L682.6 385L684.6 395.6L697.6 401.4L706.2 398.5L717.7 397.9L726.3 389.1L729.8 382L736.3 373L744.9 365.2L744.9 358L756.4 359.2L765 356.1L775 353.1L781.6 359.8L786.6 365.8L796.6 373L806.7 379L809.2 387.3L811.7 380.2L818.3 377.2L821.8 379L809.2 368.2L799.2 363.4L793.1 356.1L790.6 348.8L797.2 345.1L801.7 348.8L809.2 358L821.8 365.2L826.8 370L831.8 382L836.9 389.1L842.4 399.7L848.4 392.6L845.4 383.8L846.9 377.2L857 374.2L862 376L869.5 371.9L874.6 370.6L869.5 358L872 350L882.1 340.1L892.1 343.9L899.7 351.9L909.7 347.6L922.3 336.4L929.8 333.3L929.8 304.6L929.8 264.3L929.8 228.2L914.8 205L894.7 201.1L924.8 184.6L894.7 175.2L869.5 162.9L849.4 164.7L829.3 173.5L809.2 186.3L794.1 205L779.1 220.6L766.5 231.2L753.9 239.3L754.9 255.1L764 264.3L774 258.7L781.6 253L786.1 260.8L790.6 275.3L794.1 281.4L801.7 278L811.7 269.8L814.2 259.4L821.8 250.2L816.8 239.3L826.8 225.9L836.9 214.5L846.9 207.4L855.5 211.4L839.4 224.4L835.9 239.3L841.9 250.2L854.5 248.7L872 246.6L879.6 250.9L867 254.4L849.4 254.4L846.9 262.2L850.4 269.8L836.9 268.4L834.3 276.7L833.3 283.4L826.8 288.1L816.8 286.8L804.2 290.1L791.6 288.8L784.1 291.4L779.1 287.4L776 281.4L770 272.6L772.5 269.1L780.1 269.8L781.6 278L778.1 283.4L772 285.4L773 290.1L765 294.8L754.9 296.7L749.9 304.6L745.9 308.5L739.9 311.1L736.8 314.3L729.8 320L722.3 320L719.7 326.4L705.7 327L707.2 331.4L717.2 335.2L721.3 342.6L722.3 351.9L719.7 358.6L708.7 358.6L696.1 357.4L686.1 358ZM700.6 317.5L712.2 314.3L723.8 313L735.8 310.4L736.8 300L729.8 294.1L726.8 287.4L720.8 280.7L717.7 269.8L719.7 267.1L711.7 260.8L703.7 260.1L697.6 267.7L700.6 274.6L704.7 280.7L713.2 286.1L712.7 291.4L705.7 295.4L707.7 302.6L702.7 306.5L707.7 309.8ZM678.5 305.9L688.6 307.2L698.1 303.3L698.6 294.8L697.6 288.8L691.1 282.8L681 289.5L677.5 298.1ZM608.2 209.8L620.7 219.1L643.4 224.4L659.4 215.2L655.9 203.5L633.3 201.1L615.7 201.9ZM860.5 377.8L872 374.2L884.6 371.3L899.7 367L914.8 371.9L934.9 370.6L948.9 374.2L952.5 385L944.9 394.4L929.8 396.8L912.3 401.4L894.7 401.4L879.6 400.3L869.5 398.5L865.5 388.5L862 383.2ZM791.1 390.3L806.7 389.7L805.2 397.9L792.1 393.2ZM770 372.4L777.5 372.4L777 384.4L771 385ZM772 361L776.5 362.8L775.5 370L772.5 367.6Z';
/**
 * Points lumineux de la carte (coordonnées dans le viewBox), répartis dans les silhouettes : purement
 * décoratifs, sans correspondance avec des villes ni des actifs — la carte est aria-hidden.
 */
const MAP_POINTS: ReadonlyArray<readonly [number, number]> = [
  [60, 230],
  [120, 250],
  [200, 262],
  [150, 300],
  [240, 300],
  [300, 315],
  [350, 265],
  [400, 290],
  [335, 80],
  [370, 190],
  [635, 212],
  [700, 380],
  [722, 300],
  [760, 340],
  [800, 240],
  [838, 382],
  [880, 300],
  [912, 260],
  [905, 385],
];
---

<Section id={id} tone="ink" class="overflow-hidden">
  <Container size="wide" class="relative">
    <header class="max-w-4xl">
      <p data-animate="fade-up" class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-teal-200">
        {strategy.eyebrow}
      </p>
      <h2 id={titleId} class="text-display-lg" data-reveal-text>{strategy.title}</h2>
    </header>

    {/* Mot d'ordre en très grand + introduction (avantage) et son contre-poids, même taille, jamais animé */}
    {
      mottoScene ? (
        <div class="mt-block">
          <div data-scene data-scene-start="top 72px" data-scene-end="+=100%" class="py-4">
            <p class="text-display-lg lg:text-display-xl text-sand">
              {mottoSteps.map((step, i) =>
                i < mottoSteps.length - 1 ? (
                  <span data-step data-step-stay class="block">{step},</span>
                ) : (
                  <span data-step data-step-stay class="block">{step}<NoteRef id="strategie-mot-d-ordre" /></span>
                )
              )}
            </p>
            <div class="mt-8 grid gap-6 text-white sm:grid-cols-2 lg:mt-10 lg:gap-10">
              <p data-advantage class="text-lead">{strategy.intro}</p>
              {strategy.mottoRisk && (
                <RiskNote text={strategy.mottoRisk} tone="dark" size="lead" class="border-t border-white/15 pt-5 sm:border-t-0 sm:pt-0" />
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="mt-block grid gap-6 lg:grid-cols-12 lg:gap-10">
          {strategy.motto && (
            <p class="text-display-md text-sand lg:col-span-7" data-animate="fade-up">
              {strategy.motto}
              <NoteRef id="strategie-mot-d-ordre" />
            </p>
          )}
          <div class:list={['max-w-2xl text-white', strategy.motto ? 'lg:col-span-5 lg:pt-2' : 'lg:col-span-12']}>
            <p data-advantage class="text-lead" data-animate="fade-up" data-animate-delay="0.1">
              {strategy.intro}
            </p>
            {strategy.mottoRisk && (
              <RiskNote text={strategy.mottoRisk} tone="dark" size="lead" class="mt-5 border-t border-white/15 pt-5" />
            )}
          </div>
        </div>
      )
    }

    {/* Deux leviers */}
    <div class="mt-section-sm">
      {strategy.leversTitle && <p class="text-eyebrow text-teal-200" data-animate="fade-up">{strategy.leversTitle}</p>}
      <ul role="list" class="mt-6 grid gap-6 sm:grid-cols-2 lg:gap-8" data-animate="stagger" data-animate-stagger="0.12">
        {
          strategy.levers.map((lever, i) => (
            <li>
              <span aria-hidden="true" data-draw="width" class="block h-px w-full bg-white/20"></span>
              <div class="pt-6">
                <p class="text-caption font-semibold tabular-nums text-teal-200" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3 class="text-display-sm mt-3 text-white">{lever.title}</h3>
                <p class="text-lead mt-4 text-white">{lever.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Trois photos d'immeubles, crédit visible, parallaxe de sens alterné dans chaque cadre */}
    <ul role="list" class="mt-section-sm grid gap-5 sm:grid-cols-3 lg:gap-6" data-animate="stagger" data-animate-stagger="0.1">
      {
        photos.map((photo, i) => (
          <li>
            <figure>
              <div class="img-frame aspect-[4/3] sm:aspect-[4/5]">
                <div
                  class="absolute inset-x-0 -top-[12%] h-[124%]"
                  data-parallax={String(PHOTO_PARALLAX[i] ?? PHOTO_PARALLAX[0])}
                  data-parallax-trigger="parent"
                >
                  <Picture
                    src={photo.image}
                    alt={photo.alt}
                    widths={[480, 800, 1200]}
                    sizes={photoSizes}
                    formats={['avif', 'webp']}
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'block h-full w-full' }}
                    class={i === 1 ? 'h-full w-full object-cover object-[70%_50%]' : 'h-full w-full object-cover'}
                  />
                </div>
              </div>
              {photo.credit && <figcaption class="text-caption mt-3 text-white/90">{photo.credit}</figcaption>}
            </figure>
          </li>
        ))
      }
    </ul>

    {/* Trois piliers, chacun avec son contre-poids */}
    <div class="mt-section-sm">
      {strategy.pillarsTitle && <p class="text-eyebrow text-teal-200" data-animate="fade-up">{strategy.pillarsTitle}</p>}
      <ul role="list" class="mt-6 grid gap-5 lg:grid-cols-3 lg:gap-6">
        {
          pillars.map((pillar, i) => (
            <Card as="li" tone="glass" class="flex flex-col">
              <div data-animate="tilt" data-animate-delay={String(i * STAGGER)}>
                <Image
                  src={pillar.picto}
                  alt=""
                  aria-hidden="true"
                  width={112}
                  height={112}
                  densities={[1, 2]}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  data-scrub={PICTO_FLOAT[i] ?? PICTO_FLOAT[0]}
                  class="size-24 object-contain object-left-bottom sm:size-28"
                />
                <h3 class="text-display-sm mt-6 text-white">{pillar.title}</h3>
              </div>
              <p data-advantage class="mt-4 text-base leading-relaxed text-white">
                {pillar.description}
              </p>
              <RiskNote text={pillar.risk} tone="dark" class="mt-4 border-t border-white/15 pt-4" />
            </Card>
          ))
        }
      </ul>
    </div>

    {/* Zone d'investissement : carte stylisée + texte et contre-poids */}
    <div class="mt-section-sm grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <p class="text-eyebrow text-teal-200" data-animate="fade-up">{strategy.zone.countriesLabel}</p>
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox={`0 0 ${MAP_W} ${MAP_H}`}
          width={MAP_W}
          height={MAP_H}
          class="mt-4 aspect-[960/420] h-auto w-full text-teal-400"
        >
          <defs>
            <pattern id={id + '-map-dots'} width="9" height="9" patternUnits="userSpaceOnUse">
              <circle cx="4.5" cy="4.5" r="2.1" fill="currentColor"></circle>
            </pattern>
            <linearGradient id={id + '-map-fade'} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0.9" stop-color="#fff"></stop>
              <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
            </linearGradient>
            <mask id={id + '-map-mask'}>
              <rect width="100%" height="100%" fill={`url(#${id}-map-fade)`}></rect>
            </mask>
          </defs>
          <g mask={`url(#${id}-map-mask)`} stroke-linejoin="round">
            {/* Aplats et trame : fondu une fois les contours engagés */}
            <g data-animate="fade" data-animate-delay="0.35">
              <path d={MAP_CANADA} fill="currentColor" fill-opacity="0.14"></path>
              <path d={MAP_CANADA} fill={`url(#${id}-map-dots)`}></path>
              <path d={MAP_EUROPE} fill="currentColor" fill-opacity="0.14"></path>
              <path d={MAP_EUROPE} fill={`url(#${id}-map-dots)`}></path>
            </g>
            {/* Contours tracés au fil du défilement (Canada, puis Europe) */}
            <g
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.75"
              stroke-width="1.75"
              data-draw
              data-draw-scrub
              data-draw-stagger="0.4"
              data-draw-start="top 85%"
              data-draw-end="center 45%"
            >
              <path d={MAP_CANADA}></path>
              <path d={MAP_EUROPE}></path>
            </g>
            {/* Points lumineux décoratifs : s'allument en cascade */}
            <g data-animate="stagger" data-animate-stagger="0.08" data-animate-y="0" data-animate-delay="0.6">
              {
                MAP_POINTS.map(([x, y]) => (
                  <g>
                    <circle cx={x} cy={y} r="10" fill="currentColor" fill-opacity="0.28"></circle>
                    <circle cx={x} cy={y} r="3.5" class="text-sand" fill="currentColor"></circle>
                  </g>
                ))
              }
            </g>
          </g>
        </svg>
      </div>
      <div class="lg:col-span-5">
        <h3 class="text-display-sm text-white" data-animate="fade-up">
          {strategy.zone.title}
          <NoteRef id="strategie-objectif" />
        </h3>
        <p data-advantage class="text-lead mt-4 text-white">{strategy.zone.description}</p>
        <RiskNote text={strategy.zone.risk} tone="dark" size="lead" class="mt-5 border-t border-white/15 pt-5" />
      </div>
    </div>

    {/* Types d'actifs */}
    <div class="mt-section-sm">
      {
        strategy.assetTypesLabel && (
          <p class="text-eyebrow text-teal-200" data-animate="fade-up">
            {strategy.assetTypesLabel}
            <span class="text-lead"><NoteRef id="strategie-actifs" /></span>
          </p>
        )
      }
      <ul role="list" class="mt-5 flex flex-wrap gap-2.5" data-animate="stagger" data-animate-stagger="0.04" data-animate-y="12">
        {
          strategy.assetTypes.map((type) => (
            <li class="rounded-full bg-white/10 px-4 py-2 text-base leading-snug text-white ring-1 ring-white/15">{type}</li>
          ))
        }
      </ul>
    </div>

    {/* Effet de levier : avantage et risque dans le même bloc */}
    <div class="mt-section-sm">
      <span aria-hidden="true" data-draw="width" class="block h-px w-full bg-white/20"></span>
      <div class="pt-8 lg:grid lg:grid-cols-12 lg:gap-12">
        {
          strategy.leverageTitle && (
            <h3 class="text-display-sm text-white lg:col-span-5" data-animate="fade-up">
              {strategy.leverageTitle}
              <NoteRef id="strategie-endettement" />
            </h3>
          )
        }
        <div class="mt-4 space-y-5 text-white lg:col-span-7 lg:mt-0">
          <p data-advantage class="text-lead">{strategy.leverage.advantage}</p>
          <RiskNote text={strategy.leverage.risk} tone="dark" size="lead" class="border-t border-white/15 pt-5" />
        </div>
      </div>
    </div>
  </Container>
</Section>
