---
/**
 * Accueil, zone 3 : LE COMPARATEUR DE FRAIS (15/09/2026, demande de l'équipe : « Remets le
 * Comparateur après R Start en un clin d'œil »). Enveloppe MINCE : tout le travail est dans
 * components/pages/frais/FeeComparator.astro, qui rend son propre <Section>, son titre et ses
 * sources. Deux rendus du même composant, aucun contenu dupliqué, les deux pages ne peuvent pas
 * diverger. L'IDENTIFIANT VIENT DU REGISTRE (config/sections.ts, clé `fees`, ancre « frais ») et
 * non d'une chaîne écrite ici : c'est le contrat des sections de l'accueil.
 *
 * Ce qu'il faut savoir côté Conformité : la seule exigence encore attachée au comparatif, la source
 * des chiffres, est contrôlée par scripts/check-compliance.mjs sur la seule page /frais ; le
 * périmètre de l'analyse et l'encadré « Une innovation, pas une révolution » ont quitté l'écran le
 * 14/09/2026 et le code le 22/09/2026. Le tableau nomme des sociétés de gestion tierces : s'il faut
 * un jour rétablir ces mentions, elles devront l'être sur les DEUX pages.
 */
import FeeComparator from '@/components/pages/frais/FeeComparator.astro';
import { sections } from '@/config/sections';
import { comparator } from '@/content/fr/comparator';

const { id } = sections.fees;
---

{/* Titre visible ici seulement : l'accueil arrive sur ce tableau sans autre contexte. */}
<FeeComparator id={id} heading={comparator.homeHeading} />
