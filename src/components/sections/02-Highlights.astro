---
/**
 * Section 2, « R Start en un clin d'œil » (id « points-forts »). Fond paper (voir plus bas), entre
 * le bandeau « Points essentiels à connaître » (01c, ink) et le comparateur de frais (03, white),
 * dans l'ordre de HOME_ORDER (index.astro).
 * En-tête aligné à gauche (H2 rendu ici pour porter ses attributs motion), puis six cartes, le bloc
 * « Souscription et options disponibles » et le bouton vers /strategie.
 * La valeur est l'image : la valeur de chaque carte (« 200 € », « 4 sur 7 », « Mensuels »…) est
 * l'élément visuel principal, en marine (text-display-sm), même utilitaire pour les six (chiffres
 * et valeurs en toutes lettres : aucune hiérarchie de taille entre elles). Le libellé est AU-DESSUS de
 * la valeur et, sur trois cartes, un bouton « i » déplie une explication. Ni pictogramme, ni
 * description, ni contre-poids par carte.
 * Motion (src/scripts/motion.ts), un seul effet d'entrée par bloc :
 *  - en-tête : H2 mot à mot (data-reveal-text ; H1 interdit, H2 autorisé) ;
 *  - chaque carte (li) entre d'un bloc en fade-up. Chaque carte ayant son propre déclencheur, le
 *    délai alterne 0 / 0,08 s selon `i % COLUMNS`, pas selon l'index : une carte qui entre seule
 *    n'attend pas la cascade des précédentes ;
 *  - valeurs : statiques et exactes (pas de compteur : « 200 € », « 4 sur 7 », « 1er jour du 6e
 *    mois » sont des caractéristiques réglementaires ; ni mot à mot, réservé aux H2 de chapitre).
 * Sans JS / reduced-motion : HTML complet et statique, valeurs exactes.
 * Contenu : src/content/fr/highlights.ts.
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { highlights } from '@/content/fr/highlights';

/** Aucune valeur n'est comptée ni découpée : la clé `icon` du contenu n'est plus lue ici (pictos non rendus). */
const cards = highlights.cards;
/** Décalage de la cascade entre les deux colonnes d'une rangée (secondes) ; la seconde colonne suit la première. */
const STAGGER = 0.08;
/** Colonnes de la grille dès `sm` : le délai se calcule par colonne, pas par carte. */
const COLUMNS = 2;
const titleId = sections.highlights.id + '-title';

/*
 * ORDINAUX EN EXPOSANT (16/09/2026, demande de l'équipe : « 1er jour du 6ème mois, mettre en
 * exposant »). LE CONTENU RESTE DU TEXTE : écrire « 1<sup>er</sup> » dans highlights.ts obligerait
 * à rendre ces valeurs en `set:html`, et à faire confiance à une chaîne pour du balisage ; d'autres
 * pages lisent la même donnée et y afficheraient les balises. La découpe se fait ici, au rendu.
 * Le motif ne reconnaît qu'un NOMBRE SUIVI DE SON SUFFIXE ORDINAL en fin de mot : « 1er », « 6e »,
 * « 2de ». Les autres valeurs passent au travers sans être touchées (« 8 ans minimum » n'a pas de
 * suffixe collé au chiffre, « 10 € » non plus).
 * LE RENDU TIENT SUR UNE SEULE LIGNE, et ce n'est pas une coquetterie : un retour à la ligne entre
 * deux expressions JSX produit une espace dans le HTML, et on lisait « 1 er jour du 6 e mois ».
 */
const enExposant = (
  valeur: string
): (string | { chiffre: string; suffixe: string })[] =>
  valeur.split(/(\d+(?:ers?|res?|es?|ds?|des?)\b)/).map((bout) => {
    const m = /^(\d+)(ers?|res?|es?|ds?|des?)$/.exec(bout);
    return m?.[1] && m[2] ? { chiffre: m[1], suffixe: m[2] } : bout;
  });

---

{
  /* FOND CLAIR depuis le 22/09/2026 (demande de Martin), ex-ink depuis le 14/09/2026 : section
    paper, repères en cartes blanches à ombre portée (« qu'elles ressortent un peu plus », le même
    jour ; cerclées sur blanc, elles se fondaient dans la page), valeurs en marine. */
}
<Section id={sections.highlights.id} tone="paper">
  <Container size="wide">
    <header>
      <h2 id={titleId} class="text-display-lg text-balance text-ink" data-reveal-text>
        {highlights.title}
      </h2>
      {
        highlights.intro && (
          <p
            data-animate="fade-up"
            data-animate-delay="0.1"
            class="text-lead mt-6 max-w-3xl opacity-90"
          >
            {highlights.intro}
          </p>
        )
      }
    </header>

    {
      /* Six blocs simples en 3 × 2 : un libellé, une valeur. Le contre-poids de la section, sous la
        grille, a été retiré du contenu le 14/09/2026 (voir highlights.ts). */
    }
    <ul role="list" class="mt-chapter grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        cards.map((card, i) => (
          <li
            class="rounded-3xl bg-white p-6 shadow-card ring-1 ring-navy/5 sm:p-8"
            data-animate="fade-up"
            data-animate-delay={String((i % COLUMNS) * STAGGER)}
          >
            {/* Sans libellé, la valeur se suffit à elle-même (« 100 % Digital »). */}
            {card.label && (
              <p class="flex items-center gap-2 text-base font-medium text-slate-700">
                <span>{card.label}</span>
                {card.info && (
                  <button
                    type="button"
                    data-info-bouton
                    hidden
                    aria-expanded="false"
                    aria-controls={'info-' + i}
                    class="info-bouton"
                  >
                    <span aria-hidden="true">i</span>
                    <span class="visually-hidden">
                      {highlights.labels?.info} : {card.label}
                    </span>
                  </button>
                )}
              </p>
            )}
            <p class:list={['text-display-sm text-navy', card.label && 'mt-2']}>
              {enExposant(card.value).map((b) => (typeof b === 'string' ? b : <>{b.chiffre}<sup class="ordinal">{b.suffixe}</sup></>))}
            </p>
            {card.info && (
              <div id={'info-' + i} class="info-panneau">
                <p class="text-base leading-snug text-slate-700">{card.info}</p>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    {
      /* Bloc À PART : comment on souscrit et ce qu'on peut automatiser. Un filet et un titre le
        détachent des six repères, et il est rendu sans encadré : ce ne sont pas des
        caractéristiques du produit, mais des modalités. */
      highlights.subscriptionItems && highlights.subscriptionItems.length > 0 && (
        <div class="mt-chapter border-t border-navy/10 pt-8 sm:pt-10">
          {
            /* Le TITRE du bloc est en ink, ses libellés en gris comme ceux des six cartes : un libellé
              nomme, il ne porte pas l'information, le marine est réservé à ce qu'on doit lire, la
              valeur. */
          }
          {highlights.subscriptionTitle && (
            <h3 class="text-display-sm text-ink">{highlights.subscriptionTitle}</h3>
          )}
          <ul role="list" class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-8 lg:mt-8">
            {highlights.subscriptionItems.map((item) => (
              <li class="border-t border-navy/10 pt-4 sm:border-t-0 sm:pt-0">
                <p class="text-base font-medium text-slate-700">{item.label}</p>
                <p class="text-lead mt-1 font-semibold text-navy">
              {enExposant(item.value).map((b) => (typeof b === 'string' ? b : <>{b.chiffre}<sup class="ordinal">{b.suffixe}</sup></>))}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      /* APPEL À L'ACTION DE LA SECTION. `secondary`, le contour marine, et non `primary` : un bouton
        plein aurait le poids d'un CTA de souscription, alors que celui-ci mène à une page du site.
        La hiérarchie de l'accueil reste celle du hero. */
      highlights.secondaryCta && (
        <p class="mt-chapter">
          <Button href={highlights.secondaryCta.href} variant="secondary" size="md">
            {highlights.secondaryCta.label}
          </Button>
        </p>
      )
    }
  </Container>
</Section>

<script>
  /* Dépliage des explications « i » : module partagé avec le comparateur de frais, les deux
     composants coexistent sur l'accueil (src/scripts/infoToggle.ts). */
  import '@/scripts/infoToggle';
</script>
