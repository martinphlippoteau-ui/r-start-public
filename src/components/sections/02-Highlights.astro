---
/**
 * Section 2, Points forts (id « points-forts »). Fond blanc, juste après le hero (ink) et avant « Ce qui
 * change vraiment » (paper) : trame du 10/09/2026, comprendre le produit avant le modèle de frais.
 * En-tête centré façon page produit, puis six cartes. L'en-tête est rendu ici (et non par
 * SectionHeading) pour poser les attributs motion sur le H2.
 * La valeur est l'image : les pictos 3D de banque ont été retirés, la valeur de chaque carte (« 200 € »,
 * « 3 sur 7 », « Chaque mois »…) est rendue en très grand (text-display-lg) comme élément visuel principal,
 * même utilitaire pour les six cartes (chiffres et valeurs en toutes lettres : aucune hiérarchie de taille
 * entre elles). Libellé en text-lead sous la valeur, puis description et contre-poids.
 * Motion (src/scripts/motion.ts), modèle « l'avantage s'anime seul, jamais son enveloppe », passe de
 * sobriété du 11/09/2026 (un seul effet d'entrée par bloc) :
 *  - en-tête : surtitre statique, H2 mot à mot (data-reveal-text ; H1 interdit, H2 autorisé), intro en
 *    fade-up décalée de 0,1 s ;
 *  - dans chaque carte, UN seul effet : le H3 (valeur + libellé) entre en fade-up ; la description
 *    (data-advantage) et la RiskNote sont en place d'emblée. Chaque carte ayant son propre déclencheur, le
 *    délai dépend de la COLONNE (0 / 0,08 s), pas de l'index : en 2e rangée desktop comme sur mobile (une
 *    colonne), une carte qui entre seule n'attend pas la cascade des précédentes ; la RiskNote est leur
 *    sœur dans la carte, jamais enveloppée par un élément animé : aucun ancêtre d'un [data-risk] n'est
 *    animé (règle AMF « aucun avertissement masqué »), la carte elle-même (li) ne porte donc aucun
 *    attribut motion ;
 *  - valeurs : statiques et exactes (plus de compteur, « 200 € », « 3 sur 7 », « 6 mois » sont des
 *    caractéristiques réglementaires, « 100 % » ressemblerait à un taux en cours de comptage, ni mot à
 *    mot, réservé aux H2 de chapitre). Retirés le 11/09/2026 : tilt du H3, fade-up de la description.
 * Sans JS / reduced-motion : HTML complet et statique, valeurs exactes.
 * Contenu : src/content/fr/highlights.ts.
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { highlights } from '@/content/fr/highlights';

/** Aucune valeur n'est comptée ni découpée : la clé `icon` du contenu n'est plus lue ici (pictos non rendus). */
const cards = highlights.cards;
/** Décalage de la cascade entre les deux colonnes d'une rangée (secondes) ; la seconde colonne suit la première. */
const STAGGER = 0.08;
/** Colonnes de la grille dès `sm` : le délai se calcule par colonne, pas par carte. */
const COLUMNS = 2;
const titleId = sections.highlights.id + '-title';

/*
 * ORDINAUX EN EXPOSANT (16/09/2026, demande de l'équipe : « 1er jour du 6ème mois, mettre en exposant »).
 *
 * LE CONTENU RESTE DU TEXTE. Écrire « 1<sup>er</sup> » dans highlights.ts obligerait à rendre ces
 * valeurs en `set:html`, et à faire confiance à une chaîne pour du balisage ; d'autres pages lisent la
 * même donnée et y afficheraient les balises. La découpe se fait donc ici, au rendu.
 *
 * Le motif ne reconnaît qu'un NOMBRE SUIVI DE SON SUFFIXE ORDINAL en fin de mot : « 1er », « 6e »,
 * « 2de ». Les autres valeurs des cartes passent au travers sans être touchées — « 8 ans minimum » n'a
 * pas de suffixe collé au chiffre, « 10 € » non plus.
 *
 * LE RENDU TIENT SUR UNE SEULE LIGNE, et ce n'est pas une coquetterie : un retour à la ligne entre deux
 * expressions JSX produit une espace dans le HTML, et on lisait « 1 er jour du 6 e mois ».
 */
const enExposant = (
  valeur: string
): (string | { chiffre: string; suffixe: string })[] =>
  valeur.split(/(\d+(?:ers?|res?|es?|ds?|des?)\b)/).map((bout) => {
    const m = /^(\d+)(ers?|res?|es?|ds?|des?)$/.exec(bout);
    return m ? { chiffre: m[1], suffixe: m[2] } : bout;
  });

---

{
  /*
   * FOND SOMBRE depuis le 14/09/2026 (demande de l'équipe) : le tableau prend l'ink, et « L'expérience
   * derrière R Start » prend le blanc en échange. C'est ce qui règle le rendu du carrousel Trustpilot,
   * qui pose ses propres cartes blanches et s'accommodait mal d'un fond bleu.
   * Les repères passent donc en verre clair sur l'ink, valeurs en sand, appels de note en teal-200.
   */
}
<Section id={sections.highlights.id} tone="ink">
  <Container size="wide">
    {
      /* Aligné à gauche comme tous les autres titres de section depuis le 11/09/2026 : c'était le seul
        en-tête centré de la page. */
    }
    <header>
      {/* Titre en sable depuis le 16/09/2026, comme celui de la section Risques : les deux blocs
        sur fond ink partagent la même couleur de titre. */}
      <h2 id={titleId} class="text-display-lg text-balance text-sand" data-reveal-text>
        {highlights.title}
      </h2>
      {
        highlights.intro && (
          <p
            data-animate="fade-up"
            data-animate-delay="0.1"
            class="text-lead mt-6 max-w-3xl opacity-90"
          >
            {highlights.intro}
          </p>
        )
      }
    </header>

    {
      /* Six blocs simples en 3 × 2 (11/09/2026) : un libellé, une valeur, un appel de note. Ni
        pictogramme, ni description, ni contre-poids par bloc, celui de la section les remplace, sous la
        grille. Les blocs ne portent donc pas `data-advantage` : ce sont des caractéristiques du produit,
        pas des arguments, et le contrôle d'équilibre AMF compte le couple de la section. */
    }
    <ul role="list" class="mt-chapter grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        cards.map((card, i) => (
          <li
            class="rounded-3xl border border-white/15 bg-white/5 p-6 sm:p-8"
            data-animate="fade-up"
            data-animate-delay={String((i % COLUMNS) * STAGGER)}
          >
            {/* Sans libellé, la valeur se suffit à elle-même et l'appel de note la suit (« 100 % Digital »). */}
            {card.label && (
              <p class="flex items-center gap-2 text-base font-medium text-white/80">
                <span>
                  {card.label}
                  {card.noteId && <NoteRef id={card.noteId} tone="dark" />}
                </span>
                {card.info && (
                  <button
                    type="button"
                    data-info-bouton
                    hidden
                    aria-expanded="false"
                    aria-controls={'info-' + i}
                    class="info-bouton info-bouton-sombre"
                  >
                    <span aria-hidden="true">i</span>
                    <span class="visually-hidden">
                      {highlights.labels?.info} : {card.label}
                    </span>
                  </button>
                )}
              </p>
            )}
            <p class:list={['text-display-sm text-sand', card.label && 'mt-2']}>
              {enExposant(card.value).map((b) => (typeof b === 'string' ? b : <>{b.chiffre}<sup class="ordinal">{b.suffixe}</sup></>))}
              {!card.label && card.noteId && <NoteRef id={card.noteId} tone="dark" />}
            </p>
            {card.info && (
              <div id={'info-' + i} data-info-panneau class="info-panneau">
                <p class="text-base leading-snug text-white/80">{card.info}</p>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    {
      /* Bloc À PART (11/09/2026) : comment on souscrit et ce qu'on peut automatiser. Un filet et un titre
        le détachent des six repères, et il est rendu sans encadré, ce ne sont pas des caractéristiques
        du produit, mais des modalités. */
      highlights.subscriptionItems && highlights.subscriptionItems.length > 0 && (
        <div class="mt-chapter border-t border-white/20 pt-8 sm:pt-10">
          {
            /* Le TITRE du bloc passe en sable le 16/09/2026, pas ses libellés : ceux-ci restent en
              blanc atténué, comme les libellés des six cartes au-dessus (« Niveau de risque »,
              « Approche »…). Un libellé nomme, il ne porte pas l'information : le sable est réservé à
              ce qu'on doit lire, la valeur. Les mettre en sable les faisait rivaliser avec elle. */
          }
          {highlights.subscriptionTitle && (
            <h3 class="text-display-sm text-sand">{highlights.subscriptionTitle}</h3>
          )}
          <ul role="list" class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-8 lg:mt-8">
            {highlights.subscriptionItems.map((item) => (
              <li class="border-t border-white/15 pt-4 sm:border-t-0 sm:pt-0">
                <p class="text-base font-medium text-white/80">
                  {item.label}
                  {item.noteId && <NoteRef id={item.noteId} tone="dark" />}
                </p>
                <p class="text-lead mt-1 font-semibold text-sand">
              {enExposant(item.value).map((b) => (typeof b === 'string' ? b : <>{b.chiffre}<sup class="ordinal">{b.suffixe}</sup></>))}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {/* Contre-poids unique de la section, jamais animé. */}
    {highlights.risk && <RiskNote text={highlights.risk} size="lead" class="mt-8 lg:mt-10" />}
    {
      /* APPEL À L'ACTION DE LA SECTION (15/09/2026). `outline-light` et non `light` : le fond est ink,
        et un bouton blanc plein aurait le poids d'un CTA de souscription, alors que celui-ci mène à une
        page du site. La hiérarchie de l'accueil reste celle du hero. */
      highlights.secondaryCta && (
        <p class="mt-chapter">
          <Button href={highlights.secondaryCta.href} variant="outline-light" size="md">
            {highlights.secondaryCta.label}
          </Button>
        </p>
      )
    }
  </Container>
</Section>

<script>
  /* Le dépliage vit dans un module partagé depuis le 16/09/2026 : le comparateur de frais s'en sert
     aussi, et les deux composants coexistent sur l'accueil. Voir src/scripts/infoToggle.ts. */
  import '@/scripts/infoToggle';
</script>
