---
/**
 * Section 3 — Frais en bref (id « frais »). Fond paper (alternance avec Points forts, blanc, et
 * Stratégie, ink). C'est le CHAPITRE de la page /frais, pas son double : depuis l'audit UX, le barème
 * complet, la frise de la commission de retrait et le comparatif ont quitté l'accueil pour ne vivre
 * que sur /frais. L'accueil garde ce qui fait comprendre le modèle et ce que la réglementation impose
 * de montrer à côté.
 *
 * 1. Scène épinglée (data-scene, fin à +60 % du viewport depuis l'audit : au-delà, le lecteur
 *    traversait un demi-écran vide après le dernier temps). Le moteur n'épingle que si la scène tient
 *    ENTIÈREMENT sous son départ (hauteur + 72 px ≤ fenêtre, scene.ts) : gabarit serré dès lg (valeurs
 *    text-display-md, libellés et contre-poids text-lg, interlignes réduits) pour tenir en 681 px à
 *    1440×900, 671 à 1280×800, 678 à 1366×768 (11/09/2026 ; à 1024×768, 854 px : repli statique prévu).
 *    Avant, 944 px pour 828 disponibles : plus aucun épinglage.
 *    les trois « 0 % » (navy uni, AA sur paper) sont chacun un [data-step][data-step-stay]
 *    et arrivent un à un au fil du défilement, le premier visible d'emblée — son chiffre reçoit un simple
 *    accent d'échelle à l'entrée (span inline-flex data-animate="scale" : opacité + scale 0,95, 0,6 s ;
 *    pas `inline-block` : ce nom de classe est détourné par le jeton --spacing-block de global.css).
 *    JAMAIS de compteur sur un taux réglementaire qui partirait d'une valeur fausse ; puis un quatrième
 *    step (data-step-stay) fait « basculer » vers les frais réellement prélevés : 15 % de gestion,
 *    commission sur les cessions, commission de retrait avec ses cinq paliers. Cette rangée n'est plus
 *    aria-hidden : le barème ayant quitté l'accueil, elle est le seul endroit de la page où ces taux
 *    figurent, elle doit donc être lue. Le contre-poids rédigé — avantage (data-advantage, qui porte
 *    l'appel de la note « incidence des coûts du DIC ») + RiskNote, même taille (text-lead ; text-lg dès
 *    lg, voir ci-dessus) — est HORS des steps, dans la scène : visible du premier au dernier instant
 *    (aucun step ne contient de [data-risk] ; le moteur refuserait de l'animer). Les steps ne sont pas superposés (pas de
 *    `scene-stack`) : ils gardent leur place en flux. Départ du pin sous la barre collée (3,5 rem) :
 *    data-scene-start="top 72px" (ScrollTrigger ne lit pas les rem).
 *    Taille des six valeurs (AMF : un frais ne s'affiche jamais plus petit que ses voisins, d'où la
 *    même classe sur tous les [data-fee-value] du bloc « apercu-accueil ») : text-display-md à toutes
 *    les largeurs (51 px à 1280, 56 px dès 1400 : chiffre géant qui ne concurrence plus le H2 en
 *    display-lg) ; « 10 à 0 % » tient sur une ligne à 1280 comme à 1440 px.
 *    Mobile (< sm) : une colonne, chaque frais est une LIGNE — valeur à gauche sur une largeur fixe
 *    (w-32, alignement commun aux deux listes), libellé puis assiette/détail à droite — car trois
 *    colonnes de 109 px cassaient « 0 à 12 % » sur deux lignes et les libellés sur cinq. L'ordre DOM
 *    reste valeur → libellé.
 *    Sans JS / reduced-motion : aucun pin, tout est visible et statique.
 * 2. Rappel « le rachat de vos parts n'est pas garanti » (RiskNote fees.withdrawal.note, jamais animé),
 *    conservé après le retrait de la frise : il porte aussi les cas d'exonération et la durée de
 *    placement recommandée, que rien d'autre ne rappelle sur l'accueil.
 * 3. (Retiré le 10/09/2026 : l'encadré « Une innovation, pas une révolution » et les puces de la
 *    commission d'arbitrage ne vivent plus que sur /frais ; les puces restent dans la section Risques.)
 * 4. Précision HT = TTC (corps de texte, statique), CTA tunnel (position « frais ») et lien vers la page
 *    /frais, rendu uniquement lorsque src/pages/frais.astro existe (vérification au build : pas de lien
 *    mort tant que la page n'est pas livrée).
 * L'en-tête est rendu ici (surtitre en teal-700, AA sur paper, statique ; H2 mot à mot via data-reveal-text ;
 * introduction en fade-up décalée de 0,1 s — signature commune des chapitres, 11/09/2026) plutôt que par
 * SectionHeading. L'introduction porte un appel de note : pas d'opacité réduite (contraste).
 * Chaque <NoteRef> est collé à son mot et enveloppé dans un span `whitespace-nowrap` : le gabarit de
 * NoteRef émet un blanc avant le numéro, qui sinon peut passer seul à la ligne.
 * Contenu : src/content/fr/fees.ts.
 */
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { fees } from '@/content/fr/fees';

const id = sections.fees.id;
const titleId = id + '-title';
const { zeroHighlights, withdrawal } = fees;

/**
 * Face aux trois « 0 % », les frais non nuls perçus ensuite : gestion, cessions, retrait, avec leurs
 * taux. Depuis le retrait du barème complet de l'accueil, cette rangée n'est plus une répétition d'un
 * tableau voisin : elle est le seul endroit de la page où ces taux figurent, elle est donc lue par les
 * lecteurs d'écran (plus d'aria-hidden) et porte son propre libellé de liste.
 */
const isZero = (value: string): boolean => /^0\s*%$/.test(value);
const counterRows = fees.rows.filter(
  (row) => row.kind !== 'entree' && row.kind !== 'investissement' && !isZero(row.value)
);

/**
 * Le lien « Tous les frais en détail » n'est rendu que si la page /frais existe (src/pages/frais.astro,
 * livrée par un autre sous-lot) : la liste des fichiers est résolue au build, sans import.
 */
const feesPageExists = Object.keys(import.meta.glob('/src/pages/frais.astro')).length > 0;
const detailsLink = feesPageExists ? fees.detailsLink : undefined;

/**
 * Classes communes aux six valeurs de frais : UNE seule chaîne, pour que la taille rendue soit
 * identique dans tout le bloc (data-fee-block) quel que soit le viewport. La couleur est ajoutée par
 * chaque liste. Sous sm, la valeur occupe une colonne fixe (w-32) qui aligne les deux listes.
 */
const feeValueClass = 'text-display-md w-32 tabular-nums sm:w-auto';

/** Ligne sur mobile (valeur | libellé + assiette), colonne à partir de sm. */
const feeItemClass =
  'grid grid-cols-[auto_1fr] items-baseline gap-x-4 border-t sm:flex sm:flex-col sm:items-stretch';
---

<Section id={id} tone="paper">
  <Container size="wide">
    <header class="max-w-4xl">
      <p class="text-eyebrow mb-4 text-teal-700">{fees.eyebrow}</p>
      <h2 id={titleId} class="text-display-lg" data-reveal-text>{fees.title}</h2>
      {
        /* La note « sources » était accrochée à la légende du barème, parti sur /frais. Les taux
          restent affichés ici : leur source doit rester à portée, elle rejoint l'introduction. */
      }
      <p data-animate="fade-up" data-animate-delay="0.1" class="mt-6 text-lead">
        {fees.intro}<span class="whitespace-nowrap"><NoteRef id="frais-sources" /></span>
      </p>
    </header>

    <!-- Scène épinglée : les trois 0 %, un à un, puis leur contre-poids — RiskNote hors des steps, toujours visible -->
    <div
      data-scene
      data-scene-start="top 72px"
      data-scene-end="+=60%"
      class="mt-12 sm:mt-16 lg:mt-24"
    >
      <ul
        role="list"
        aria-label={fees.zeroHighlightsLabel}
        class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-8 lg:gap-12"
      >
        {
          zeroHighlights.map((item, i) => (
            <li
              data-step
              data-step-stay
              class:list={[feeItemClass, 'border-navy/15 pt-3 sm:gap-3 sm:pt-6']}
            >
              <span
                class:list={[feeValueClass, 'text-navy']}
                data-fee-value
                data-fee-block="apercu-accueil"
              >
                {/* Premier chiffre : accent d'échelle seulement (inline-flex : une transform ne s'applique pas à un
                    inline, et la classe `inline-block` est cassée par le jeton --spacing-block du thème, qui lui fait
                    émettre `inline-size` : la boîte ferait 2 rem quel que soit le texte) ; valeur statique, jamais de compteur */}
                {i === 0 ? (
                  <span data-animate="scale" class="inline-flex">
                    {item.value}
                  </span>
                ) : (
                  item.value
                )}
              </span>
              <div class="flex flex-col gap-1.5 sm:gap-3">
                <p class="text-base leading-snug font-medium text-ink sm:text-lg">{item.label}</p>
                <p class="text-sm leading-snug text-slate-700 sm:text-base sm:leading-relaxed">
                  {item.base}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <ul
        role="list"
        aria-label={fees.counterRowsLabel}
        data-step
        data-step-stay
        class="mt-4 grid grid-cols-1 gap-3 sm:mt-6 sm:grid-cols-3 sm:gap-8 lg:gap-12"
      >
        {
          counterRows.map((row) => (
            <li class:list={[feeItemClass, 'border-coral/40 pt-2 sm:gap-2 sm:pt-5']}>
              {/* Même taille que les « 0 % » ci-dessus : l'AMF a relevé sur la brochure qu'un frais ne
                  peut pas être affiché dans une police plus petite que les autres. */}
              {/* Forme courte des barèmes (« 0 à 12 % », « 10 à 0 % ») : une seule ligne, alignée sur les
                  « 0 % » ; les paliers exacts sont dans le contre-poids ci-dessous, les notes et /frais. */}
              <span
                class:list={[feeValueClass, 'text-coral-700']}
                data-fee-value
                data-fee-block="apercu-accueil"
              >
                {row.valueShort ?? row.value}
              </span>
              <div class="flex flex-col gap-1 sm:gap-2">
                <p class="text-base leading-snug font-medium text-ink sm:text-lg">
                  {row.label}
                  {row.noteId && (
                    <span class="whitespace-nowrap">
                      <NoteRef id={row.noteId} />
                    </span>
                  )}
                </p>
                {/* Quand et sur quoi le frais est prélevé, en langage courant, sans répéter le taux :
                    même gabarit que l'assiette sous les « 0 % ». */}
                {row.detail && (
                  <p class="text-sm leading-snug text-slate-700 sm:text-base sm:leading-relaxed">
                    {row.detail}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      {
        /* Le couple rédigé « R Start prélève 0 %… / Concrètement, R Start retient 15 %… » a été retiré le
          11/09/2026 (décision de l'équipe) : la rangée des frais prélevés, dans la même scène et à la même
          taille que les « 0 % », reste le contre-poids des trois zéros. */
      }
    </div>

    <!-- Rappel de la commission de retrait : la frise détaillée vit sur /frais, ce contre-poids reste ici -->
    <RiskNote text={withdrawal.note} size="lead" class="mt-8 max-w-4xl sm:mt-10" />

    {
      /* L'encadré « Une innovation, pas une révolution » et les trois puces de la commission d'arbitrage
        ont quitté l'accueil (allègement du 10/09/2026) : ils vivent sur /frais (feesPage.ts), et les
        puces figurent déjà dans la section Risques de cette page. Les appels de note des trois frais
        restent portés par leur libellé ci-dessus. */
    }
    <!-- HT = TTC, CTA et lien vers la page Frais -->
    <div
      class="mt-12 flex flex-col gap-8 border-t border-navy/15 pt-8 lg:mt-16 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
    >
      <p class="max-w-2xl text-base leading-relaxed text-slate-700">
        {fees.htNote}<span class="whitespace-nowrap"><NoteRef id="frais-ht" /></span>
      </p>
      <div class="flex flex-wrap items-center gap-3 sm:gap-4" data-animate="fade-up">
        <Button position={fees.cta.position} size="lg">{fees.cta.label}</Button>
        {
          detailsLink && (
            <Button href={detailsLink.href} variant="secondary" size="lg">
              {detailsLink.label}
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</Section>
