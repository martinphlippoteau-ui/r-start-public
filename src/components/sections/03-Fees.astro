---
/**
 * Section 3 — Frais en bref (id « frais »). Fond paper (alternance avec Points forts, blanc, et
 * Stratégie, ink). C'est le CHAPITRE de la page /frais, pas son double : depuis l'audit UX, le barème
 * complet, la frise de la commission de retrait et le comparatif ont quitté l'accueil pour ne vivre
 * que sur /frais. L'accueil garde ce qui fait comprendre le modèle et ce que la réglementation impose
 * de montrer à côté.
 *
 * 1. Scène épinglée (data-scene, fin à +60 % du viewport depuis l'audit : au-delà, le lecteur
 *    traversait un demi-écran vide après le dernier temps) :
 *    les trois « 0 % » (text-stat en navy uni, AA sur paper) sont chacun un [data-step][data-step-stay]
 *    et arrivent un à un au fil du défilement, le premier visible d'emblée — son chiffre reçoit un simple
 *    accent d'échelle à l'entrée (span inline-block data-animate="scale" : opacité + scale 0,95, 0,8 s).
 *    JAMAIS de compteur sur un taux réglementaire qui partirait d'une valeur fausse ; puis un quatrième
 *    step (data-step-stay) fait « basculer » vers les frais réellement prélevés : 15 % de gestion,
 *    commission sur les cessions, commission de retrait avec ses cinq paliers. Cette rangée n'est plus
 *    aria-hidden : le barème ayant quitté l'accueil, elle est le seul endroit de la page où ces taux
 *    figurent, elle doit donc être lue. Le contre-poids rédigé — avantage (data-advantage, qui porte
 *    l'appel de la note « incidence des coûts du DIC ») + RiskNote, même taille (text-lead) — est HORS
 *    des steps, dans la scène : visible du premier au dernier instant (aucun step ne contient de
 *    [data-risk] ; le moteur refuserait de l'animer). Les steps ne sont pas superposés (pas de
 *    `scene-stack`) : ils gardent leur place en flux. Départ du pin sous la barre collée (3,5 rem) :
 *    data-scene-start="top 72px" (ScrollTrigger ne lit pas les rem).
 *    Sans JS / reduced-motion : aucun pin, tout est visible et statique.
 * 2. Rappel « le rachat de vos parts n'est pas garanti » (RiskNote fees.withdrawal.note, jamais animé),
 *    conservé après le retrait de la frise : il porte aussi les cas d'exonération et la durée de
 *    placement recommandée, que rien d'autre ne rappelle sur l'accueil.
 * 3. Encadré « Une innovation, pas une révolution » (Card blanche, jamais animé) et les trois puces de la
 *    commission d'arbitrage (liste, jamais animées), reproduits à l'identique depuis legal.ts.
 * 4. Précision HT = TTC (corps de texte, statique), CTA tunnel (position « frais ») et lien vers la page
 *    /frais, rendu uniquement lorsque src/pages/frais.astro existe (vérification au build : pas de lien
 *    mort tant que la page n'est pas livrée).
 * L'en-tête est rendu ici (surtitre en teal-700, AA sur paper ; H2 mot à mot via data-reveal-text) plutôt
 * que par SectionHeading.
 * Chaque <NoteRef> est collé à son mot et enveloppé dans un span `whitespace-nowrap` : le gabarit de
 * NoteRef émet un blanc avant le numéro, qui sinon peut passer seul à la ligne.
 * Contenu : src/content/fr/fees.ts.
 */
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { sections } from '@/config/sections';
import { fees } from '@/content/fr/fees';

const id = sections.fees.id;
const titleId = id + '-title';
const { zeroHighlights, counterweight, withdrawal, innovationBox, arbitrageWarning } = fees;

/**
 * Face aux trois « 0 % », les frais non nuls perçus ensuite : gestion, cessions, retrait, avec leurs
 * taux. Depuis le retrait du barème complet de l'accueil, cette rangée n'est plus une répétition d'un
 * tableau voisin : elle est le seul endroit de la page où ces taux figurent, elle est donc lue par les
 * lecteurs d'écran (plus d'aria-hidden) et porte son propre libellé de liste.
 */
const isZero = (value: string): boolean => /^0\s*%$/.test(value);
const counterRows = fees.rows.filter(
  (row) => row.kind !== 'entree' && row.kind !== 'investissement' && !isZero(row.value)
);

/**
 * Le lien « Tous les frais en détail » n'est rendu que si la page /frais existe (src/pages/frais.astro,
 * livrée par un autre sous-lot) : la liste des fichiers est résolue au build, sans import.
 */
const feesPageExists = Object.keys(import.meta.glob('/src/pages/frais.astro')).length > 0;
const detailsLink = feesPageExists ? fees.detailsLink : undefined;
---

<Section id={id} tone="paper">
  <Container size="wide">
    <header class="max-w-4xl">
      <p data-animate="fade-up" class="text-eyebrow mb-4 text-teal-700">{fees.eyebrow}</p>
      <h2 id={titleId} class="text-display-lg" data-reveal-text>{fees.title}</h2>
      {
        /* La note « sources » était accrochée à la légende du barème, parti sur /frais. Les taux
          restent affichés ici : leur source doit rester à portée, elle rejoint l'introduction. */
      }
      <p data-animate="fade-up" data-animate-delay="0.15" class="mt-6 text-lead opacity-90">
        {fees.intro}<span class="whitespace-nowrap"><NoteRef id="frais-sources" /></span>
      </p>
    </header>

    <!-- Scène épinglée : les trois 0 %, un à un, puis leur contre-poids — RiskNote hors des steps, toujours visible -->
    <div
      data-scene
      data-scene-start="top 72px"
      data-scene-end="+=60%"
      class="mt-12 sm:mt-16 lg:mt-24"
    >
      <ul
        role="list"
        aria-label={fees.zeroHighlightsLabel}
        class="grid grid-cols-3 gap-3 sm:gap-8 lg:gap-12"
      >
        {
          zeroHighlights.map((item, i) => (
            <li
              data-step
              data-step-stay
              class="flex flex-col gap-1.5 border-t border-navy/15 pt-3 sm:gap-3 sm:pt-8"
            >
              <p class="flex flex-col gap-1.5 sm:gap-3">
                <span class="text-stat text-navy" data-fee-value data-fee-block="apercu-accueil">
                  {/* Premier chiffre : accent d'échelle seulement (inline-block : une transform ne s'applique pas à un inline) ; valeur statique, jamais de compteur */}
                  {i === 0 ? (
                    <span data-animate="scale" class="inline-block">
                      {item.value}
                    </span>
                  ) : (
                    item.value
                  )}
                </span>
                <span class="text-base leading-snug font-medium text-ink sm:text-lead">
                  {item.label}
                </span>
              </p>
              <p class="text-sm leading-snug text-slate-700 sm:text-base sm:leading-relaxed">
                {item.base}
              </p>
            </li>
          ))
        }
      </ul>

      <ul
        role="list"
        aria-label={fees.counterRowsLabel}
        data-step
        data-step-stay
        class="mt-4 grid grid-cols-3 gap-3 sm:mt-6 sm:gap-8 lg:mt-8 lg:gap-12"
      >
        {
          counterRows.map((row) => (
            <li class="flex flex-col gap-1 border-t border-coral/40 pt-2 sm:gap-2 sm:pt-5">
              {/* Même taille que les « 0 % » ci-dessus : l'AMF a relevé sur la brochure qu'un frais ne
                  peut pas être affiché dans une police plus petite que les autres. */}
              <span
                class="text-stat text-coral-700 tabular-nums"
                data-fee-value
                data-fee-block="apercu-accueil"
              >
                {row.valueShort ? (
                  <>
                    <span class="sm:hidden">{row.valueShort}</span>
                    <span class="hidden sm:inline">{row.value}</span>
                  </>
                ) : (
                  row.value
                )}
              </span>
              <span class="text-base leading-snug font-medium text-ink sm:text-lead">
                {row.label}
              </span>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-4 grid gap-3 border-t border-navy/15 pt-4 sm:mt-10 sm:gap-6 sm:pt-8 lg:mt-14 lg:grid-cols-2 lg:gap-12 lg:pt-10"
      >
        <p data-advantage class="text-lead max-sm:text-base">
          {counterweight.advantage}<span class="whitespace-nowrap"
            ><NoteRef id="frais-incidence-dic" /></span
          >
        </p>
        <RiskNote text={counterweight.risk} size="lead" class="max-sm:text-base" />
      </div>
    </div>

    <!-- Rappel de la commission de retrait : la frise détaillée vit sur /frais, ce contre-poids reste ici -->
    <RiskNote text={withdrawal.note} size="lead" class="mt-8 max-w-4xl sm:mt-10" />

    <!-- Encadré et avertissement (jamais animés) -->
    <div class="mt-section-sm grid gap-6 lg:grid-cols-2">
      <Card class="lg:p-10">
        <h3 class="text-display-sm">{innovationBox.title}</h3>
        <RiskNote text={innovationBox.body} size="lead" class="mt-5" />
      </Card>
      <Card class="lg:p-10">
        <p class="text-lead font-medium">
          {arbitrageWarning.title}<span class="whitespace-nowrap"
            ><NoteRef id="frais-commission-arbitrage" /></span
          >
        </p>
        <ul class="mt-5 list-disc space-y-4 pl-6 text-lead marker:text-coral">
          {arbitrageWarning.bullets.map((bullet) => <li class="pl-1">{bullet}</li>)}
        </ul>
      </Card>
    </div>

    <!-- HT = TTC, CTA et lien vers la page Frais -->
    <div
      class="mt-12 flex flex-col gap-8 border-t border-navy/15 pt-8 lg:mt-16 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
    >
      <p class="max-w-2xl text-base leading-relaxed text-slate-700">
        {fees.htNote}<span class="whitespace-nowrap"><NoteRef id="frais-ht" /></span>
      </p>
      <div class="flex flex-wrap items-center gap-3 sm:gap-4" data-animate="fade-up">
        <Button position={fees.cta.position} size="lg">{fees.cta.label}</Button>
        {
          detailsLink && (
            <Button href={detailsLink.href} variant="secondary" size="lg">
              {detailsLink.label}
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</Section>
