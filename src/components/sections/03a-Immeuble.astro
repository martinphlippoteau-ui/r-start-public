---
/**
 * Section 3a, Immeuble (id « immeuble »). Respiration visuelle entre la section CORUM (07, bande
 * white) et Frais (03) : une photo d'immeuble pleine largeur, sans titre, sans texte marketing ni
 * avantage (donc aucun contre-poids risque à rendre), sans légende (voir media.ts).
 * Hors contrat de sections : SectionKey (src/content/types.ts) ne prévoit pas cette section, elle
 * porte donc son id ici et n'apparaît pas dans src/config/sections.ts.
 * LE VISUEL VIENT DE media.hero.main, jamais d'un nom de fichier écrit ici : nommé en dur, la bande
 * a déjà montré un fichier absent quand le lot d'images a été remplacé. Le format compte : le cadre
 * fait entre 2,0 et 2,7 selon l'écran, l'image est en 2,36.
 * Rendu : hauteur clamp(24rem, 60vh, 44rem), assez pour l'effet, jamais un écran entier, l'image
 * couvre le cadre (object-cover). Motion (src/scripts/motion/*, attributs seulement) : le <picture>
 * se dévoile par clip-path (data-animate="clip", réservé aux médias) et flotte en parallaxe douce
 * (enveloppe -top-[12%] h-[124%], data-parallax 0.08, déclencheur = cadre parent) sans jamais
 * découvrir le bord. Sans JS ou en reduced-motion : image statique complète.
 * Chargement lazy (loin du LCP), formats avif/webp, largeurs jusqu'à 2400 px pour les écrans denses.
 * RÉUTILISÉE SUR /strategie (25/09/2026, Martin : « une bande pas trop grande en hauteur
 * d'illustration comme sur la home », à la place de la canalisation entre les moteurs et les volets) :
 * `id`, `image` (clé de media.ts) et `basse` (cadre clamp(14rem, 32vh, 22rem)) en props ; sans
 * props, la bande de l'accueil est inchangée.
 */
import { Picture } from 'astro:assets';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

interface Props {
  id?: string;
  /** Clé de media.ts : `hero` (media.hero.main, par défaut) ou `corum`. */
  image?: 'hero' | 'corum';
  /** Bande basse : clamp(14rem, 32vh, 22rem) au lieu de clamp(24rem, 60vh, 44rem). */
  basse?: boolean;
}
const { id = 'immeuble', image: cle = 'hero', basse = false } = Astro.props as Props;
const visuel = cle === 'corum' ? media.corum : media.hero.main;
/** Libellé lu par les lecteurs d'écran pour cette région sans titre. */
const label = 'Illustration';
const image = await resolveImage(visuel.src);
const alt = visuel.alt;
/** Parallaxe douce d'un seul sens ; l'enveloppe surdimensionnée de ±12 % absorbe la course. */
const PARALLAX = 0.08;
const sizes = '100vw';
---

<section id={id} data-section={id} aria-label={label} class="relative bg-white text-ink">
  <figure>
    <div class:list={['relative overflow-hidden', basse ? 'h-[clamp(14rem,32vh,22rem)]' : 'h-[clamp(24rem,60vh,44rem)]']}>
      <div
        class="absolute inset-x-0 -top-[12%] h-[124%]"
        data-parallax={String(PARALLAX)}
        data-parallax-trigger="parent"
      >
        <Picture
          src={image}
          alt={alt}
          widths={[640, 1024, 1600, 2400]}
          sizes={sizes}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          loading="lazy"
          decoding="async"
          pictureAttributes={{ class: 'block h-full w-full', 'data-animate': 'clip' }}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </figure>
</section>
