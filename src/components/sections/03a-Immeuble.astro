---
/**
 * Section 3a, Immeuble (id « immeuble »). Respiration visuelle de la trame du 10/09/2026, entre
 * L'expérience derrière R Start (07, bande white) et Frais (03) : une photo d'immeuble pleine largeur,
 * sans titre, sans texte marketing ni avantage (donc aucun contre-poids risque à rendre), avec pour seule
 * légende la mention obligatoire (R Start n'a pas encore de patrimoine).
 * Hors contrat de sections : SectionKey (src/content/types.ts) ne prévoit pas cette section, elle porte donc
 * son id ici et n'apparaît ni dans src/config/sections.ts ni dans le registre des notes.
 * LE VISUEL VIENT MAINTENANT DE media.hero.main (15/09/2026). Il était nommé en dur ici, si bien que la
 * bande pointait sur un fichier que le registre ne connaissait pas : quand le lot d'images a été remplacé,
 * media.ts était à jour et cette section montrait encore un fichier absent. Une seule source désormais.
 * Le format compte : le cadre fait entre 2,0 et 2,7 selon l'écran, l'image est en 2,36.
 * Rendu : hauteur clamp(24rem, 60vh, 44rem), assez pour l'effet, jamais un écran entier, l'image couvre le
 * cadre (object-cover). Motion (src/scripts/motion/*, attributs seulement) : le <picture> se dévoile par
 * clip-path (data-animate="clip", réservé aux médias) et flotte en parallaxe douce (modèle des photos de
 * 04-Strategy : enveloppe -top-[12%] h-[124%], data-parallax 0.08, déclencheur = cadre parent) sans jamais
 * découvrir le bord. La légende n'est pas animée. Sans JS ou en reduced-motion : image statique complète.
 * Chargement lazy (loin du LCP), formats avif/webp, largeurs jusqu'à 2400 px pour les écrans denses.
 */
import { Picture } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import { media, AFFICHER_LEGENDES } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

const id = 'immeuble';
/** Libellé lu par les lecteurs d'écran pour cette région sans titre. */
const label = 'Illustration';
const image = await resolveImage(media.hero.main.src);
const alt = media.hero.main.alt;
const credit = media.hero.main.credit;
/** Parallaxe douce d'un seul sens ; l'enveloppe surdimensionnée de ±12 % absorbe la course. */
const PARALLAX = 0.08;
const sizes = '100vw';
---

<section id={id} data-section={id} aria-label={label} class="relative bg-white text-ink">
  <figure>
    <div class="relative h-[clamp(24rem,60vh,44rem)] overflow-hidden">
      <div
        class="absolute inset-x-0 -top-[12%] h-[124%]"
        data-parallax={String(PARALLAX)}
        data-parallax-trigger="parent"
      >
        <Picture
          src={image}
          alt={alt}
          widths={[640, 1024, 1600, 2400]}
          sizes={sizes}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          loading="lazy"
          decoding="async"
          pictureAttributes={{ class: 'block h-full w-full', 'data-animate': 'clip' }}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
    {
      AFFICHER_LEGENDES && credit && (
        <figcaption class="text-caption py-4 text-slate-700">
          <Container size="wide">{credit}</Container>
        </figcaption>
      )
    }
  </figure>
</section>
