---
/**
 * Navigation unique du site : une barre collée en haut, un seul landmark (`<nav aria-label>`) qui
 * contient la barre et le tiroir plein écran des petits écrans. Pastille flottante
 * (`--spacing-nav-gap`, `--radius-nav`, @utility nav-glass), pleine dès le premier pixel sur toutes
 * les pages (12/09/2026, demande de l'équipe), ombre au défilement (`data-stuck`). Elle RECOUVRE le
 * contenu (marge basse négative `--spacing-nav-total`) et les en-têtes de page réservent cette
 * hauteur en padding haut : posée sur le fond clair du document, elle était invisible (11/09/2026).
 * L'écart entre aussi dans `scroll-padding-top` (global.css) et dans la barre d'ancres de
 * /documentation.
 * Entrées : les pages du menu (`menuPages`, src/config/pages.ts), l'accueil excepté, jamais d'ancre
 * de section (10/09/2026) ; aucun libellé en dur (src/content/fr/nav.ts). À partir de « lg », liste
 * centrée dans une grille `minmax(max-content,1fr) / minmax(0,auto) / minmax(max-content,1fr)` :
 * les colonnes du logo et du CTA ne cèdent jamais, c'est la liste qui défile (`scrollbar-none`)
 * sous son fondu (`scroll-fade-x`) ; en `1fr / auto / 1fr`, les six entrées (19/09/2026) écrasaient
 * le logo entre 1024 et 1180 px, et `lg:max-w-[calc(100%+1rem)]` compense les marges négatives de
 * la liste. Sous « lg », un tiroir entre par la droite ; sous 26 rem, « Menu » repasse en `sr-only`
 * et la loupe prend sa place : logo, loupe, Souscrire et le mot demandaient 380 px sur un Pixel 5
 * qui en offre 369 (17/09/2026).
 * Recherche (17/09/2026) : la loupe ouvre SiteSearch.astro, posé sous la barre dans la même
 * enveloppe. La barre passe devant (`z-20`) et éteint son verre tant que le panneau est présent
 * (global.css, « Recherche du site ») : un seul verre à la fois. Le verre est sur
 * `[data-sitenav-bar]` et non sur le <nav> `sticky` : un `backdrop-filter` sur un ancêtre ferait de
 * lui le bloc conteneur du panneau `fixed`.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import logoWhite from '@/assets/logos/r-start-blanc.svg';
import SiteSearch from '@/components/SiteSearch.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { menuPages, pages } from '@/config/pages';
import { nav } from '@/content/fr/nav';
import { search } from '@/content/fr/search';
import { withBase } from '@/lib/href';

/** Chemin courant normalisé (sans barre finale) pour l'état actif du menu. */
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => (path.replace(/\/+$/, '') || '/') === currentPath;

interface Entry {
  key: string;
  label: string;
  href: string;
  /** Page courante : aria-current="page". */
  current: boolean;
}

/**
 * L'accueil est retiré ICI et non dans `menuPages` (12/09/2026, demande de l'équipe) : le logo de
 * la barre y mène déjà, alors que le pied de page et la page 404, bâtis sur la même source, n'ont
 * pas de logo cliquable et gardent leur lien vers l'accueil.
 */
const entries: Entry[] = menuPages
  .filter((p) => p.key !== 'home')
  .map((p) => ({
    key: p.key,
    label: p.navLabel ?? p.label,
    href: withBase(p.path),
    current: isCurrent(p.path),
  }));

/** Le logo ramène toujours à l'accueil (aucune ancre dans la navigation). */
const logoHref = withBase(pages.home.path);
const panelId = 'site-nav-panel';
const rechercheId = 'site-search';
const menuLabel = nav.menuLabel ?? nav.brand;
const closeLabel = nav.closeLabel ?? menuLabel;
const menuAriaLabel = nav.menuAriaLabel ?? nav.brand;
const homeLinkLabel = nav.homeLinkLabel ?? nav.brand;
const ctaLabel = nav.subnavCtaLabel ?? nav.cta.label;
/* 16 px (15/09/2026), ex-`text-lg` : quatre entrées plus le bouton tenaient à l'étroit, et les
   liens pesaient autant que le corps de texte des pages. Les liens du TIROIR suivent, un seul corps
   pour le même menu ; leur cible tactile reste à 44 px (`py-2.5` plus une interligne de 24 px). */
const linkClass =
  'block rounded-full px-2.5 py-1.5 text-base font-medium whitespace-nowrap text-slate-700 no-underline transition-colors hover:text-navy aria-[current]:font-semibold aria-[current]:text-navy sm:px-3.5';
---

<nav
  data-sitenav
  data-compact-at="0.4"
  aria-label={menuAriaLabel}
  class="pt-nav-gap -mb-nav-total sticky top-0 z-40"
>
  <div class="mx-auto w-full max-w-7xl px-3 sm:px-5">
    {
      /* `view-transition-name` : le navigateur extrait cette pastille des deux captures de page et
        l'anime à part, donc immobile d'une page à l'autre. Le nom est ici et non sur le <nav>, qui
        porte aussi le tiroir `fixed` (un élément capturé devient le bloc conteneur de ses
        descendants fixes). */
    }
    {/* Enveloppe de la barre et du panneau de recherche, posé dessous (SiteSearch.astro). */}
    <div class="relative">
    <div
      data-sitenav-bar
      style="view-transition-name: barre-nav"
      class="nav-glass z-20 flex h-subnav items-center gap-2 px-3 sm:gap-4 sm:px-4 lg:grid lg:grid-cols-[minmax(max-content,1fr)_minmax(0,auto)_minmax(max-content,1fr)] lg:pr-[3px]"
    >
      <a
        href={logoHref}
        data-nav-brand
        class="flex shrink-0 items-center gap-2.5 no-underline lg:justify-self-start"
        aria-label={homeLinkLabel}
      >
        <Image
          src={brandLogo}
          alt={nav.brand}
          width={290}
          height={89}
          loading="eager"
          decoding="async"
          class="h-7 w-auto"
        />
      </a>

      <ul
        data-sitenav-list
        class="scrollbar-none scroll-fade-x relative -my-2 -mr-2 -ml-3 hidden min-w-0 flex-1 items-center gap-0.5 overflow-x-auto py-2 pr-2 pl-3 sm:-mx-2 sm:gap-1 sm:px-2 lg:flex lg:max-w-[calc(100%+1rem)] lg:justify-self-center"
        role="list"
      >
        {
          /* Deux éléments et non un : l'enveloppe porte le DÉPLACEMENT (translateX, posé en ligne
            par le script), la peau porte l'ÉTIREMENT (scaleX, une animation) ; sur un seul
            élément, les deux se disputeraient `transform`. `view-transition-name` sur
            l'enveloppe : d'une page à l'autre, le navigateur interpole lui-même ses coordonnées,
            la pastille glisse du lien quitté vers le nouveau. */
        }
        <li
          aria-hidden="true"
          data-subnav-pill
          style="view-transition-name: pastille-nav"
          class="subnav-pill"
        >
          <span data-subnav-pill-skin class="subnav-pill-skin"></span>
        </li>
        {
          entries.map((e) => (
            <li class="relative shrink-0">
              <a
                href={e.href}
                aria-current={e.current ? 'page' : undefined}
                data-astro-prefetch="hover"
                class={linkClass}
              >
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Sous « lg », la liste est masquée : loupe et CTA restent visibles, poussés à droite. */}
      <div class="ml-auto flex shrink-0 items-center gap-1 lg:ml-0 lg:justify-self-end">
        {/* Loupe : ouvre la recherche du site. Affichée seulement si les scripts s'exécutent
          (`recherche-loupe`, global.css) ; l'icône passe à la croix quand le panneau est
          ouvert. */}
        <button
          type="button"
          data-recherche-ouvrir
          aria-expanded="false"
          aria-controls={rechercheId}
          aria-label={search.openLabel}
          data-label-fermer={search.closeLabel}
          class="recherche-loupe size-10 shrink-0 rounded-full text-navy transition-colors hover:bg-navy/8"
        >
          <svg
            aria-hidden="true"
            class="recherche-loupe-icone size-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <circle cx="8.75" cy="8.75" r="5.25"></circle>
            <path d="m12.75 12.75 4 4"></path>
          </svg>
          <svg
            aria-hidden="true"
            class="recherche-croix-icone size-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M5 5l10 10M15 5 5 15"></path>
          </svg>
        </button>
        {/* Taille `md` (48 px) dans une barre de 56 : 4 px de part et d'autre, et la contraction au
          défilement (scale 0.92, `subnav-cta`) le ramène à 44 px, la cible tactile minimale.
          `lg:pr-[3px]` sur la barre égalise le retrait droit : le bouton mesure 50 px avec son
          filet, (56 - 50) / 2 fait 3. À partir de `lg` seulement : en dessous, c'est le bouton
          Menu (40 px) qui borde la barre, avec son propre retrait. */}
        <Button position={nav.cta.position} variant="primary" size="md" class="subnav-cta px-7 max-[26rem]:px-5">{ctaLabel}</Button>
      </div>

      <button
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls={panelId}
        class="inline-flex h-10 shrink-0 items-center gap-2 rounded-full px-2.5 text-sm font-semibold text-navy transition-colors hover:bg-navy/8 sm:px-3 lg:hidden"
      >
        <svg
          aria-hidden="true"
          class="size-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
        </svg>
        <span class="max-[26rem]:sr-only">{menuLabel}</span>
      </button>
    </div>
    <SiteSearch id={rechercheId} />
    </div>
  </div>

  <div
    id={panelId}
    data-menu-panel
    role="dialog"
    aria-modal="true"
    aria-label={menuAriaLabel}
    class="fixed inset-0 z-60"
    hidden
  >
    {/* Voile : il assombrit la page derrière le tiroir et le referme au clic. */}
    <div data-menu-close data-menu-scrim class="absolute inset-0 bg-ink/70"></div>
    <div
      data-menu-drawer
      class="surface-glass-dark absolute inset-y-0 right-0 flex w-full max-w-sm flex-col overflow-y-auto overscroll-contain text-white max-sm:max-w-none"
    >
      <Container size="wide" class="flex h-subnav shrink-0 items-center justify-between gap-4">
        <a
          href={logoHref}
          class="flex items-center gap-2.5 no-underline"
          aria-label={homeLinkLabel}
          data-menu-close
        >
          <Image
            src={logoWhite}
            alt={nav.brand}
            width={290}
            height={89}
            loading="lazy"
            decoding="async"
            class="h-7 w-auto"
          />
        </a>
        <button
          type="button"
          data-menu-close
          class="inline-flex h-10 items-center gap-2 rounded-full px-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          <span>{closeLabel}</span>
          <svg
            aria-hidden="true"
            class="size-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M4.5 4.5l11 11M15.5 4.5l-11 11"></path>
          </svg>
        </button>
      </Container>

      <Container size="wide" class="flex flex-1 flex-col justify-center pb-10">
        <ul class="flex flex-col gap-1" role="list">
          {
            entries.map((e) => (
              <li>
                <a
                  href={e.href}
                  data-menu-close
                  data-astro-prefetch="hover"
                  aria-current={e.current ? 'page' : undefined}
                  class="block rounded-full px-3.5 py-2.5 text-base font-medium text-white/85 no-underline transition-colors hover:text-white aria-[current]:bg-white/12 aria-[current]:font-semibold aria-[current]:text-white"
                >
                  {e.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button position={nav.cta.position} variant="light" size="lg" class="w-full sm:w-auto"
            >{nav.cta.label}</Button
          >
        </div>
      </Container>
    </div>
  </div>
</nav>

<script>
  /* Aucune dépendance au moteur d'animation : la barre se comporte de même sur toutes les pages. */
  import { deverrouiller, verrouiller } from '@/scripts/verrou';

  const root = document.querySelector<HTMLElement>('[data-sitenav]');
  if (root) {
    const bar = root.querySelector<HTMLElement>('[data-sitenav-bar]');
    const list = root.querySelector<HTMLElement>('[data-sitenav-list]');
    const pill = root.querySelector<HTMLElement>('[data-subnav-pill]');
    /* La pastille marque la page courante (le menu ne contient que des pages). */
    const currentLink = list?.querySelector<HTMLAnchorElement>('a[aria-current="page"]') ?? null;

    /* Pastille : position et taille d'un lien (lectures groupées, puis écritures). Sans argument,
       la page courante ; avec, le lien visé, pour le retour visuel immédiat du clic. */
    const placePill = (cible: HTMLAnchorElement | null = currentLink) => {
      if (!pill) return;
      if (!cible) {
        pill.style.opacity = '0';
        return;
      }
      const item = cible.parentElement as HTMLElement;
      const { offsetLeft, offsetTop, offsetWidth, offsetHeight } = item;
      // Première apparition : placée sans transition de position ni de largeur, seul le fondu joue ;
      // ensuite (redimensionnement, polices, clic) elle glisse et se morphe.
      const appearing = pill.style.opacity !== '1';
      if (appearing) pill.style.transitionProperty = 'opacity';
      pill.style.width = offsetWidth + 'px';
      pill.style.height = offsetHeight + 'px';
      pill.style.top = offsetTop + 'px';
      pill.style.transform = `translateX(${offsetLeft}px)`;
      pill.style.opacity = '1';
      if (appearing) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            pill.style.transitionProperty = '';
          });
        });
      }
    };

    /* Retour visuel AU CLIC, avant que la page suivante réponde : la pastille part vers le lien
       visé et s'étire dans le sens du trajet ; la transition de vue reprend le mouvement là où il
       en est. Clics rapides : l'étirement est relancé en le RETIRANT puis en le reposant après un
       reflow forcé, sans quoi le navigateur ignore une animation déjà en cours ; le déplacement,
       lui, est une transition et repart toujours de la position réelle. */
    const skin = pill?.querySelector<HTMLElement>('[data-subnav-pill-skin]') ?? null;
    let etirement = 0;
    const glisserVers = (lien: HTMLAnchorElement) => {
      if (!pill || lien === currentLink) return;
      pill.removeAttribute('data-sliding');
      if (skin) void skin.offsetWidth;
      pill.setAttribute('data-sliding', '');
      placePill(lien);
      window.clearTimeout(etirement);
      etirement = window.setTimeout(() => pill.removeAttribute('data-sliding'), 560);
    };

    list?.addEventListener('click', (event) => {
      const lien = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      /* Un clic modifié ou un clic du milieu ouvre un onglet : la page ne change pas, l'indicateur non
         plus. */
      const e = event as MouseEvent;
      if (!lien || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      glisserVers(lien);
    });

    /* Retour arrière : la page revient du bfcache avec l'indicateur là où il était au départ ;
       `pageshow` le remet sur le lien courant de CETTE page. */
    window.addEventListener('pageshow', () => placePill());

    /* Fondu latéral : uniquement quand la liste déborde réellement. */
    const syncOverflow = () => {
      if (list) list.toggleAttribute('data-overflow', list.scrollWidth - list.clientWidth > 1);
    };

    /* Ombre dès que la page est défilée, CTA compact passé le seuil `data-compact-at` (part du
       défilement total du document, 0,4 par défaut ; l'attribut est retiré en remontant). Une seule
       lecture de scroll par frame. */
    const compactAt = Math.min(1, Math.max(0, parseFloat(root.dataset.compactAt ?? '') || 0.4));

    let scrollFrame = 0;
    const syncScroll = () => {
      scrollFrame = 0;
      const y = window.scrollY;
      /* Seuil à 40 px (12/09/2026) : la barre prend son ombre ET se contracte légèrement une fois la
         page franchement défilée, pas au premier pixel d'un rebond élastique. */
      bar?.toggleAttribute('data-stuck', y > 40);
      const range = document.documentElement.scrollHeight - window.innerHeight;
      const compact = range > 0 && y / range >= compactAt;
      if (compact !== root.hasAttribute('data-compact'))
        root.toggleAttribute('data-compact', compact);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(syncScroll);
      },
      { passive: true }
    );

    /* La pastille, le fondu et le seuil suivent les changements de taille (polices, rotation, fenêtre). */
    let raf = 0;
    const replace = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        syncOverflow();
        placePill();
        syncScroll();
      });
    };
    window.addEventListener('resize', replace, { passive: true });
    document.fonts?.ready.then(replace);
    syncOverflow();
    placePill();
    syncScroll();

    /* Panneau plein écran (< lg) : ouverture / fermeture, Échap, retour du focus, piège à tabulation. */
    const opener = root.querySelector<HTMLButtonElement>('[data-menu-open]');
    const panel = root.querySelector<HTMLElement>('[data-menu-panel]');
    if (opener && panel) {
      const focusables = () =>
        Array.from(
          panel.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => !el.hidden && el.offsetParent !== null);

      /* Tiroir : le panneau entre par la DROITE. `hidden` le sort du parcours clavier quand il est
         fermé, mais il doit être présent AVANT que le glissement commence : on l'affiche, on force
         un calcul de mise en page pour que le navigateur enregistre la position fermée, puis on
         pose `data-open`. À la fermeture, l'inverse : on retire `data-open`, on laisse glisser, on
         masque à la fin. L'état ouvert se lit sur `data-open`, jamais sur `hidden`, qui reste faux
         pendant toute la sortie. */
      const CLOSE_MS = 420;
      let hideTimer = 0;
      const isOpen = () => panel.dataset.open !== undefined;

      const open = () => {
        if (isOpen()) return;
        /* Une seule surface à la fois : la recherche se ferme d'abord (src/scripts/recherche/panneau.ts écoute).
           Ouverts ensemble, les deux pièges à tabulation se renvoyaient le focus à chaque Tab. */
        document.dispatchEvent(new CustomEvent('rstart:recherche:fermer'));
        window.clearTimeout(hideTimer);
        panel.hidden = false;
        void panel.offsetWidth;
        panel.dataset.open = '';
        opener.setAttribute('aria-expanded', 'true');
        /* La page ne défile plus derrière le tiroir mais garde sa barre de défilement
           (src/scripts/verrou.ts) ; troisième argument : la barre devient inerte elle aussi, le
           tiroir la recouvre. */
        verrouiller(panel, panel.querySelector<HTMLElement>('[data-menu-drawer]'), [bar]);
        /* Le bouton « Fermer », pas le voile : `[data-menu-close]:not(a)` attrapait le <div> du voile,
           qui n'est pas focalisable. Le focus restait alors sur le bouton Menu, donc hors du dialogue,
           et le `:focus-within` de la barre rallumait ses entrées derrière le tiroir. */
        panel.querySelector<HTMLElement>('button[data-menu-close]')?.focus({ preventScroll: true });
      };

      const close = (restoreFocus = true) => {
        if (!isOpen()) return;
        delete panel.dataset.open;
        opener.setAttribute('aria-expanded', 'false');
        deverrouiller(panel);
        /* `preventScroll` : le bouton Menu vit dans la barre COLLANTE, et rendre le focus à un
           élément collant fait défiler la page jusqu'à sa position statique, tout en haut : fermer
           le tiroir par Échap ramenait le visiteur au sommet (repéré le 18/09/2026 par le test du
           tiroir). */
        if (restoreFocus) opener.focus({ preventScroll: true });
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          if (!isOpen()) panel.hidden = true;
        }, CLOSE_MS);
      };

      opener.addEventListener('click', () => (isOpen() ? close() : open()));

      panel.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        /* « Souscrire en ligne » du tiroir, tunnel fermé : la fenêtre « bientôt » va s'ouvrir
           (SubscribeSoon.astro, écouteur sur `document`, donc après celui-ci). Le tiroir se ferme
           d'abord et rend le focus au bouton Menu, où le navigateur le rendra à la fermeture de la
           fenêtre. */
        if (
          target?.closest('[data-cta="souscrire"]') &&
          document.body.dataset.souscriptionOuverte !== 'oui'
        ) {
          close();
          return;
        }
        const closer = target?.closest<HTMLElement>('[data-menu-close]');
        if (!closer) return;
        // Lien : on laisse la navigation se faire (ancre ou page) sans renvoyer le focus sur le bouton.
        close(closer.tagName !== 'A');
      });

      document.addEventListener('keydown', (e) => {
        /* Une fenêtre native ouverte par-dessus a la main sur le clavier : annuler Échap ici empêchait
           sa fermeture (audit du 18/09/2026). */
        if (!isOpen() || document.querySelector('dialog[open]')) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }
        if (e.key === 'Tab') {
          const items = focusables();
          if (!items.length) return;
          const first = items[0] as HTMLElement;
          const last = items[items.length - 1] as HTMLElement;
          const active = document.activeElement as HTMLElement | null;
          if (e.shiftKey && (active === first || !panel.contains(active))) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && (active === last || !panel.contains(active))) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      /* Aucune fermeture forcée au changement de largeur : ouvert sur une tablette qu'on fait
         pivoter, le tiroir reste ouvert et entier ; il se ferme comme partout, par son bouton, le
         voile ou Échap. */
    }
  }
</script>
