---
/**
 * Navigation unique du site (plan V2 §1) : une seule barre, collée en haut de page, qui remplace
 * l'ancien couple Header + SubNav. Un seul landmark de navigation par page (`<nav aria-label>`),
 * qui contient la barre et le panneau plein écran des petits écrans.
 *
 * Forme (11/09/2026, demande de l'équipe) : ce n'est plus un bandeau pleine largeur mais une PASTILLE
 * FLOTTANTE — décollée du haut et des bords de `--spacing-nav-gap`, gros rayon (`--radius-nav`),
 * matière « liquid glass » (@utility nav-glass). Elle RECOUVRE le contenu au lieu de le pousser vers le
 * bas (marge basse négative de `--spacing-nav-total`) : l'en-tête sombre de chaque page passe derrière
 * elle. Sans ce recouvrement, la pastille claire était posée sur le fond clair du document, donc
 * invisible, et un bouton Menu blanc l'aurait été aussi (constat du 11/09/2026). Les en-têtes réservent
 * cette hauteur en padding haut. L'écart entre dans `scroll-padding-top` (global.css) et
 * dans le calage de la barre d'ancres de /documentation, pour qu'aucune ancre ne passe dessous.
 * Sur téléphone, le libellé « Menu » est désormais visible à côté du chevron (il était en `sr-only`) :
 * au premier écran de l'accueil, le logo et le CTA sont encore à opacité 0 — ils arrivent par le vol
 * d'ouverture — et la barre paraissait vide.
 *
 * Entrées : uniquement les pages du menu (src/config/pages.ts, `menuPages`), l'accueil compris, sur
 * toutes les pages — jamais d'ancre de section (décision du 10/09/2026). Aucun libellé en dur :
 * src/config/pages.ts et src/content/fr/nav.ts.
 *
 * Reprise de l'ancienne sous-navigation :
 *  - sur grand écran, la barre passe en grille de trois colonnes (1fr / auto / 1fr) : les entrées sont
 *    CENTRÉES dans la pastille, quelles que soient les largeurs du logo à gauche et du CTA à droite ;
 *  - liste des pages visible à partir de « lg » seulement (sous ce seuil, un seul menu : le panneau ; la barre
 *    ne garde que le logo, le CTA et le bouton Menu), à défilement horizontal sans barre visible (`scrollbar-none`), avec fondu latéral
 *    (`scroll-fade-x`) posé par le script dès que la liste déborde réellement ;
 *  - pastille glissante (`data-subnav-pill`, transform + width, aucune propriété de mise en page
 *    animée) posée sur la page courante (aria-current="page") ; plus aucun état actif de section
 *    (IntersectionObserver retiré le 10/09/2026 avec les ancres) ;
 *  - CTA compacté au-delà de 40 % du défilement du document (`data-compact-at="0.4"` sur le <nav> →
 *    attribut `data-compact` → CSS `.subnav-cta`, scale 0.92). Géré ici, par le script inline, sans
 *    GSAP : le comportement est le même sur l'accueil et sur les sous-pages (ex-motion/progress.ts).
 * Reprise de l'ancien en-tête :
 *  - logo et CTA (le suffixe « par CORUM L'Épargne » est retiré de la barre depuis le 10/09/2026, à la
 *    demande de l'équipe ; `nav.brandSuffix` n'a plus de consommateur, il reste dans nav.ts parce que
 *    NavContent l'exige encore) ;
 *  - sous « lg », un panneau plein écran (aria-expanded / aria-controls, Échap, piège à focus,
 *    retour du focus sur le bouton) qui liste les mêmes entrées à la verticale.
 *
 * L'ombre n'apparaît qu'une fois la page défilée (`data-stuck` sur la barre). Aucune différence entre
 * l'accueil et les sous-pages : mêmes entrées, même CTA. Le logo porte `data-brand-target` et le CTA
 * `data-cta-target` : ce sont les deux arrivées du vol d'ouverture du hero. Le logo de la barre :
 * c'est l'arrivée du vol de la marque (src/scripts/motion/brandflight.ts), masqué par CSS sur l'accueil
 * (≥ 40 rem, no-preference) jusqu'au fondu croisé ; visible d'emblée partout ailleurs.
 * La barre est `sticky` sans filtre : le panneau `fixed` reste bien calé sur le viewport (un
 * `backdrop-filter` sur un ancêtre en ferait le bloc conteneur), d'où la surface vitrée posée sur
 * l'enfant `[data-sitenav-bar]`.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import logoWhite from '@/assets/logos/r-start-blanc.svg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { menuPages, pages } from '@/config/pages';
import { nav } from '@/content/fr/nav';
import { withBase } from '@/lib/href';

/** Chemin courant normalisé (sans barre finale) pour l'état actif du menu. */
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => (path.replace(/\/+$/, '') || '/') === currentPath;

interface Entry {
  key: string;
  label: string;
  href: string;
  /** Page courante : aria-current="page". */
  current: boolean;
}

/** Le menu ne contient que des pages (décision du 10/09/2026), l'accueil compris, sur toutes les pages. */
const entries: Entry[] = menuPages.map((p) => ({
  key: p.key,
  label: p.navLabel ?? p.label,
  href: withBase(p.path),
  current: isCurrent(p.path),
}));

/** Le logo ramène toujours à l'accueil (aucune ancre dans la navigation). */
const logoHref = withBase(pages.home.path);
const panelId = 'site-nav-panel';
const menuLabel = nav.menuLabel ?? nav.brand;
const closeLabel = nav.closeLabel ?? menuLabel;
const menuAriaLabel = nav.menuAriaLabel ?? nav.brand;
const homeLinkLabel = nav.homeLinkLabel ?? nav.brand;
const ctaLabel = nav.subnavCtaLabel ?? nav.cta.label;
const linkClass =
  'block rounded-full px-2 py-1.5 text-sm whitespace-nowrap text-slate-700 no-underline transition-colors hover:text-navy aria-[current]:font-semibold aria-[current]:text-navy sm:px-3';
---

<nav
  data-sitenav
  data-compact-at="0.4"
  aria-label={menuAriaLabel}
  class="pt-nav-gap -mb-nav-total sticky top-0 z-40"
>
  <div class="mx-auto w-full max-w-7xl px-3 sm:px-5">
    <div
      data-sitenav-bar
      class="nav-glass flex h-subnav items-center gap-2 px-3 sm:gap-4 sm:px-4 lg:grid lg:grid-cols-[1fr_auto_1fr]"
    >
      <a
        href={logoHref}
        class="flex shrink-0 items-center gap-2.5 no-underline lg:justify-self-start"
        aria-label={homeLinkLabel}
      >
        <Image
          src={brandLogo}
          alt={nav.brand}
          width={290}
          height={89}
          loading="eager"
          decoding="async"
          data-brand-target
          class="h-7 w-auto"
        />
      </a>

      <ul
        data-sitenav-list
        class="scrollbar-none scroll-fade-x relative -my-2 -mr-2 -ml-3 hidden min-w-0 flex-1 items-center gap-0.5 overflow-x-auto py-2 pr-2 pl-3 sm:-mx-2 sm:gap-1 sm:px-2 lg:flex lg:justify-self-center"
        role="list"
      >
        <li aria-hidden="true" data-subnav-pill class="subnav-pill"></li>
        {
          entries.map((e) => (
            <li class="relative shrink-0">
              <a href={e.href} aria-current={e.current ? 'page' : undefined} class={linkClass}>
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        /* Sous « lg », la liste est masquée : un seul menu (le panneau), le CTA reste visible et pousse à droite. */
      }
      {/* `data-cta-target` : arrivée du vol du CTA du hero (src/scripts/motion/brandflight.ts). */}
      <div data-cta-target class="ml-auto shrink-0 lg:ml-0 lg:justify-self-end">
        <Button position="nav" variant="primary" size="sm" class="subnav-cta">{ctaLabel}</Button>
      </div>

      <button
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls={panelId}
        class="inline-flex h-10 shrink-0 items-center gap-2 rounded-full px-2.5 text-sm font-semibold text-navy transition-colors hover:bg-navy/8 sm:px-3 lg:hidden"
      >
        <svg
          aria-hidden="true"
          class="size-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
        </svg>
        <span class="max-[22rem]:sr-only">{menuLabel}</span>
      </button>
    </div>
  </div>

  <div
    id={panelId}
    data-menu-panel
    role="dialog"
    aria-modal="true"
    aria-label={menuAriaLabel}
    class="surface-glass-dark fixed inset-0 z-50 flex flex-col overflow-y-auto text-white lg:hidden"
    hidden
  >
    <Container size="wide" class="flex h-subnav shrink-0 items-center justify-between gap-4">
      <a
        href={logoHref}
        class="flex items-center gap-2.5 no-underline"
        aria-label={homeLinkLabel}
        data-menu-close
      >
        <Image
          src={logoWhite}
          alt={nav.brand}
          width={290}
          height={89}
          loading="lazy"
          decoding="async"
          class="h-7 w-auto"
        />
      </a>
      <button
        type="button"
        data-menu-close
        class="inline-flex h-10 items-center gap-2 rounded-full px-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
      >
        <span>{closeLabel}</span>
        <svg
          aria-hidden="true"
          class="size-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M4.5 4.5l11 11M15.5 4.5l-11 11"></path>
        </svg>
      </button>
    </Container>

    <Container size="wide" class="flex flex-1 flex-col justify-center py-10">
      <ul class="flex flex-col gap-1" role="list">
        {
          entries.map((e) => (
            <li>
              <a
                href={e.href}
                data-menu-close
                aria-current={e.current ? 'page' : undefined}
                class="text-display-sm block rounded-2xl px-3 py-2.5 text-white/85 no-underline transition-colors hover:text-white aria-[current]:text-white aria-[current]:underline aria-[current]:decoration-2 aria-[current]:underline-offset-8"
              >
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button position="nav" variant="light" size="lg" class="w-full sm:w-auto"
          >{nav.cta.label}</Button
        >
      </div>
    </Container>
  </div>
</nav>

<script>
  /*
   * Barre unique : pastille sur la page courante, fondu de débordement, ombre au défilement, CTA
   * compact au-delà de 40 % du document, panneau plein écran sous « lg ». Aucune dépendance au moteur
   * d'animation : identique sur toutes les pages.
   */
  const root = document.querySelector<HTMLElement>('[data-sitenav]');
  if (root) {
    const bar = root.querySelector<HTMLElement>('[data-sitenav-bar]');
    const list = root.querySelector<HTMLElement>('[data-sitenav-list]');
    const pill = root.querySelector<HTMLElement>('[data-subnav-pill]');
    /* La pastille marque la page courante (le menu ne contient que des pages). */
    const currentLink = list?.querySelector<HTMLAnchorElement>('a[aria-current="page"]') ?? null;

    /* Pastille : position et taille du lien courant (lectures groupées, puis écritures). */
    const placePill = () => {
      if (!pill) return;
      if (!currentLink) {
        pill.style.opacity = '0';
        return;
      }
      const item = currentLink.parentElement as HTMLElement;
      const { offsetLeft, offsetTop, offsetWidth, offsetHeight } = item;
      // Première apparition : placée sans transition de position ni de largeur, seul le fondu joue ;
      // ensuite (redimensionnement, polices) elle glisse et se morphe.
      const appearing = pill.style.opacity !== '1';
      if (appearing) pill.style.transitionProperty = 'opacity';
      pill.style.width = offsetWidth + 'px';
      pill.style.height = offsetHeight + 'px';
      pill.style.top = offsetTop + 'px';
      pill.style.transform = `translateX(${offsetLeft}px)`;
      pill.style.opacity = '1';
      if (appearing) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            pill.style.transitionProperty = '';
          });
        });
      }
    };

    /* Fondu latéral : uniquement quand la liste déborde réellement. */
    const syncOverflow = () => {
      if (list) list.toggleAttribute('data-overflow', list.scrollWidth - list.clientWidth > 1);
    };

    /*
     * Ombre portée dès que la page est défilée (la barre est collée en haut dès le premier écran) et
     * CTA compact une fois passé le seuil `data-compact-at` (part du défilement total du document,
     * 0,4 par défaut ; l'attribut est retiré en remontant). Une seule lecture de scroll par frame.
     */
    const compactAt = Math.min(1, Math.max(0, parseFloat(root.dataset.compactAt ?? '') || 0.4));
    let scrollFrame = 0;
    const syncScroll = () => {
      scrollFrame = 0;
      const y = window.scrollY;
      bar?.toggleAttribute('data-stuck', y > 2);
      const range = document.documentElement.scrollHeight - window.innerHeight;
      const compact = range > 0 && y / range >= compactAt;
      if (compact !== root.hasAttribute('data-compact'))
        root.toggleAttribute('data-compact', compact);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(syncScroll);
      },
      { passive: true }
    );

    /* La pastille, le fondu et le seuil suivent les changements de taille (polices, rotation, fenêtre). */
    let raf = 0;
    const replace = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        syncOverflow();
        placePill();
        syncScroll();
      });
    };
    window.addEventListener('resize', replace, { passive: true });
    document.fonts?.ready.then(replace);
    syncOverflow();
    placePill();
    syncScroll();

    /* Panneau plein écran (< lg) : ouverture / fermeture, Échap, retour du focus, piège à tabulation. */
    const opener = root.querySelector<HTMLButtonElement>('[data-menu-open]');
    const panel = root.querySelector<HTMLElement>('[data-menu-panel]');
    if (opener && panel) {
      const focusables = () =>
        Array.from(
          panel.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => !el.hidden && el.offsetParent !== null);

      const isOpen = () => !panel.hidden;

      const open = () => {
        if (isOpen()) return;
        panel.hidden = false;
        opener.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
        panel.querySelector<HTMLElement>('[data-menu-close]:not(a)')?.focus();
      };

      const close = (restoreFocus = true) => {
        if (!isOpen()) return;
        panel.hidden = true;
        opener.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
        if (restoreFocus) opener.focus();
      };

      opener.addEventListener('click', () => (isOpen() ? close() : open()));

      panel.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const closer = target?.closest<HTMLElement>('[data-menu-close]');
        if (!closer) return;
        // Lien : on laisse la navigation se faire (ancre ou page) sans renvoyer le focus sur le bouton.
        close(closer.tagName !== 'A');
      });

      document.addEventListener('keydown', (e) => {
        if (!isOpen()) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }
        if (e.key === 'Tab') {
          const items = focusables();
          if (!items.length) return;
          const first = items[0] as HTMLElement;
          const last = items[items.length - 1] as HTMLElement;
          const active = document.activeElement as HTMLElement | null;
          if (e.shiftKey && (active === first || !panel.contains(active))) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && (active === last || !panel.contains(active))) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // Le panneau n'existe qu'en dessous de « lg » : on le referme si la fenêtre s'élargit.
      const desktop = window.matchMedia('(min-width: 64rem)');
      desktop.addEventListener('change', (e) => {
        if (e.matches) close(false);
      });
    }
  }
</script>
