---
/**
 * Bandeau de consentement cookies (CNIL) : deux boutons de même poids « Tout accepter » /
 * « Tout refuser », « Personnaliser » en lien, lien vers /cookies. Sous « sm », la carte est compacte
 * (texte court consent.bodyShort, boutons sur une ligne, marges réduites) pour ne jamais masquer la
 * ligne risques du hero à 375×812 ; à partir de « sm », elle reste assez basse (max-w-4xl, p-6) pour ne
 * pas rogner les CTA du hero à 1440×900 (haut de carte ≥ 665 px). Toutes les cibles tactiles font au
 * moins 40 px de haut. Textes : src/content/fr/consent.ts ; logique : src/scripts/consent.ts.
 */
import { site } from '@/config/site';
import { consent } from '@/content/fr/consent';
import { withBase } from '@/lib/href';

const bodyShort = consent.bodyShort ?? consent.body;
---

<div
  id="consent-banner"
  class="fixed inset-x-0 bottom-0 z-50 p-3 sm:p-6"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-title"
  aria-describedby="consent-body"
  data-gtm-id={site.gtmId}
  data-cookie-name={site.consent.cookieName}
  data-max-age-days={site.consent.maxAgeDays}
  hidden
>
  <div class="mx-auto max-w-4xl rounded-2xl border border-mist bg-white p-4 shadow-float sm:rounded-3xl sm:p-6">
    <h2 id="consent-title" class="text-base font-semibold text-navy sm:text-lg">{consent.title}</h2>
    <p id="consent-body" class="mt-1.5 text-sm leading-relaxed text-slate-700">
      <span class="sm:hidden">{bodyShort}</span>
      <span class="hidden sm:inline">{consent.body}</span>
      <a href={withBase(consent.policyHref)} class="ml-1 font-medium text-teal-700 underline underline-offset-4">{consent.policyLabel}</a>
    </p>

    <div class="mt-4 space-y-3 sm:mt-5" data-consent-panel hidden>
      <label class="flex items-start gap-3 rounded-2xl bg-paper p-4">
        <input type="checkbox" checked disabled class="mt-1 size-4 accent-teal-500" />
        <span>
          <span class="block font-medium text-navy">{consent.necessaryLabel}</span>
          <span class="block text-sm text-slate-700">{consent.necessaryDescription}</span>
        </span>
      </label>
      <label class="flex items-start gap-3 rounded-2xl bg-paper p-4">
        <input type="checkbox" data-consent-analytics class="mt-1 size-4 accent-teal-500" />
        <span>
          <span class="block font-medium text-navy">{consent.analyticsLabel}</span>
          <span class="block text-sm text-slate-700">{consent.analyticsDescription}</span>
        </span>
      </label>
      <button
        type="button"
        data-consent-save
        class="rounded-full border border-navy px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-navy hover:text-white"
      >
        {consent.save}
      </button>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 sm:mt-4 sm:gap-3">
      <button
        type="button"
        data-consent-accept
        class="min-h-10 rounded-full bg-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-700 sm:px-5"
      >
        {consent.accept}
      </button>
      <button
        type="button"
        data-consent-refuse
        class="min-h-10 rounded-full bg-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-700 sm:px-5"
      >
        {consent.refuse}
      </button>
      <button
        type="button"
        data-consent-customize
        aria-expanded="false"
        class="min-h-10 w-full rounded-full px-1 py-2.5 text-left text-sm font-semibold text-navy underline underline-offset-4 transition hover:text-teal-700 sm:w-auto sm:px-5 sm:text-center"
      >
        {consent.customize}
      </button>
    </div>
  </div>
</div>
