---
/**
 * Illustration du moteur 02, « Les plus-values réalisées sur les ventes d'immeuble » (16/09/2026).
 *
 * MÊME GRAMMAIRE QUE LES TROIS TUILES et que le moteur 01 : trait clair sur fond ink, boucle lente,
 * animation coupée en `prefers-reduced-motion`, format 236 × 100 comme le bandeau de la carte.
 *
 * DEUXIÈME VERSION. La première montrait un échange, immeuble d'un côté, prix de l'autre, sans rien
 * qui monte : une vente, pas un gain. L'équipe a demandé « plutôt une hausse de prix », en
 * connaissance de cause, et c'est ce que montre celle-ci.
 *
 * CE QU'ELLE MONTRE, ET SES LIMITES : une étiquette de prix qui monte d'un palier bas vers un palier
 * haut. AUCUN CHIFFRE, aucune devise, aucune échelle, aucune durée, aucune unité : rien ne permet de
 * lire une ampleur ni une période, et il n'y a pas de courbe de performance. C'est le mécanisme
 * qu'elle nomme, celui que le texte de la carte décrit, pas un résultat attendu.
 * Le bloc Risques de la page porte l'avertissement correspondant.
 *
 * Décorative (aria-hidden) : le texte de la carte porte le sens.
 */
---

<figure class="gain-figure" aria-hidden="true">
  <svg viewBox="0 0 236 100" fill="none" class="gain-svg">
    {
      /* L'immeuble vendu, à gauche : la même grille de fenêtres que le moteur 01, pour que les deux
        cartes montrent bien le même objet. */
    }
    <rect x="20" y="26" width="52" height="58" rx="5" class="gain-cadre" />
    {
      [0, 1, 2].flatMap((colonne) =>
        [0, 1, 2, 3].map((ligne) => (
          <rect x={29 + colonne * 13} y={35 + ligne * 12} width="8" height="7" rx="1.5" class="gain-fenetre" />
        ))
      )
    }

    {/* Les deux paliers, bas et haut, et la pente entre les deux. */}
    <path d="M92 76h30" class="gain-palier" />
    <path d="M197 34h18" class="gain-palier gain-palier--haut" />
    <path d="M122 76 184 34" class="gain-pente" />

    {
      /*
       * L'ÉTIQUETTE DE PRIX, et non un chiffre : elle dit « prix » sans avancer de montant. Elle monte
       * le long de la pente, du palier bas au palier haut, puis disparaît et recommence.
       * Le trou de l'étiquette est un cercle plein de la couleur du fond, pas un masque : un masque
       * SVG coûterait une couche de rendu pour un point de 2 px.
       */
    }
    <g class="gain-etiquette">
      <path d="M-11-9h13l9 9-13 13-9-9v-13z" class="gain-etiquette-corps" />
      <circle cx="-6.5" cy="-4.5" r="2.2" class="gain-etiquette-trou" />
    </g>

    {/* La flèche du palier haut : elle se pose quand l'étiquette arrive. */}
    <path d="M206 26v-9M201 21l5-5 5 5" class="gain-fleche" />
  </svg>
</figure>

<style>
  .gain-figure {
    margin: 0;
  }
  .gain-svg {
    display: block;
    width: 100%;
    aspect-ratio: 236 / 100;
  }
  .gain-cadre {
    stroke: rgb(169 221 230 / 0.42);
    stroke-width: 1.6;
  }
  .gain-fenetre {
    fill: rgb(169 221 230 / 0.3);
  }
  .gain-palier {
    stroke: rgb(169 221 230 / 0.28);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .gain-pente {
    stroke: rgb(169 221 230 / 0.2);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }
  .gain-etiquette-corps {
    fill: var(--color-teal-200);
  }
  .gain-etiquette-trou {
    fill: var(--color-ink);
  }
  .gain-fleche {
    stroke: var(--color-teal-400);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
   * UNE MONTÉE PAR CYCLE de 6,5 s. L'étiquette part du palier bas (122, 76), suit la pente jusqu'au
   * palier haut (184, 34), s'y tient, puis s'efface. Le palier haut et la flèche s'allument à son
   * arrivée et s'éteignent avec elle.
   * Les positions sont écrites en translations depuis l'origine du viewBox : le groupe est dessiné
   * autour de (0, 0), ce qui permet de l'animer en `transform` sans rouvrir son tracé.
   */
  .gain-etiquette {
    animation: gain-montee 6.5s ease-in-out infinite;
  }
  .gain-palier--haut {
    animation: gain-arrivee 6.5s ease-in-out infinite;
  }
  .gain-fleche {
    animation: gain-arrivee 6.5s ease-in-out infinite;
  }

  @keyframes gain-montee {
    0%,
    10% {
      transform: translate(122px, 76px);
      opacity: 0;
    }
    18% {
      transform: translate(122px, 76px);
      opacity: 1;
    }
    52%,
    80% {
      transform: translate(184px, 34px);
      opacity: 1;
    }
    92%,
    100% {
      transform: translate(184px, 34px);
      opacity: 0;
    }
  }
  @keyframes gain-arrivee {
    0%,
    46% {
      opacity: 0.25;
    }
    56%,
    80% {
      opacity: 1;
    }
    92%,
    100% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gain-etiquette,
    .gain-palier--haut,
    .gain-fleche {
      animation: none;
      opacity: 1;
    }
    /* À l'arrêt : l'étiquette est posée sur le palier haut, la hausse se lit d'un coup d'œil. */
    .gain-etiquette {
      transform: translate(184px, 34px);
    }
  }
</style>
