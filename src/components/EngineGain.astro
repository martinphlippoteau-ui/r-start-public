---
/**
 * Illustration du moteur 02, « Les plus-values réalisées sur les ventes d'immeuble » (16/09/2026).
 *
 * MÊME GRAMMAIRE QUE LES QUATRE AUTRES DESSINS DES CARTES (StrategySelect.astro la décrit en tête) :
 * trait clair sur fond ink, boucle lente, en pause hors écran, complet et immobile en
 * `prefers-reduced-motion`. Format 236 × 100, pleine largeur de la carte.
 *
 * QUATRIÈME VERSION, ET C'EST L'ÉQUIPE QUI A CHOISI LA FORME (16/09/2026 au soir : « utilise une
 * courbe de prix € qui monte »). Avant : un échange immeuble/prix sans hausse ; une étiquette sur une
 * pente ; une étiquette qui montait le long de la façade puis filait vers la marque, en miroir du
 * moteur 01, jugée « pas terrible du tout ».
 *
 * CE QU'ELLE MONTRE : l'immeuble à gauche, celui du moteur 01 ; à sa droite, un point d'achat, puis UNE
 * COURBE DE PRIX QUI MONTE, révélée de gauche à droite avec la surface qu'elle couvre, une pointe
 * lumineuse à son extrémité ; au sommet, une pastille « € » se pose : la vente, et la plus-value
 * réalisée. Puis tout s'efface, un temps de silence, et un autre immeuble.
 *
 * SES LIMITES, tenues à la lettre : AUCUN CHIFFRE, aucun axe gradué, aucune échelle, aucune date,
 * aucune durée. La courbe monte sans à-coup ni creux : elle nomme le mécanisme que le texte de la
 * carte décrit, la recherche de plus-values à la vente, elle ne dessine ni un historique ni une
 * promesse. Le bloc Risques de la page porte l'avertissement correspondant. Le signe « € » est un
 * symbole, pas un montant.
 *
 * LA RÉVÉLATION EST FAITE PAR UN DÉCOUPAGE (`clip-path: inset`) qui avance à vitesse constante de
 * gauche à droite, sur la courbe ET sur sa surface ensemble : les deux ont donc toujours exactement
 * le même bord. La pointe, elle, est portée le long de la courbe par `offset-path`, dont la vitesse
 * est celle du CHEMIN, pas celle de l'abscisse : pour qu'elle reste au bord du découpage, sa courbe
 * de temps est une fonction `linear()` CALCULÉE ci-dessous à partir de la géométrie, abscisse par
 * abscisse. Un navigateur sans `linear()` la remplace par une progression uniforme : la pointe
 * dérive alors de quelques unités au plus, toujours sur la courbe.
 *
 * Décorative (aria-hidden) : le texte de la carte porte le sens.
 */
import { fenetres } from '@/lib/immeuble';

/** L'immeuble du moteur 01, un peu plus étroit pour laisser la place à la courbe. */
const CADRE = { x: 18, y: 30, w: 48, h: 54 };
const FENETRES = fenetres(CADRE, { colonnes: 3, rangees: 4, taille: 7, ecart: 4 });
const SOL = 84;

/*
 * LA COURBE, quatre cubiques raccordées tangentes à tangentes (les tangentes entrante et sortante de
 * chaque nœud sont colinéaires : aucun angle). Elle part du point d'achat et monte jusqu'au sommet,
 * sans creux, sa pente variant juste assez pour ne pas être une droite.
 */
type Pt = [number, number];
const SEGMENTS: [Pt, Pt, Pt, Pt][] = [
  [[84, 76], [96, 75], [104, 71], [116, 66]],
  [[116, 66], [128, 61], [134, 60], [142, 54]],
  [[142, 54], [150, 48], [160, 45], [172, 40]],
  [[172, 40], [184, 35], [192, 30], [204, 26]],
];
const DEPART = SEGMENTS[0]![0];
const SOMMET = SEGMENTS[SEGMENTS.length - 1]![3];
const COURBE =
  `M${DEPART[0]} ${DEPART[1]}` +
  SEGMENTS.map(([, p1, p2, p3]) => `C${p1[0]} ${p1[1]} ${p2[0]} ${p2[1]} ${p3[0]} ${p3[1]}`).join('');
const SURFACE = `${COURBE}V${SOL}H${DEPART[0]}Z`;

/*
 * ÉCHANTILLONNAGE de la courbe : pour chaque abscisse (32 pas uniformes entre le départ et le sommet),
 * la fraction de LONGUEUR de chemin déjà parcourue. C'est la courbe de temps de la pointe : quand le
 * découpage est à u % de la largeur, la pointe doit être à s(u) % du chemin.
 */
const bezier = ([p0, p1, p2, p3]: [Pt, Pt, Pt, Pt], t: number): Pt => {
  const u = 1 - t;
  return [
    u * u * u * p0[0] + 3 * u * u * t * p1[0] + 3 * u * t * t * p2[0] + t * t * t * p3[0],
    u * u * u * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1],
  ];
};
const echantillons: { x: number; l: number }[] = [{ x: DEPART[0], l: 0 }];
let longueur = 0;
let precedent: Pt = DEPART;
for (const seg of SEGMENTS) {
  for (let i = 1; i <= 100; i += 1) {
    const p = bezier(seg, i / 100);
    longueur += Math.hypot(p[0] - precedent[0], p[1] - precedent[1]);
    echantillons.push({ x: p[0], l: longueur });
    precedent = p;
  }
}
const PAS = 32;
const fractions = Array.from({ length: PAS + 1 }, (_, k) => {
  const x = DEPART[0] + ((SOMMET[0] - DEPART[0]) * k) / PAS;
  const e = echantillons.find((s) => s.x >= x) ?? echantillons[echantillons.length - 1]!;
  return Math.round((e.l / longueur) * 1000) / 1000;
});
const TEMPS_POINTE = `linear(${fractions.join(', ')})`;
---

<figure class="gain-figure" aria-hidden="true" data-in-view="illus-en-vue">
  <svg viewBox="0 0 236 100" fill="none" class="gain-svg">
    {/* L'immeuble vendu, et le sol qu'il partage avec la courbe. */}
    <rect x={CADRE.x} y={CADRE.y} width={CADRE.w} height={CADRE.h} rx="5" class="gain-cadre" />
    {FENETRES.map((f) => <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="1.5" class="gain-fenetre" />)}
    <path d={`M${CADRE.x} ${SOL + 0.5}H218`} class="gain-sol" />

    {/* La courbe et sa surface, révélées ensemble par le même découpage. */}
    <g class="gain-courbe">
      <path d={SURFACE} class="gain-surface" />
      <path d={COURBE} class="gain-trait" />
    </g>

    {/* Le point d'achat, au départ de la courbe. */}
    <circle cx={DEPART[0]} cy={DEPART[1]} r="3" class="gain-achat" />

    {/* La pointe qui mène la courbe : un point et sa lueur, dessinés autour de (0, 0). */}
    <g class="gain-pointe">
      <circle r="5" class="gain-pointe-lueur" />
      <circle r="2.2" class="gain-pointe-corps" />
    </g>

    {/* La vente, au sommet : l'onde, puis la pastille et son signe. */}
    <circle cx={SOMMET[0]} cy={SOMMET[1]} r="13" class="gain-onde" />
    <g class="gain-vente">
      <circle cx={SOMMET[0]} cy={SOMMET[1]} r="9" class="gain-vente-fond" />
      <text x={SOMMET[0]} y={SOMMET[1] + 0.5} class="gain-euro">€</text>
    </g>
  </svg>
</figure>

<style define:vars={{ courbe: `path("${COURBE}")`, tempsPointe: TEMPS_POINTE }}>
  .gain-figure {
    margin: 0;
    /* Pleine largeur de la carte : enfant d'une boîte flex, la figure retomberait sinon à la largeur
       intrinsèque du SVG, 300 px. */
    width: 100%;
    --cycle: 8s;
    --decal: var(--illus-decalage, 0s);
  }
  .gain-svg {
    display: block;
    width: 100%;
    aspect-ratio: 236 / 100;
  }
  .gain-cadre {
    stroke: rgb(169 221 230 / 0.38);
    stroke-width: 1.6;
  }
  .gain-fenetre {
    fill: rgb(169 221 230 / 0.3);
  }
  .gain-sol {
    stroke: rgb(169 221 230 / 0.2);
    stroke-width: 1;
  }
  .gain-surface {
    fill: var(--color-teal-400);
    fill-opacity: 0.14;
  }
  .gain-trait {
    stroke: var(--color-teal-200);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .gain-achat {
    fill: var(--color-ink);
    stroke: var(--color-teal-200);
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
  }
  .gain-pointe-lueur {
    fill: var(--color-teal-400);
    opacity: 0.3;
  }
  .gain-pointe-corps {
    fill: var(--color-teal-100);
  }
  .gain-vente-fond {
    fill: var(--color-ink);
    stroke: var(--color-teal-200);
    stroke-width: 1.4;
  }
  .gain-euro {
    fill: var(--color-teal-200);
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  /*
   * ÉTAT DE REPOS = IMAGE COMPLÈTE (`prefers-reduced-motion`, navigateurs sans animation) : la courbe
   * et sa surface entières, le point d'achat, la pastille au sommet ; ni pointe ni onde.
   */
  .gain-courbe {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }
  .gain-pointe {
    offset-path: var(--courbe);
    offset-rotate: 0deg;
    offset-distance: 100%;
    opacity: 0;
  }
  @supports not (offset-path: path('M0 0h1')) {
    .gain-pointe {
      display: none;
    }
  }
  .gain-onde {
    stroke: var(--color-teal-400);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .gain-vente {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
  }

  /*
   * LE CYCLE, 8 s comme les quatre autres dessins :
   *    0 –  5 %  silence : l'immeuble, le sol, rien d'autre ;
   *    5 – 10 %  le point d'achat se pose ;
   *   10 – 56 %  la courbe se révèle de gauche à droite, à vitesse constante, la pointe à son bord ;
   *   56 – 62 %  la pastille « € » se pose au sommet, son onde s'élargit, la pointe s'y fond ;
   *   62 – 80 %  on lit ;
   *   80 – 90 %  tout s'efface ;
   *   90 – 100 % silence.
   */
  @media (prefers-reduced-motion: no-preference) {
    .gain-courbe,
    .gain-achat,
    .gain-pointe,
    .gain-onde,
    .gain-vente {
      animation-duration: var(--cycle);
      animation-iteration-count: infinite;
      animation-fill-mode: both;
      animation-delay: var(--decal);
    }
    .gain-courbe {
      animation-name: gain-courbe;
    }
    .gain-achat {
      animation-name: gain-achat;
    }
    .gain-pointe {
      animation-name: gain-pointe;
      /* LA COURBE DE TEMPS CALCULÉE EST POSÉE ICI, SUR L'ÉLÉMENT, et non dans l'image-clé : une
         règle `@keyframes` est analysée sans élément, `var()` n'y est pas résolu pour
         `animation-timing-function`, et la pointe retombait sur `ease`, loin devant le bord (constaté
         le 16/09/2026). Sur l'élément, elle vaut pour tout segment qui n'en déclare pas une autre :
         le parcours, donc. Le fondu final garde la sienne, écrite dans l'image-clé. */
      animation-timing-function: var(--tempsPointe);
    }
    .gain-onde {
      animation-name: gain-onde;
    }
    .gain-vente {
      animation-name: gain-vente;
    }
  }

  @keyframes gain-courbe {
    0%,
    10% {
      clip-path: inset(0 100% 0 0);
      opacity: 1;
      animation-timing-function: linear;
    }
    56% {
      clip-path: inset(0 0 0 0);
      animation-timing-function: linear;
    }
    80% {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    90%,
    100% {
      clip-path: inset(0 0 0 0);
      opacity: 0;
    }
  }
  @keyframes gain-achat {
    0%,
    5% {
      opacity: 0;
      transform: scale(0.4);
      animation-timing-function: cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    10% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: linear;
    }
    80% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    90%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  /* Mêmes bornes que le découpage ; la courbe de temps de l'élément tient la pointe à son bord. */
  @keyframes gain-pointe {
    0%,
    10% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    56% {
      offset-distance: 100%;
      opacity: 1;
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    60%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  @keyframes gain-onde {
    0%,
    56% {
      opacity: 0;
      transform: scale(0.5);
      animation-timing-function: var(--ease-out-expo);
    }
    60% {
      opacity: 0.7;
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    78%,
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  @keyframes gain-vente {
    0%,
    56% {
      opacity: 0;
      transform: scale(0.5);
      animation-timing-function: cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    62% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: linear;
    }
    80% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    90%,
    100% {
      opacity: 0;
      transform: scale(0.9);
    }
  }
</style>
