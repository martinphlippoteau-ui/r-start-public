---
/**
 * Illustration du moteur 02, « Les plus-values ». Même grammaire que les quatre autres dessins des
 * cartes (StrategySelect.astro la décrit en tête) ; format 236 × 100 ; décorative (aria-hidden).
 * Dessin retenu par Martin le 24/09/2026 (« la répartition », après cinq pistes et dix variations
 * essayées ; « pas de courbe qui monte, l'AMF n'aime pas ça »), audité et posé ici le 25/09/2026,
 * à la place de la courbe de prix des 16 et 17/09/2026.
 * CE QU'ELLE DIT : l'immeuble reçoit son panneau « Vendu », UN versement gagne R Start, qui le
 * partage entre trois épargnants (EnginePartage.astro, commun au moteur 01). Une fois par cycle de
 * 8 s : le versement est PONCTUEL, pendant exact du moteur 01 où le loyer est régulier. AUCUN
 * CHIFFRE, aucun axe, aucune échelle, rien qui monte : l'image nomme le mécanisme, elle ne dessine
 * ni un historique ni une promesse ; le bloc Risques de la page porte l'avertissement.
 * Repos = image complète, panneau posé, versement à mi-chemin ; en pause hors écran (`data-in-view`).
 */
import EnginePartage from '@/components/EnginePartage.astro';
import { fenetres } from '@/lib/immeuble';

const CADRE = { x: 22, y: 26, w: 56, h: 60 };
const FENETRES = fenetres(CADRE, { colonnes: 3, rangees: 4, taille: 8, ecart: 4 });
---

<figure class="gain-figure" aria-hidden="true" data-in-view="illus-en-vue">
  <svg viewBox="0 0 236 100" fill="none" class="gain-svg">
    {/* L'immeuble vendu. */}
    <rect x={CADRE.x} y={CADRE.y} width={CADRE.w} height={CADRE.h} rx="5" class="gain-trait" />
    {FENETRES.map((f) => <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="1.5" class="gain-fenetre" />)}
    <g class="gain-panneau">
      <rect x="30" y="14" width="40" height="16" rx="4" class="gain-panneau-fond" />
      <text x="50" y="22.5" class="gain-panneau-texte">Vendu</text>
    </g>

    {/* Le versement de la vente, de l'immeuble à la marque. */}
    <circle cx="90" cy="56" r="3.2" class="gain-vente" />

    <EnginePartage />
  </svg>
</figure>

<style>
  .gain-figure {
    margin: 0;
    width: 100%;
    /* Une vente par cycle commun de 8 s. Le versement atteint la marque à 3,84 s : c'est l'instant
       que le partage prend pour repère. */
    --cycle: 8s;
    --decal: var(--illus-decalage, 0s);
    --partage-duree: var(--cycle);
    --partage-retard: 4s;
  }
  .gain-svg {
    display: block;
    width: 100%;
    aspect-ratio: 236 / 100;
  }
  .gain-trait {
    stroke: rgb(var(--illus-trait-rgb) / 0.38);
    stroke-width: 1.6;
  }
  .gain-fenetre {
    fill: var(--illus-trait);
    opacity: 0.5;
  }
  .gain-panneau-fond {
    fill: var(--illus-fond);
    stroke: var(--illus-accent);
    stroke-width: 1.4;
  }
  .gain-panneau-texte {
    fill: var(--illus-trait);
    font-family: inherit;
    font-size: 8.5px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .gain-vente {
    fill: var(--illus-trait);
    transform-box: fill-box;
    transform-origin: center;
    /* Repos : à mi-chemin. */
    transform: translateX(21px);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Panneau à 2,9 s, versement de 3,1 à 3,84 s ; le partage suit (EnginePartage.astro). */
    .gain-panneau {
      animation: gain-panneau var(--cycle) infinite both;
      animation-delay: var(--decal);
    }
    .gain-vente {
      animation: gain-vente var(--cycle) infinite both;
      animation-delay: var(--decal);
    }
  }
  @keyframes gain-panneau {
    0%, 28% { opacity: 0; transform: translateY(6px); animation-timing-function: var(--ease-out-expo); }
    36% { opacity: 1; transform: translateY(0); }
    84% { opacity: 1; animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    94%, 100% { opacity: 0; transform: translateY(0); }
  }
  @keyframes gain-vente {
    0%, 38% { opacity: 0; transform: translateX(0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    41% { opacity: 1; transform: translateX(4px) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    48% { opacity: 1; transform: translateX(36px) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    51%, 100% { opacity: 0; transform: translateX(42px) scale(0.3); }
  }
</style>
