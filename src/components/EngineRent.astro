---
/**
 * Illustration du moteur 01, « Les loyers ». Même grammaire que les quatre autres dessins des
 * cartes (StrategySelect.astro la décrit en tête) ; format 236 × 100 ; décorative (aria-hidden).
 * Dessin retenu par Martin le 24/09/2026 (« la répartition », après cinq pistes et dix variations
 * essayées, audité et posé ici le 25/09/2026) à la place du flux immeuble → marque du 16/09/2026.
 * CE QU'ELLE DIT : UN locataire, une entreprise (un immeuble derrière, son équipe devant, d'après
 * l'exemple de Martin), légendé « Locataires » ; son loyer gagne R Start, qui le partage entre
 * trois épargnants (EnginePartage.astro, commun au moteur 02). Le loyer part toutes les 4 s,
 * deux fois par cycle de 8 s : la RÉGULARITÉ est le sujet, pendant exact du moteur 02 où le
 * versement est ponctuel. AUCUN CHIFFRE, aucune échelle, rien qui monte : le flux est régulier,
 * pas croissant. L'image ne dit rien du montant ni de la régularité future des loyers, elle nomme
 * le mécanisme.
 * Repos = image complète, le loyer à mi-chemin ; en pause hors écran (`data-in-view`).
 */
import EnginePartage from '@/components/EnginePartage.astro';
---

<figure class="rent-figure" aria-hidden="true" data-in-view="illus-en-vue">
  <svg viewBox="0 0 236 100" fill="none" class="rent-svg">
    {/* Le locataire : l'immeuble derrière, l'équipe devant (fond blanc pour passer devant). */}
    <g class="rent-locataire">
      <rect x="22" y="26" width="34" height="24" rx="3" class="rent-trait" />
      <path d="M28 32h12M28 37h12M28 42h12" class="rent-trait-fin" />
      <circle cx="29" cy="55" r="4.2" class="rent-personne" />
      <circle cx="49" cy="55" r="4.2" class="rent-personne" />
      <circle cx="39" cy="53" r="5" class="rent-personne" />
      <path d="M19 70c0-5.5 4.5-9 10-9s10 3.5 10 9" class="rent-personne" />
      <path d="M39 70c0-5.5 4.5-9 10-9s10 3.5 10 9" class="rent-personne" />
      <path d="M27 70c0-6.5 5.5-11 12-11s12 4.5 12 11" class="rent-personne" />
    </g>
    <text x="39" y="86" class="rent-libelle">Locataires</text>

    {/* Le loyer, du locataire à la marque. */}
    <path d="M66 56h26" class="rent-chemin" />
    <circle cx="66" cy="56" r="3.2" class="rent-loyer" />

    <EnginePartage />
  </svg>
</figure>

<style>
  .rent-figure {
    margin: 0;
    /* Pleine largeur de la carte : enfant d'une boîte flex, la figure retomberait sinon à la largeur
       intrinsèque du SVG, 300 px. */
    width: 100%;
    /* Un loyer toutes les 4 s, deux par cycle commun de 8 s. Le loyer atteint la marque à 1,76 s :
       c'est l'instant que le partage prend pour repère. */
    --tour: 4s;
    --decal: var(--illus-decalage, 0s);
    --partage-duree: var(--tour);
    --partage-retard: 2s;
  }
  .rent-svg {
    display: block;
    width: 100%;
    aspect-ratio: 236 / 100;
  }
  .rent-trait {
    stroke: rgb(var(--illus-trait-rgb) / 0.38);
    stroke-width: 1.6;
  }
  .rent-trait-fin {
    stroke: rgb(var(--illus-trait-rgb) / 0.3);
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .rent-personne {
    fill: var(--illus-fond);
    stroke: rgb(var(--illus-trait-rgb) / 0.55);
    stroke-width: 1.4;
  }
  .rent-locataire {
    transform-box: fill-box;
    transform-origin: center;
  }
  .rent-libelle {
    fill: rgb(var(--illus-trait-rgb) / 0.7);
    font-family: inherit;
    font-size: 6.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-anchor: middle;
  }
  .rent-chemin {
    stroke: rgb(var(--illus-trait-rgb) / 0.22);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }
  .rent-loyer {
    fill: var(--illus-trait);
    transform-box: fill-box;
    transform-origin: center;
    /* Repos : à mi-chemin. */
    transform: translateX(13px);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Le locataire bat d'un souffle (6 %) au départ du loyer, qui gagne la marque à 1,76 s. */
    .rent-locataire {
      animation: rent-souffle var(--tour) infinite both;
      animation-delay: var(--decal);
    }
    .rent-loyer {
      animation: rent-loyer var(--tour) infinite both;
      animation-delay: var(--decal);
    }
  }
  @keyframes rent-loyer {
    0% { opacity: 0; transform: translateX(0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    6% { opacity: 1; transform: translateX(3px) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    44% { opacity: 1; transform: translateX(66px) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    50%, 100% { opacity: 0; transform: translateX(72px) scale(0.3); }
  }
  @keyframes rent-souffle {
    0%, 4% { transform: scale(1); animation-timing-function: var(--ease-out-expo); }
    10% { transform: scale(1.06); animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1); }
    30%, 100% { transform: scale(1); }
  }
</style>
