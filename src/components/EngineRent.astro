---
/**
 * Illustration du moteur 01, « Les loyers versés par les entreprises locataires » (16/09/2026).
 *
 * MÊME GRAMMAIRE QUE LES TROIS TUILES de la sélection (StrategySelect, StrategyGlobe,
 * StrategyTiming) : dessin au trait clair sur fond ink, animé en boucle lente, coupé en
 * `prefers-reduced-motion`. Elle remplace la photo d'illustration qui occupait ce bandeau.
 * Format 236 × 100, le rapport natif du bandeau de la carte : le cadre ne change pas.
 *
 * CE QU'ELLE DIT : des entreprises occupent l'immeuble, et il en sort un flux RÉGULIER. C'est le
 * pendant exact du moteur 02, qui montre lui un échange ponctuel. Les fenêtres s'allument l'une
 * après l'autre (les locataires), et les versements partent à intervalles égaux vers la droite.
 *
 * AUCUN CHIFFRE, aucune échelle, rien qui monte : le flux est régulier, pas croissant. L'image ne
 * dit rien du montant ni de la régularité future des loyers, elle nomme le mécanisme.
 *
 * Décorative (aria-hidden) : le texte de la carte porte le sens.
 */

/* Les quatre versements en vol. Retards NÉGATIFS : au chargement, le flux est déjà installé, la
   carte ne s'ouvre pas sur une ligne vide qui attendrait son premier point. */
const versements = [0, 1, 2, 3];
/* Trois colonnes de quatre fenêtres. L'ordre sert le décalage d'allumage. */
const fenetres = [0, 1, 2].flatMap((colonne) => [0, 1, 2, 3].map((ligne) => ({ colonne, ligne })));
---

<figure class="rent-figure" aria-hidden="true">
  <svg viewBox="0 0 236 100" fill="none" class="rent-svg">
    {/* L'immeuble : les entreprises locataires que la ligne nomme. */}
    <rect x="24" y="22" width="60" height="62" rx="5" class="rent-cadre" />
    {
      fenetres.map(({ colonne, ligne }) => (
        <rect
          x={35 + colonne * 15}
          y={32 + ligne * 13}
          width="9"
          height="8"
          rx="1.5"
          class="rent-fenetre"
          style={`--rang:${colonne * 4 + ligne}`}
        />
      ))
    }

    {/* Le chemin des versements, de l'immeuble vers la droite. */}
    <path d="M96 56h86" class="rent-ligne" />
    {
      versements.map((i) => (
        <circle cx="98" cy="56" r="3.2" class="rent-versement" style={`--rang:${i}`} />
      ))
    }

    {
      /*
       * CE QUI REÇOIT : LA MARQUE R START (16/09/2026, demande de l'équipe, « le rond tout à droite
       * doit être le logo avec que le R »). C'était un cercle vide, qui ne disait pas où allaient les
       * versements.
       * Le tracé est celui de src/assets/logos/r-start-blanc.svg, sa première forme, la seule du
       * fichier qui porte la marque : une goutte dont le R est évidé. Les deux autres dessinent le mot
       * « start », qui n'a rien à faire à cette taille.
       * `<svg>` imbriqué et non `<use>` : le fichier est un `astro:assets`, il n'est pas servi tel quel
       * à une URL stable. Son propre viewBox (94,08 × 88,98, la boîte exacte du tracé, mesurée et non
       * devinée) le recale sans le déformer.
       * `rent-marque` la fait battre au passage de chaque versement, comme le faisait le cercle.
       */
    }
    <svg x="190" y="40" width="32" height="30" viewBox="0 0 94.08 88.98" class="rent-marque">
      <path d="M68.21.17C36.7,3.24,5.47,23.07,2.44,29.88c-11.59,26.1,21.48,52.52,27.22,55.34,21.52,10.59,48.04-1.99,59.51-27.5C93.5,48.09,104.2-3.34,68.21.17ZM64.76,69.76c-1.25,0-2.36-.57-3.09-1.47l-2.84-3.52c-4.06-4.98-10.05-12.1-12.26-13.54-1.92-1.22-4.48-1.84-7.59-1.84l-7.96.02c-2.02,0-3.66-1.64-3.66-3.66s1.64-3.66,3.66-3.66h18.33c3.05-.01,5.54-2.14,5.54-4.76s-2.49-4.74-5.54-4.74h-18.34c-2.02,0-3.66-1.63-3.66-3.65s1.64-3.66,3.66-3.66h18.34c7.58,0,13.73,5.4,13.73,12.05,0,4.74-3.2,9.03-8.07,10.97,3.22,3.36,7.64,8.61,11.3,13.08l1.52,1.86c.57.69.91,1.57.91,2.54,0,2.2-1.79,3.99-3.99,3.99Z" />
    </svg>
  </svg>
</figure>

<style>
  .rent-figure {
    margin: 0;
  }
  .rent-svg {
    display: block;
    width: 100%;
    aspect-ratio: 236 / 100;
  }
  .rent-cadre {
    stroke: rgb(169 221 230 / 0.38);
    stroke-width: 1.6;
  }
  .rent-ligne {
    stroke: rgb(169 221 230 / 0.22);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }

  /* Les fenêtres s'allument par vagues : douze, 0,22 s d'écart, cycle de 4,8 s, le même que celui
     des versements pour que les deux mouvements restent en phase. */
  .rent-fenetre {
    fill: rgb(169 221 230 / 0.16);
    animation: rent-occupation 4.8s ease-in-out infinite;
    animation-delay: calc(var(--rang) * 0.22s);
  }

  /* Quatre versements pour un cycle de 4,8 s : un départ toutes les 1,2 s, à intervalles égaux.
     C'est la régularité qui est le sujet, d'où un `linear` et non une courbe qui accélérerait. */
  .rent-versement {
    fill: var(--color-teal-200);
    animation: rent-flux 4.8s linear infinite;
    animation-delay: calc(var(--rang) * -1.2s);
  }
  .rent-marque {
    fill: var(--color-teal-200);
    transform-origin: 206px 55px;
    animation: rent-marque 1.2s ease-out infinite;
  }

  @keyframes rent-occupation {
    0%,
    70%,
    100% {
      fill: rgb(169 221 230 / 0.16);
    }
    20%,
    50% {
      fill: rgb(169 221 230 / 0.62);
    }
  }
  @keyframes rent-flux {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateX(84px);
      opacity: 0;
    }
  }
  @keyframes rent-marque {
    0%,
    100% {
      fill-opacity: 0.55;
      transform: scale(1);
    }
    12% {
      fill-opacity: 1;
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rent-fenetre,
    .rent-versement,
    .rent-marque {
      animation: none;
    }
    /* À l'arrêt : l'immeuble est occupé et les versements sont posés le long du chemin, à intervalles
       égaux. L'image dit la même chose, sans mouvement. */
    .rent-fenetre {
      fill: rgb(169 221 230 / 0.5);
    }
    .rent-versement {
      transform: translateX(calc(var(--rang) * 21px));
    }
  }
</style>
