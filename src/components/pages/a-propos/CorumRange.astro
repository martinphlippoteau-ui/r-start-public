---
/**
 * Page /a-propos, société de gestion : DEUX sections et une photo pleine largeur.
 *  1. #corum   (white) « Le groupe CORUM en quelques chiffres », les cinq chiffres du groupe, puis
 *                      le cadre réglementaire (logo R Start, une phrase de trust.ts) et l'appel vers
 *                      corum.fr ;
 *  2. bande pleine largeur, hors section (décorative, sans titre : elle n'a donc pas d'ancre) ;
 *  3. #gamme   (paper) « Nos autres SCPI en quelques chiffres » : une grille des quatre autres
 *              SCPI du groupe et de leurs chiffres (corumRange.ts, ceux des pages produit de
 *              corum.fr), sans R Start ; chaque chiffre renvoie à sa note numérotée sous les
 *              cartes et un bouton « i » la déplie sur place (MesureGamme.astro, dépliage par
 *              src/scripts/infoToggle.ts, chargé en bas de ce fichier).
 * La section #savoir-faire (trois familles de solutions du groupe) et l'histoire du groupe ont été
 * retirées les 14 et 16/09/2026 à la demande de l'équipe, leurs textes archivés hors du dépôt
 * (.claude/audits).
 * La photo n'a PAS de parallaxe : `data-parallax` exige le moteur GSAP, que cette page n'a aucune
 * autre raison de télécharger (tests/performance.spec.ts). Elle se révèle par
 * `data-animate="clip"`, rendu par le moteur léger.
 * Contenu : src/content/fr/corum.ts (le lien vers corum.fr), corumRange.ts, facts.ts, trust.ts et
 * media.ts.
 */
import { Image, Picture } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { corum } from '@/content/fr/corum';
import MesureGamme from '@/components/pages/a-propos/MesureGamme.astro';
import { corumRange } from '@/content/fr/corumRange';
import { trust } from '@/content/fr/trust';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

const officePhoto = await resolveImage(media.corum.src);
const stats = trust.stats;
const QUIET_TITLE_Y = 12;
---

{/* 1. Le groupe CORUM en chiffres */}
{/* `plan="haut"` (24/09/2026) : au premier plan de l'en-tête sombre. */}
<Section id="corum" tone="white" labelledBy="chiffres-title" plan="haut">
  <Container size="wide">
    <h2 id="chiffres-title" class="text-display-md max-w-4xl" data-animate="fade-up">
      {stats.title}
    </h2>
    {
      /*
       * Deux colonnes dès le téléphone : en une seule, les chiffres prenaient un écran pour quatre
       * nombres. Plusieurs colonnes dès `lg` seulement : plus étroites, « 160 000 » en text-stat
       * déborde de sa cellule (texte dégradé tronqué).
       * LE NOMBRE DE COLONNES SUIT LE NOMBRE DE CHIFFRES (14/09/2026, cinquième chiffre ajouté par
       * l'équipe) : sur une grille de quatre il restait seul sur une deuxième ligne. La grille est
       * bornée à cinq ; au-delà, on repasse à quatre et la deuxième ligne se remplit. À CINQ
       * COLONNES (215 px sur 1440), « 9,6 Md€ » et « + 160 000 » passaient à la ligne en `solid` :
       * les chiffres passent en `solid-compact` dès qu'ils sont cinq. Un chiffre un peu plus petit
       * se lit ; cinq chiffres désalignés, non.
       */
    }
    <ul
      role="list"
      class:list={[
        'mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:mt-14',
        stats.items.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4',
      ]}
    >
      {/* Chiffres STATIQUES : Stat n'a plus de compteur animé depuis le 22/09/2026. */}
      {
        stats.items.map((s) => (
          <li>
            <Stat
              size={stats.items.length === 5 ? 'solid-compact' : 'solid'}
              value={s.value}
              label={s.label}
            />
          </li>
        ))
      }
    </ul>
    {
      /*
       * CADRE RÉGLEMENTAIRE, une phrase (22/09/2026, texte de Martin, trust.ts `amf.aboutSentence`) :
       * R Start est VISÉE, la société de gestion est AGRÉÉE, et le texte ne dit jamais « R Start
       * agréé ». Le logo est celui de R START : celui de l'AMF, que l'autorité ne concède pas aux
       * communications commerciales, a quitté le site le même jour (« on n'a pas le droit de
       * l'utiliser »). Décoratif (alt vide) : le texte à côté nomme R Start.
       */
    }
    {/* Logo NU, sans plaque ni filet (demande de Martin), centré sur la hauteur de la phrase dès
      `sm` : quel que soit le nombre de lignes du texte, qui varie entre 640 et 1024 px, le logo
      reste au milieu. */}
    <div class="mt-section-sm flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-8">
      <Image src={brandLogo} alt="" width={142} height={44} class="h-11 w-auto shrink-0" />
      <p class="max-w-3xl text-base leading-snug text-slate-700">{trust.amf.aboutSentence}</p>
    </div>

    {
      /*
       * APPEL SOUS LES CHIFFRES (16/09/2026, demande de l'équipe). Il SORT DU SITE, vers corum.fr,
       * ce qu'aucun autre appel ne fait depuis le corps d'une page : d'où `target="_blank"`, le
       * `rel="noopener noreferrer"` qui va avec, et la mention de nouvelle fenêtre lue par les
       * lecteurs d'écran mais pas affichée. `secondary` et non `primary` : il ne mène pas au tunnel
       * de souscription, et la page en porte déjà un dans son en-tête.
       */
    }
    {corum.siteLink && (
      <p class="mt-section-sm">
        <Button
          href={corum.siteLink.href}
          variant="secondary"
          size="lg"
          target="_blank"
        >
          {corum.siteLink.label}
          <span class="visually-hidden">({corum.siteLink.newTabHint})</span>
        </Button>
      </p>
    )}

    {
      /* Le contre-poids « Ces chiffres sont ceux du groupe CORUM… » et la ligne de source ont été
        retirés le 11/09/2026 (décision de l'équipe). Le rappel « cette expérience ne préjuge pas
        des résultats de R Start, qui n'a pas d'historique propre » n'est plus porté nulle part sur
        la page (l'introduction de l'en-tête ne le dit plus). Reste le bloc Risques, plus bas. */
    }
  </Container>
</Section>

{
  /* 2. Bande PLEINE LARGEUR : elle sépare les deux chapitres et donne à la page sa seule
    respiration visuelle. Décorative, aucun avantage, donc aucun contre-poids attendu. Hors
    <Section> : sans titre, elle n'aurait aucune ancre à désigner en aria-labelledby. Sans légende,
    comme les deux autres bandes du site (voir media.ts). */
}
<figure class="relative" data-animate="clip">
  <div
    class="relative h-[42vh] min-h-64 w-full overflow-hidden sm:h-[52vh] sm:min-h-80 lg:h-[60vh]"
  >
    <Picture
      src={officePhoto}
      alt={media.corum.alt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </div>
</figure>

<Section id="gamme" tone="paper" labelledBy="gamme-title">
  <Container size="wide">
    {
      /*
       * LA GAMME : les chiffres des pages produit de corum.fr (22/09/2026, demande de Martin ;
       * jusque-là, le document de l'équipe du 16/09/2026). R START N'Y EST PAS : elle n'a ni TRI ni
       * rendement à montrer. Les années de création restent dans facts.ts (`scpiCreated`), que la
       * gamme lit toujours.
       * SUR LES CHIFFRES, voir l'en-tête de corumRange.ts : chaque intitulé est celui de corum.fr,
       * chaque chiffre renvoie à sa note, et la mention réglementaire sur les performances passées
       * est ajoutée au contenu de corum.fr.
       */
    }
    <header class="max-w-4xl">
      <h2
        id="gamme-title"
        class="text-display-md text-ink"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {corumRange.title}
      </h2>
    </header>

    {
      /*
       * CARTES CLAIRES (22/09/2026, demande de Martin : « pas en mode sombre », « au niveau ») :
       * section paper et cartes blanches à ombre portée, LA RECETTE DES REPÈRES DE L'ACCUEIL
       * (02-Highlights.astro), pour que la page ressemble au reste du site. Dans chaque carte, une
       * <dl> : une ligne par mesure, l'intitulé au-dessus du chiffre, des filets entre les lignes.
       * UNE GRILLE, PLUS UN RAIL (16/09/2026 : « que les cards prennent la largeur de l'écran, sans
       * scroll ») : quatre de front dès `xl` (à `lg`, 220 px par carte, les intitulés se
       * repliaient sur trois lignes), deux dès `sm`, une au téléphone. Aucun défilement horizontal.
       */
    }
    <ul
      role="list"
      aria-label={corumRange.listLabel}
      class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 xl:grid-cols-4"
    >
      {
        corumRange.items.map((scpi, i) => (
          <li class="rounded-3xl bg-white p-6 shadow-card ring-1 ring-navy/5 sm:p-7">
            <p class="text-display-sm text-navy">{scpi.name}</p>
            {
              /* La date en poids normal sous un nom en gras, et d'un cran plus petite : deux lignes de
                même graisse se liraient comme deux noms. */
            }
            {scpi.created && <p class="text-caption mt-1 text-slate-700">{scpi.created}</p>}

            {
              /* LE TRI EN PREMIER (22/09/2026, demande de Martin), en display-md et non plus lg
                (« diminue la taille du TRI ») ; les trois autres mesures en display-sm. Chaque
                ligne : MesureGamme.astro (intitulé, renvois, bouton « i », chiffre, panneau). Les
                filets viennent de `divide-y`, le premier du `border-t` de la liste. */
            }
            <dl class="mt-5 divide-y divide-navy/10 border-t border-navy/10 [&>div]:py-4 [&>div:last-child]:pb-0">
              <div>
                <MesureGamme mesure={scpi.principale} id={`gamme-${i}-tri`} principale />
              </div>
              {scpi.autres.map((m, j) => (
                <div>
                  <MesureGamme mesure={m} id={`gamme-${i}-${j}`} />
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ul>

    {
      /* LA MENTION RÉGLEMENTAIRE D'ABORD, les notes ensuite : elle qualifie tous les chiffres
        au-dessus, elle ne peut pas être la sixième ligne d'une liste de notes. Jamais animée.
        Pleine largeur des cartes (17/09/2026, demande de Martin) : plus de `max-w-4xl`.
        LES NOTES SONT NUMÉROTÉES comme leurs renvois sur les cartes, « (1) » à « (5) », chacune
        avec l'ancre que le renvoi vise, et en text-base et non plus en caption (22/09/2026,
        « augmente la taille des disclaimers sous les cards »). Le numéro est écrit dans la ligne
        et non par `list-style` : il doit s'écrire « (1) », comme sur la carte. Marges et
        interlignes serrés (« réduire l'espace vertical des disclaimers, pas la police »). */
    }
    <p class="mt-8 text-base leading-snug text-ink">{corumRange.pastPerformance}</p>
    <ol role="list" class="mt-4 space-y-2 text-base leading-snug text-slate-700">
      {
        corumRange.notes.map((note, n) => (
          <li id={`gamme-note-${n + 1}`} class="flex gap-2">
            <span class="shrink-0 tabular-nums">({n + 1})</span>
            <span>{note.text}</span>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>

<script>
  /* Dépliage des notes par les boutons « i » des cartes, le module des repères de l'accueil et du
     comparateur (src/scripts/infoToggle.ts) : sans lui, panneaux ouverts et boutons cachés. */
  import '@/scripts/infoToggle';
</script>
