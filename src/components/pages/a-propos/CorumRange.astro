---
/**
 * Page /a-propos, société de gestion : DEUX sections et une photo pleine largeur.
 *  1. #corum   (white) « Le groupe CORUM en quelques chiffres », les cinq chiffres du groupe, puis
 *                      le cadre réglementaire (logo AMF, deux phrases de facts.ts) et l'appel vers
 *                      corum.fr ;
 *  2. bande pleine largeur, hors section (décorative, sans titre : elle n'a donc pas d'ancre) ;
 *  3. #gamme   (white) « Nos autres SCPI en quelques chiffres » : une grille des quatre autres
 *              SCPI du groupe et de leurs chiffres (corumRange.ts), sans R Start.
 * La section #savoir-faire (trois familles de solutions du groupe) et l'histoire du groupe ont été
 * retirées les 14 et 16/09/2026 à la demande de l'équipe, leurs textes archivés hors du dépôt
 * (.claude/audits).
 * La photo n'a PAS de parallaxe : `data-parallax` exige le moteur GSAP, que cette page n'a aucune
 * autre raison de télécharger (tests/performance.spec.ts). Elle se révèle par
 * `data-animate="clip"`, rendu par le moteur léger.
 * Contenu : src/content/fr/corum.ts (le lien vers corum.fr), corumRange.ts, facts.ts, trust.ts et
 * media.ts.
 */
import { Image, Picture } from 'astro:assets';
import amfLogo from '@/assets/logos/amf.svg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { corum } from '@/content/fr/corum';
import { corumRange } from '@/content/fr/corumRange';
import { trust as trustFacts } from '@/content/fr/facts';
import { trust } from '@/content/fr/trust';
import { media } from '@/content/fr/media';
import { resolveImage } from '@/lib/images';

const officePhoto = await resolveImage(media.corum.src);
const stats = trust.stats;
const QUIET_TITLE_Y = 12;
---

{/* 1. Le groupe CORUM en chiffres */}
<Section id="corum" tone="white" labelledBy="chiffres-title">
  <Container size="wide">
    <h2 id="chiffres-title" class="text-display-md max-w-4xl" data-animate="fade-up">
      {stats.title}
    </h2>
    {
      /*
       * Deux colonnes dès le téléphone : en une seule, les chiffres prenaient un écran pour quatre
       * nombres. Plusieurs colonnes dès `lg` seulement : plus étroites, « 160 000 » en text-stat
       * déborde de sa cellule (texte dégradé tronqué).
       * LE NOMBRE DE COLONNES SUIT LE NOMBRE DE CHIFFRES (14/09/2026, cinquième chiffre ajouté par
       * l'équipe) : sur une grille de quatre il restait seul sur une deuxième ligne. La grille est
       * bornée à cinq ; au-delà, on repasse à quatre et la deuxième ligne se remplit. À CINQ
       * COLONNES (215 px sur 1440), « 9,6 Md€ » et « + 160 000 » passaient à la ligne en `solid` :
       * les chiffres passent en `solid-compact` dès qu'ils sont cinq. Un chiffre un peu plus petit
       * se lit ; cinq chiffres désalignés, non.
       */
    }
    <ul
      role="list"
      class:list={[
        'mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:mt-14',
        stats.items.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4',
      ]}
    >
      {/* Chiffres STATIQUES : Stat n'a plus de compteur animé depuis le 22/09/2026. */}
      {
        stats.items.map((s) => (
          <li>
            <Stat
              size={stats.items.length === 5 ? 'solid-compact' : 'solid'}
              value={s.value}
              label={s.label}
            />
          </li>
        ))
      }
    </ul>
    {
      /*
       * CADRE RÉGLEMENTAIRE (16/09/2026, demande de l'équipe : « mettre le logo AMF en disant que
       * R Start est agréé par l'AMF »). LE TEXTE NE DIT PAS CELA, ET C'EST VOULU. R Start n'est pas
       * agréé, il est VISÉ : la note d'information a obtenu le visa SCPI n° 26-06 du 4 mars 2026.
       * Ce qui est AGRÉÉ, c'est la société de gestion. Écrire « R Start est agréé par l'AMF »
       * affirmerait exactement ce que la mention standard du pied de page nie (« le visa n'implique
       * ni approbation de l'opportunité de l'opération »). L'équipe a arbitré entre trois
       * formulations exactes et retenu celle-ci, qui porte les DEUX faits.
       * LES DEUX PHRASES SONT REPRISES DE facts.ts, mot pour mot : elles viennent du bulletin de
       * souscription, et celle de l'agrément est la formulation que l'AMF a demandée dans ses
       * retours sur la brochure (09/2026). Rien n'est reparaphrasé ici.
       * LE LOGO : un fichier hébergé sur Wikipédia France au titre d'un usage non libre, et l'AMF
       * ne concède pas son logo aux communications commerciales. La réserve vaut toujours,
       * l'équipe l'a levée en connaissance de cause.
       */
    }
    {/* `sm:items-stretch` : la plaque prend la hauteur de la rangée, donc celle du texte à sa
      droite, et le logo la remplit. Une hauteur écrite en dur se serait décalée dès qu'une phrase
      passe d'une ligne à l'autre, ce qui arrive entre 640 et 1024 px. */}
    <div class="mt-section-sm flex flex-col gap-5 sm:flex-row sm:items-stretch sm:gap-7">
      {/* Le logo prend toute la hauteur du texte à sa droite : à 40 px sa ligne de tête (« AUTORITÉ
      DES MARCHÉS FINANCIERS ») se refermait. Sous `sm`, la plaque passe au-dessus du texte et il
      garde ses 56 px, rien à épouser dans ce sens-là. */}
      <span class="flex shrink-0 items-center justify-center rounded-xl bg-white px-5 py-4 ring-1 ring-navy/10">
        <Image
          src={amfLogo}
          alt={trust.amf.heroBadge.logoAlt}
          width={142}
          height={57}
          class="w-auto max-sm:h-14 sm:h-full"
        />
      </span>
      <div class="max-w-3xl space-y-2">
        <p class="text-base leading-snug text-slate-700">{trustFacts.amf.managementCompanyApproval}</p>
        <p class="text-base leading-snug text-slate-700">{trustFacts.amf.visaSentence}</p>
      </div>
    </div>

    {
      /*
       * APPEL SOUS LES CHIFFRES (16/09/2026, demande de l'équipe). Il SORT DU SITE, vers corum.fr,
       * ce qu'aucun autre appel ne fait depuis le corps d'une page : d'où `target="_blank"`, le
       * `rel="noopener noreferrer"` qui va avec, et la mention de nouvelle fenêtre lue par les
       * lecteurs d'écran mais pas affichée. `secondary` et non `primary` : il ne mène pas au tunnel
       * de souscription, et la page en porte déjà un dans son en-tête.
       */
    }
    {corum.siteLink && (
      <p class="mt-section-sm">
        <Button
          href={corum.siteLink.href}
          variant="secondary"
          size="lg"
          target="_blank"
        >
          {corum.siteLink.label}
          <span class="visually-hidden">({corum.siteLink.newTabHint})</span>
        </Button>
      </p>
    )}

    {
      /* Le contre-poids « Ces chiffres sont ceux du groupe CORUM… » et la ligne de source ont été
        retirés le 11/09/2026 (décision de l'équipe). Le rappel « cette expérience ne préjuge pas
        des résultats de R Start, qui n'a pas d'historique propre » n'est plus porté nulle part sur
        la page (l'introduction de l'en-tête ne le dit plus). Reste le bloc Risques, plus bas. */
    }
  </Container>
</Section>

{
  /* 2. Bande PLEINE LARGEUR : elle sépare les deux chapitres et donne à la page sa seule
    respiration visuelle. Décorative, aucun avantage, donc aucun contre-poids attendu. Hors
    <Section> : sans titre, elle n'aurait aucune ancre à désigner en aria-labelledby. Sans légende,
    comme les deux autres bandes du site (voir media.ts). */
}
<figure class="relative" data-animate="clip">
  <div
    class="relative h-[42vh] min-h-64 w-full overflow-hidden sm:h-[52vh] sm:min-h-80 lg:h-[60vh]"
  >
    <Picture
      src={officePhoto}
      alt={media.corum.alt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </div>
</figure>

<Section id="gamme" tone="white" labelledBy="gamme-title">
  <Container size="wide">
    {
      /*
       * LA GAMME (16/09/2026, contenu fourni par l'équipe) : les chiffres remplacent les noms des
       * SCPI. R START N'Y EST PLUS : elle n'a ni TRI ni rendement à montrer. Les années de création
       * restent dans facts.ts (`scpiCreated`), que la gamme lit toujours.
       * SUR LES CHIFFRES, voir l'en-tête de corumRange.ts : chaque intitulé est celui fourni, la
       * mention réglementaire sur les performances passées a été ajoutée, et la date d'arrêté reste
       * à demander à CORUM.
       */
    }
    <header class="max-w-4xl">
      <h2
        id="gamme-title"
        class="text-display-md text-ink"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {corumRange.title}
      </h2>
    </header>

    {
      /*
       * UNE GRILLE, PLUS UN RAIL (16/09/2026 : « que les cards prennent la largeur de l'écran, sans
       * scroll ») : quatre SCPI tiennent dans la largeur, le défilement ne servait qu'à cacher ce
       * qui pouvait être montré. Les cartes n'ont pas de largeur propre, c'est la colonne qui la
       * donne : quatre de front dès `lg`, deux sur tablette, une au téléphone. Aucun défilement
       * horizontal à aucune largeur. Le script du rail (carrousel.ts) est dans l'historique git.
       */
    }
    <ul
      role="list"
      aria-label={corumRange.listLabel}
      class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4"
    >
      {
        corumRange.items.map((scpi) => (
          <li class="flex flex-col rounded-3xl bg-ink p-6 text-white sm:p-7">
            <p class="text-display-sm text-sand">{scpi.name}</p>
            {
              /* La date en poids normal sous un nom en gras, et d'un cran plus petite : deux lignes de
                même graisse se liraient comme deux noms. `white/70` sur le fond ink donne 7,7:1, bien
                au-dessus du seuil exigé pour ce corps de texte. */
            }
            {scpi.created && <p class="text-caption mt-1 font-normal text-white/70">{scpi.created}</p>}

            {
              /* LA MESURE MISE EN AVANT, et son intitulé juste dessous : un grand nombre seul ne
                dit pas ce qu'il mesure, et ces quatre-là ne mesurent pas la même chose (trois TRI
                réalisés et un objectif). */
            }
            <p class="text-display-lg mt-6 leading-none text-white">
              {scpi.principale.value}
              <span class="text-display-sm text-teal-200">{scpi.principale.unit}</span>
            </p>
            <p class="mt-2 text-base leading-snug text-white/80">{scpi.principale.label}</p>

            {
              /* `mt-auto` sur le bloc du bas : les intitulés de la mesure mise en avant font une ou
                deux lignes selon la SCPI, et sans lui les trois dernières lignes ne s'alignaient pas
                d'une carte à l'autre. */
            }
            <ul role="list" class="mt-auto space-y-4 border-t border-white/15 pt-5">
              {scpi.autres.map((m) => (
                <li class="flex items-baseline justify-between gap-3">
                  <span class="text-base leading-snug text-white/80">{m.label}</span>
                  <span class="text-lead shrink-0 font-semibold text-sand tabular-nums">
                    {m.value}
                    <span class="text-base text-teal-200">{m.unit}</span>
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    {
      /* LA MENTION RÉGLEMENTAIRE D'ABORD, les définitions ensuite : elle qualifie tous les chiffres
        au-dessus, elle ne peut pas être la sixième ligne d'une liste de notes. Jamais animée.
        Pleine largeur des cartes (17/09/2026, demande de Martin) : plus de `max-w-4xl`. */
    }
    <p class="mt-10 text-base leading-relaxed text-ink">{corumRange.pastPerformance}</p>
    <ul role="list" class="text-caption mt-5 space-y-3 text-slate-700">
      {corumRange.notes.map((note) => <li>{note}</li>)}
    </ul>
  </Container>
</Section>
