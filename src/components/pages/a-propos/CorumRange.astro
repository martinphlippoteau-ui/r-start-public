---
/**
 * Page /a-propos, la société de gestion : TROIS sections et une photo pleine largeur (refonte du
 * 13/09/2026). Jusqu'ici les deux chapitres tenaient dans une seule section blanche de 1 575 px,
 * sans repère entre eux :
 *  1. #corum         (white) « Le groupe CORUM en chiffres », les quatre chiffres du groupe ;
 *  2. bande photo pleine largeur, hors section (décorative, sans titre : elle n'a donc pas d'ancre) ;
 *  3. #savoir-faire  (paper) les trois familles de solutions du groupe, avec leur contre-poids ;
 *  4. #gamme         (white) la gamme des cinq SCPI, tuile R Start marquée « Nouveau », et son contre-poids.
 * Ces blocs étaient sur l'accueil jusqu'au 11/09/2026 ; ils ont leur place ici, où le sujet est la
 * société de gestion. Les savoir-faire sont arrivés le 13/09/2026 : la page disait qui gère R Start,
 * pas ce que fait le groupe par ailleurs. Ils DÉCRIVENT une activité, ils ne proposent rien : aucune
 * de ces solutions n'est vendue ni détaillée sur ce site, et le contre-poids le dit dans le même bloc.
 * Le bloc n'est rendu que si `corum.expertise` existe.
 * La photo n'a PAS de parallaxe : `data-parallax` exige le moteur GSAP, que cette page n'a aucune autre
 * raison de télécharger (tests/performance.spec.ts). Elle se révèle par `data-animate="clip"`, rendu par le
 * moteur léger.
 * Équilibre AMF : la gamme porte son contre-poids (corum.disclaimer, RiskNote de même taille, jamais animé),
 * juste sous les tuiles, dans le même bloc. La photo est décorative.
 * Contenu : src/content/fr/corum.ts et media.ts. Notes résolues dans celles de la page (about.notes).
 */
import { Picture } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import Picto, { isPictoKey } from '@/components/ui/Picto.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { corum } from '@/content/fr/corum';
import { trust } from '@/content/fr/trust';
import { media } from '@/content/fr/media';
import { product } from '@/content/fr/facts';
import { resolveImage } from '@/lib/images';
import type { LegalNote } from '@/content/types';

interface Props {
  tone?: 'paper' | 'white';
  /** Notes de la page, pour la numérotation des appels de note. */
  notes?: LegalNote[];
}
const { tone = 'white', notes } = Astro.props as Props;
const officePhoto = await resolveImage(media.corum[0].src);
const stats = trust.stats;
const range = corum.range.scpiNames.map((name) => ({ name, current: name === product.name }));
const LOGO_STAGGER = 0.08;
const QUIET_TITLE_Y = 12;
/** Décalage de la cascade entre deux savoir-faire (secondes) : un déclencheur par colonne lg. */
const STAGGER = 0.08;
const expertise = corum.expertise;
const savoirFaire = (expertise?.items ?? []).map((item) => {
  if (!isPictoKey(item.icon)) throw new Error(`Pictogramme inconnu dans corum.ts : ${item.icon}`);
  return { ...item, icon: item.icon };
});
---

{/* 1. Le groupe CORUM en chiffres */}
<Section id="corum" tone={tone} labelledBy="chiffres-title">
  <Container size="wide">
    <h2 id="chiffres-title" class="text-display-md max-w-4xl" data-animate="fade-up">
      {stats.title}
      <NoteRef notes={notes} id="confiance-chiffres" tone="light" />
    </h2>
    <!--
      Deux colonnes dès le téléphone (13/09/2026) : en une seule, les quatre chiffres prenaient un écran
      pour quatre nombres. Quatre colonnes dès `lg` seulement : plus étroites, « 160 000 » en text-stat
      déborde de sa cellule (texte dégradé tronqué).
    -->
    <ul
      role="list"
      class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:mt-14 lg:grid-cols-4"
    >
      {
        /* Les quatre chiffres comptent depuis 0, en place, avec une durée liée à leur ordre de grandeur. */
      }
      {
        stats.items.map((s) => (
          <li>
            <Stat size="solid" value={s.value} suffix={s.suffix} label={s.label} />
          </li>
        ))
      }
    </ul>
    {
      /* Le contre-poids « Ces chiffres sont ceux du groupe CORUM… » et la ligne de source ont été retirés
        d'ici le 11/09/2026 (décision de l'équipe). Le rappel « cette expérience ne préjuge pas des résultats
        de R Start, qui n'a pas d'historique propre » reste porté par l'introduction de l'en-tête de la
        page (aboutPage.hero.intro). Les chiffres ne sont donc plus marqués [data-advantage]. */
    }
  </Container>
</Section>

{
  /* 2. Photo d'ambiance des bureaux, PLEINE LARGEUR (13/09/2026) : elle sépare les deux chapitres et
    donne à la page sa seule respiration visuelle. Décorative, aucun avantage, donc aucun contre-poids
    attendu. Hors <Section> : sans titre, elle n'aurait aucune ancre à désigner en aria-labelledby. */
}
<figure class="relative" data-animate="clip">
  <div
    class="relative h-[42vh] min-h-64 w-full overflow-hidden sm:h-[52vh] sm:min-h-80 lg:h-[60vh]"
  >
    <Picture
      src={officePhoto}
      alt={media.corum[0].alt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </div>
</figure>

{
  /* 3. Les trois savoir-faire du groupe : ce que fait CORUM L'Épargne au-delà de R Start. Chaque carte
    décrit une activité, jamais un produit (aucun chiffre, aucune performance, aucune comparaison), et
    le contre-poids commun ferme le bloc : l'étendue de la gamme ne retire rien aux risques de R Start. */
}
{
  expertise && (
    <Section id="savoir-faire" tone="paper" labelledBy="savoir-faire-title">
      <Container size="wide">
        <header class="max-w-4xl">
          <h2
            id="savoir-faire-title"
            class="text-display-md text-ink"
            data-animate="fade-up"
            data-animate-y={String(QUIET_TITLE_Y)}
          >
            {expertise.title}
            <NoteRef notes={notes} id="corum-savoir-faire" tone="light" />
          </h2>
          <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">{expertise.intro}</p>
        </header>

        <ul role="list" class="mt-10 grid gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {savoirFaire.map((item, i) => (
            <li class="flex flex-col rounded-3xl bg-white p-6 shadow-card sm:p-8">
              <span
                class="block w-fit"
                data-animate="tilt"
                data-animate-delay={String(i * STAGGER)}
              >
                <Picto name={item.icon} class="size-12 text-teal-700 sm:size-14" />
              </span>
              <p class="text-eyebrow mt-6 text-teal-700">{item.kicker}</p>
              <h3 class="text-display-sm mt-2 text-ink">{item.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-slate-700">{item.description}</p>
            </li>
          ))}
        </ul>

        <RiskNote text={expertise.risk} size="lead" class="mt-8 max-w-4xl lg:mt-10" />
      </Container>
    </Section>
  )
}

{/* 4. La gamme des cinq SCPI */}
<Section id="gamme" tone="white" labelledBy="gamme-title">
  <Container size="wide">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <!-- Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. -->
        <h2
          id="gamme-title"
          class="text-display-md text-ink"
          data-animate="fade-up"
          data-animate-y={String(QUIET_TITLE_Y)}
        >
          {corum.range.title}
          <NoteRef notes={notes} id="corum-gamme" tone="light" />
        </h2>
        <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">{corum.range.description}</p>
      </div>
      <div class="lg:col-span-7">
        <ul
          role="list"
          class="grid grid-cols-2 gap-4 sm:grid-cols-3"
          data-animate="stagger"
          data-animate-stagger={String(LOGO_STAGGER)}
        >
          {
            range.map(({ name, current }) => (
              <li
                class:list={[
                  'flex min-h-24 items-center justify-center rounded-2xl border p-5 text-center text-lg font-semibold sm:p-6',
                  current
                    ? 'border-teal-400 bg-teal-100 text-navy'
                    : 'border-mist bg-paper text-navy',
                ]}
                aria-current={current ? 'true' : undefined}
              >
                <span class="flex flex-col items-center gap-1.5">
                  {current && corum.range.currentBadge && (
                    <span class="inline-flex items-center rounded-full bg-navy px-2.5 py-0.5 text-[0.7rem] font-semibold tracking-wider text-white uppercase">
                      {corum.range.currentBadge}
                    </span>
                  )}
                  <span>{name}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <RiskNote text={corum.disclaimer} size="lead" class="mt-6" />
      </div>
    </div>
  </Container>
</Section>
