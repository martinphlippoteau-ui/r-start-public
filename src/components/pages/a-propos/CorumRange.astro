---
/**
 * Page /a-propos, société de gestion : DEUX sections et une photo pleine largeur.
 *  1. #corum   (white) « Le groupe CORUM en quelques chiffres », les cinq chiffres du groupe. Cinq
 *                      colonnes et une taille de chiffre plus basse dès qu'ils sont cinq : à quatre
 *                      colonnes le cinquième restait seul sur une ligne, et à cinq colonnes en taille
 *                      pleine « 9,6 Md€ » passait à la ligne (14/09/2026) ;
 *  2. bande photo pleine largeur, hors section (décorative, sans titre : elle n'a donc pas d'ancre) ;
 *  3. #gamme   (white) la gamme des cinq SCPI, tuile R Start marquée « Nouveau ».
 * La section #savoir-faire, qui décrivait les trois familles de solutions du groupe, a été RETIRÉE le
 * 14/09/2026 à la demande de l'équipe ; son contenu reste dans corum.ts (`expertise`) et ses trois
 * visuels dans media.ts (`expertise`).
 * Ces blocs étaient sur l'accueil jusqu'au 11/09/2026 ; ils ont leur place ici, où le sujet est la
 * société de gestion.
 * La photo n'a PAS de parallaxe : `data-parallax` exige le moteur GSAP, que cette page n'a aucune autre
 * raison de télécharger (tests/performance.spec.ts). Elle se révèle par `data-animate="clip"`, rendu par
 * le moteur léger.
 * Le contre-poids de la gamme (corum.disclaimer) est toujours passé à RiskNote, qui ne rend plus rien
 * depuis le 14/09/2026 : il reparaîtra avec les autres mentions.
 * Contenu : src/content/fr/corum.ts et media.ts. Notes résolues dans celles de la page (about.notes).
 */
import { Picture } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { corum } from '@/content/fr/corum';
import { trust } from '@/content/fr/trust';
import { media, AFFICHER_LEGENDES } from '@/content/fr/media';
import { product } from '@/content/fr/facts';
import { resolveImage } from '@/lib/images';
import type { LegalNote } from '@/content/types';

interface Props {
  tone?: 'paper' | 'white';
  /** Notes de la page, pour la numérotation des appels de note. */
  notes?: LegalNote[];
}
const { tone = 'white', notes } = Astro.props as Props;
const officePhoto = await resolveImage(media.corum.src);
const stats = trust.stats;
const range = corum.range.scpiNames.map((name) => ({ name, current: name === product.name }));
const LOGO_STAGGER = 0.08;
const QUIET_TITLE_Y = 12;
/*
 * `corum.expertise` n'est plus lu : la section des trois savoir-faire est partie le 14/09/2026.
 * Le contenu reste dans corum.ts, prêt à resservir ; les trois visuels, eux, ont été retirés de
 * media.ts le 15/09/2026 avec les dernières photographies du site.
 */
---

{/* 1. Le groupe CORUM en chiffres */}
<Section id="corum" tone={tone} labelledBy="chiffres-title">
  <Container size="wide">
    <h2 id="chiffres-title" class="text-display-md max-w-4xl" data-animate="fade-up">
      {stats.title}
      <NoteRef notes={notes} id="confiance-chiffres" tone="light" />
    </h2>
    <!--
      Deux colonnes dès le téléphone (13/09/2026) : en une seule, les chiffres prenaient un écran pour
      quatre nombres. Plusieurs colonnes dès `lg` seulement : plus étroites, « 160 000 » en text-stat
      déborde de sa cellule (texte dégradé tronqué).
      LE NOMBRE DE COLONNES SUIT LE NOMBRE DE CHIFFRES (14/09/2026) : l'équipe en a ajouté un cinquième,
      « 7 bureaux dans le monde », et sur une grille de quatre il se retrouvait seul sur une deuxième
      ligne, à côté de trois cases vides. La grille est bornée à cinq : au-delà, on repasse à quatre et
      c'est la deuxième ligne qui se remplit.
      À CINQ COLONNES, les cases descendent à 215 px sur un écran de 1440 : « 9,6 Md€ » et
      « + 160 000 » passaient à la ligne en taille `solid` et les cinq libellés ne s'alignaient plus.
      Les chiffres passent donc en `solid-compact`, un cran plus bas, dès qu'ils sont cinq. Un chiffre
      un peu plus petit se lit ; cinq chiffres désalignés, non.
    -->
    <ul
      role="list"
      class:list={[
        'mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:mt-14',
        stats.items.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4',
      ]}
    >
      {
        /* Les chiffres comptent depuis 0, en place, avec une durée liée à leur ordre de grandeur. */
      }
      {
        stats.items.map((s) => (
          <li>
            <Stat
              size={stats.items.length === 5 ? 'solid-compact' : 'solid'}
              value={s.value}
              suffix={s.suffix}
              label={s.label}
            />
          </li>
        ))
      }
    </ul>
    {
      /* Le contre-poids « Ces chiffres sont ceux du groupe CORUM… » et la ligne de source ont été retirés
        d'ici le 11/09/2026 (décision de l'équipe). Le rappel « cette expérience ne préjuge pas des résultats
        de R Start, qui n'a pas d'historique propre » reste porté par l'introduction de l'en-tête de la
        page (aboutPage.hero.intro). Les chiffres ne sont donc plus marqués [data-advantage]. */
    }
  </Container>
</Section>

{
  /* 2. Bande PLEINE LARGEUR (13/09/2026) : elle sépare les deux chapitres et donne à la page sa seule
    respiration visuelle. Décorative, aucun avantage, donc aucun contre-poids attendu. Hors <Section> :
    sans titre, elle n'aurait aucune ancre à désigner en aria-labelledby.
    LA MENTION EST APPARUE LE 15/09/2026 avec le passage aux illustrations. Tant que la bande montrait
    les bureaux de CORUM, il n'y avait rien à écarter ; elle montre désormais un immeuble, et doit donc
    la même mention que les deux autres bandes du site (03a-Immeuble, 01b-Difference). */
}
<figure class="relative" data-animate="clip">
  <div
    class="relative h-[42vh] min-h-64 w-full overflow-hidden sm:h-[52vh] sm:min-h-80 lg:h-[60vh]"
  >
    <Picture
      src={officePhoto}
      alt={media.corum.alt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </div>
  {
    AFFICHER_LEGENDES && media.corum.credit && (
      <figcaption class="text-caption py-4 text-slate-700">
        <Container size="wide">{media.corum.credit}</Container>
      </figcaption>
    )
  }
</figure>

{
  /*
   * SECTION « Les trois savoir-faire de CORUM L'Épargne » SUPPRIMÉE le 14/09/2026, demande de l'équipe.
   * Elle décrivait les trois familles de solutions du groupe (SCPI, fonds obligataires, assurance vie
   * et plan d'épargne retraite), chacune avec sa photo. Le contenu reste dans corum.ts (`expertise`) et
   * les trois visuels dans media.ts (`expertise`) : rien n'est perdu, la page ne les appelle plus.
   * La page passe ainsi de cinq blocs à quatre : l'histoire, les chiffres, la photo des bureaux, la gamme.
   */
}

<Section id="gamme" tone="white" labelledBy="gamme-title">
  <Container size="wide">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <!-- Titre suivi d'un paragraphe visible d'emblée : fade-up court pour ne pas chevaucher sa première ligne. -->
        <h2
          id="gamme-title"
          class="text-display-md text-ink"
          data-animate="fade-up"
          data-animate-y={String(QUIET_TITLE_Y)}
        >
          {corum.range.title}
          <NoteRef notes={notes} id="corum-gamme" tone="light" />
        </h2>
        <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">{corum.range.description}</p>
      </div>
      <div class="lg:col-span-7">
        <ul
          role="list"
          class="grid grid-cols-2 gap-4 sm:grid-cols-3"
          data-animate="stagger"
          data-animate-stagger={String(LOGO_STAGGER)}
        >
          {
            range.map(({ name, current }) => (
              <li
                class:list={[
                  'flex min-h-24 items-center justify-center rounded-2xl border p-5 text-center text-lg font-semibold sm:p-6',
                  current
                    ? 'border-teal-400 bg-teal-100 text-navy'
                    : 'border-mist bg-paper text-navy',
                ]}
                aria-current={current ? 'true' : undefined}
              >
                <span class="flex flex-col items-center gap-1.5">
                  {current && corum.range.currentBadge && (
                    <span class="inline-flex items-center rounded-full bg-navy px-2.5 py-0.5 text-[0.7rem] font-semibold tracking-wider text-white uppercase">
                      {corum.range.currentBadge}
                    </span>
                  )}
                  <span>{name}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <RiskNote text={corum.disclaimer} size="lead" class="mt-6" />
      </div>
    </div>
  </Container>
</Section>
