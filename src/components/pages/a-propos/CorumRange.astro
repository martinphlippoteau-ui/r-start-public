---
/**
 * Page /a-propos, société de gestion : DEUX sections et une photo pleine largeur.
 *  1. #corum   (white) « Le groupe CORUM en quelques chiffres », les cinq chiffres du groupe. Cinq
 *                      colonnes et une taille de chiffre plus basse dès qu'ils sont cinq : à quatre
 *                      colonnes le cinquième restait seul sur une ligne, et à cinq colonnes en taille
 *                      pleine « 9,6 Md€ » passait à la ligne (14/09/2026) ;
 *  2. bande photo pleine largeur, hors section (décorative, sans titre : elle n'a donc pas d'ancre) ;
 *  3. #gamme   (white) la gamme des cinq SCPI, tuile R Start marquée « Nouveau ».
 * La section #savoir-faire, qui décrivait les trois familles de solutions du groupe, a été RETIRÉE le
 * 14/09/2026 à la demande de l'équipe ; son contenu reste dans corum.ts (`expertise`) et ses trois
 * visuels dans media.ts (`expertise`).
 * Ces blocs étaient sur l'accueil jusqu'au 11/09/2026 ; ils ont leur place ici, où le sujet est la
 * société de gestion.
 * La photo n'a PAS de parallaxe : `data-parallax` exige le moteur GSAP, que cette page n'a aucune autre
 * raison de télécharger (tests/performance.spec.ts). Elle se révèle par `data-animate="clip"`, rendu par
 * le moteur léger.
 * Le contre-poids de la gamme (corum.disclaimer) est toujours passé à RiskNote, qui ne rend plus rien
 * depuis le 14/09/2026 : il reparaîtra avec les autres mentions.
 * Contenu : src/content/fr/corum.ts et media.ts. Notes résolues dans celles de la page (about.notes).
 */
import { Image, Picture } from 'astro:assets';
import amfLogo from '@/assets/logos/amf.svg';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { corum } from '@/content/fr/corum';
import { corumRange } from '@/content/fr/corumRange';
import { trust as trustFacts } from '@/content/fr/facts';
import { trust } from '@/content/fr/trust';
import { media, AFFICHER_LEGENDES } from '@/content/fr/media';
import { product } from '@/content/fr/facts';
import { resolveImage } from '@/lib/images';
import type { LegalNote } from '@/content/types';

interface Props {
  tone?: 'paper' | 'white';
  /** Notes de la page, pour la numérotation des appels de note. */
  notes?: LegalNote[];
}
const { tone = 'white', notes } = Astro.props as Props;
const officePhoto = await resolveImage(media.corum.src);
const stats = trust.stats;
/*
 * DATE DE CRÉATION SOUS CHAQUE TUILE (16/09/2026, demande de l'équipe). Le gabarit vient du contenu,
 * l'année aussi : le composant ne fabrique aucun texte. Une SCPI sans année rend une tuile inchangée.
 */
const range = corum.range.scpiNames.map((name) => {
  const annee = corum.range.scpiCreated?.[name];
  const gabarit = corum.range.scpiCreatedLabel;
  return {
    name,
    current: name === product.name,
    created: annee && gabarit ? gabarit.replace('{year}', annee) : undefined,
  };
});
const LOGO_STAGGER = 0.08;
const QUIET_TITLE_Y = 12;
/*
 * `corum.expertise` n'est plus lu : la section des trois savoir-faire est partie le 14/09/2026.
 * Le contenu reste dans corum.ts, prêt à resservir ; les trois visuels, eux, ont été retirés de
 * media.ts le 15/09/2026 avec les dernières photographies du site.
 */
---

{/* 1. Le groupe CORUM en chiffres */}
<Section id="corum" tone={tone} labelledBy="chiffres-title">
  <Container size="wide">
    <h2 id="chiffres-title" class="text-display-md max-w-4xl" data-animate="fade-up">
      {stats.title}
      <NoteRef notes={notes} id="confiance-chiffres" tone="light" />
    </h2>
    <!--
      Deux colonnes dès le téléphone (13/09/2026) : en une seule, les chiffres prenaient un écran pour
      quatre nombres. Plusieurs colonnes dès `lg` seulement : plus étroites, « 160 000 » en text-stat
      déborde de sa cellule (texte dégradé tronqué).
      LE NOMBRE DE COLONNES SUIT LE NOMBRE DE CHIFFRES (14/09/2026) : l'équipe en a ajouté un cinquième,
      « 7 bureaux dans le monde », et sur une grille de quatre il se retrouvait seul sur une deuxième
      ligne, à côté de trois cases vides. La grille est bornée à cinq : au-delà, on repasse à quatre et
      c'est la deuxième ligne qui se remplit.
      À CINQ COLONNES, les cases descendent à 215 px sur un écran de 1440 : « 9,6 Md€ » et
      « + 160 000 » passaient à la ligne en taille `solid` et les cinq libellés ne s'alignaient plus.
      Les chiffres passent donc en `solid-compact`, un cran plus bas, dès qu'ils sont cinq. Un chiffre
      un peu plus petit se lit ; cinq chiffres désalignés, non.
    -->
    <ul
      role="list"
      class:list={[
        'mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:mt-14',
        stats.items.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4',
      ]}
    >
      {
        /* Les chiffres comptent depuis 0, en place, avec une durée liée à leur ordre de grandeur. */
      }
      {
        stats.items.map((s) => (
          <li>
            <Stat
              size={stats.items.length === 5 ? 'solid-compact' : 'solid'}
              value={s.value}
              suffix={s.suffix}
              label={s.label}
            />
          </li>
        ))
      }
    </ul>
    {
      /*
       * CADRE RÉGLEMENTAIRE (16/09/2026, demande de l'équipe : « mettre le logo AMF en disant que
       * R Start est agréé par l'AMF »).
       *
       * LE TEXTE NE DIT PAS CELA, ET C'EST VOULU. R Start n'est pas agréé, il est VISÉ : la note
       * d'information a obtenu le visa SCPI n° 26-06 du 4 mars 2026. Ce qui est AGRÉÉ, c'est la société
       * de gestion. Écrire « R Start est agréé par l'AMF » affirmerait exactement ce que la mention
       * standard du pied de page nie (« le visa n'implique ni approbation de l'opportunité de
       * l'opération »). L'équipe a arbitré entre trois formulations exactes et retenu celle-ci, qui
       * porte les DEUX faits.
       *
       * LES DEUX PHRASES SONT REPRISES DE trust.ts, mot pour mot : elles viennent du bulletin de
       * souscription, et celle de l'agrément est la formulation que l'AMF a demandée dans ses retours
       * sur la brochure (09/2026). Rien n'est reparaphrasé ici.
       *
       * LE LOGO reste ce qu'il était sur le hero avant son retrait : un fichier hébergé sur Wikipédia
       * France au titre d'un usage non libre, et l'AMF ne concède pas son logo aux communications
       * commerciales. La réserve vaut toujours, l'équipe l'a levée en connaissance de cause.
       */
    }
    {/* `sm:items-stretch` : la plaque prend la hauteur de la rangée, donc celle du texte à sa
      droite, et le logo la remplit. Une hauteur écrite en dur se serait décalée dès qu'une phrase
      passe d'une ligne à l'autre, ce qui arrive entre 640 et 1024 px. */}
    <div class="mt-section-sm flex flex-col gap-5 sm:flex-row sm:items-stretch sm:gap-7">
      {/* Logo agrandi deux fois le 16/09/2026 : à 40 px sa ligne de tête (« AUTORITÉ DES MARCHÉS
      FINANCIERS ») se refermait, à 56 px elle redevenait lisible, et il prend maintenant toute la
      hauteur du texte à sa droite. Sous `sm`, où la plaque passe au-dessus du texte, il garde ses
      56 px : rien à épouser dans ce sens-là. */}
      <span class="flex shrink-0 items-center justify-center rounded-xl bg-white px-5 py-4 ring-1 ring-navy/10">
        <Image
          src={amfLogo}
          alt="Autorité des marchés financiers"
          width={142}
          height={57}
          class="w-auto max-sm:h-14 sm:h-full"
        />
      </span>
      <div class="max-w-3xl space-y-2">
        <p class="text-base leading-snug text-slate-700">{trustFacts.amf.managementCompanyApproval}</p>
        <p class="text-base leading-snug text-slate-700">{trustFacts.amf.visaSentence}</p>
      </div>
    </div>

    {
      /*
       * APPEL SOUS LES CHIFFRES (16/09/2026, demande de l'équipe). Il SORT DU SITE, vers corum.fr, ce
       * qu'aucun autre appel ne fait depuis le corps d'une page : d'où `target="_blank"`, le
       * `rel="noopener noreferrer"` qui va avec, et la mention de nouvelle fenêtre lue par les lecteurs
       * d'écran mais pas affichée.
       * `secondary` et non `primary` : il ne mène pas au tunnel de souscription, et la page en porte
       * déjà un dans son en-tête.
       */
    }
    {corum.siteLink && (
      <p class="mt-section-sm">
        <Button
          href={corum.siteLink.href}
          variant="secondary"
          size="lg"
          target="_blank"
        >
          {corum.siteLink.label}
          <span class="visually-hidden">({corum.siteLink.newTabHint})</span>
        </Button>
      </p>
    )}

    {
      /* Le contre-poids « Ces chiffres sont ceux du groupe CORUM… » et la ligne de source ont été retirés
        d'ici le 11/09/2026 (décision de l'équipe). Le rappel « cette expérience ne préjuge pas des résultats
        de R Start, qui n'a pas d'historique propre » reste porté par l'introduction de l'en-tête de la
        page (aboutPage.hero.intro). Les chiffres ne sont donc plus marqués [data-advantage]. */
    }
  </Container>
</Section>

{
  /* 2. Bande PLEINE LARGEUR (13/09/2026) : elle sépare les deux chapitres et donne à la page sa seule
    respiration visuelle. Décorative, aucun avantage, donc aucun contre-poids attendu. Hors <Section> :
    sans titre, elle n'aurait aucune ancre à désigner en aria-labelledby.
    LA MENTION EST APPARUE LE 15/09/2026 avec le passage aux illustrations. Tant que la bande montrait
    les bureaux de CORUM, il n'y avait rien à écarter ; elle montre désormais un immeuble, et doit donc
    la même mention que les deux autres bandes du site (03a-Immeuble, 01b-Difference). */
}
<figure class="relative" data-animate="clip">
  <div
    class="relative h-[42vh] min-h-64 w-full overflow-hidden sm:h-[52vh] sm:min-h-80 lg:h-[60vh]"
  >
    <Picture
      src={officePhoto}
      alt={media.corum.alt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </div>
  {
    AFFICHER_LEGENDES && media.corum.credit && (
      <figcaption class="text-caption py-4 text-slate-700">
        <Container size="wide">{media.corum.credit}</Container>
      </figcaption>
    )
  }
</figure>

{
  /*
   * SECTION « Les trois savoir-faire de CORUM L'Épargne » SUPPRIMÉE le 14/09/2026, demande de l'équipe.
   * Elle décrivait les trois familles de solutions du groupe (SCPI, fonds obligataires, assurance vie
   * et plan d'épargne retraite), chacune avec sa photo. Le contenu reste dans corum.ts (`expertise`) et
   * les trois visuels dans media.ts (`expertise`) : rien n'est perdu, la page ne les appelle plus.
   * La page passe ainsi de cinq blocs à quatre : l'histoire, les chiffres, la photo des bureaux, la gamme.
   */
}

<Section id="gamme" tone="white" labelledBy="gamme-title">
  <Container size="wide">
    {
      /*
       * LA GAMME EN CARROUSEL depuis le 16/09/2026, contenu fourni par l'équipe. Cette place portait
       * « Des SCPI gérées depuis 2012 » : cinq tuiles nommant les SCPI, avec leur année de création et
       * le logo de R Start. Les chiffres remplacent les noms.
       *
       * R START N'Y EST PLUS, et c'est cohérent : elle n'a ni TRI ni rendement à montrer. Le contenu
       * précédent reste dans corum.ts (`range`) et les années de création dans facts.ts
       * (`scpiCreated`), prêts à resservir.
       *
       * SUR LES CHIFFRES, voir l'en-tête de corumRange.ts : chaque intitulé est celui fourni, la
       * mention réglementaire sur les performances passées a été ajoutée, et la date d'arrêté reste à
       * demander à CORUM.
       */
    }
    <header class="max-w-4xl">
      <h2
        id="gamme-title"
        class="text-display-md text-ink"
        data-animate="fade-up"
        data-animate-y={String(QUIET_TITLE_Y)}
      >
        {corumRange.title}
      </h2>
    </header>

    {
      /* RAIL DÉFILANT. Sans script il se fait déjà défiler au doigt et à la tabulation ; les deux
        flèches arrivent `hidden` et ne sont révélées que par src/scripts/carrousel.ts.
        `-mx-5 px-5` fait sortir le rail des marges du conteneur : sur un téléphone, une carte coupée au
        bord de l'écran annonce qu'il y en a d'autres, là où un rail bien rangé dans sa colonne laisse
        croire que tout est visible.
        `scroll-pl-*` ÉGAL AU REMBOURRAGE : sans lui, l'accrochage aligne la première carte sur le bord
        du contenu et le rail s'ouvre déjà décalé de la valeur du rembourrage, flèche « précédente »
        active alors qu'on est au départ. Mesuré à 32 px, puis corrigé. */
    }
    <div class="relative mt-10 lg:mt-14" data-rail-zone>
      <ul
        role="list"
        aria-label={corumRange.listLabel}
        tabindex="0"
        class="-mx-5 flex snap-x snap-mandatory scroll-pl-5 gap-4 overflow-x-auto px-5 pb-4 sm:-mx-8 sm:scroll-pl-8 sm:gap-5 sm:px-8"
        data-rail
      >
        {
          corumRange.items.map((scpi) => (
            <li class="flex w-[17rem] shrink-0 snap-start flex-col rounded-3xl bg-ink p-6 text-white sm:w-[19rem] sm:p-7">
              <p class="text-display-sm text-sand">{scpi.name}</p>
              {scpi.badge && (
                <p class="mt-3 inline-flex self-start rounded-full bg-teal-200 px-2.5 py-0.5 text-[0.7rem] font-semibold tracking-wider text-ink uppercase">
                  {scpi.badge}
                </p>
              )}

              {
                /* LA MESURE MISE EN AVANT, et son intitulé juste dessous : un grand nombre seul ne dit
                  pas ce qu'il mesure, et ces quatre-là ne mesurent pas la même chose — trois TRI
                  réalisés et un objectif. */
              }
              <p class="text-display-lg mt-6 leading-none text-white">
                {scpi.principale.value}
                <span class="text-display-sm text-teal-200">{scpi.principale.unit}</span>
              </p>
              <p class="mt-2 text-base leading-snug text-white/80">{scpi.principale.label}</p>

              <ul role="list" class="mt-6 space-y-4 border-t border-white/15 pt-5">
                {scpi.autres.map((m) => (
                  <li class="flex items-baseline justify-between gap-3">
                    <span class="text-base leading-snug text-white/80">{m.label}</span>
                    <span class="text-lead shrink-0 font-semibold text-sand tabular-nums">
                      {m.value}
                      <span class="text-base text-teal-200">{m.unit}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      {
        /* Les deux flèches, révélées par le script. Sous la liste et non par-dessus : posées sur les
          cartes, elles masqueraient un chiffre sur un petit écran. */
      }
      <div class="mt-5 flex gap-3">
        <button
          type="button"
          data-rail-precedent
          hidden
          aria-label={corumRange.previousLabel}
          class="rail-fleche"
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="size-4">
            <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          data-rail-suivant
          hidden
          aria-label={corumRange.nextLabel}
          class="rail-fleche"
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="size-4">
            <path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    {
      /* LA MENTION RÉGLEMENTAIRE D'ABORD, les définitions ensuite : elle qualifie tous les chiffres
        au-dessus, elle ne peut pas être la sixième ligne d'une liste de notes. Jamais animée. */
    }
    <p class="mt-10 max-w-4xl text-base leading-relaxed text-ink">{corumRange.pastPerformance}</p>
    <ul role="list" class="text-caption mt-5 max-w-4xl space-y-3 text-slate-700">
      {corumRange.notes.map((note) => <li>{note}</li>)}
    </ul>
  </Container>
</Section>

<script>
  /* Flèches du rail : le rail défile sans elles, elles ne sont révélées que si le script tourne. */
  import '@/scripts/carrousel';
</script>
