---
/**
 * Zone 2 de /a-propos (id « histoire ») : la conviction de 2011, ce que CORUM a changé au modèle des
 * SCPI, et la bascule vers R Start. Contenu fourni par l'équipe le 14/09/2026, repris mot pour mot
 * (src/content/fr/corum.ts, `history`).
 *
 * Mise en page : le récit à gauche, la liste des cinq transformations à droite, alignés en haut. Elle
 * est LA matière du bloc, elle mérite sa colonne ; empilée sous le texte, elle repoussait la bascule
 * « R Start ouvre un nouveau chapitre » à un écran de distance de ce qui l'amène.
 * Sous `lg`, tout s'empile dans l'ordre de lecture du document.
 *
 * Motion : rien qui masque du texte au repos, et RIEN QUI EXIGE GSAP. Le titre en fade-up court et les
 * cinq items en cascade, tous deux rendus par le moteur léger ; le filet de la bascule est statique.
 * /a-propos ne charge que motion/lite.ts, un test le vérifie. Aucune révélation sur les paragraphes.
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { history } from '@/content/fr/corum';

interface Props {
  /** Ton de la section, pour l'alternance des fonds sur la page. */
  tone?: 'paper' | 'white';
}
const { tone = 'white' } = Astro.props;
const id = 'histoire';
/** Titre suivi d'un paragraphe visible d'emblée : fade-up court, il ne chevauche pas sa première ligne. */
const QUIET_TITLE_Y = 12;
---

<Section id={id} tone={tone}>
  <Container size="wide">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 xl:gap-16">
      <div class="lg:col-span-6">
        <h2
          id={id + '-title'}
          class="text-display-md text-ink"
          data-animate="fade-up"
          data-animate-y={String(QUIET_TITLE_Y)}
        >
          {history.title}
        </h2>
        <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">{history.lead}</p>

        <p class="text-lead mt-8 text-pretty text-ink lg:mt-10">{history.transformIntro}</p>
      </div>

      <div class="mt-8 lg:col-span-6 lg:mt-0">
        <ul
          role="list"
          class="grid gap-5 lg:gap-6"
          data-animate="stagger"
          data-animate-stagger="0.08"
        >
          {
            history.transformItems.map((item) => (
              <li class="flex items-start gap-4 border-t border-navy/12 pt-5">
                <span aria-hidden="true" class="mt-2.5 size-2 shrink-0 rounded-full bg-teal-700" />
                <p class="text-base leading-relaxed text-slate-700 sm:text-lg">{item}</p>
              </li>
            ))
          }
        </ul>

        {
          /* La flèche est décorative : le lien logique est déjà dans la phrase, un lecteur d'écran qui
            annoncerait « flèche vers la droite » n'apprendrait rien. */
        }
        <p class="text-display-sm mt-8 flex items-baseline gap-3 text-navy">
          <span aria-hidden="true" class="text-teal-700">&rarr;</span>
          {history.transformOutro}
        </p>
      </div>
    </div>

    <div class="mt-14 lg:mt-20">
      {
        /* Filet STATIQUE, et non `data-draw` : ce dernier est un effet du moteur GSAP, et /a-propos ne
          doit charger que le moteur léger (45 Ko gzip d'écart, tests/performance.spec.ts le vérifie).
          Les révélations `data-animate` de cette section, elles, sont rendues par le moteur léger. */
      }
      <span aria-hidden="true" class="block h-px w-full bg-navy/15"></span>
      <div class="pt-8 lg:flex lg:items-baseline lg:justify-between lg:gap-12">
        <p class="text-lead max-w-2xl text-slate-700">{history.today}</p>
        <p class="text-display-sm mt-4 max-w-2xl text-ink lg:mt-0 lg:text-right">
          {history.chapter.lead}{' '}
          <strong class="font-bold text-navy">{history.chapter.strong}</strong>
        </p>
      </div>
    </div>
  </Container>
</Section>
