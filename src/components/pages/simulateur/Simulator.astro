  class="simu-barre fixed inset-x-0 bottom-0 z-30 flex items-center justify-between gap-3 border-t border-mist bg-white px-4 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] shadow-float lg:hidden"
