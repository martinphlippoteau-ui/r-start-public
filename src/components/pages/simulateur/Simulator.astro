                    [0, 1, 2, 3, 4].map((i) => (
                      <g>
                        <line
                          data-grille={i}
                          x1="64"
                          x2="700"
                          class={i === 0 ? 'stroke-navy/30' : 'stroke-mist'}
                          stroke-dasharray={i === 0 ? undefined : '3 4'}
