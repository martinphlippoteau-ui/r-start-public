---
/**
 * Page /frais — Bascule pédagogique des frais (id « comparatif », plan §3 bis).
 * Deux positions, « SCPI avec frais d'acquisition » et « R Start », qui rejouent le même parcours
 * d'épargne : souscription, achat des immeubles, détention, vente d'un immeuble, sortie. Chaque ligne
 * montre le taux, son assiette et le moment du prélèvement : la bascule explique *quand* la société de
 * gestion se rémunère, pas seulement *combien*.
 *
 * Garde-fous appliqués ici (retours AMF de septembre 2026) :
 *  - une seule taille de police pour toutes les valeurs de frais, des deux côtés (classe `fee-value`),
 *    et aucun texte de la bascule sous `text-base` : le barème de retrait n'est plus en petits caractères ;
 *  - aucune SCPI tierce nommée dans la partie visible : le périmètre (les neuf SCPI du panel), la note de
 *    bas de tableau et la source sont affichés en toutes lettres sous la bascule, jamais repliés ;
 *  - le contre-poids risque (RiskNote) et l'encadré « Une innovation, pas une révolution » (legal.ts,
 *    reproduit à l'identique) restent visibles quelle que soit la position choisie, jamais animés.
 *
 * Progressif : sans JavaScript, les deux positions s'affichent l'une sous l'autre, en entier, et les
 * boutons ne sont pas rendus visibles. Au chargement, le script pose la sémantique d'onglets
 * (role tablist / tab / tabpanel, flèches, Origine et Fin, focus visible), affiche les boutons et
 * n'affiche plus qu'une position à la fois. Position par défaut : la première, « SCPI avec frais
 * d'acquisition », pour dérouler la pédagogie avant d'arriver à R Start.
 *
 * Contenu : src/content/fr/feesPage.ts (`marketComparison`), aucun texte en dur.
 */
import Container from '@/components/ui/Container.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import FeesNoteRef from '@/components/pages/frais/FeesNoteRef.astro';
import { feesPage } from '@/content/fr/feesPage';

interface Props {
  /** Ancre de la section (par défaut « comparatif »). */
  id?: string;
}
const { id = 'comparatif' } = Astro.props;
const comparison = feesPage.marketComparison;
const { columns } = comparison;

/** Regroupe les étapes consécutives d'un même moment du parcours (souscription, achat, détention…). */
const groupByMoment = (steps: (typeof comparison.sides)[number]['steps']) =>
  steps.reduce<{ moment: string; steps: typeof steps }[]>((groups, step) => {
    const last = groups[groups.length - 1];
    if (last && last.moment === step.moment) last.steps.push(step);
    else groups.push({ moment: step.moment, steps: [step] });
    return groups;
  }, []);

const sides = comparison.sides.map((side) => ({ ...side, groups: groupByMoment(side.steps) }));
---

<Section id={id} tone="white" labelledBy={id + '-title'}>
  <Container size="wide">
    {comparison.eyebrow && <p class="text-eyebrow mb-4 text-teal-700">{comparison.eyebrow}</p>}
    <h2 id={id + '-title'} class="text-display-lg max-w-4xl">
      {comparison.title}
      {comparison.noteId && (
        <span class="whitespace-nowrap"><FeesNoteRef id={comparison.noteId} /></span>
      )}
    </h2>
    <p class="text-lead mt-6 max-w-3xl">{comparison.intro}</p>

    <div class="mt-10 lg:mt-12" data-fee-switcher>
      <!-- Boutons de bascule : rendus inertes sans JavaScript (le script retire l'attribut hidden). -->
      <div
        class="fee-tabs inline-flex flex-wrap gap-2 rounded-full bg-paper p-2 ring-1 ring-navy/10"
        role="tablist"
        aria-label={comparison.switchLabel}
        data-fee-tabs
        hidden
      >
        {
          sides.map((side, i) => (
            <button
              type="button"
              id={`${id}-tab-${side.key}`}
              data-fee-tab={side.key}
              data-fee-selected={i === 0 ? 'true' : undefined}
              class="fee-tab rounded-full px-5 py-3 text-base font-semibold text-ink transition-colors duration-200 hover:text-navy focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-navy"
            >
              {side.label}
            </button>
          ))
        }
      </div>

      <div class="mt-8 grid gap-6 lg:gap-8" data-fee-panels>
        {
          sides.map((side, i) => (
            <article
              id={`${id}-panel-${side.key}`}
              data-fee-panel={side.key}
              data-fee-default={i === 0 ? 'true' : undefined}
              class="fee-panel rounded-3xl bg-paper p-6 ring-1 ring-navy/5 sm:p-8 lg:p-10"
            >
              <h3 class="text-display-sm text-ink">{side.label}</h3>
              <p class="text-lead mt-4 max-w-3xl text-ink">{side.summary}</p>

              {side.groups.map((group) => (
                <section class="mt-8 border-t border-navy/15 pt-6">
                  <h4 class="text-eyebrow text-teal-700">{group.moment}</h4>
                  <ul role="list" class="mt-4 grid gap-5">
                    {group.steps.map((step) => (
                      <li class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-x-8">
                        <p class="text-base font-semibold text-ink sm:text-lg">
                          <span class="visually-hidden">{columns.fee} : </span>
                          {step.label}
                        </p>
                        <p class="fee-value order-first font-bold text-navy tabular-nums sm:order-none sm:text-right" data-fee-value data-fee-block="comparatif">
                          <span class="visually-hidden">{columns.value} : </span>
                          {step.value}
                        </p>
                        <p class="text-base leading-relaxed text-slate-700 sm:col-span-2">
                          {step.base} · {step.timing}
                          {step.detail && <> · {step.detail}</>}
                        </p>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </article>
          ))
        }
      </div>
    </div>

    <!-- Périmètre, note de bas de tableau et source : toujours affichés, jamais repliés. -->
    <div class="mt-10 grid gap-6 border-t border-navy/15 pt-8 lg:mt-12 lg:grid-cols-2 lg:gap-12">
      <div data-advantage class="text-base leading-relaxed text-slate-700">
        <p>{comparison.perimeter}</p>
        {comparison.footnote && <p class="mt-3">{comparison.footnote}</p>}
      </div>
      <RiskNote text={comparison.risk} size="lead" />
    </div>

    <div class="mt-10 rounded-3xl bg-ink p-6 text-white sm:p-8 lg:mt-12 lg:p-10">
      <h3 class="text-display-sm text-white">{comparison.innovationBox.title}</h3>
      <RiskNote text={comparison.innovationBox.body} tone="dark" size="lead" class="mt-5" />
    </div>
  </Container>
</Section>

<style>
  /* Valeurs de frais : une seule taille, des deux côtés de la bascule (exigence AMF). */
  .fee-value {
    font-size: 1.5rem;
    line-height: 1.2;
  }
  /* Onglets : la position sélectionnée est portée par data-fee-selected (posé par le script). */
  .fee-tab[data-fee-selected='true'] {
    background-color: var(--color-navy);
    color: #fff;
  }
  /* Transition sobre entre les deux positions ; supprimée en reduced-motion. */
  .fee-panel[data-fee-entering] {
    animation: fee-panel-in 220ms ease-out both;
  }
  @keyframes fee-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fee-panel[data-fee-entering] {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Sémantique d'onglets posée seulement si JavaScript s'exécute : sans lui, les deux positions restent
   * affichées l'une sous l'autre et aucun bouton n'apparaît. Aucune valeur de frais n'est modifiée ici.
   */
  const initFeeSwitcher = (root: HTMLElement): void => {
    const tabsBox = root.querySelector<HTMLElement>('[data-fee-tabs]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-fee-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-fee-panel]')];
    if (!tabsBox || tabs.length < 2 || panels.length !== tabs.length) return;

    tabsBox.hidden = false;
    tabsBox.setAttribute('role', 'tablist');

    const select = (key: string, focus: boolean): void => {
      tabs.forEach((tab) => {
        const active = tab.dataset.feeTab === key;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active) tab.dataset.feeSelected = 'true';
        else delete tab.dataset.feeSelected;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.dataset.feePanel === key;
        panel.hidden = !active;
        if (active) {
          panel.dataset.feeEntering = 'true';
          panel.addEventListener('animationend', () => delete panel.dataset.feeEntering, { once: true });
        }
      });
    };

    tabs.forEach((tab, i) => {
      const panel = panels[i];
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.tabIndex = 0;
      tab.addEventListener('click', () => select(tab.dataset.feeTab ?? '', false));
      tab.addEventListener('keydown', (event: KeyboardEvent) => {
        const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const forward = event.key === 'ArrowRight' || event.key === 'ArrowDown';
        const next =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? tabs.length - 1
              : (i + (forward ? 1 : tabs.length - 1)) % tabs.length;
        select(tabs[next].dataset.feeTab ?? '', true);
      });
    });

    const initial = tabs.find((t) => t.dataset.feeSelected === 'true') ?? tabs[0];
    select(initial.dataset.feeTab ?? '', false);
    panels.forEach((panel) => delete panel.dataset.feeEntering);
  };

  document
    .querySelectorAll<HTMLElement>('[data-fee-switcher]')
    .forEach((root) => initFeeSwitcher(root));
</script>
