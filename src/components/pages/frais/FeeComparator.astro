---
/**
 * Comparateur de frais (11/09/2026) : R Start à gauche, une SCPI choisie dans une liste à droite, sept
 * lignes de frais. Le choix se fait sans rechargement, toutes les valeurs sont dans le HTML, le script
 * ne fait qu'afficher la colonne demandée. Sans script, la première SCPI reste affichée : le tableau est
 * complet et lisible.
 *
 * C'est un VRAI TABLEAU (<table>, en-têtes de colonne et de ligne) : une comparaison de frais se lit
 * aussi au lecteur d'écran, et la liste déroulante vit dans l'en-tête de la colonne qu'elle change.
 *
 * Conformité :
 *  - chaque taux porte `data-fee-value` dans un même `data-fee-block` : le contrôle vérifie qu'aucun
 *    frais n'est affiché plus petit que ses voisins (retour AMF sur la brochure) ;
 *  - tant qu'une valeur manque, un avertissement le dit en toutes lettres au-dessus du tableau, et le
 *    tableau ne prétend rien comparer ;
 *  - les sources sont sous le tableau, celle de R Start et celle, à venir, des autres SCPI ;
 *  - nommer une autre SCPI engage : le périmètre, l'encadré « Une innovation, pas une révolution » et la
 *    source de l'analyse restent exigés sur la page par scripts/check-compliance.mjs.
 * Contenu : src/content/fr/comparator.ts. Les taux de R Start viennent de facts.fees.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import Container from '@/components/ui/Container.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { comparator, comparatorScpis } from '@/content/fr/comparator';

interface Props {
  id: string;
}
const { id } = Astro.props as Props;
const titleId = id + '-title';
const selectId = id + '-select';
const { rows } = comparator;
/** Les SCPI vérifiées : celles qu'on n'a pas pu vérifier ne sont pas proposées (champ `unavailable`). */
const scpis = comparatorScpis;

/** Valeurs par SCPI, sérialisées pour le script : une seule source, aucun texte dupliqué dans le HTML. */
const data = scpis.map((s) => ({
  name: s.name,
  manager: s.manager,
  values: rows.map((r) => s.values?.[r.key] ?? null),
  details: rows.map((r) => s.details?.[r.key] ?? null),
  source: s.source ?? null,
  /** Source consultée : une case vide veut alors dire « non publié », et non « pas encore relevé ». */
  documentee: Boolean(s.source),
}));
---

<Section id={id} tone="white" labelledBy={titleId}>
  <Container size="wide">
    {
      /* Titre MASQUÉ VISUELLEMENT (12/09/2026, demande de l'équipe) : la page arrive directement sur le
        tableau. Il reste dans le code parce que la section a besoin d'un nom, sans lui, elle n'est plus
        annonçable au lecteur d'écran, et `labelledBy` pointerait dans le vide.
        L'introduction et l'hypothèse de lecture ont été retirées à la même occasion. L'hypothèse des huit
        ans n'est pas perdue : chaque taux de retrait porte sa condition juste en dessous, « au-delà de
        6 ans ; avant, 6,00 % TTC du capital retiré ». L'information est au plus près du chiffre. */
    }
    <h2 id={titleId} class="visually-hidden">{comparator.title}</h2>

    {
      /* Avertissement tant que les taux des autres SCPI ne sont pas relevés. Le script le masque dès que
        la SCPI choisie est complète. */
    }
    <div data-comparator-pending>
      <RiskNote text={comparator.pendingNotice} size="lead" />
    </div>

    {
      /* Défilement horizontal SOUS « sm » seulement. `overflow-x: auto` fait de l'enveloppe un conteneur
        de défilement sur LES DEUX axes : un en-tête collant s'y collerait à l'enveloppe, pas à l'écran,
        donc il ne bougerait jamais. Le tableau tient à partir de « sm ». */
    }
    <div class="mt-8 max-sm:overflow-x-auto sm:mt-10">
      <table data-comparator data-fee-block="comparateur-frais" class="w-full min-w-[34rem]">
        <caption class="visually-hidden">{comparator.title}</caption>
        <thead>
          <tr>
            <th
              scope="col"
              class="sticky top-[calc(var(--spacing-nav-total)+0.5rem)] z-10 w-[34%] bg-white p-0"
            >
              <span class="visually-hidden">Frais</span>
            </th>
            <th
              scope="col"
              class="sticky top-[calc(var(--spacing-nav-total)+0.5rem)] z-10 w-[33%] border-b border-navy/12 bg-white px-3 pb-5 align-bottom sm:px-5"
            >
              <Image
                src={brandLogo}
                alt={comparator.leftLabel}
                width={290}
                height={89}
                loading="eager"
                decoding="async"
                class="mx-auto h-8 w-auto sm:h-10"
              />
              <span class="mt-2 block text-sm font-normal text-slate-700">
                {comparator.leftManager}
              </span>
            </th>
            <th
              scope="col"
              class="sticky top-[calc(var(--spacing-nav-total)+0.5rem)] z-10 w-[33%] border-b border-navy/12 bg-white px-3 pb-5 align-bottom sm:px-5"
            >
              <label for={selectId} class="visually-hidden">{comparator.selectLabel}</label>
              <select
                id={selectId}
                data-comparator-select
                class="w-full rounded-2xl border border-navy/20 bg-white px-4 py-3 text-base font-semibold text-navy focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-navy"
              >
                {scpis.map((s, i) => <option value={String(i)}>{s.name}</option>)}
              </select>
              <span data-comparator-manager class="mt-2 block text-sm font-normal text-slate-700">
                {scpis[0]?.manager}
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, i) => (
              <tr class="border-t border-navy/12">
                <th scope="row" class="py-5 pr-3 text-left align-top font-medium text-ink sm:pr-5">
                  {row.label}
                  <span class="text-caption mt-1 block font-normal text-slate-700">
                    {row.basis}
                  </span>
                </th>
                <td class="px-3 py-5 text-center align-top sm:px-5">
                  <span data-fee-value class="text-display-sm text-navy">
                    {row.rstart}
                  </span>
                  <span data-comparator-best="left" class="visually-hidden" hidden>
                    {comparator.bestLabel}
                  </span>
                  {row.rstartDetail && (
                    <span class="text-caption mt-1 block text-slate-700">{row.rstartDetail}</span>
                  )}
                </td>
                <td class="px-3 py-5 text-center align-top sm:px-5">
                  <span data-comparator-cell={String(i)} class="text-display-sm text-slate-700">
                    {comparator.pendingLabel}
                  </span>
                  <span data-comparator-best="right" class="visually-hidden" hidden>
                    {comparator.bestLabel}
                  </span>
                  <span
                    data-comparator-detail={String(i)}
                    class="text-caption mt-1 block text-slate-700"
                  />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      /* Périmètre et sources : obligatoires dès qu'une autre SCPI est nommée. Ils disent ce qui est
        comparé, des taux affichés, pas des coûts réels, et d'où viennent les chiffres. */
    }
    <p class="text-lead mt-8 max-w-3xl text-ink">{comparator.perimeter}</p>

    <p class="text-caption mt-4 max-w-3xl text-slate-700">{comparator.notPublishedNotice}</p>

    <p class="text-caption mt-3 max-w-3xl text-slate-700">{comparator.vatNotice}</p>

    {
      /* Sources, une ligne par colonne. Celle de droite suit la SCPI choisie : chaque relevé a sa page et
        sa date, parce qu'un taux change et que la date fait foi. */
    }
    <div class="mt-6 max-w-3xl border-t border-navy/12 pt-5">
      <h3 class="text-base font-semibold text-ink">{comparator.sourceLabel}</h3>
      <dl class="text-caption mt-3 space-y-2 text-slate-700">
        <div class="flex flex-wrap gap-x-2">
          <dt class="font-semibold">
            {comparator.leftLabel} ,{' '}{comparator.sourceRStartLabel} :
          </dt>
          <dd>{comparator.sourceRStart}</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt data-comparator-source-name class="font-semibold">{scpis[0]?.name} :</dt>
          <dd data-comparator-source>{comparator.sourceOthers}</dd>
        </div>
      </dl>
    </div>

    {
      /* Encadré de la brochure (p.4) : un comparatif de frais ne part jamais sans lui, il dit que R Start
        n'est pas une SCPI sans frais et que son coût total n'est pas connu à la souscription. */
    }
    <div class="mt-8 rounded-3xl border border-navy/15 p-6 sm:p-8 lg:mt-10 lg:p-10">
      <h3 class="text-display-sm">{comparator.innovationBox.title}</h3>
      <p class="text-lead mt-4 text-ink">{comparator.innovationBox.body}</p>
    </div>
  </Container>
</Section>

<script
  is:inline
  define:vars={{
    data,
    pendingLabel: comparator.pendingLabel,
    notPublishedLabel: comparator.notPublishedLabel,
  }}
>
  /*
   * Changement de colonne sans rechargement. Les valeurs sont passées telles quelles : le script ne
   * calcule rien, il recopie. Une valeur absente reste le libellé « à compléter » et l'avertissement
   * reste affiché, c'est la seule règle métier ici.
   */
  (() => {
    const table = document.querySelector('[data-comparator]');
    const select = document.querySelector('[data-comparator-select]');
    if (!table || !select) return;
    const manager = table.querySelector('[data-comparator-manager]');
    const pending = document.querySelector('[data-comparator-pending]');
    const source = document.querySelector('[data-comparator-source]');
    const sourceName = document.querySelector('[data-comparator-source-name]');
    const cells = [...table.querySelectorAll('[data-comparator-cell]')];
    const details = [...table.querySelectorAll('[data-comparator-detail]')];
    const lignes = [...table.querySelectorAll('tbody tr')].map((tr) => ({
      gauche: tr.querySelector('[data-fee-value]'),
      marqueGauche: tr.querySelector('[data-comparator-best="left"]'),
      marqueDroite: tr.querySelector('[data-comparator-best="right"]'),
    }));
    const sourceFallback = source ? source.textContent : '';

    const render = () => {
      const scpi = data[Number(select.value)] || data[0];
      if (!scpi) return;
      if (manager) manager.textContent = scpi.manager;
      let missing = 0;
      cells.forEach((cell, i) => {
        const value = scpi.values[i];
        cell.textContent = value || (scpi.documentee ? notPublishedLabel : pendingLabel);
        cell.classList.toggle('text-navy', Boolean(value));
        cell.classList.toggle('text-slate-700', !value);
        if (!value && !scpi.documentee) missing += 1;
        const detail = details[i];
        if (detail) detail.textContent = (value && scpi.details[i]) || '';
      });
      if (pending) pending.hidden = missing === 0;
      if (sourceName) sourceName.textContent = scpi.name + ' :';
      if (source) source.textContent = scpi.source || sourceFallback;

      /*
       * Taux le plus bas de la ligne. Marqué SEULEMENT si les deux cases portent un pourcentage unique :
       * un barème à paliers (« 0 / 6 / 12 % ») ne se compare pas à un taux unique, et deux taux égaux ne
       * départagent rien. Hors de ces cas, aucune marque, mieux vaut ne rien dire que suggérer un
       * classement que les chiffres ne portent pas.
       */
      const seul = (t) => {
        if (!t) return null;
        /*
         * La case doit contenir UN taux et rien d'autre : « 14,40 % TTC » oui, « 0 / 6 / 12 % » non.
         * Chercher simplement un pourcentage ne suffisait pas, dans « 0 / 6 / 12 % », seul le dernier
         * nombre est suivi du signe, la valeur était donc lue comme un taux unique de 12 %.
         */
        const m = t.trim().match(/^(\d+(?:[,.]\d+)?)\s*%(?:\s*(?:TTC|HT))?$/);
        return m ? parseFloat(m[1].replace(',', '.')) : null;
      };
      lignes.forEach((ligne, i) => {
        const g = seul(ligne.gauche.textContent);
        const d = seul(scpi.values[i]);
        const comparable = g !== null && d !== null && g !== d;
        const gagneGauche = comparable && g < d;
        const gagneDroite = comparable && d < g;
        ligne.marqueGauche.hidden = !gagneGauche;
        ligne.marqueDroite.hidden = !gagneDroite;
        /*
         * Mise en avant par la COULEUR et la GRAISSE seulement : la taille reste identique d'une case à
         * l'autre, sans quoi un frais serait affiché plus petit que son voisin, ce que l'AMF refuse.
         * Le perdant est atténué, jamais effacé : il reste parfaitement lisible.
         */
        const peindre = (cell, gagne, perd) => {
          cell.classList.toggle('font-bold', gagne);
          cell.classList.toggle('text-teal-700', gagne);
          cell.classList.toggle('fee-halo', gagne);
          cell.classList.toggle('text-slate-600', perd);
          cell.classList.toggle('text-navy', !gagne && !perd);
        };
        peindre(ligne.gauche, gagneGauche, gagneDroite);
        const droite = cells[i];
        if (droite && scpi.values[i]) peindre(droite, gagneDroite, gagneGauche);
      });
    };

    select.addEventListener('change', render);
    render();
  })();
</script>
