---
/**
 * Comparateur de frais (11/09/2026) : R Start à gauche, une SCPI choisie dans une liste à droite,
 * sept lignes de frais. Le choix se fait sans rechargement : les valeurs de toutes les SCPI
 * voyagent dans le HTML, en bloc de données, et le script remplit la colonne demandée. SANS SCRIPT,
 * la colonne de droite reste à « À compléter » sur chaque ligne : seule la colonne R Start se lit.
 *
 * C'est un VRAI TABLEAU (<table>, en-têtes de colonne et de ligne) : une comparaison de frais se lit
 * aussi au lecteur d'écran, et la liste déroulante vit dans l'en-tête de la colonne qu'elle change.
 *
 * Conformité :
 *  - chaque taux porte `data-fee-value` dans un même `data-fee-block` : le contrôle vérifie qu'aucun
 *    frais n'est affiché plus petit que ses voisins (retour AMF sur la brochure) ;
 *  - une case sans valeur n'est jamais marquée « taux le plus bas » (les dix-neuf SCPI ont une
 *    source ; l'avertissement prévu quand des taux manquent a quitté le code le 22/09/2026) ;
 *  - les sources sont sous le tableau, en un paragraphe, R Start puis les autres SCPI ;
 *  - nommer une autre SCPI engage : scripts/check-compliance.mjs n'exige plus sur /frais que la
 *    source (data-comparator-source). Le périmètre et l'encadré « Une innovation, pas une
 *    révolution », retirés de l'écran le 14/09/2026, ne sont plus contrôlés ; textes archivés hors
 *    du dépôt (.claude/audits).
 * Contenu : src/content/fr/comparator.ts. Les taux de R Start viennent de facts.fees.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import Container from '@/components/ui/Container.astro';
import EssentialsBand from '@/components/ui/EssentialsBand.astro';
import Section from '@/components/ui/Section.astro';
import { comparator, comparatorScpis } from '@/content/fr/comparator';
import { arbitrageWarningBullets, arbitrageWarningTitle } from '@/content/fr/legal';
import { jsonScript } from '@/lib/jsonScript';
import { nb } from '@/lib/texte';

interface Props {
  id: string;
  /**
   * Titre VISIBLE, et introduction sous lui. Absents : le titre reste hors écran, comme sur /frais,
   * dont l'en-tête dit déjà de quoi il s'agit. L'accueil, lui, arrive sans contexte sur un tableau
   * de chiffres et a besoin des deux.
   */
  heading?: string;
  intro?: string;
  /** Premier plan (ui/Section.astro `plan`, 24/09/2026) sur /frais, où la section suit l'en-tête
      sombre ; rien sur l'accueil, où elle suit les points forts, clairs. */
  plan?: 'haut';
}
const { id, heading, intro, plan } = Astro.props as Props;
/** Le nombre derrière « 12 % », pour la seule teinte des segments de la frise. */
const tauxDe = (rate: string): number => parseFloat(rate.replace(',', '.')) || 0;
const tauxMax = (tiers: readonly { rate: string }[]): number =>
  Math.max(...tiers.map((t) => tauxDe(t.rate)), 1);
/**
 * La condition d'un palier en DEUX LIGNES dans la frise (25/09/2026, Martin : « Si plus-value
 * < 7 % sur deux lignes aussi »), coupée avant son dernier signe de comparaison : « Si plus-value »
 * puis « < 7 % », « Si 7 % < plus-value » puis « < 13 % », « Si sortie » puis « > 8 ans ». Le texte
 * ne change pas, seule la coupe est imposée ; sans signe, une seule ligne.
 */
const couper = (when: string): [string, string | null] => {
  const i = Math.max(when.lastIndexOf(' < '), when.lastIndexOf(' > '));
  return i < 0 ? [when, null] : [when.slice(0, i), when.slice(i + 1)];
};
const titleId = id + '-title';
const selectId = id + '-select';
const { rows } = comparator;
/** Les SCPI vérifiées : celles qu'on n'a pas pu vérifier ne sont pas proposées (champ `unavailable`). */
const scpis = comparatorScpis;

/** Valeurs par SCPI, sérialisées pour le script : une seule source, aucun texte dupliqué dans le HTML. */
const data = scpis.map((s) => ({
  name: s.name,
  manager: s.manager,
  /* `nb` : espace insécable avant « % » et « ans », sinon le signe passe seul à la ligne sur
     téléphone (« si la plus-value dépasse 5 / % »). */
  values: rows.map((r) => (s.values?.[r.key] ? nb(s.values[r.key] as string) : null)),
  details: rows.map((r) => (s.details?.[r.key] ? nb(s.details[r.key] as string) : null)),
  /** Source consultée : une case vide veut alors dire « non publié », et non « pas encore relevé ». */
  documentee: Boolean(s.source),
}));
---

<Section id={id} tone="white" labelledBy={titleId} plan={plan} class="pt-8 sm:pt-10 lg:pt-14">
  <Container size="wide">
    {
      /* Un seul H2 : le même titre de section, visible ou non. Avec `heading`, c'est le texte de
        l'appelant qui s'affiche et `comparator.title`, plus descriptif, reste la légende du
        tableau. Sans lui, le titre reste dans le HTML hors écran (il nomme la section et le
        tableau, et il est descriptif, pas promotionnel) : la page arrive directement sur le
        tableau, son en-tête portant déjà « Comparateur de frais SCPI ». L'hypothèse de durée n'est
        pas rappelée ici : chaque taux de retrait porte sa condition juste en dessous, au plus près
        du chiffre. */
    }
    {heading ? (
      <header class="max-w-4xl">
        <h2 id={titleId} class="text-display-md text-ink" data-animate="fade-up">
          {heading}
        </h2>
        {intro && <p class="text-lead mt-5 text-pretty text-slate-700">{intro}</p>}
      </header>
    ) : (
      <>
        <h2 id={titleId} class="visually-hidden">{comparator.title}</h2>
        {intro && <p class="text-lead max-w-4xl text-pretty text-slate-700">{intro}</p>}
      </>
    )}

    {
      /* AUCUNE enveloppe à défilement : sous « sm », elle envoyait la colonne de la SCPI comparée
        et sa liste déroulante hors de l'écran, le comparateur ne comparait plus rien. Sous 48 rem
        le tableau se lit en cartes (règles dans global.css), au-dessus il tient en entier dans le
        conteneur. `overflow-x: auto` aurait de toute façon empêché les en-têtes de se coller à
        l'écran : un conteneur de défilement retient ses enfants collants. Les RÔLES sont posés à la
        main : `display: block` efface la sémantique de tableau, et sans elle le lecteur d'écran
        énoncerait quatorze taux sans jamais dire de quelle SCPI ils viennent. */
    }
    <div class="mt-6 sm:mt-10">
      <table role="table" data-comparator data-fee-block="comparateur-frais" class="w-full">
        <caption class="visually-hidden">{comparator.title}</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col" class="w-[34%] p-0">
              <span class="visually-hidden">{comparator.feeColumnLabel}</span>
            </th>
            {
              /* COLLÉ À LA BARRE (25/09/2026, Martin) : la barre flottante se contracte au défilement
                par `scale(0.95)` depuis son bord haut (global.css, `[data-stuck]`), son bas visible
                remonte donc de 5 % de sa hauteur ; l'en-tête se colle à ce bas visible et non à sa
                boîte, sinon une bande de page défilait entre les deux. En mouvement réduit, la barre
                ne se contracte pas et l'en-tête passe 3 px sous elle, sans que rien ne se voie. */
            }
            <th
              role="columnheader"
              scope="col"
              class="sticky top-[calc(var(--spacing-nav-gap)+var(--spacing-subnav)*0.95)] z-10 w-[33%] border-b border-navy/12 bg-white px-3 pb-3 align-bottom sm:px-5 md:pb-5"
            >
              {
                /* Le logo prend la hauteur de la colonne de droite, intitulé plus liste déroulante : les
                  deux en-têtes pèsent alors pareil, au lieu d'un logo timide face à un bloc deux fois
                  plus haut. Sa proportion est conservée, seule la hauteur change. */
              }
              <Image
                src={brandLogo}
                alt={comparator.leftLabel}
                width={290}
                height={89}
                loading="eager"
                decoding="async"
                class="mx-auto h-12 w-auto sm:h-14 md:h-[3.75rem]"
              />
            </th>
            <th
              role="columnheader"
              scope="col"
              class="sticky top-[calc(var(--spacing-nav-gap)+var(--spacing-subnav)*0.95)] z-10 w-[33%] border-b border-navy/12 bg-white px-3 pb-3 align-bottom sm:px-5 md:pb-5"
            >
              {
                /* Intitulé VISIBLE : il nomme ce que la colonne oppose à R Start, là où « SCPI à
                  comparer » ne disait ni laquelle ni pourquoi. Il reste un <label> lié au champ, il sert
                  donc toujours de nom accessible à la liste déroulante. */
              }
              <label
                for={selectId}
                class="mb-2 block text-sm font-medium text-balance text-slate-700"
              >
                {comparator.selectLabel}
              </label>
              <select
                id={selectId}
                data-comparator-select
                class="w-full rounded-2xl border border-navy/20 bg-white px-3 py-2.5 text-base font-semibold text-navy focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-navy sm:px-4 sm:py-3"
              >
                {scpis.map((s, i) => <option value={String(i)}>{s.name}</option>)}
              </select>
            </th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            rows.map((row, i) => (
              <tr role="row" class="border-t border-navy/12">
                <th
                  role="rowheader"
                  scope="row"
                  class="py-5 pr-3 text-left align-top font-medium text-ink sm:pr-5"
                >
                  {
                    /* EXPLICATION DÉPLIABLE : `basis` ne dit que l'assiette de calcul,
                      l'explication dit ce que le frais recouvre et qui le paie. Repliée derrière un
                      bouton, le tableau se lit d'abord en chiffres. Même module que les repères de
                      l'accueil (src/scripts/infoToggle.ts). */
                  }
                  <span class="flex items-start gap-2">
                    <span>{row.label}</span>
                    {row.info && (
                      <button
                        type="button"
                        data-info-bouton
                        hidden
                        aria-expanded="false"
                        aria-controls={'info-frais-' + i}
                        class="info-bouton mt-0.5"
                      >
                        <span aria-hidden="true">i</span>
                        <span class="visually-hidden">
                          {comparator.infoLabel} : {row.label}
                        </span>
                      </button>
                    )}
                  </span>
                  <span class="text-caption mt-1 block font-normal text-slate-700">
                    {row.basis}
                  </span>
                  {row.info && (
                    <div id={'info-frais-' + i} class="info-panneau">
                      <p class="text-caption font-normal text-slate-700">{row.info}</p>
                    </div>
                  )}
                </th>
                <td role="cell" class="px-3 py-5 text-center align-top sm:px-5">
                  {
                    /* Un taux unique, ou un BARÈME À PALIERS EN FRISE (25/09/2026, proposition
                      retenue par Martin parmi dix essayées ; ex-grille à deux colonnes du
                      22/09/2026) : les paliers côte à côte, le taux au-dessus, un segment de
                      couleur, la condition dessous ; la teinte du segment s'assombrit avec le taux
                      affiché, rien d'autre n'est proportionné. Sous `lg`, la case est trop étroite
                      pour cinq paliers : la frise redevient une liste, taux à gauche et condition
                      à côté (les `li` en `contents`, le segment masqué). `data-fee-value` (un
                      <div> : une liste ne peut pas vivre dans un <span>) enveloppe le barème
                      entier : c'est l'élément dont le contrôle de taille lit le corps
                      (text-display-sm, le même que les autres taux, hérité par chaque taux de la
                      frise), et son texte n'est pas un taux unique, donc jamais comparé (voir le
                      script). */
                  }
                  {row.rstartTiers ? (
                    <div data-fee-value class="text-display-sm w-full text-navy">
                      <ol class="grid grid-cols-[auto_1fr] items-baseline gap-x-2 gap-y-1 text-left lg:flex lg:items-stretch lg:gap-1 lg:text-center">
                        {row.rstartTiers.map((tier) => (
                          <li class="contents lg:flex lg:flex-1 lg:flex-col lg:items-center">
                            <span>{tier.rate}</span>
                            <span
                              aria-hidden="true"
                              class="segment hidden h-1.5 w-full lg:mt-1.5 lg:block"
                              style={`background: color-mix(in srgb, var(--color-navy) ${20 + (80 * tauxDe(tier.rate)) / tauxMax(row.rstartTiers!)}%, var(--color-teal-100))`}
                            />
                            <span class="text-caption font-normal text-slate-700 lg:mt-1.5 lg:px-0.5 lg:leading-tight">
                              {couper(tier.when)[0]}
                              {couper(tier.when)[1] && <span class="lg:block"> {couper(tier.when)[1]}</span>}
                            </span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  ) : (
                    <span data-fee-value class="text-display-sm text-navy">
                      {row.rstart}
                    </span>
                  )}
                  <span data-comparator-best="left" class="visually-hidden" hidden>
                    {comparator.bestLabel}
                  </span>
                </td>
                <td role="cell" class="px-3 py-5 text-center align-top sm:px-5">
                  {row.rstartTiers ? (
                    <>
                      {/* CENTRÉ (24/09/2026, Martin : « centre tous les chiffres des concurrents frais de vente
                        d'immeubles et frais de sortie anticipée ») : le taux du concurrent puis son
                        détail l'un sous l'autre, au centre de la case comme sur les autres lignes ;
                        la grille alignée sur celle de R Start (22/09/2026) est abandonnée. */}
                      <span data-comparator-cell={String(i)} class="text-display-sm text-slate-700">
                        {comparator.pendingLabel}
                      </span>
                      <span
                        data-comparator-detail={String(i)}
                        class="text-caption mx-auto mt-1 block max-w-[16rem] text-slate-700 empty:hidden"
                      />
                      <span data-comparator-best="right" class="visually-hidden" hidden>
                        {comparator.bestLabel}
                      </span>
                    </>
                  ) : (
                    <>
                      <span data-comparator-cell={String(i)} class="text-display-sm text-slate-700">
                        {comparator.pendingLabel}
                      </span>
                      <span data-comparator-best="right" class="visually-hidden" hidden>
                        {comparator.bestLabel}
                      </span>
                      {/* Même écart qu'à gauche, pour la même raison : la pastille peut être de ce côté. */}
                      <span
                        data-comparator-detail={String(i)}
                        class="text-caption mt-3 block text-slate-700"
                      />
                    </>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      /* RETIRÉS le 14/09/2026 (texte de la page fourni par l'équipe, « je veux ce contenu là ») :
        le paragraphe de périmètre, les deux avertissements courts (frais non publié, base HT/TTC)
        et l'encadré « Une innovation, pas une révolution », seul endroit du site à écrire que R
        Start n'est pas une SCPI sans frais, ni moins chère qu'une SCPI traditionnelle, et que le
        coût total n'est pas connu à la souscription. Sortis du code le 22/09/2026, archivés hors du
        dépôt (.claude/audits). LES SOURCES RESTENT, juste en dessous : nommer des sociétés de
        gestion et afficher leurs taux sans dire d'où ils sortent ni à quelle date serait une
        comparaison invérifiable. */
    }

    {
      /* SOUS LE TABLEAU (22/09/2026, textes de Martin) : la base HT de tous les taux, puis les sources
        en un paragraphe, R Start d'abord, les autres SCPI ensuite. La source des autres SCPI est la
        même pour les dix-neuf, le paragraphe ne change donc pas avec la SCPI choisie ; il porte
        `data-comparator-source`, que scripts/check-compliance.mjs exige dès qu'une SCPI du panel est
        nommée. */
    }
    <div class="text-caption mt-4 space-y-3 text-slate-700">
      <p>{comparator.htNote}</p>
      <p data-comparator-source>
        <strong class="font-semibold text-ink">{comparator.sourceLabel} :</strong>{' '}
        {comparator.sourceText}
      </p>
    </div>

  </Container>
</Section>

{
  /* POINTS ESSENTIELS À CONNAÎTRE (22/09/2026, demande de Martin) : l'avertissement sur la
    commission d'arbitrage, texte réglementaire reproduit à l'identique depuis legal.ts (le même que
    sur /documentation), puis le mécanisme de réserve en cas de moins-value (texte de Martin), dans
    le bandeau pleine largeur commun avec l'accueil. Son ancre suit celle du comparateur : la page
    d'accueil porte déjà un bandeau du même nom. */
}
<EssentialsBand id={id + '-essentiels'} title={comparator.essentialsTitle}>
  <p>{arbitrageWarningTitle}</p>
  <ul role="list" class="mt-2 space-y-1">
    {
      arbitrageWarningBullets.map((puce) => (
        <li class="flex gap-3">
          <span aria-hidden="true">•</span>
          <span>{puce}</span>
        </li>
      ))
    }
  </ul>
  <p class="mt-3">
    <strong class="font-semibold">{comparator.lossNote.title}</strong>
    <br />
    {comparator.lossNote.text}
  </p>
</EssentialsBand>

{
  /* Réglages dans un bloc de DONNÉES, non exécutable : la politique de sécurité du contenu
  ne le soumet pas à `script-src`, il voyage donc sans nonce. Le script qui suit n'est plus
  « en ligne » : Astro le sort dans un fichier, que `script-src 'self'` autorise. */
}
<script
  type="application/json"
  data-reglages="comparateur"
  is:inline
  set:html={jsonScript({
    data,
    pendingLabel: comparator.pendingLabel,
    notPublishedLabel: comparator.notPublishedLabel,
  })}
/>

<script>
  /*
   * Changement de colonne sans rechargement. Les valeurs sont passées telles quelles : le script
   * les recopie, et ne calcule que la mise en avant du taux le plus bas de chaque ligne (règle plus
   * bas). Une valeur absente affiche « à compléter » ; si la SCPI a une source, elle affiche
   * « non publié ».
   */
  (() => {
    /* Ce que le gabarit sérialise plus haut (`data`, dans l'en-tête du composant). `JSON.parse` rend
       `any` : sans ce type, la règle du « taux le plus bas » n'était vérifiée par personne. */
    interface Reglages {
      data: {
        name: string;
        manager: string;
        values: (string | null)[];
        details: (string | null)[];
        documentee: boolean;
      }[];
      pendingLabel: string;
      notPublishedLabel: string;
    }
    const bloc = document.querySelector('[data-reglages="comparateur"]');
    if (!bloc?.textContent) return;
    const { data, pendingLabel, notPublishedLabel } = JSON.parse(bloc.textContent) as Reglages;
    const table = document.querySelector('[data-comparator]');
    const select = document.querySelector<HTMLSelectElement>('[data-comparator-select]');
    if (!table || !select) return;
    const cells = [...table.querySelectorAll<HTMLElement>('[data-comparator-cell]')];
    const details = [...table.querySelectorAll('[data-comparator-detail]')];
    const lignes = [...table.querySelectorAll('tbody tr')].map((tr) => ({
      gauche: tr.querySelector<HTMLElement>('[data-fee-value]'),
      marqueGauche: tr.querySelector<HTMLElement>('[data-comparator-best="left"]'),
      marqueDroite: tr.querySelector<HTMLElement>('[data-comparator-best="right"]'),
    }));

    const render = () => {
      const scpi = data[Number(select.value)] || data[0];
      if (!scpi) return;
      cells.forEach((cell, i) => {
        const value = scpi.values[i];
        cell.textContent = value || (scpi.documentee ? notPublishedLabel : pendingLabel);
        cell.classList.toggle('text-navy', Boolean(value));
        cell.classList.toggle('text-slate-700', !value);
        const detail = details[i];
        if (detail) detail.textContent = (value && scpi.details[i]) || '';
      });

      /*
       * Taux le plus bas de la ligne. Il faut que LES DEUX cases donnent un pourcentage unique : un
       * barème à paliers (vente d'immeubles, sortie anticipée) ne se compare jamais (22/09/2026,
       * demande de Martin), son texte n'étant pas un taux unique. LA RÈGLE (24/09/2026, Martin :
       * « si c'est égal, c'est mis en valeur aussi », qui généralise celle du 16/09/2026 sur le
       * zéro partagé) : EST MARQUÉ LE PLUS BAS DES DEUX, ET LES DEUX QUAND ILS SONT ÉGAUX. Le
       * libellé lu par les lecteurs d'écran dit « taux le plus bas de la ligne », il serait inexact
       * de le réserver à une colonne quand les deux portent le même taux.
       */
      const seul = (t: string | null | undefined) => {
        if (!t) return null;
        /*
         * La case doit contenir UN taux et rien d'autre : « 14,40 % TTC » oui, « 0 / 6 / 12 % » non.
         * Chercher simplement un pourcentage ne suffisait pas, dans « 0 / 6 / 12 % », seul le dernier
         * nombre est suivi du signe, la valeur était donc lue comme un taux unique de 12 %.
         */
        const m = t.trim().match(/^(\d+(?:[,.]\d+)?)\s*%(?:\s*(?:TTC|HT))?$/);
        return m?.[1] ? parseFloat(m[1].replace(',', '.')) : null;
      };
      lignes.forEach((ligne, i) => {
        const g = seul(ligne.gauche?.textContent);
        const d = seul(scpi.values[i]);
        const comparable = g !== null && d !== null;
        const gagneGauche = comparable && g <= d;
        const gagneDroite = comparable && d <= g;
        if (ligne.marqueGauche) ligne.marqueGauche.hidden = !gagneGauche;
        if (ligne.marqueDroite) ligne.marqueDroite.hidden = !gagneDroite;
        /*
         * Mise en avant par la COULEUR et la GRAISSE seulement : la taille reste identique d'une
         * case à l'autre, sans quoi un frais serait affiché plus petit que son voisin, ce que l'AMF
         * refuse. Le perdant est atténué, jamais effacé : il reste parfaitement lisible. Le gagnant
         * porte une PASTILLE PLEINE (`fee-gagnant`), texte blanc sur navy, contraste relevé à
         * 9,52:1.
         */
        const peindre = (cell: Element | null | undefined, gagne: boolean, perd: boolean) => {
          if (!cell) return;
          cell.classList.toggle('font-bold', gagne);
          cell.classList.toggle('text-white', gagne);
          cell.classList.toggle('fee-gagnant', gagne);
          cell.classList.toggle('text-slate-600', perd);
          cell.classList.toggle('text-navy', !gagne && !perd);
        };
        peindre(ligne.gauche, gagneGauche, gagneDroite);
        /*
         * LA CASE DE DROITE EST REPEINTE À CHAQUE FOIS, VIDE OU NON (audit du 18/09/2026) : sinon,
         * en passant d'une SCPI qui GAGNAIT la ligne à une SCPI sans valeur, la case gardait la
         * pastille du gagnant autour de « non publié », un faux « taux le plus bas » sur un
         * comparatif qui nomme des concurrents. Latent tant que les dix-neuf SCPI ont leurs sept
         * valeurs. Sans valeur, `comparable` est faux, les deux drapeaux aussi, la pastille tombe ;
         * la case vide reprend ensuite l'ardoise de la boucle du dessus, `peindre` la rendrait
         * navy.
         */
        const droite = cells[i];
        peindre(droite, gagneDroite, gagneGauche);
        if (droite && !scpi.values[i]) {
          droite.classList.remove('text-navy');
          droite.classList.add('text-slate-700');
        }
      });
    };

    select.addEventListener('change', render);
    render();
  })();
</script>

