---
/**
 * Comparateur de frais (11/09/2026) : R Start à gauche, une SCPI choisie dans une liste à droite, sept
 * lignes de frais. Le choix se fait sans rechargement, toutes les valeurs sont dans le HTML, le script
 * ne fait qu'afficher la colonne demandée. Sans script, la première SCPI reste affichée : le tableau est
 * complet et lisible.
 *
 * C'est un VRAI TABLEAU (<table>, en-têtes de colonne et de ligne) : une comparaison de frais se lit
 * aussi au lecteur d'écran, et la liste déroulante vit dans l'en-tête de la colonne qu'elle change.
 *
 * Conformité :
 *  - chaque taux porte `data-fee-value` dans un même `data-fee-block` : le contrôle vérifie qu'aucun
 *    frais n'est affiché plus petit que ses voisins (retour AMF sur la brochure) ;
 *  - tant qu'une valeur manque, un avertissement le dit en toutes lettres au-dessus du tableau, et le
 *    tableau ne prétend rien comparer ;
 *  - les sources sont sous le tableau, celle de R Start et celle, à venir, des autres SCPI ;
 *  - nommer une autre SCPI engage : le périmètre, l'encadré « Une innovation, pas une révolution » et la
 *    source de l'analyse restent exigés sur la page par scripts/check-compliance.mjs.
 * Contenu : src/content/fr/comparator.ts. Les taux de R Start viennent de facts.fees.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import Container from '@/components/ui/Container.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import { comparator, comparatorScpis } from '@/content/fr/comparator';
import { jsonScript } from '@/lib/jsonScript';

interface Props {
  id: string;
  /**
   * Titre VISIBLE, et introduction sous lui (16/09/2026). Absents : le titre reste hors écran, comme
   * sur /frais, dont l'en-tête dit déjà de quoi il s'agit. L'accueil, lui, arrive sans contexte sur un
   * tableau de chiffres et a besoin des deux.
   */
  heading?: string;
  intro?: string;
}
const { id, heading, intro } = Astro.props as Props;
const titleId = id + '-title';
const selectId = id + '-select';
const { rows } = comparator;
/** Les SCPI vérifiées : celles qu'on n'a pas pu vérifier ne sont pas proposées (champ `unavailable`). */
const scpis = comparatorScpis;

/** Valeurs par SCPI, sérialisées pour le script : une seule source, aucun texte dupliqué dans le HTML. */
const data = scpis.map((s) => ({
  name: s.name,
  manager: s.manager,
  values: rows.map((r) => s.values?.[r.key] ?? null),
  details: rows.map((r) => s.details?.[r.key] ?? null),
  source: s.source ?? null,
  /** Source consultée : une case vide veut alors dire « non publié », et non « pas encore relevé ». */
  documentee: Boolean(s.source),
}));
---

<Section id={id} tone="white" labelledBy={titleId} class="pt-8 sm:pt-10 lg:pt-14">
  <Container size="wide">
    {
      /* Titre de nouveau VISIBLE (14/09/2026, texte fourni par l'équipe). Il était masqué depuis le
        12/09/2026 pour que la page arrive directement sur le tableau ; la phrase fournie est une
        promesse, pas un intitulé de rubrique, elle se lit. L'accroche qui suit invite à comparer.
        L'hypothèse des huit ans n'est toujours pas rappelée ici : chaque taux de retrait porte sa
        condition juste en dessous, « au-delà de 6 ans ; avant, 6,00 % TTC du capital retiré ».
        L'information est au plus près du chiffre. */
    }
    {
      /* Le titre est HORS ÉCRAN depuis le 16/09/2026 : la page arrive directement sur le tableau, son
        en-tête portant déjà « Comparateur de frais SCPI ». Il reste dans le HTML parce qu'il nomme la
        section et le tableau, et il est descriptif, pas promotionnel (voir comparator.ts). */
    }
    {
      /* Un seul H2 dans les deux cas : c'est le même titre de section, il est seulement visible ou non.
        Quand il est visible, c'est le texte de l'appelant qui s'affiche, et `comparator.title`, plus
        descriptif, reste la légende du tableau. */
    }
    {heading ? (
      <header class="max-w-4xl">
        <h2 id={titleId} class="text-display-md text-ink" data-animate="fade-up">
          {heading}
        </h2>
        {intro && <p class="text-lead mt-5 text-pretty text-slate-700">{intro}</p>}
      </header>
    ) : (
      <>
        <h2 id={titleId} class="visually-hidden">{comparator.title}</h2>
        {intro && <p class="text-lead max-w-4xl text-pretty text-slate-700">{intro}</p>}
      </>
    )}

    {
      /* Avertissement tant que les taux des autres SCPI ne sont pas relevés. Le script le masque dès que
        la SCPI choisie est complète. */
    }
    <div data-comparator-pending>
      <RiskNote text={comparator.pendingNotice} size="lead" />
    </div>

    {
      /* AUCUNE enveloppe à défilement (12/09/2026). Il y en avait une sous « sm » et elle coûtait cher :
        sur un téléphone, la colonne de la SCPI comparée et sa liste déroulante tombaient hors de l'écran,
        le comparateur ne comparait plus rien. Sous 48 rem le tableau se lit maintenant en cartes (règles
        dans global.css), au-dessus il tient en entier dans le conteneur. Au passage, `overflow-x: auto`
        aurait de toute façon empêché les en-têtes de se coller à l'écran : un conteneur de défilement
        retient ses enfants collants.

        Les RÔLES sont posés à la main : `display: block` efface la sémantique de tableau, et sans elle le
        lecteur d'écran énoncerait quatorze taux sans jamais dire de quelle SCPI ils viennent. */
    }
    <div class="mt-6 sm:mt-10">
      <table role="table" data-comparator data-fee-block="comparateur-frais" class="w-full">
        <caption class="visually-hidden">{comparator.title}</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col" class="w-[34%] p-0">
              <span class="visually-hidden">{comparator.feeColumnLabel}</span>
            </th>
            <th
              role="columnheader"
              scope="col"
              class="sticky top-nav-total z-10 w-[33%] border-b border-navy/12 bg-white px-3 pb-3 align-bottom sm:px-5 md:pb-5"
            >
              {
                /* Le logo prend la hauteur de la colonne de droite, intitulé plus liste déroulante : les
                  deux en-têtes pèsent alors pareil, au lieu d'un logo timide face à un bloc deux fois
                  plus haut. Sa proportion est conservée, seule la hauteur change. */
              }
              <Image
                src={brandLogo}
                alt={comparator.leftLabel}
                width={290}
                height={89}
                loading="eager"
                decoding="async"
                class="mx-auto h-12 w-auto sm:h-14 md:h-[3.75rem]"
              />
            </th>
            <th
              role="columnheader"
              scope="col"
              class="sticky top-nav-total z-10 w-[33%] border-b border-navy/12 bg-white px-3 pb-3 align-bottom sm:px-5 md:pb-5"
            >
              {
                /* Intitulé VISIBLE : il nomme ce que la colonne oppose à R Start, là où « SCPI à
                  comparer » ne disait ni laquelle ni pourquoi. Il reste un <label> lié au champ, il sert
                  donc toujours de nom accessible à la liste déroulante. */
              }
              <label
                for={selectId}
                class="mb-2 block text-sm font-medium text-balance text-slate-700"
              >
                {comparator.selectLabel}
              </label>
              <select
                id={selectId}
                data-comparator-select
                class="w-full rounded-2xl border border-navy/20 bg-white px-3 py-2.5 text-base font-semibold text-navy focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-navy sm:px-4 sm:py-3"
              >
                {scpis.map((s, i) => <option value={String(i)}>{s.name}</option>)}
              </select>
            </th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            rows.map((row, i) => (
              <tr role="row" class="border-t border-navy/12">
                <th
                  role="rowheader"
                  scope="row"
                  class="py-5 pr-3 text-left align-top font-medium text-ink sm:pr-5"
                >
                  {
                    /* EXPLICATION DÉPLIABLE (16/09/2026) : `basis` ne dit que l'assiette de calcul,
                      l'explication dit ce que le frais recouvre et qui le paie. Repliée derrière un
                      bouton, le tableau se lit d'abord en chiffres. Même mécanique que les repères de
                      l'accueil, même module (src/scripts/infoToggle.ts). */
                  }
                  <span class="flex items-start gap-2">
                    <span>{row.label}</span>
                    {row.info && (
                      <button
                        type="button"
                        data-info-bouton
                        hidden
                        aria-expanded="false"
                        aria-controls={'info-frais-' + i}
                        class="info-bouton mt-0.5"
                      >
                        <span aria-hidden="true">i</span>
                        <span class="visually-hidden">
                          {comparator.infoLabel} : {row.label}
                        </span>
                      </button>
                    )}
                  </span>
                  <span class="text-caption mt-1 block font-normal text-slate-700">
                    {row.basis}
                  </span>
                  {row.info && (
                    <div id={'info-frais-' + i} data-info-panneau class="info-panneau">
                      <p class="text-caption font-normal text-slate-700">{row.info}</p>
                    </div>
                  )}
                </th>
                <td role="cell" class="px-3 py-5 text-center align-top sm:px-5">
                  {
                    /* `data-fee-compare` : ce qu'il faut COMPARER quand ce n'est pas ce qui est AFFICHÉ.
                      La ligne du retrait montre une fourchette (« de 0 % à 10 % ») mais se compare sur
                      le taux au-delà de la durée retenue, l'hypothèse de lecture du tableau. Sans lui,
                      la case cesserait d'être comparable : un intervalle ne se départage pas d'un taux
                      unique. Les autres lignes n'en portent pas, affiché et comparé s'y confondent. */
                  }
                  <span
                    data-fee-value
                    data-fee-compare={row.rstartCompare}
                    class="text-display-sm text-navy"
                  >
                    {row.rstart}
                  </span>
                  <span data-comparator-best="left" class="visually-hidden" hidden>
                    {comparator.bestLabel}
                  </span>
                  {
                    /* `mt-3` et non `mt-1` : la pastille du gagnant déborde de 0,3 em SOUS la ligne de
                      base du chiffre, et le détail venait s'y coller. Les quatre pixels d'origine
                      suffisaient sous un halo diffus, plus sous un fond plein. */
                  }
                  {
                    /* Un barème se lit UNE LIGNE PAR PALIER (16/09/2026) : une vraie liste, et non des
                      retours forcés dans un texte, pour qu'un lecteur d'écran annonce « cinq éléments »
                      et les énumère un par un. `role="list"` rétablit la sémantique que la remise à
                      zéro des puces efface. */
                  }
                  {Array.isArray(row.rstartDetail) ? (
                    <ul role="list" class="text-caption mt-3 space-y-1 text-slate-700">
                      {row.rstartDetail.map((ligne) => (
                        <li>{ligne}</li>
                      ))}
                    </ul>
                  ) : (
                    row.rstartDetail && (
                      <span class="text-caption mt-3 block text-slate-700">{row.rstartDetail}</span>
                    )
                  )}
                </td>
                <td role="cell" class="px-3 py-5 text-center align-top sm:px-5">
                  <span data-comparator-cell={String(i)} class="text-display-sm text-slate-700">
                    {comparator.pendingLabel}
                  </span>
                  <span data-comparator-best="right" class="visually-hidden" hidden>
                    {comparator.bestLabel}
                  </span>
                  {/* Même écart qu'à gauche, pour la même raison : la pastille peut être de ce côté. */}
                  <span
                    data-comparator-detail={String(i)}
                    class="text-caption mt-3 block text-slate-700"
                  />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      /* RETIRÉS le 14/09/2026 (texte de la page fourni par l'équipe, « je veux ce contenu là ») : le
        paragraphe de périmètre (« Ce tableau compare les taux affichés… »), les deux avertissements
        courts (frais non publié, base HT/TTC) et l'encadré « Une innovation, pas une révolution ».
        Ce dernier était le seul endroit du site à écrire que R Start n'est pas une SCPI sans frais, ni
        moins chère qu'une SCPI traditionnelle, et que le coût total n'est pas connu à la souscription.
        Les textes restent dans comparator.ts, prêts à revenir en une ligne.
        LES SOURCES RESTENT, juste en dessous : nommer dix-sept sociétés de gestion et afficher leurs
        taux sans dire d'où ils sortent ni à quelle date serait une comparaison invérifiable. */
    }

    {
      /* Sources, une par colonne du tableau, côte à côte comme les colonnes qu'elles documentent. Celle
        de droite suit la SCPI choisie : chaque relevé a sa page et sa date, parce qu'un taux change et
        que la date fait foi. */
    }
    <div class="mt-6 border-t border-navy/12 pt-5">
      <h3 class="text-base font-semibold text-ink">{comparator.sourceLabel}</h3>
      <dl class="text-caption mt-3 grid gap-3 text-slate-700 md:grid-cols-2 md:gap-8">
        <div>
          <dt class="font-semibold">
            {comparator.leftLabel} ,{' '}{comparator.sourceRStartLabel} :
          </dt>
          <dd class="mt-0.5">{comparator.sourceRStart}</dd>
        </div>
        <div>
          <dt data-comparator-source-name class="font-semibold">{scpis[0]?.name} :</dt>
          <dd data-comparator-source class="mt-0.5">{comparator.sourceOthers}</dd>
        </div>
      </dl>
    </div>
  </Container>
</Section>

{
  /* Réglages dans un bloc de DONNÉES, non exécutable : la politique de sécurité du contenu
  ne le soumet pas à `script-src`, il voyage donc sans nonce. Le script qui suit n'est plus
  « en ligne » : Astro le sort dans un fichier, que `script-src 'self'` autorise. */
}
<script
  type="application/json"
  data-reglages="comparateur"
  is:inline
  set:html={jsonScript({
    data,
    pendingLabel: comparator.pendingLabel,
    notPublishedLabel: comparator.notPublishedLabel,
  })}
/>

<script>
  /*
   * Changement de colonne sans rechargement. Les valeurs sont passées telles quelles : le script ne
   * calcule rien, il recopie. Une valeur absente reste le libellé « à compléter » et l'avertissement
   * reste affiché, c'est la seule règle métier ici.
   */
  (() => {
    const bloc = document.querySelector('[data-reglages="comparateur"]');
    if (!bloc?.textContent) return;
    const reglages = JSON.parse(bloc.textContent);
    const { data, pendingLabel, notPublishedLabel } = reglages;
    const table = document.querySelector('[data-comparator]');
    const select = document.querySelector<HTMLSelectElement>('[data-comparator-select]');
    if (!table || !select) return;
    const pending = document.querySelector<HTMLElement>('[data-comparator-pending]');
    const source = document.querySelector('[data-comparator-source]');
    const sourceName = document.querySelector('[data-comparator-source-name]');
    const cells = [...table.querySelectorAll<HTMLElement>('[data-comparator-cell]')];
    const details = [...table.querySelectorAll('[data-comparator-detail]')];
    const lignes = [...table.querySelectorAll('tbody tr')].map((tr) => ({
      gauche: tr.querySelector<HTMLElement>('[data-fee-value]'),
      marqueGauche: tr.querySelector<HTMLElement>('[data-comparator-best="left"]'),
      marqueDroite: tr.querySelector<HTMLElement>('[data-comparator-best="right"]'),
    }));
    const sourceFallback = source ? source.textContent : '';

    const render = () => {
      const scpi = data[Number(select.value)] || data[0];
      if (!scpi) return;
      let missing = 0;
      cells.forEach((cell, i) => {
        const value = scpi.values[i];
        cell.textContent = value || (scpi.documentee ? notPublishedLabel : pendingLabel);
        cell.classList.toggle('text-navy', Boolean(value));
        cell.classList.toggle('text-slate-700', !value);
        if (!value && !scpi.documentee) missing += 1;
        const detail = details[i];
        if (detail) detail.textContent = (value && scpi.details[i]) || '';
      });
      if (pending) pending.hidden = missing === 0;
      if (sourceName) sourceName.textContent = scpi.name + ' :';
      if (source) source.textContent = scpi.source || sourceFallback;

      /*
       * Taux le plus bas de la ligne. Il faut que LES DEUX cases donnent un pourcentage unique : un
       * barème à paliers ne se compare pas à un taux unique. Une case peut fournir ce nombre par
       * `data-fee-compare` quand ce qu'elle affiche est une fourchette (ligne du retrait).
       *
       * LA RÈGLE, arrêtée le 16/09/2026 : EST MARQUÉ TOUT TAUX À 0 %, ET SINON LE PLUS BAS DES DEUX.
       * Elle s'est faite en deux temps. Le 15/09, seule la colonne R Start était marquée à égalité sur
       * 0 %, la droite ne l'étant que si elle était strictement inférieure. L'équipe a corrigé le
       * lendemain : « si un concurrent est à 0 % aussi il faut le mettre en valeur. »
       * C'est le bon arbitrage, et pas seulement parce qu'il vient d'elle : le libellé lu par les
       * lecteurs d'écran dit « taux le plus bas de la ligne », et il était inexact de le réserver à une
       * colonne quand les deux portaient le même zéro.
       */
      const seul = (t: string | null | undefined) => {
        if (!t) return null;
        /*
         * La case doit contenir UN taux et rien d'autre : « 14,40 % TTC » oui, « 0 / 6 / 12 % » non.
         * Chercher simplement un pourcentage ne suffisait pas, dans « 0 / 6 / 12 % », seul le dernier
         * nombre est suivi du signe, la valeur était donc lue comme un taux unique de 12 %.
         */
        const m = t.trim().match(/^(\d+(?:[,.]\d+)?)\s*%(?:\s*(?:TTC|HT))?$/);
        return m ? parseFloat(m[1].replace(',', '.')) : null;
      };
      lignes.forEach((ligne, i) => {
        const g = seul(ligne.gauche?.dataset.feeCompare || ligne.gauche?.textContent);
        const d = seul(scpi.values[i]);
        const comparable = g !== null && d !== null;
        const gagneGauche = comparable && (g < d || g === 0);
        const gagneDroite = comparable && (d < g || d === 0);
        if (ligne.marqueGauche) ligne.marqueGauche.hidden = !gagneGauche;
        if (ligne.marqueDroite) ligne.marqueDroite.hidden = !gagneDroite;
        /*
         * Mise en avant par la COULEUR et la GRAISSE seulement : la taille reste identique d'une case à
         * l'autre, sans quoi un frais serait affiché plus petit que son voisin, ce que l'AMF refuse.
         * Le perdant est atténué, jamais effacé : il reste parfaitement lisible.
         * Depuis le 15/09/2026 le gagnant porte une PASTILLE PLEINE (`fee-gagnant`), et non plus un
         * halo à 18 % d'opacité qui se voyait à peine sur le blanc du tableau. Texte BLANC sur le navy,
         * relevé à 9,52:1, après un essai en sable qui tenait déjà largement (7,72:1) mais rendait le
         * chiffre moins net que son voisin en navy plein.
         */
        const peindre = (cell: Element | null | undefined, gagne: boolean, perd: boolean) => {
          if (!cell) return;
          cell.classList.toggle('font-bold', gagne);
          cell.classList.toggle('text-white', gagne);
          cell.classList.toggle('fee-gagnant', gagne);
          cell.classList.toggle('text-slate-600', perd);
          cell.classList.toggle('text-navy', !gagne && !perd);
        };
        peindre(ligne.gauche, gagneGauche, gagneDroite);
        /*
         * LA CASE DE DROITE EST REPEINTE À CHAQUE FOIS, VIDE OU NON (audit du 18/09/2026). Elle ne l'était
         * que si la SCPI choisie avait une valeur sur la ligne : en passant d'une SCPI qui GAGNAIT la
         * ligne à une SCPI sans valeur, la case gardait la pastille pleine du gagnant autour de « non
         * publié ». Un faux « taux le plus bas », sur un comparatif qui nomme des concurrents. Latent
         * tant que les dix-neuf SCPI ont leurs sept valeurs ; le code prévoit pourtant la case vide.
         * Sans valeur, `comparable` est faux : les deux drapeaux aussi, la pastille tombe. Une case vide
         * reprend ensuite l'ardoise que lui a donnée la boucle du dessus, `peindre` la rendrait navy.
         */
        const droite = cells[i];
        peindre(droite, gagneDroite, gagneGauche);
        if (droite && !scpi.values[i]) {
          droite.classList.remove('text-navy');
          droite.classList.add('text-slate-700');
        }
      });
    };

    select.addEventListener('change', render);
    render();
  })();
</script>

<script>
  /* Dépliage des explications « i » : module partagé avec les repères de l'accueil, mis dans le paquet
     une seule fois même quand les deux composants coexistent sur une page (c'est le cas de l'accueil). */
  import '@/scripts/infoToggle';
</script>
