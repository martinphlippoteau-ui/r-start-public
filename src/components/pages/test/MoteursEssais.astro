---
/**
 * ESSAI (24/09/2026, demande de Martin : « cinq voies pour changer les animations des cartes Loyers
 * et Plus-values ; pas de courbe qui monte, l'AMF n'aime pas ça »). Rendu SUR /test SEULEMENT.
 * Cinq pistes ont été montrées le jour même (calendrier, clés, étiquettes, horloge, répartition) ;
 * Martin a retenu LA RÉPARTITION, avec des LOCATAIRES à la place de l'immeuble sur la carte des
 * loyers, et fait supprimer le reste. Grammaire des cartes de /strategie (StrategySelect.astro en
 * tête : 236 × 100, trait marine, cycle de 8 s, état de repos = image complète). AUCUNE COURBE,
 * AUCUN AXE, RIEN QUI MONTE : le dessin raconte un mécanisme, la répartition, jamais un résultat.
 * CE QU'IL DIT. Loyers : trois entreprises locataires, chacune un immeuble et son équipe devant
 * (25/09/2026, d'après l'exemple de Martin) ; chacune verse son loyer, les trois se rejoignent en
 * une somme qui gagne R Start, qui la partage entre trois épargnants.
 * Plus-values : l'immeuble reçoit son panneau « Vendu », un seul versement gagne R Start, qui le
 * partage de même. Les trois épargnants sont des personnes, comme les locataires (25/09/2026,
 * Martin). Les dessins lisent la palette du recto (`.carte-recto`, global.css). Pas de
 * `data-in-view` : sur cette page d'essai, les dessins tournent sans le moteur de mouvement. À
 * REPORTER dans EngineRent.astro et EngineGain.astro, puis à supprimer avec la page.
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { fenetres } from '@/lib/immeuble';

const MARQUE =
  'M68.21.17C36.7,3.24,5.47,23.07,2.44,29.88c-11.59,26.1,21.48,52.52,27.22,55.34,21.52,10.59,48.04-1.99,59.51-27.5C93.5,48.09,104.2-3.34,68.21.17ZM64.76,69.76c-1.25,0-2.36-.57-3.09-1.47l-2.84-3.52c-4.06-4.98-10.05-12.1-12.26-13.54-1.92-1.22-4.48-1.84-7.59-1.84l-7.96.02c-2.02,0-3.66-1.64-3.66-3.66s1.64-3.66,3.66-3.66h18.33c3.05-.01,5.54-2.14,5.54-4.76s-2.49-4.74-5.54-4.74h-18.34c-2.02,0-3.66-1.63-3.66-3.65s1.64-3.66,3.66-3.66h18.34c7.58,0,13.73,5.4,13.73,12.05,0,4.74-3.2,9.03-8.07,10.97,3.22,3.36,7.64,8.61,11.3,13.08l1.52,1.86c.57.69.91,1.57.91,2.54,0,2.2-1.79,3.99-3.99,3.99Z';
/* La goutte pleine (premier sous-chemin), posée EN BLANC sous la marque : le R est un trou dans le
   tracé, on y voyait passer la pièce (25/09/2026, Martin). */
const MARQUE_FOND = MARQUE.slice(0, MARQUE.indexOf('Z') + 1);

/** L'immeuble vendu (carte des plus-values) : cadre et grille (src/lib/immeuble.ts). */
const CADRE = { x: 22, y: 26, w: 56, h: 60 };
const FEN = fenetres(CADRE, { colonnes: 3, rangees: 4, taille: 8, ecart: 4 });
/** Trois entreprises à gauche, trois épargnants à droite, aux mêmes hauteurs. Vingt-huit unités
    d'écart : l'icône d'entreprise fait vingt-deux de haut, il reste six entre deux. */
const RANGS = [28, 56, 84];
---

<Section id="moteurs-essais" tone="paper">
  <Container size="wide">
    <p class="text-eyebrow text-teal-700">Essai du 24/09/2026</p>
    <h1 id="moteurs-essais-title" class="text-display-md mt-3 text-ink">
      Les deux moteurs : la répartition
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-700">
      Piste retenue par Martin. Loyers : les entreprises locataires de l’immeuble versent, R Start
      partage entre trois épargnants. Plus-values : l’immeuble vendu verse une fois, R Start partage de même. Aucun axe,
      aucune échelle, rien qui monte.
    </p>
    <ul role="list" class="mt-8 grid gap-8 sm:grid-cols-2 lg:gap-12">
      {
        ['Les loyers', 'Les plus-values'].map((titre, k) => (
          <li>
            <article class="carte-recto relative flex min-h-[20rem] flex-col rounded-3xl bg-white p-6 text-ink shadow-card ring-1 ring-navy/5 sm:p-8">
              <p class="text-eyebrow text-teal-700">{k === 0 ? 'D’abord' : 'Et ensuite'}</p>
              <p class="text-display-sm mt-3 text-navy">{titre}</p>
              <div class="flex w-full flex-1 items-center py-6" style={`--illus-decalage:${k * 0.35}s`}>
                <figure class="essai-figure" aria-hidden="true">
                  <svg viewBox="0 0 236 100" fill="none" class="essai-svg">
                    {k === 0 ? (
                      <>
                        {/* Trois ENTREPRISES locataires (25/09/2026, Martin, d'après son exemple) : un
                          immeuble derrière, une équipe de trois personnes devant. */}
                        {RANGS.map((y, e) => (
                          <g class="locataire" style={`--e:${e}`}>
                            <rect x="29" y={y - 11} width="20" height="13" rx="2" class="cadre" />
                            <path d={`M33 ${y - 7.5}h7M33 ${y - 4.5}h7`} class="trait-fin" />
                            <circle cx="33.5" cy={y + 3} r="2.4" class="cadre-plein" />
                            <circle cx="44.5" cy={y + 3} r="2.4" class="cadre-plein" />
                            <circle cx="39" cy={y + 2} r="2.8" class="cadre-plein" />
                            <path d={`M28 ${y + 11}c0-3 2.5-5 5.5-5s5.5 2 5.5 5`} class="cadre-plein" />
                            <path d={`M39 ${y + 11}c0-3 2.5-5 5.5-5s5.5 2 5.5 5`} class="cadre-plein" />
                            <path d={`M32.5 ${y + 11}c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6`} class="cadre-plein" />
                          </g>
                        ))}
                        {RANGS.map((y) => (
                          <path d={`M56 ${y}C78 ${y} 82 56 92 56`} class="chemin" />
                        ))}
                        {RANGS.map((y, e) => (
                          <circle cx="56" cy={y} r="2.4" class="piece loyer" style={`--e:${e};--dy:${56 - y}px`} />
                        ))}
                        <circle cx="92" cy="56" r="3.2" class="piece somme" />
                      </>
                    ) : (
                      <>
                        <rect x={CADRE.x} y={CADRE.y} width={CADRE.w} height={CADRE.h} rx="5" class="cadre" />
                        {FEN.map((f) => (
                          <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="1.5" class="fenetre" />
                        ))}
                        <g class="panneau">
                          <rect x="30" y="14" width="40" height="16" rx="4" class="panneau-fond" />
                          <text x="50" y="22.5" class="etiquette">Vendu</text>
                        </g>
                        <circle cx="90" cy="56" r="3.2" class="piece vente" />
                      </>
                    )}
                    {/* Le tronçon commun : vers la marque, puis les trois chemins vers les épargnants. */}
                    <path d="M92 56h40" class="chemin" />
                    {RANGS.map((y) => (
                      <path d={`M146 56C170 56 176 ${y} 200 ${y}`} class="chemin" />
                    ))}
                    {RANGS.map((y, e) => (
                      <>
                        <circle cx="146" cy="56" r="2.4" class={`piece part ${k === 0 ? 'part-loyers' : 'part-vente'}`} style={`--e:${e};--dy:${y - 56}px`} />
                        {/* Les épargnants en personnes (25/09/2026, Martin), tête et épaules comme les locataires. */}
                        <g class={`epargnant ${k === 0 ? 'epargnant-loyers' : 'epargnant-vente'}`} style={`--e:${e}`}>
                          <circle cx="208" cy={y - 4} r="3.5" class="cadre" />
                          <path d={`M201 ${y + 8}c0-4.5 3-7 7-7s7 2.5 7 7`} class="cadre" />
                        </g>
                      </>
                    ))}
                    {/* La marque R Start relaie : elle reçoit, s'assombrit un instant, partage. */}
                    <svg x="118" y="46" width="22" height="21" viewBox="0 0 94.08 88.98" class={`marque ${k === 0 ? 'marque-loyers' : 'marque-vente'}`}>
                      <path d={MARQUE_FOND} class="marque-fond" />
                      <path d={MARQUE} />
                    </svg>
                  </svg>
                </figure>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>

<style>
  .essai-figure {
    margin: 0;
    width: 100%;
    /* Les loyers tournent sur 4 s (deux versements par cycle de 8 s : régulier) ; la vente, une
       fois par cycle. */
    --cycle: 8s;
    --tour: 4s;
    --decal: var(--illus-decalage, 0s);
  }
  .essai-svg {
    display: block;
    width: 100%;
    aspect-ratio: 236 / 100;
  }
  .cadre {
    stroke: rgb(var(--illus-trait-rgb) / 0.38);
    stroke-width: 1.6;
  }
  .chemin {
    stroke: rgb(var(--illus-trait-rgb) / 0.22);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }
  .fenetre {
    fill: var(--illus-trait);
    opacity: 0.5;
  }
  .piece {
    fill: var(--illus-trait);
    transform-box: fill-box;
    transform-origin: center;
  }
  .panneau-fond {
    fill: var(--illus-fond);
    stroke: var(--illus-accent);
    stroke-width: 1.4;
  }
  .etiquette {
    fill: var(--illus-trait);
    font-family: inherit;
    font-size: 8.5px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .marque {
    fill: var(--illus-trait);
  }
  .marque-fond {
    fill: var(--illus-fond);
  }
  .epargnant,
  .locataire {
    fill: var(--illus-fond);
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Repos = image complète : locataires et épargnants en place, le panneau posé, les versements
     arrivés (les loyers chez la marque, les parts chez les épargnants), les pièces en vol effacées. */
  .loyer {
    transform: translate(36px, var(--dy));
  }
  .trait-fin {
    stroke: rgb(var(--illus-trait-rgb) / 0.3);
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  /* Les personnes de l'équipe : fond blanc pour passer DEVANT l'immeuble. */
  .cadre-plein {
    fill: var(--illus-fond);
    stroke: rgb(var(--illus-trait-rgb) / 0.55);
    stroke-width: 1.4;
  }
  .part {
    transform: translate(54px, var(--dy));
  }
  .somme,
  .vente {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Loyers : trois versements partent à un souffle d'écart (0,12 s), se rejoignent, la somme
       gagne la marque, qui partage ; les épargnants répondent d'un battement. */
    /* Un souffle seulement pour les étages (6 %) : à 25 %, ils débordaient de l'immeuble. */
    .locataire {
      animation: essai-souffle var(--tour) infinite both;
      animation-delay: calc(var(--decal) + var(--e) * 0.12s);
    }
    .loyer {
      animation: essai-loyer var(--tour) infinite both;
      animation-delay: calc(var(--decal) + var(--e) * 0.12s);
    }
    .somme {
      animation: essai-somme var(--tour) infinite both;
      animation-delay: var(--decal);
    }
    .marque-loyers {
      animation: essai-relais var(--tour) infinite both;
      animation-delay: calc(var(--decal) + 1.9s);
    }
    .part-loyers {
      animation: essai-part var(--tour) infinite both;
      animation-delay: calc(var(--decal) + 2s);
    }
    .epargnant-loyers {
      animation: essai-battement var(--tour) infinite both;
      animation-delay: calc(var(--decal) + 3.2s + var(--e) * 0.08s);
    }
    /* Plus-values : panneau à 30 % du cycle, un versement de 40 à 50 %, partage de 50 à 68 %. */
    .panneau {
      animation: essai-panneau var(--cycle) infinite both;
      animation-delay: var(--decal);
    }
    .vente {
      animation: essai-vente var(--cycle) infinite both;
      animation-delay: var(--decal);
    }
    .marque-vente {
      animation: essai-relais var(--cycle) infinite both;
      animation-delay: calc(var(--decal) + 3.9s);
    }
    .part-vente {
      animation: essai-part var(--cycle) infinite both;
      animation-delay: calc(var(--decal) + 4s);
    }
    .epargnant-vente {
      animation: essai-battement var(--cycle) infinite both;
      animation-delay: calc(var(--decal) + 5.2s + var(--e) * 0.08s);
    }
  }

  @keyframes essai-loyer {
    0% { opacity: 0; transform: translate(0, 0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    6% { opacity: 1; transform: translate(3px, 0) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    24% { opacity: 1; transform: translate(36px, var(--dy)) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    28%, 100% { opacity: 0; transform: translate(36px, var(--dy)) scale(0.3); }
  }
  @keyframes essai-somme {
    0%, 26% { opacity: 0; transform: translateX(0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    30% { opacity: 1; transform: translateX(2px) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    44% { opacity: 1; transform: translateX(34px) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    50%, 100% { opacity: 0; transform: translateX(40px) scale(0.3); }
  }
  @keyframes essai-panneau {
    0%, 28% { opacity: 0; transform: translateY(6px); animation-timing-function: var(--ease-out-expo); }
    36% { opacity: 1; transform: translateY(0); }
    84% { opacity: 1; animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    94%, 100% { opacity: 0; transform: translateY(0); }
  }
  @keyframes essai-vente {
    0%, 38% { opacity: 0; transform: translateX(0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    41% { opacity: 1; transform: translateX(4px) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    48% { opacity: 1; transform: translateX(36px) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    51%, 100% { opacity: 0; transform: translateX(42px) scale(0.3); }
  }
  @keyframes essai-part {
    0% { opacity: 0; transform: translate(0, 0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    8% { opacity: 1; transform: translate(4px, 0) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    28% { opacity: 1; transform: translate(54px, var(--dy)) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    34%, 100% { opacity: 0; transform: translate(58px, var(--dy)) scale(0.3); }
  }
  @keyframes essai-battement {
    0%, 4% { transform: scale(1); animation-timing-function: var(--ease-out-expo); }
    10% { transform: scale(1.25); animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1); }
    30%, 100% { transform: scale(1); }
  }
  @keyframes essai-souffle {
    0%, 4% { transform: scale(1); animation-timing-function: var(--ease-out-expo); }
    10% { transform: scale(1.06); animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1); }
    30%, 100% { transform: scale(1); }
  }
  @keyframes essai-relais {
    0% { opacity: 1; }
    4% { opacity: 0.55; }
    14%, 100% { opacity: 1; }
  }
</style>
