---
/**
 * ESSAI (25/09/2026, demande de Martin : « dix propositions » pour afficher les deux barèmes à
 * paliers du comparateur, « intégrées dans le tableau »). Rendu SUR /test SEULEMENT. Chaque
 * proposition est posée DANS LA CASE R START d'un tableau qui reprend la structure du comparateur
 * (FeeComparator.astro : en-tête, colonne des intitulés, colonne R Start, colonne des autres SCPI,
 * ici la première SCPI du menu, valeurs et détails tels quels), pour juger à la vraie largeur.
 * LES PALIERS VIENNENT DU COMPARATEUR (comparator.ts, `rstartTiers`), taux et conditions tels
 * quels : ici on ne joue que la forme. Aucune comparaison, aucun chiffre ajouté ; les hauteurs et
 * teintes des propositions 2, 3 et 7 sont proportionnelles au taux affiché, rien d'autre. À
 * supprimer une fois tranché.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-couleur.svg';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { comparator, comparatorScpis } from '@/content/fr/comparator';
import { nb } from '@/lib/texte';

const LIGNES = comparator.rows.filter((r) => r.rstartTiers);
const AUTRE = comparatorScpis[0]!;
const autre = (key: string): { value: string; detail: string } => ({
  value: (AUTRE.values as Record<string, string | undefined>)[key] ?? '',
  detail: nb(((AUTRE.details ?? {}) as Record<string, string | undefined>)[key] ?? ''),
});
/** Le nombre derrière « 12 % » : seulement pour proportionner une barre ou une teinte. */
const taux = (rate: string): number => parseFloat(rate.replace(',', '.')) || 0;
const maxi = (tiers: readonly { rate: string }[]): number => Math.max(...tiers.map((t) => taux(t.rate)), 1);

const PROPOSITIONS: { titre: string; note: string }[] = [
  { titre: 'Le tableau', note: 'Condition à gauche, taux à droite, un filet entre les paliers.' },
  { titre: 'La frise', note: 'Les paliers en segments côte à côte, le taux au-dessus, la condition dessous, la teinte qui s’assombrit avec le taux.' },
  { titre: 'L’escalier', note: 'Une barre par palier, hauteur proportionnelle au taux.' },
  { titre: 'Les pastilles', note: 'Chaque taux dans un rond, le 0 % en pastille pleine, la condition dessous.' },
  { titre: 'Les cartes', note: 'Une petite carte par palier, en grille.' },
  { titre: 'La phrase', note: 'Le barème en une phrase, les taux en gras.' },
  { titre: 'Le dégradé', note: 'La liste actuelle, la case du taux de plus en plus foncée à mesure que le taux monte.' },
  { titre: 'Le meilleur d’abord', note: 'Le premier palier en avant, les autres derrière « Voir le barème ».' },
  { titre: 'La colonne', note: 'Un fil vertical, un point par palier, le taux à gauche, la condition à droite.' },
  { titre: 'Les puces alignées', note: 'La liste actuelle resserrée en un bloc, taux alignés à droite.' },
];
const cellule = 'px-3 py-5 align-top sm:px-5';
const enTete = 'w-[33%] border-b border-navy/12 bg-white px-3 pb-3 align-bottom sm:px-5 md:pb-5';
---

<Section id="baremes-essais" tone="paper">
  <Container size="wide">
    <p class="text-eyebrow text-teal-700">Essai du 25/09/2026</p>
    <h1 id="baremes-essais-title" class="text-display-md mt-3 text-ink">Les barèmes à paliers : dix façons de les afficher dans le comparateur</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-700">
      Les deux lignes à barème du comparateur, dans sa structure et à sa largeur, face à la première SCPI
      du menu. Paliers tels quels, seule la forme change.
    </p>
    <ol class="mt-6 max-w-3xl columns-2 space-y-1 text-base text-ink">
      {PROPOSITIONS.map((p, i) => <li><a href={`#proposition-${i + 1}`} class="font-semibold">{`${i + 1}. ${p.titre}`}</a></li>)}
    </ol>
  </Container>
</Section>

{
  PROPOSITIONS.map((p, i) => {
    const n = i + 1;
    return (
      <Section id={`proposition-${n}`} tone="white" class="pt-section-sm">
        <Container size="wide">
          <h2 id={`proposition-${n}-title`} class="text-display-sm text-ink">{`Proposition ${n} : ${p.titre}`}</h2>
          <p class="mt-3 max-w-3xl text-base text-slate-700">{p.note}</p>
          <table class="mt-8 w-full">
            <thead>
              <tr>
                <th scope="col" class="w-[34%] p-0"><span class="visually-hidden">{comparator.feeColumnLabel}</span></th>
                <th scope="col" class={enTete}>
                  <Image src={brandLogo} alt={comparator.leftLabel} width={290} height={89} loading="lazy" decoding="async" class="mx-auto h-12 w-auto sm:h-14 md:h-[3.75rem]" />
                </th>
                <th scope="col" class={enTete}>
                  <p class="mb-2 block text-sm font-medium text-slate-700">{comparator.selectLabel}</p>
                  <p class="w-full rounded-2xl border border-navy/20 bg-white px-3 py-2.5 text-base font-semibold text-navy sm:px-4 sm:py-3">{AUTRE.name}</p>
                </th>
              </tr>
            </thead>
            <tbody>
              {LIGNES.map((row) => {
                const b = row.rstartTiers!;
                const a = autre(row.key);
                return (
                  <tr class="border-t border-navy/12">
                    <th scope="row" class="py-5 pr-3 text-left align-top font-medium text-ink sm:pr-5">
                      <span class="block">{row.label}</span>
                      <span class="text-caption mt-1 block font-normal text-slate-700">{row.basis}</span>
                    </th>
                    <td class={cellule}>
                      {n === 1 && (
                        <table class="w-full text-base">
                          <tbody>
                            {b.map((t) => (
                              <tr class="not-first:border-t not-first:border-navy/10">
                                <td class="py-1.5 pr-3 text-caption text-slate-700">{t.when}</td>
                                <td class="py-1.5 text-right text-lg font-bold text-navy tabular-nums">{t.rate}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      )}
                      {n === 2 && (
                        <ol class="flex gap-0.5">
                          {b.map((t, k) => (
                            <li class="flex-1 text-center">
                              <p class="text-lg font-bold text-navy tabular-nums">{t.rate}</p>
                              <div class={`mt-1.5 h-1.5 ${k === 0 ? 'rounded-l-full' : ''} ${k === b.length - 1 ? 'rounded-r-full' : ''}`} style={`background: color-mix(in srgb, var(--color-navy) ${20 + (80 * taux(t.rate)) / maxi(b)}%, var(--color-teal-100))`} />
                              <p class="text-caption mt-1.5 leading-tight text-slate-700">{t.when}</p>
                            </li>
                          ))}
                        </ol>
                      )}
                      {n === 3 && (
                        <ol class="flex items-end gap-1.5" style="height: 9rem">
                          {b.map((t) => (
                            <li class="flex flex-1 flex-col items-center justify-end self-stretch">
                              <p class="text-lg font-bold text-navy tabular-nums">{t.rate}</p>
                              <div class="mt-1 w-full rounded-t-md bg-teal-100" style={`height: ${10 + (56 * taux(t.rate)) / maxi(b)}px`} />
                              <p class="text-caption mt-1.5 h-8 text-center leading-tight text-slate-700">{t.when}</p>
                            </li>
                          ))}
                        </ol>
                      )}
                      {n === 4 && (
                        <ol class="flex flex-wrap justify-center gap-x-2 gap-y-3">
                          {b.map((t) => (
                            <li class="flex w-[4.25rem] flex-col items-center text-center">
                              <span class={`inline-flex size-12 items-center justify-center rounded-full text-base font-bold tabular-nums ${taux(t.rate) === 0 ? 'bg-navy text-white' : 'bg-white text-navy ring-2 ring-navy/15'}`}>{t.rate}</span>
                              <p class="text-caption mt-1.5 leading-tight text-slate-700">{t.when}</p>
                            </li>
                          ))}
                        </ol>
                      )}
                      {n === 5 && (
                        <ol class="grid grid-cols-2 gap-2">
                          {b.map((t) => (
                            <li class="rounded-xl bg-paper px-3 py-2.5">
                              <p class="text-lg font-bold text-navy tabular-nums">{t.rate}</p>
                              <p class="text-caption leading-tight text-slate-700">{t.when}</p>
                            </li>
                          ))}
                        </ol>
                      )}
                      {n === 6 && (
                        <p class="text-base leading-relaxed text-ink">
                          {b.map((t, k) => (
                            <>
                              <strong class="font-semibold text-navy tabular-nums">{t.rate}</strong>{' '}
                              <span class="text-slate-700">{t.when.charAt(0).toLowerCase() + t.when.slice(1)}</span>
                              {k < b.length - 1 ? ' · ' : '.'}
                            </>
                          ))}
                        </p>
                      )}
                      {n === 7 && (
                        <ol class="space-y-1.5">
                          {b.map((t) => (
                            <li class="flex items-center gap-2.5">
                              <span class="inline-flex w-16 shrink-0 justify-center rounded-lg px-2 py-1 text-base font-bold tabular-nums" style={`background: color-mix(in srgb, var(--color-navy) ${8 + (92 * taux(t.rate)) / maxi(b)}%, white); color: ${taux(t.rate) / maxi(b) > 0.45 ? 'white' : 'var(--color-navy)'}`}>{t.rate}</span>
                              <span class="text-caption text-slate-700">{t.when}</span>
                            </li>
                          ))}
                        </ol>
                      )}
                      {n === 8 && (
                        <div>
                          <p class="text-display-sm text-navy tabular-nums">{b[0]!.rate} <span class="text-caption font-normal text-slate-700">{b[0]!.when}</span></p>
                          <details class="mt-2 text-base">
                            <summary class="cursor-pointer text-sm font-semibold text-navy">Voir le barème</summary>
                            <ol class="mt-2 space-y-1.5">
                              {b.slice(1).map((t) => (
                                <li class="flex items-baseline gap-2.5"><span class="w-12 text-base font-bold text-navy tabular-nums">{t.rate}</span><span class="text-caption text-slate-700">{t.when}</span></li>
                              ))}
                            </ol>
                          </details>
                        </div>
                      )}
                      {n === 9 && (
                        <ol class="relative ml-16 border-l-2 border-navy/15 pl-5">
                          {b.map((t) => (
                            <li class="relative py-1.5">
                              <span aria-hidden="true" class="absolute top-1/2 -left-[27px] size-2.5 -translate-y-1/2 rounded-full bg-teal-700 ring-4 ring-white" />
                              <span class="absolute top-1/2 -left-[6rem] w-12 -translate-y-1/2 text-right text-base font-bold text-navy tabular-nums">{t.rate}</span>
                              <span class="text-caption text-slate-700">{t.when}</span>
                            </li>
                          ))}
                        </ol>
                      )}
                      {n === 10 && (
                        <ol class="divide-y divide-navy/10 rounded-xl bg-paper px-3">
                          {b.map((t) => (
                            <li class="flex items-center justify-between gap-3 py-2">
                              <span class="text-caption text-slate-700">{t.when}</span>
                              <span class="text-base font-bold text-navy tabular-nums">{t.rate}</span>
                            </li>
                          ))}
                        </ol>
                      )}
                    </td>
                    <td class={cellule + ' text-center'}>
                      <span class="text-display-sm text-slate-700">{a.value}</span>
                      {a.detail && <span class="text-caption mx-auto mt-1 block max-w-[16rem] text-slate-700">{a.detail}</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </Container>
      </Section>
    );
  })
}
