---
/**
 * ESSAI (24/09/2026, demande de Martin) : cinq variantes du hero de l'accueil qui font une place à
 * CORUM L'Épargne, rendues SUR /test SEULEMENT, pour choisir sur pièces. CORUM L'Épargne est le
 * DISTRIBUTEUR de R Start, pas son concepteur (CORUM Asset Management) : elle n'« invente » donc
 * jamais, elle distribue ou présente. Version statique du hero (01-Hero.astro : mêmes classes de
 * texte, même logo, mêmes boutons, même bandeau Trustpilot), sans aurore, sans entrée animée ni
 * défilement lié : c'est la place de CORUM L'Épargne qu'on juge, pas le mouvement. Cinq variantes
 * au départ, quatre depuis le retrait de la pastille de distribution. Le logo CORUM
 * L'Épargne n'existe qu'en couleur : posé sur pastille blanche là où il apparaît. À SUPPRIMER avec
 * la page /test une fois le choix fait et reporté dans 01-Hero.astro.
 */
import { Image } from 'astro:assets';
import brandLogo from '@/assets/logos/r-start-blanc.svg';
import corumLogo from '@/assets/logos/corum-lepargne-couleur.svg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import TrustBox from '@/components/ui/TrustBox.astro';
import { hero } from '@/content/fr/hero';
import { trust, experienceStats } from '@/content/fr/trust';

/* Formulation de Martin (24/09/2026), reprise telle quelle partout où la phrase est écrite. */
const DISTRIBUEE = 'La SCPI R Start est distribuée par CORUM L’Épargne';
const experience = experienceStats[0]?.value ?? '';
const epargne = experienceStats[1]?.value ?? '';

type Cle = 'ligne' | 'signature' | 'confiance' | 'surtitre';
/* La pastille de distribution (ex-variante 4) a été retirée le 24/09/2026 à la demande de Martin. */
const VARIANTES: { cle: Cle; titre: string; note: string }[] = [
  {
    cle: 'ligne',
    titre: 'Une ligne sous l’accroche',
    note: 'Le hero ne change pas ; « La SCPI R Start est distribuée par CORUM L’Épargne » en petit, sous l’accroche. Texte seul.',
  },
  {
    cle: 'signature',
    titre: 'La signature sous le logo',
    note: 'Sous le logo R Start, « distribuée par » et le logo CORUM L’Épargne. « CORUM invente » reste au-dessus : le groupe invente, CORUM L’Épargne distribue.',
  },
  {
    cle: 'confiance',
    titre: 'La ligne de confiance',
    note: 'En bas, sous les étoiles Trustpilot, CORUM L’Épargne comme caution, avec les chiffres du groupe pris dans les faits du site.',
  },
  {
    cle: 'surtitre',
    titre: 'Le surtitre « CORUM L’Épargne présente »',
    note: 'Le surtitre change de sujet : ce n’est plus le groupe qui invente, c’est le distributeur qui présente. Rien d’autre ne bouge.',
  },
];
const eyebrowClass =
  'text-base leading-tight font-semibold tracking-[0.14em] text-teal-100 uppercase sm:text-lg lg:text-xl';
const taglineClass =
  'mt-6 max-w-4xl text-[2rem] leading-[1.12] font-bold tracking-[-0.01em] text-balance text-white sm:mt-8 sm:text-[clamp(2.5rem,2.07rem+1.53vw,3rem)]';
---

<Section id="hero-corum" tone="paper">
  <Container size="wide">
    <p class="text-eyebrow text-teal-700">Essai du 24/09/2026</p>
    <h1 id="hero-corum-title" class="text-display-md mt-3 text-ink">
      Le hero de l’accueil avec CORUM L’Épargne : quatre variantes
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-700">
      CORUM L’Épargne distribue R Start, CORUM Asset Management la conçoit et la gère : dans
      chaque variante, CORUM L’Épargne distribue ou présente, jamais n’invente. Version fixe du
      hero, sans son animation.
    </p>
    <ol class="mt-6 max-w-3xl space-y-2 text-base text-ink">
      {VARIANTES.map((v, i) => (
        <li>
          <a href={`#hero-${i + 1}`} class="font-semibold">{`${i + 1}. ${v.titre}`}</a>
          <span class="text-slate-700"> — {v.note}</span>
        </li>
      ))}
    </ol>
  </Container>
</Section>

{
  VARIANTES.map((v, i) => {
    const n = i + 1;
    const id = `hero-${n}`;
    const { cle } = v;
    return (
      <Section id={id} tone="ink" spacing="none" class="brand-halo grain overflow-hidden">
        <Container size="wide" class="relative pt-10 pb-16 sm:pt-12 sm:pb-20">
          <h2 id={id + '-title'} class="text-eyebrow text-teal-200">
            {`Variante ${n} : ${v.titre}`}
          </h2>

          <div class="mx-auto mt-10 flex max-w-4xl flex-col items-center text-center">
            {/* Surtitre */}
            <p class={eyebrowClass + ' mb-5 sm:mb-8'}>
              {cle === 'surtitre' ? 'CORUM L’Épargne présente' : hero.eyebrow}
            </p>

            {/* Logo R Start, à la place réservée du hero */}
            <div class="hero-logo-wrap" aria-hidden="true">
              <span class="hero-logo-stack">
                <Image src={brandLogo} alt="" width={290} height={89} loading="lazy" decoding="async" />
              </span>
            </div>

            {/* 2. Signature sous le logo */}
            {cle === 'signature' && (
              <p class="mt-5 flex items-center gap-3 text-sm font-semibold tracking-[0.08em] text-white/80 uppercase">
                distribuée par
                <span class="inline-flex items-center rounded-full bg-white px-4 py-2">
                  <Image src={corumLogo} alt="CORUM L’Épargne" height={20} loading="lazy" decoding="async" class="h-5 w-auto" />
                </span>
              </p>
            )}

            <p class={taglineClass}>{hero.tagline}</p>

            {/* 1. Ligne sous l'accroche */}
            {cle === 'ligne' && <p class="mt-4 text-base text-white/80 sm:text-lg">{DISTRIBUEE}</p>}

            {/* Boutons */}
            <div class="mt-6 flex w-full flex-col items-stretch gap-2 sm:mt-12 sm:w-auto sm:flex-row sm:items-center sm:justify-center sm:gap-3">
              <Button href="#" variant="light" size="lg">{hero.primaryCta.label}</Button>
              <Button href={hero.secondaryCta.href} variant="outline-light" size="lg" class="max-sm:hidden">
                {hero.secondaryCta.label}
              </Button>
            </div>

            {/* Trustpilot */}
            <div class="mx-auto mt-6 w-full max-w-md sm:mt-10">
              <TrustBox template="horizontal" theme="dark" label={trust.trustpilot.widgetLabel!} />
            </div>

            {/* 3. Ligne de confiance */}
            {cle === 'confiance' && (
              <p class="mt-5 max-w-2xl text-base text-white/80">
                {DISTRIBUEE}. Le groupe CORUM : {experience} d’expertise, {epargne} d’épargne gérée.
              </p>
            )}
          </div>
        </Container>
      </Section>
    );
  })
}
