---
/**
 * Page Salle de presse, Communiqués de presse (id « communiques »). Fond paper, après le PageHero (ink).
 * Liste chronologique des communiqués livrés par le contenu (pressRoom.releases.items, déjà filtrés et triés
 * du plus récent au plus ancien) ; si la liste est vide, seul `emptyLabel` est rendu.
 *  - communiqué disponible : carte-lien vers le PDF (nouvel onglet, rel noopener, type application/pdf,
 *    data-doc pour l'analytics document_download), date, mention PDF et poids (résolu au build) ;
 *  - communiqué non disponible : titre sans lien, date, résumé s'il existe, puis `emptyLabel`.
 * Accessibilité des cartes : comme la section Documents de l'accueil (lien-titre étendu à la carte par
 * ::after, anneau de focus sur ::after, « PDF, nouvelle fenêtre » porté par aria-describedby ; le span
 * caché n'est rendu que si au moins un communiqué est lié).
 * Rythme : tant qu'aucun communiqué n'est publié (titre, phrase et carte d'attente seulement), la section
 * est compacte (py-section-sm) pour ne pas paraître creuse entre le PageHero sombre et la Revue de presse ;
 * rythme normal dès le premier communiqué.
 * Animation : révélation en cascade de la liste (aucun [data-risk] dedans).
 * Contenu : src/content/fr/pressRoom.ts (releases, labels).
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import PressRoomNoteRef from '@/components/pages/salle-de-presse/PressRoomNoteRef.astro';
import { pressRoom } from '@/content/fr/pressRoom';
import { fileKey, kbFormat, publicFileKb } from '@/components/pages/salle-de-presse/public-files';
import { withBase } from '@/lib/href';

const id = 'communiques';
const { releases } = pressRoom;
const labels = pressRoom.labels ?? {};

const items = releases.items.map((r) => {
  const linked = r.available && r.file.trim() !== '';
  return { ...r, linked, kb: linked ? publicFileKb(r.file) : undefined };
});
const hasLinked = items.some((i) => i.linked);

/** Détail lu par les lecteurs d'écran après le titre du lien (ex. « PDF, nouvelle fenêtre »). */
const linkHint = [labels.fileTypeLabel, labels.newTabHint].filter(Boolean).join(', ');
const linkHintId = `${id}-link-hint`;
---

<Section id={id} tone="paper" spacing={items.length === 0 ? 'compact' : 'default'}>
  <Container size="wide">
    <header class="max-w-4xl">
      <h2 id={id + '-title'} class="text-display-md text-ink">{releases.title}</h2>
      <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">
        {releases.intro}<span class="whitespace-nowrap"
          ><PressRoomNoteRef id="salle-presse-communiques" /></span
        >
      </p>
    </header>
    {
      hasLinked && linkHint && (
        <span id={linkHintId} hidden>
          {linkHint}
        </span>
      )
    }

    {
      items.length === 0 ? (
        <p class="mt-10 max-w-4xl rounded-3xl bg-white p-6 text-lead text-ink shadow-card sm:p-8 lg:mt-14 lg:p-10">
          {releases.emptyLabel}
        </p>
      ) : (
        <ol
          role="list"
          aria-label={labels.releasesListLabel}
          class="mt-10 grid gap-5 lg:mt-14 lg:gap-6"
          data-animate="stagger"
        >
          {items.map((item) => (
            <li class="group relative flex flex-col gap-3 rounded-3xl bg-white p-6 shadow-card ring-1 ring-navy/5 transition-shadow duration-300 hover:shadow-float focus-within:shadow-float sm:p-8 lg:p-10">
              <p class="text-caption flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold tracking-wider text-slate-700">
                <time datetime={item.dateIso}>{item.date}</time>
                {item.linked && labels.fileTypeLabel && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span class="uppercase">{labels.fileTypeLabel}</span>
                  </>
                )}
                {item.kb !== undefined && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span class="tabular-nums">
                      {kbFormat.format(item.kb)}
                      {labels.sizeUnit && <> {labels.sizeUnit}</>}
                    </span>
                  </>
                )}
              </p>

              <h3 class="text-display-sm text-ink">
                {item.linked ? (
                  <a
                    href={withBase(item.file)}
                    data-doc={fileKey(item.file)}
                    target="_blank"
                    rel="noopener"
                    type="application/pdf"
                    aria-describedby={linkHint ? linkHintId : undefined}
                    class="text-ink no-underline after:absolute after:inset-0 after:rounded-3xl group-hover:text-navy focus-visible:shadow-none focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-2 focus-visible:after:outline-navy"
                  >
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>

              {item.summary && <p class="text-base leading-relaxed text-ink">{item.summary}</p>}
              {!item.linked && (
                <p class="text-base leading-relaxed text-slate-700">{releases.emptyLabel}</p>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </Container>
</Section>
