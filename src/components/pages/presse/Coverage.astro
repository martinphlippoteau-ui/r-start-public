---
/**
 * Page « La presse en parle », la revue de presse (id « revue-de-presse », fond white). Sous `sm`,
 * une ligne par article, séparée d'un filet (média, titre, date) ; la forme de carte revient à
 * partir de deux colonnes.
 * INTRODUCTION ET AVERTISSEMENT RETIRÉS LE 16/09/2026, demande de l'équipe : l'introduction
 * rappelait que R Start n'est pas une SCPI sans frais, l'avertissement fermait la page dans sa
 * propre bande sombre. Textes archivés hors du dépôt (.claude/audits).
 * Chaque article a une adresse vérifiée (press.ts écarte les autres) : le titre est un lien externe
 * (nouvel onglet, rel noopener noreferrer, mention « nouvelle fenêtre » portée par aria-describedby
 * vers un span caché commun), étendu à toute la ligne par ::after.
 * Les titres sont des citations de tiers : ils portent `data-press-quote`, ce qui les exclut du
 * contrôle des formulations interdites de scripts/check-compliance.mjs. L'avertissement qui les
 * couvrait est retiré : le contrôle le signale à chaque exécution, et seul le pied de page les
 * accompagne.
 * Aucun logo de média : les noms sont en typographie (aucune licence).
 * Animation : révélation en cascade de la liste seulement.
 * Contenu : src/content/fr/press.ts (coverage, labels).
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { press } from '@/content/fr/press';

const id = 'revue-de-presse';
const { coverage } = press;
const labels = press.labels ?? {};

/** Mention lue par les lecteurs d'écran après le titre de chaque lien (ex. « nouvelle fenêtre »). */
const linkHint = labels.newTabHint ?? '';
const linkHintId = `${id}-link-hint`;
---

<Section id={id} tone="white">
  <Container size="wide">
    <header class="max-w-4xl">
      <h2 id={id + '-title'} class="text-display-md text-ink">{coverage.title}</h2>
    </header>
    {
      linkHint && (
        <span id={linkHintId} hidden>
          {linkHint}
        </span>
      )
    }

    {
      /* Sous `sm` : une ligne par article, séparée d'un filet (des cartes empilées faisaient
        presque deux écrans à elles seules). Dès `sm` : la grille de cartes. */
    }
    <ul
      role="list"
      aria-label={labels.coverageListLabel}
      class="mt-8 grid border-t border-navy/10 sm:mt-10 sm:grid-cols-2 sm:gap-5 sm:border-0 lg:mt-14 lg:grid-cols-3 lg:gap-6"
      data-animate="stagger"
    >
      {
        coverage.items.map((item) => (
          <li class="group relative flex flex-col gap-2 border-b border-navy/10 py-5 transition-shadow duration-300 focus-within:shadow-card sm:gap-4 sm:rounded-3xl sm:border-0 sm:bg-paper sm:p-8 sm:ring-1 sm:ring-navy/5 sm:hover:shadow-card">
            <p class="text-eyebrow text-teal-700">{item.media}</p>
            <h3 class="text-lg font-semibold leading-snug tracking-tight text-ink sm:text-2xl">
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-describedby={linkHint ? linkHintId : undefined}
                data-press-quote
                class="text-ink no-underline after:absolute after:inset-0 sm:after:rounded-3xl group-hover:text-navy focus-visible:shadow-none focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-2 focus-visible:after:outline-navy"
              >
                {item.title}
              </a>
            </h3>
            <p class="mt-auto flex items-center justify-between gap-4 pt-1 text-base text-slate-700 sm:pt-2">
              <span>
                <time datetime={item.dateIso}>{item.date}</time>
              </span>
              <svg
                aria-hidden="true"
                class="size-5 shrink-0 text-navy transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 4h9v9M16 4 4 16" />
              </svg>
            </p>
          </li>
        ))
      }
    </ul>
    {
      /* Avertissement sous la revue (22/09/2026, demande de Martin) ; scripts/check-compliance.mjs
      l'exige sur la page. Jamais animé. */
    }
    <p class="text-caption mt-6 text-slate-700 sm:mt-8">{coverage.notice}</p>
  </Container>
</Section>
