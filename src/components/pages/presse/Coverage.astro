---
/**
 * Page « La presse en parle », La revue de presse (id « revue-de-presse »). Fond white.
 * Introduction (qui rappelle, dans le même bloc, que R Start n'est pas une SCPI sans frais et cite les
 * frais réellement prélevés) et avertissement de fin (facts.press.coverageDisclaimer) en texte normal,
 * jamais animés. Entre les deux, une grille de cartes : média (surtitre), titre de l'article, date.
 *  - article dont l'adresse est vérifiée : le titre est un lien externe (nouvel onglet, rel noopener
 *    noreferrer, mention « nouvelle fenêtre » portée par aria-describedby vers un span caché commun),
 *    étendu à toute la carte par ::after ;
 *  - article sans adresse : le titre s'affiche sans lien, avec son média et sa date (arbitrage du
 *    10/09/2026 ; les adresses manquantes sont attendues de CORUM).
 * Les titres sont des citations de tiers : ils portent `data-press-quote`, ce qui les exclut du contrôle
 * des formulations interdites de scripts/check-compliance.mjs, ils sont couverts par l'avertissement.
 * Aucun logo de média : les noms sont en typographie (aucune licence).
 * Animation : révélation en cascade de la grille seulement.
 * Contenu : src/content/fr/press.ts (coverage, labels).
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import PressNoteRef from '@/components/pages/presse/PressNoteRef.astro';
import { press } from '@/content/fr/press';

const id = 'revue-de-presse';
const { coverage } = press;
const labels = press.labels ?? {};

/** Mention lue par les lecteurs d'écran après le titre de chaque lien (ex. « nouvelle fenêtre »). */
const linkHint = labels.newTabHint ?? '';
const linkHintId = `${id}-link-hint`;
const hasLinks = coverage.items.some((item) => item.url);

/** Classes communes aux titres, liés ou non : même taille des deux côtés. */
const titleClass = 'text-xl font-semibold leading-snug tracking-tight text-ink sm:text-2xl';
---

<Section id={id} tone="white">
  <Container size="wide">
    <header class="max-w-4xl">
      <h2 id={id + '-title'} class="text-display-md text-ink">{coverage.title}</h2>
      <p class="text-lead mt-5 text-pretty text-slate-700 sm:mt-6">
        {coverage.intro}<span class="whitespace-nowrap"><PressNoteRef id="presse-revue" /></span>
      </p>
    </header>
    {
      hasLinks && linkHint && (
        <span id={linkHintId} hidden>
          {linkHint}
        </span>
      )
    }

    <ul
      role="list"
      aria-label={labels.coverageListLabel}
      class="mt-10 grid gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6"
      data-animate="stagger"
    >
      {
        coverage.items.map((item) => (
          <li class="group relative flex flex-col gap-4 rounded-3xl bg-paper p-6 ring-1 ring-navy/5 transition-shadow duration-300 hover:shadow-card focus-within:shadow-card sm:p-8">
            <p class="text-eyebrow text-teal-700">{item.media}</p>
            <h3 class={titleClass}>
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-describedby={linkHint ? linkHintId : undefined}
                  data-press-quote
                  class="text-ink no-underline after:absolute after:inset-0 after:rounded-3xl group-hover:text-navy focus-visible:shadow-none focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-2 focus-visible:after:outline-navy"
                >
                  {item.title}
                </a>
              ) : (
                <span data-press-quote>{item.title}</span>
              )}
            </h3>
            <p class="mt-auto flex items-center justify-between gap-4 pt-2 text-base text-slate-700">
              <span>
                {item.dateIso ? <time datetime={item.dateIso}>{item.date}</time> : item.date}
              </span>
              {item.url && (
                <svg
                  aria-hidden="true"
                  class="size-5 shrink-0 text-navy transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 4h9v9M16 4 4 16" />
                </svg>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <!-- Avertissement (texte normal, jamais animé) -->
    <div class="mt-12 rounded-3xl bg-paper p-6 sm:p-10 lg:mt-16 lg:p-12">
      <p class="text-lead max-w-4xl text-ink">{coverage.disclaimer}</p>
    </div>
  </Container>
</Section>
