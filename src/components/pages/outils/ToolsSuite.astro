---
/**
 * Les quatre outils de /outils. Un seul composant et un seul script : ils partagent le formatage des
 * montants et la même règle d'affichage, autant ne pas la dupliquer.
 *
 * Tous les taux viennent de facts.fees, facts.share et facts.income, passés au script par `define:vars`.
 * Rien n'est écrit en dur ici : le jour où un barème change dans les données, les quatre outils suivent.
 *
 * Aucun outil ne projette de performance. Les montants de loyers et de plus-value sont des HYPOTHÈSES
 * saisies par le visiteur, et chaque bloc porte son contre-poids risque, jamais animé, frère du bloc
 * d'avantage comme partout ailleurs sur le site.
 *
 * Sans JavaScript, les champs restent lisibles avec leurs valeurs par défaut et les résultats affichent
 * un tiret : rien ne casse, l'outil ne calcule simplement pas.
 */
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import NoteRef from '@/components/ui/NoteRef.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import ToolField from './ToolField.astro';
import ToolResult from './ToolResult.astro';
import { fees, income, marketComparison, share } from '@/content/fr/facts';
import { toolsPage } from '@/content/fr/toolsPage';

const { feeSimulator, enjoyment, exit: exitTool, savings, labels } = toolsPage;

/** Barèmes transmis au script : un seul point de vérité, celui de facts.ts. */
const bareme = {
  management: fees.management.rate,
  disposalTiers: fees.disposal.tiers.map((t) => ({ rate: parseFloat(t.rate), from: t.from })),
  /** Paliers bornés du barème de retrait, tels quels : le dernier (`until: null`) vaut au-delà. */
  withdrawalSteps: fees.withdrawal.steps.map((s) => ({
    rate: parseFloat(s.rate),
    until: s.until,
  })),
  zeroAfter: fees.withdrawal.zeroAfterYears,
  sharePrice: share.price,
  enjoymentMonths: income.enjoymentDelayMonths,
  marketEntry: parseFloat(marketComparison.averages.subscription.label) || 0,
  marketManagement: parseFloat(marketComparison.averages.management.label) || 0,
  textes: feeSimulator.results,
};
---

<Section id="simulateur-frais" tone="white" labelledBy="simulateur-frais-title">
  <Container size="wide">
    <h2 id="simulateur-frais-title" class="text-display-lg text-balance">{feeSimulator.title}</h2>
    <p class="text-lead mt-6 max-w-3xl opacity-90">{feeSimulator.intro}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div
        role="group"
        aria-labelledby="simulateur-frais-title"
        data-tool="frais"
        class="grid gap-6 sm:grid-cols-2 lg:col-span-7"
      >
        <ToolField
          id="frais-montant"
          label={feeSimulator.fields.amount}
          unit={labels.euro}
          value={10000}
          min={200}
          step={100}
        />
        <ToolField
          id="frais-duree"
          label={feeSimulator.fields.years}
          unit={labels.years}
          value={10}
          min={1}
          max={30}
        />
        <ToolField
          id="frais-loyers"
          label={feeSimulator.fields.rent}
          unit={labels.euro}
          value={4000}
          min={0}
          step={100}
          hint={feeSimulator.hints.rent}
          class="sm:col-span-2"
        />
        <ToolField
          id="frais-plusvalue"
          label={feeSimulator.fields.gain}
          unit={labels.percent}
          value={0}
          min={0}
          max={100}
          step={1}
          hint={feeSimulator.hints.gain}
        />
        <ToolField
          id="frais-entree-rivale"
          label={feeSimulator.fields.rivalEntry}
          unit={labels.percent}
          value={marketComparison.averages.acquisition.label.replace(/[^\d,.]/g, '')}
          min={0}
          max={20}
          step={0.1}
          hint={feeSimulator.hints.rivalEntry}
        />
        <ToolField
          id="frais-gestion-rivale"
          label={feeSimulator.fields.rivalManagement}
          unit={labels.percent}
          value={marketComparison.averages.management.label.replace(/[^\d,.]/g, '')}
          min={0}
          max={30}
          step={0.1}
          class="sm:col-span-2"
        />
      </div>

      <div class="grid gap-4 lg:col-span-5">
        <ToolResult id="frais-out-rstart" label={feeSimulator.results.rstart} emphasis />
        <ToolResult id="frais-out-rivale" label={feeSimulator.results.rival} />
        <div class="rounded-3xl bg-paper p-5 sm:p-6">
          <p class="text-base font-medium text-slate-700">
            {feeSimulator.results.crossover}
            <NoteRef id={feeSimulator.marketNoteId} />
          </p>
          <p
            id="frais-out-bascule"
            data-tool-out
            aria-live="polite"
            class="text-lead mt-2 text-ink"
          >
            {labels.pending}
          </p>
        </div>
      </div>
    </div>

    <div data-advantage class="visually-hidden">{feeSimulator.intro}</div>
    <RiskNote text={feeSimulator.risk} size="lead" class="mt-8" noteId={feeSimulator.noteId} />
  </Container>
</Section>

<Section id="jouissance" tone="paper" labelledBy="jouissance-title">
  <Container size="wide">
    <h2 id="jouissance-title" class="text-display-lg text-balance">{enjoyment.title}</h2>
    <p class="text-lead mt-6 max-w-3xl opacity-90">{enjoyment.intro}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div
        role="group"
        aria-labelledby="jouissance-title"
        data-tool="jouissance"
        class="grid gap-6 lg:col-span-7"
      >
        <ToolField id="jouissance-date" label={enjoyment.fields.date} value="" type="date" />
      </div>
      <div class="grid gap-4 lg:col-span-5">
        <ToolResult id="jouissance-out-date" label={enjoyment.results.date} emphasis />
        <ToolResult id="jouissance-out-attente" label={enjoyment.results.wait} />
      </div>
    </div>

    <div data-advantage class="visually-hidden">{enjoyment.intro}</div>
    <RiskNote text={enjoyment.risk} size="lead" class="mt-8" noteId={enjoyment.noteId} />
  </Container>
</Section>

<Section id="sortie" tone="white" labelledBy="sortie-title">
  <Container size="wide">
    <h2 id="sortie-title" class="text-display-lg text-balance">{exitTool.title}</h2>
    <p class="text-lead mt-6 max-w-3xl opacity-90">{exitTool.intro}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div
        role="group"
        aria-labelledby="sortie-title"
        data-tool="sortie"
        class="grid gap-6 sm:grid-cols-2 lg:col-span-7"
      >
        <ToolField
          id="sortie-montant"
          label={exitTool.fields.amount}
          unit={labels.euro}
          value={10000}
          min={0}
          step={100}
        />
        <ToolField
          id="sortie-duree"
          label={exitTool.fields.years}
          unit={labels.years}
          value={3}
          min={0}
          max={30}
        />
      </div>
      <div class="grid gap-4 lg:col-span-5">
        <ToolResult id="sortie-out-taux" label={exitTool.results.rate} emphasis />
        <ToolResult id="sortie-out-cout" label={exitTool.results.cost} />
        <ToolResult id="sortie-out-net" label={exitTool.results.net} />
      </div>
    </div>

    <div data-advantage class="visually-hidden">{exitTool.intro}</div>
    <RiskNote text={exitTool.risk} size="lead" class="mt-8" noteId={exitTool.noteId} />
  </Container>
</Section>

<Section id="versements" tone="paper" labelledBy="versements-title">
  <Container size="wide">
    <h2 id="versements-title" class="text-display-lg text-balance">{savings.title}</h2>
    <p class="text-lead mt-6 max-w-3xl opacity-90">{savings.intro}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div
        role="group"
        aria-labelledby="versements-title"
        data-tool="versements"
        class="grid gap-6 sm:grid-cols-2 lg:col-span-7"
      >
        <ToolField
          id="versements-mensuel"
          label={savings.fields.monthly}
          unit={labels.euro}
          value={50}
          min={50}
          step={10}
        />
        <ToolField
          id="versements-duree"
          label={savings.fields.months}
          unit={labels.months}
          value={60}
          min={1}
          max={480}
        />
      </div>
      <div class="grid gap-4 lg:col-span-5">
        <ToolResult id="versements-out-total" label={savings.results.total} emphasis />
        <ToolResult id="versements-out-parts" label={savings.results.shares} />
      </div>
    </div>

    <div data-advantage class="visually-hidden">{savings.intro}</div>
    <RiskNote text={savings.risk} size="lead" class="mt-8" noteId={savings.noteId} />

    <div class="mt-10 sm:mt-14">
      <Button position={toolsPage.cta.position} variant="primary" size="lg">
        {toolsPage.cta.label}
      </Button>
    </div>
  </Container>
</Section>

<script is:inline define:vars={{ bareme, labels }}>
  /*
   * Les quatre outils. Aucun ne projette : ils appliquent les taux du contrat aux montants saisis.
   * Un seul écouteur par formulaire, recalcul à chaque frappe. Tout est borné par les attributs min et
   * max des champs, et un champ vide vaut zéro plutôt que NaN.
   */
  (() => {
    const euro = new Intl.NumberFormat('fr-FR', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 0,
    });
    const euroPrecis = new Intl.NumberFormat('fr-FR', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 2,
    });
    const nombre = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 4 });
    const dateLongue = new Intl.DateTimeFormat('fr-FR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    const val = (id) => {
      const el = document.getElementById(id);
      if (!el) return 0;
      const n = parseFloat(String(el.value).replace(',', '.'));
      return Number.isFinite(n) ? n : 0;
    };
    const ecrire = (id, texte) => {
      const el = document.getElementById(id);
      if (el) el.textContent = texte;
    };

    /* Premier palier dont la borne n'est pas encore atteinte ; le dernier, sans borne, vaut au-delà. */
    const tauxRetrait = (annees) => {
      const palier = bareme.withdrawalSteps.find((s) => s.until === null || annees < s.until);
      return palier ? palier.rate : 0;
    };

    /* 1. Frais et point de bascule. */
    const calculFrais = () => {
      const montant = val('frais-montant');
      const loyers = val('frais-loyers');
      const plusValue = val('frais-plusvalue');
      const annees = val('frais-duree');
      const entreeRivale = val('frais-entree-rivale');
      const gestionRivale = val('frais-gestion-rivale');

      /* R Start : gestion sur les loyers, cession selon le palier de plus-value, retrait si sortie tôt. */
      let rstart = (loyers * bareme.management) / 100;
      if (plusValue > 0) {
        /* Dernier palier dont le seuil d'entrée est atteint. */
        const palier = bareme.disposalTiers.reduce(
          (acc, t) => (plusValue >= t.from ? t.rate : acc),
          0
        );
        rstart += (montant * (1 + plusValue / 100) * palier) / 100;
      }
      rstart += (montant * tauxRetrait(annees)) / 100;

      /* SCPI comparée : commission d'entrée une fois, gestion sur les mêmes loyers. */
      const rivale = (montant * entreeRivale) / 100 + (loyers * gestionRivale) / 100;

      ecrire('frais-out-rstart', euro.format(rstart));
      ecrire('frais-out-rivale', euro.format(rivale));

      /* Bascule : niveau de loyers où les deux modèles coûtent le même prix. */
      const ecartTaux = (bareme.management - gestionRivale) / 100;
      if (ecartTaux <= 0) {
        ecrire('frais-out-bascule', bareme.textes.crossoverNever);
      } else {
        const seuil = (montant * entreeRivale) / 100 / ecartTaux;
        if (seuil <= 0) ecrire('frais-out-bascule', bareme.textes.crossoverAlways);
        else
          ecrire(
            'frais-out-bascule',
            bareme.textes.crossoverTemplate.replace('{seuil}', euro.format(seuil))
          );
      }
    };

    /* 2. Jouissance : premier jour du Nième mois qui suit l'encaissement. */
    const calculJouissance = () => {
      const champ = document.getElementById('jouissance-date');
      const brut = champ && champ.value;
      if (!brut) {
        ecrire('jouissance-out-date', labels.pending);
        ecrire('jouissance-out-attente', labels.pending);
        return;
      }
      const d = new Date(brut + 'T00:00:00');
      if (Number.isNaN(d.getTime())) return;
      const cible = new Date(d.getFullYear(), d.getMonth() + bareme.enjoymentMonths, 1);
      ecrire('jouissance-out-date', dateLongue.format(cible));
      const jours = Math.round((cible - d) / 86400000);
      ecrire('jouissance-out-attente', jours + ' jours');
    };

    const calculSortie = () => {
      const montant = val('sortie-montant');
      const annees = val('sortie-duree');
      const taux = tauxRetrait(annees);
      const cout = (montant * taux) / 100;
      ecrire('sortie-out-taux', nombre.format(taux) + ' %');
      ecrire('sortie-out-cout', euro.format(cout));
      ecrire('sortie-out-net', euro.format(montant - cout));
    };

    /* 4. Versements programmés : arithmétique au prix de part en vigueur. */
    const calculVersements = () => {
      const mensuel = val('versements-mensuel');
      const mois = val('versements-duree');
      const total = mensuel * mois;
      ecrire('versements-out-total', euroPrecis.format(total));
      ecrire('versements-out-parts', nombre.format(total / bareme.sharePrice));
    };

    const outils = {
      frais: calculFrais,
      jouissance: calculJouissance,
      sortie: calculSortie,
      versements: calculVersements,
    };
    for (const [nom, calcul] of Object.entries(outils)) {
      const groupe = document.querySelector('[data-tool="' + nom + '"]');
      if (!groupe) continue;
      /* `input` et `change` remontent depuis les champs : un seul écouteur par outil suffit. */
      groupe.addEventListener('input', calcul);
      groupe.addEventListener('change', calcul);
      calcul();
    }
  })();
</script>
