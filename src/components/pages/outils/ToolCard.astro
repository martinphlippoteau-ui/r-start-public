---
/**
 * Carte d'introduction à un outil, sur /outils. Elle pose la question à laquelle l'outil répond, dit en
 * deux phrases ce qu'il calcule, et mène à sa page.
 *
 * Toute la carte est cliquable par un lien étendu (`after:absolute after:inset-0`) posé sur le titre :
 * une seule cible dans l'ordre de tabulation, un seul intitulé annoncé, et la surface complète reste
 * atteignable au doigt. Rien d'autre dans la carte n'est interactif, l'étendue ne masque donc rien.
 */
import { withBase } from '@/lib/href';

interface Props {
  href: string;
  eyebrow: string;
  title: string;
  question: string;
  teaser: string;
  cta: string;
}
const { href, eyebrow, title, question, teaser, cta } = Astro.props as Props;
---

<article
  class="group relative flex h-full flex-col rounded-3xl border border-navy/12 bg-white p-6 transition-shadow hover:shadow-lg sm:p-8"
>
  <p class="text-caption font-semibold tracking-wide text-teal-700 uppercase">{eyebrow}</p>

  <h3 class="text-display-sm mt-3 text-balance">
    <a
      href={withBase(href)}
      class="text-ink no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-navy"
    >
      {title}
    </a>
  </h3>

  <p class="text-lead mt-3 text-ink">{question}</p>
  <p class="text-base mt-3 text-slate-700">{teaser}</p>

  <p
    class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-navy group-hover:gap-3 motion-safe:transition-all"
  >
    {cta}
    <svg
      aria-hidden="true"
      class="size-4 shrink-0"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 8h10M9 4l4 4-4 4"></path>
    </svg>
  </p>
</article>
