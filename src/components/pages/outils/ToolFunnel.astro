---
/**
 * Tunnel de simulation (12/09/2026, demande de l'équipe). Un outil ne pose plus toutes ses questions sur
 * un seul écran : il en pose UNE PAR ÉTAPE, avec un fil d'étapes au-dessus, et finit sur le résultat.
 *
 * Chaque outil n'apporte que ses champs, répartis dans les emplacements `step-1` à `step-4`, et ses
 * résultats dans `results`. Les titres d'étapes viennent du contenu (toolsPage.ts).
 *
 * NIVEAU D'EXPERTISE ET ÉTAPES. Le sélecteur de niveau reste : il décide quels CHAMPS existent, et donc
 * quelles étapes existent. Une étape dont tous les champs sont masqués par le niveau est retirée du fil
 * et « Suivant » l'enjambe. Le fil se raccourcit donc tout seul : deux étapes en débutant, quatre en
 * expert, sans qu'aucune liste d'étapes soit maintenue à la main quelque part.
 *
 * SANS JAVASCRIPT, toutes les étapes sont affichées à la suite, comme avant : c'est le script qui n'en
 * laisse qu'une. Un tunnel qui exigerait un script pour livrer ses champs ne serait pas un repli, ce
 * serait une page vide.
 *
 * `data-tool` est posé UNE FOIS sur la piste, pas sur chaque étape : les événements `input` et `change`
 * y remontent depuis n'importe quel champ, quelle que soit l'étape affichée, et le calcul de l'outil
 * reste un seul écouteur.
 *
 * L'introduction sert aussi de `data-advantage` : le contrôle de conformité exige qu'un avantage ait un
 * frère `data-risk` d'au moins 60 % de sa longueur et 95 % de sa taille de police. Le RiskNote en bas
 * remplit ce rôle, et il n'est jamais animé.
 */
import { Image } from 'astro:assets';
import brandLogoWhite from '@/assets/logos/r-start-blanc.svg';
import Container from '@/components/ui/Container.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import ToolLevels from './ToolLevels.astro';
import { funnel } from '@/content/fr/toolsPage';
import { shortRiskLine } from '@/content/fr/legal';

interface Props {
  /** Identifiant de section, aussi préfixe des boutons radio et valeur de `data-tool`. */
  id: string;
  title: string;
  intro: string;
  risk: string;
  noteId: string;
  levelNotes: { debutant: string; intermediaire: string; expert: string };
  /** Titres des étapes, dans l'ordre. Une question par étape. */
  steps: readonly string[];
  tone?: 'paper' | 'white';
}
const { id, title, intro, risk, noteId, levelNotes, steps, tone = 'white' } = Astro.props as Props;
const titleId = `${id}-title`;
const etapeId = (n: number) => `${id}-etape-${n}`;
const resultId = `${id}-resultat`;
---

<Section id={id} tone={tone} labelledBy={titleId} class="pt-10 sm:pt-12 lg:pt-16">
  <Container size="wide">
    {
      /* DEUX COLONNES (13/09/2026, demande de l'équipe) : à gauche ce qui ne bouge pas, le niveau puis
        le propos de l'outil ; à droite les questions, qui défilent. On ne relit pas l'introduction à
        chaque étape, et la colonne de droite garde la même hauteur d'un écran à l'autre.
        `data-tool-level` enveloppe les DEUX colonnes : le sélecteur est à gauche, les champs qu'il
        ouvre et ferme sont à droite. */
    }
    {
      /* TROIS blocs et non deux, placés à la main sur la grille à partir de « lg » : le niveau, le
        tunnel, puis le propos de l'outil. Sur grand écran, niveau et propos occupent la colonne de
        gauche l'un sous l'autre, le tunnel tient la droite sur les deux rangs.
        Sur téléphone, ils se suivent dans l'ordre du code : le niveau, PUIS LA QUESTION, et le propos
        après. En colonne unique, mettre toute la colonne de gauche avant le tunnel repoussait la
        première question à 836 px, soit bien au-delà de l'écran. */
    }
    <div
      data-tool-level={id}
      data-funnel={id}
      class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-x-16 lg:gap-y-10"
    >
      {
        /* Le niveau vient EN PREMIER : c'est le réglage qui décide du nombre de questions, on le pose
          avant de commencer, pas après avoir répondu. */
      }
      <div class="lg:col-span-5 lg:col-start-1 lg:row-start-1">
        <ToolLevels name={id} notes={levelNotes} />
      </div>

      <div class="lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
        {
          /* Fil d'étapes. Une liste ordonnée, parce que c'en est une : le lecteur d'écran annonce « 2 sur
          4 » sans qu'on ait à le lui écrire. Les puces sont des boutons : on revient sur une étape déjà
          franchie d'un clic, sans repasser par « Précédent ». */
        }
        {
          /* Une BARRE SEGMENTÉE plutôt qu'un fil à puces portant chaque question : six intitulés écrits en
          entier au-dessus du tunnel occupaient plus de place que la question elle-même. Un segment par
          étape, rempli jusqu'à celle où l'on est, et le compte en toutes lettres à côté. Le gabarit du
          compte voyage en attribut : le script ne connaît aucun texte, tout vient du contenu. */
        }
        <div class="funnel-stepper mt-8 flex items-center gap-4">
          <ol data-funnel-stepper-bar aria-hidden="true" class="flex flex-1 items-center gap-1.5">
            {
              [...steps, funnel.resultShort].map((_, i) => (
                <li
                  data-funnel-dot={i === steps.length ? 'result' : String(i + 1)}
                  class="funnel-seg"
                />
              ))
            }
          </ol>
          <p
            data-funnel-progress
            data-modele={funnel.progressTemplate}
            aria-live="polite"
            class="text-caption shrink-0 font-medium text-slate-700"
          >
          </p>
        </div>

        {
          /* La piste. `data-tool` est ici et nulle part ailleurs : c'est le point d'écoute unique de
          l'outil, il reçoit les frappes de toutes les étapes. */
        }
        <div data-funnel-track data-tool={id} class="funnel-track mt-6">
          {
            steps.map((titre, i) => (
              <section
                data-funnel-step={String(i + 1)}
                aria-labelledby={etapeId(i + 1)}
                class="funnel-step"
              >
                {/* h2, comme le titre de l'outil : celui-ci est placé APRÈS le tunnel dans le code, pour
                    que la question vienne en premier sur téléphone, et un h3 en tête aurait fait sauter
                    le document de h1 à h3. Tous frères au niveau 2 ; les cartes de résultat sont en h3. */}
                <h2 id={etapeId(i + 1)} class="text-display-sm text-balance" tabindex="-1">
                  {titre}
                </h2>
                <div class="mt-6 grid gap-6 sm:grid-cols-2">
                  {i === 0 && <slot name="step-1" />}
                  {i === 1 && <slot name="step-2" />}
                  {i === 2 && <slot name="step-3" />}
                  {i === 3 && <slot name="step-4" />}
                  {i === 4 && <slot name="step-5" />}
                  {i === 5 && <slot name="step-6" />}
                </div>
              </section>
            ))
          }

          <section data-funnel-step="result" aria-labelledby={resultId} class="funnel-step">
            <h2 id={resultId} class="text-display-sm text-balance" tabindex="-1">
              {funnel.resultTitle}
            </h2>

            {
              /* Le temps que le résultat paraisse, la marque tourne. C'est une attente FEINTE, le calcul
              est instantané : elle marque la bascule entre les questions et la réponse, et laisse à
              l'œil le temps de changer de registre. Retirée en mouvement réduit, où elle ne serait plus
              qu'un délai. */
            }
            <div data-funnel-loader hidden class="funnel-loader mt-10">
              {
                /* Même vocabulaire que la pastille d'appel : un rond bleu qui arrive au ressort, un anneau
                qui tourne autour, et la marque au centre. Ce n'est pas un sablier, c'est la marque qui
                travaille. */
              }
              <span class="funnel-loader-disc" aria-hidden="true">
                <span class="funnel-loader-ring"></span>
                <Image
                  src={brandLogoWhite}
                  alt=""
                  width={290}
                  height={89}
                  loading="lazy"
                  decoding="async"
                  class="funnel-loader-logo"
                />
              </span>
              <p class="text-caption mt-5 text-slate-700">{funnel.loading}</p>
            </div>

            <div data-funnel-results class="mt-6 grid gap-4 sm:grid-cols-2">
              <slot name="results" />
            </div>
          </section>
        </div>

        {
          /* Commandes. Masquées sans script : sans lui toutes les étapes sont là, il n'y a nulle part où
          aller. */
        }
        <div data-funnel-nav class="funnel-nav mt-8 flex flex-wrap items-center gap-3">
          <button type="button" data-funnel-prev class="funnel-btn funnel-btn-ghost">
            {funnel.previous}
          </button>
          <button
            type="button"
            data-funnel-next
            data-suivant={funnel.next}
            data-voir={funnel.see}
            class="funnel-btn funnel-btn-primary"
          >
            <span data-funnel-next-label>{funnel.next}</span>
          </button>
          <button type="button" data-funnel-restart class="funnel-btn funnel-btn-ghost">
            {funnel.restart}
          </button>
        </div>

        {
          /* Le choix du niveau est passé SOUS le tunnel (12/09/2026) : au-dessus, il pesait plus lourd que
          la question elle-même et l'on n'entrait dans la simulation qu'après un pavé d'explications.
          Ici, il est ce qu'il est : un réglage, qu'on va chercher quand on veut aller plus loin. */
        }
      </div>

      <div class="lg:col-span-5 lg:col-start-1 lg:row-start-2">
        <h2 id={titleId} class="text-display-sm text-balance">{title}</h2>
        <p class="text-lead mt-4 opacity-90">{intro}</p>
        {
          /* Ligne risques de la page, descendue ici depuis l'en-tête (13/09/2026, demande de l'équipe).
            Elle ne pouvait pas être retirée : elle est exigée sur toute sous-page produit. Dans cette
            colonne, elle reste sous les yeux pendant toute la simulation, au lieu de disparaître au
            premier défilement. */
        }
        <RiskNote text={shortRiskLine} class="mt-6" />
      </div>
    </div>

    <div data-advantage class="visually-hidden">{intro}</div>
    <RiskNote text={risk} size="lead" class="mt-10" noteId={noteId} />
  </Container>
</Section>

<script>
  /*
   * Un tunnel par outil, tous pilotés par le même script. Il ne sait rien des outils : il ne fait
   * qu'afficher une étape à la fois, tenir le fil à jour et enjamber les étapes vides.
   *
   * Une étape est DISPONIBLE si au moins un de ses champs n'est pas masqué par le niveau choisi. On lit
   * le `display` calculé du champ, et non sa position à l'écran : un champ dans une étape masquée n'a
   * pas de position, mais son `display` propre, lui, dit toujours la vérité sur le niveau.
   */
  const FUNNEL_CLE = 'data-funnel-step';

  for (const funnel of document.querySelectorAll<HTMLElement>('[data-funnel]')) {
    const etapes = [...funnel.querySelectorAll<HTMLElement>('[data-funnel-step]')];
    const puces = [...funnel.querySelectorAll<HTMLElement>('[data-funnel-dot]')];
    const attente = funnel.querySelector<HTMLElement>('[data-funnel-loader]');
    const resultats = funnel.querySelector<HTMLElement>('[data-funnel-results]');
    const douceur = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    let minuterie = 0;
    const progres = funnel.querySelector<HTMLElement>('[data-funnel-progress]');
    const precedent = funnel.querySelector<HTMLButtonElement>('[data-funnel-prev]');
    const suivant = funnel.querySelector<HTMLButtonElement>('[data-funnel-next]');
    const suivantTexte = funnel.querySelector<HTMLElement>('[data-funnel-next-label]');
    const recommencer = funnel.querySelector<HTMLButtonElement>('[data-funnel-restart]');
    if (!etapes.length) continue;

    const cle = (e: HTMLElement) => e.getAttribute(FUNNEL_CLE) ?? '';
    const estResultat = (e: HTMLElement) => cle(e) === 'result';

    const disponible = (e: HTMLElement) => {
      if (estResultat(e)) return true;
      const champs = [...e.querySelectorAll<HTMLElement>('[data-level]')];
      return champs.some((c) => getComputedStyle(c).display !== 'none');
    };

    /** Les étapes qui comptent, dans l'ordre, au niveau d'expertise du moment. */
    const ouvertes = () => etapes.filter(disponible);

    /*
     * La position est tenue par l'ÉTAPE elle-même, jamais par son rang. Changer de niveau change le
     * nombre d'étapes : un rang mémorisé désignerait alors une autre étape, et l'on retombait sur la
     * troisième question en quittant le résultat pour passer en expert.
     */
    let active: HTMLElement = etapes[0];

    const rendre = (sens: 'avant' | 'arriere' | 'aucun' = 'aucun') => {
      const liste = ouvertes();
      /* L'étape courante a pu disparaître avec le niveau : on retombe sur la plus proche avant elle. */
      if (!liste.includes(active)) {
        const rangBrut = etapes.indexOf(active);
        active =
          [...liste].reverse().find((e) => etapes.indexOf(e) <= rangBrut) ?? liste[0] ?? etapes[0];
      }
      const courante = liste.indexOf(active);

      for (const e of etapes) {
        const visible = e === active;
        e.toggleAttribute('data-current', visible);
        e.hidden = !visible;
        if (visible && sens !== 'aucun') {
          e.setAttribute('data-enter', sens);
          /* L'animation est relancée à chaque passage : on la retire et on force un reflow. */
          void e.offsetWidth;
        } else {
          e.removeAttribute('data-enter');
        }
      }

      for (const puce of puces) {
        const etape = etapes.find((e) => cle(e) === puce.getAttribute('data-funnel-dot'));
        const rang = etape ? liste.indexOf(etape) : -1;
        puce.hidden = rang === -1;
        puce.toggleAttribute('data-done', rang > -1 && rang < courante);
        puce.toggleAttribute('data-current', rang === courante);
      }

      const dernier = courante === liste.length - 1;
      if (precedent) precedent.hidden = courante === 0;
      if (suivant) suivant.hidden = dernier;
      if (recommencer) recommencer.hidden = !dernier;
      /* Sur l'avant-dernière étape, le bouton annonce ce qui vient : le résultat, pas « Suivant ». */
      if (suivantTexte && suivant)
        suivantTexte.textContent =
          courante === liste.length - 2
            ? (suivant.dataset.voir ?? '')
            : (suivant.dataset.suivant ?? '');

      if (progres)
        progres.textContent = (progres.dataset.modele ?? '')
          .replace('{n}', String(courante + 1))
          .replace('{total}', String(liste.length));
    };

    /*
     * Bascule vers le résultat : la marque tourne un instant, puis la réponse paraît. L'attente est
     * FEINTE, le calcul est déjà fait ; elle marque le passage des questions à la réponse. `aria-busy`
     * le dit aux lecteurs d'écran, qui annoncent alors le résultat une fois, à la fin, et non pendant.
     * En mouvement réduit, rien de tout cela : le résultat est là.
     */
    const ATTENTE_MS = 900;
    const jouerAttente = (versResultat: boolean) => {
      window.clearTimeout(minuterie);
      if (!attente || !resultats) return;
      if (!versResultat || !douceur) {
        attente.hidden = true;
        resultats.hidden = false;
        resultats.removeAttribute('aria-busy');
        return;
      }
      attente.hidden = false;
      resultats.hidden = true;
      resultats.setAttribute('aria-busy', 'true');
      minuterie = window.setTimeout(() => {
        attente.hidden = true;
        resultats.hidden = false;
        resultats.removeAttribute('aria-busy');
      }, ATTENTE_MS);
    };

    const aller = (rang: number, focaliser = true) => {
      const liste = ouvertes();
      const depart = liste.indexOf(active);
      const cible = Math.min(Math.max(rang, 0), liste.length - 1);
      const sens = cible > depart ? 'avant' : cible < depart ? 'arriere' : 'aucun';
      const avant = active;
      active = liste[cible] ?? active;
      rendre(sens);
      /* L'attente ne se rejoue pas si l'on était déjà sur le résultat (changement de niveau, retour). */
      jouerAttente(estResultat(active) && avant !== active);
      if (focaliser) active.querySelector<HTMLElement>('h2')?.focus();
    };

    /* Les champs de l'étape doivent être valides avant d'avancer : le navigateur dit lui-même pourquoi. */
    const valide = () => {
      if (!active) return true;
      for (const champ of active.querySelectorAll<HTMLInputElement>('input')) {
        if (!champ.checkValidity()) {
          champ.reportValidity();
          return false;
        }
      }
      return true;
    };

    const rang = () => ouvertes().indexOf(active);

    suivant?.addEventListener('click', () => {
      if (valide()) aller(rang() + 1);
    });
    precedent?.addEventListener('click', () => aller(rang() - 1));
    recommencer?.addEventListener('click', () => aller(0));

    for (const puce of puces) {
      puce.querySelector('button')?.addEventListener('click', () => {
        const etape = etapes.find((e) => cle(e) === puce.getAttribute('data-funnel-dot'));
        const cible = etape ? ouvertes().indexOf(etape) : -1;
        if (cible === -1) return;
        /* On ne saute en avant qu'après avoir rempli l'étape courante. */
        if (cible > rang() && !valide()) return;
        aller(cible);
      });
    }

    /* Entrée dans un champ : c'est « Suivant », pas un envoi de formulaire. */
    funnel.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      if (e.key !== 'Enter') return;
      const cible = e.target as HTMLElement;
      if (cible.tagName !== 'INPUT') return;
      e.preventDefault();
      if (valide()) aller(rang() + 1);
    });

    /* Changer de niveau ajoute ou retire des étapes : le fil et la position sont recalculés. */
    for (const radio of funnel.querySelectorAll('[data-tool-level-input]'))
      radio.addEventListener('change', () => rendre());

    funnel.dataset.funnelReady = '';
    rendre();
    jouerAttente(false);
  }
</script>
