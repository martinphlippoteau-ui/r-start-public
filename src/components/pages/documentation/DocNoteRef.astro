---
/**
 * Appel de note légale de la page /documentation : même rendu que ui/NoteRef.astro, mais numéroté
 * d'après les notes propres à la page (documentation.notes, rendues par <LegalNotes notes={…} />) et non
 * d'après le registre de l'accueil. Une note absente (ex. « documentation-dic » une fois le DIC publié)
 * ne rend rien. Couleur : teal-700 par défaut, teal-200 sous un ancêtre `.text-white` (AA sur les deux).
 * aria-label « Voir la note n » depuis nav.ts.
 */
import { sections } from '@/config/sections';
import { notes } from '@/content/fr/documentation';
import { nav } from '@/content/fr/nav';

interface Props {
  id: string;
  /** Force la couleur ; sans valeur, elle suit le fond (ancêtre `.text-white` → teal-200). */
  tone?: 'light' | 'dark';
  /**
   * `false` : marqueur visuel seul (span, sans lien), pour un usage à l'intérieur d'un ancêtre déjà
   * interactif, un <summary> notamment, où un <a> imbriqué est une violation d'accessibilité
   * (« nested-interactive ») et du modèle de contenu HTML. Le lien réel équivalent doit alors exister
   * ailleurs dans le contenu (ici : accolé au dernier paragraphe risque de la réponse).
   */
  interactive?: boolean;
}
const { id, tone, interactive = true } = Astro.props;
const index = notes.findIndex((n) => n.id === id);
const n = index === -1 ? null : index + 1;
const label = nav.noteRefLabel && n !== null ? `${nav.noteRefLabel} ${n}` : undefined;
const colors = {
  auto: 'text-teal-700 in-[.text-white]:text-teal-200',
  light: 'text-teal-700',
  dark: 'text-teal-200',
};
/*
 * NE REND PLUS RIEN depuis le 14/09/2026, demande de l'équipe : « enlève les notes et les sources de
 * tout le site sauf du tableau de la page frais ».
 *
 * La coupe est ici, et non dans les fichiers de contenu : les seize registres de notes restent intacts,
 * avec leurs sources, leurs dates et leurs renvois aux documents réglementaires. Rien n'est réécrit,
 * rien n'est perdu. Remettre `AFFICHER` à `true` rétablit tout, appels de note compris.
 *
 * SEULE EXCEPTION CONSERVÉE sur le site : le bloc « Sources des données » sous le comparateur de
 * /frais (FeeComparator.astro). Il dit d'où viennent les taux des dix-sept SCPI nommées et à quelle
 * date ils ont été relevés ; sans lui, la comparaison serait invérifiable.
 */
const AFFICHER = false;
---

{
  AFFICHER && n !== null && interactive && (
    <a
      href={'#' + sections.notes.id + '-' + n}
      class:list={[
        'ml-0.5 align-super text-[0.65em] font-semibold link-underline',
        colors[tone ?? 'auto'],
      ]}
      aria-label={label}
    >
      {n}
    </a>
  )
}
{
  AFFICHER && n !== null && !interactive && (
    <span
      class:list={['ml-0.5 align-super text-[0.65em] font-semibold', colors[tone ?? 'auto']]}
      aria-hidden="true"
    >
      {n}
    </span>
  )
}
