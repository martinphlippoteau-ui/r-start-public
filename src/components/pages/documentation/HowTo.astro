---
/**
 * Guide « Souscrire en ligne, en quatre étapes » de la page /documentation (id « guide »).
 * En-tête collant sur grand écran : surtitre, H2 (avec l'appel de la note « souscription »), puis, dans le
 * même bloc et la même taille (text-lead), l'avantage (data-advantage : en ligne, versements programmés
 * PEI, réinvestissement des dividendes) et son contre-poids RiskNote (data-risk, jamais animé). Face à
 * lui, le stepper vertical des quatre étapes (liste ordonnée, ligne de progression, cascade déclarative),
 * repris de la section Souscrire de l'accueil. Les appels de note des étapes viennent du contenu.
 * Contenu : documentation.howTo et documentation.labels.
 */
import Container from '@/components/ui/Container.astro';
import RiskNote from '@/components/ui/RiskNote.astro';
import Section from '@/components/ui/Section.astro';
import type { DocumentationContent, DocumentationLabels } from '@/content/types-v2';
import DocNoteRef from './DocNoteRef.astro';

interface Props {
  howTo: DocumentationContent['howTo'];
  labels: DocumentationLabels;
  tone?: 'paper' | 'white';
}
const { howTo, labels, tone = 'white' } = Astro.props;
const id = 'guide';
---

<Section id={id} tone={tone}>
  <Container size="wide">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- En-tête collant : titre, avantage et contre-poids dans le même bloc -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          {
            labels.howToEyebrow && (
              <p class="text-eyebrow mb-4 text-teal-700">{labels.howToEyebrow}</p>
            )
          }
          <h2 id={id + '-title'} class="text-display-md">
            {howTo.title}<span class="whitespace-nowrap"
              ><DocNoteRef id="documentation-souscription" /></span
            >
          </h2>
          <div class="mt-6 space-y-4">
            {
              howTo.risk ? (
                <>
                  <p data-advantage class="text-lead text-ink">
                    {howTo.intro}
                  </p>
                  <RiskNote text={howTo.risk} size="lead" />
                </>
              ) : (
                <p class="text-lead text-ink">{howTo.intro}</p>
              )
            }
          </div>
        </div>
      </div>

      {
        /* Colonne des étapes : le guide, puis le bloc MyCORUM sous la dernière étape (« Suivre votre
        épargne ») — en dessous sur mobile, à droite du chapeau sur grand écran. */
      }
      <div class="lg:col-span-7">
        <!-- Stepper -->
        <ol
          aria-label={labels.stepsLabel}
          class="relative space-y-10 before:absolute before:top-6 before:bottom-6 before:left-6 before:w-px before:bg-gradient-to-b before:from-navy before:via-teal-400 before:to-mist sm:space-y-14"
          data-animate="stagger"
        >
          {
            howTo.steps.map((step, i) => (
              <li class="relative flex gap-5 sm:gap-8">
                <span
                  aria-hidden="true"
                  class:list={[
                    'relative z-10 flex size-12 shrink-0 items-center justify-center rounded-full bg-navy text-lg font-bold text-white tabular-nums shadow-card ring-4',
                    tone === 'white' ? 'ring-white' : 'ring-paper',
                  ]}
                >
                  {i + 1}
                </span>
                <div class="pt-2">
                  <h3 class="text-display-sm">
                    {labels.stepPrefix && (
                      <span class="visually-hidden">
                        {labels.stepPrefix} {i + 1} :{' '}
                      </span>
                    )}
                    {step.title}
                    {step.noteId && <DocNoteRef id={step.noteId} />}
                  </h3>
                  <p class="mt-3 max-w-xl text-base leading-relaxed sm:text-lg">
                    {step.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        {
          /* Après la souscription : bloc MyCORUM fourni par la page (src/components/AppMyCorum.astro). */
        }
        <slot name="aside" />
      </div>
    </div>
  </Container>
</Section>
