---
/**
 * Groupe de documents de la page /documentation (id = clé du groupe : reglementaire, frais, formulaire),
 * cible de la navigation d'ancres. En-tête collant sur grand écran (surtitre, H2, introduction avec ses
 * appels de note) face aux cartes de documents, reprises de la section Documents de l'accueil : chaque
 * carte est un lien vers le PDF (nouvel onglet, rel noopener, type application/pdf, data-doc pour
 * l'analytics document_download) avec sa description, sa version et son poids en kilooctets.
 * Aucun avantage vanté ici : pas de paire avantage / risque à rendre ; l'intro reste en texte normal.
 *
 * Accessibilité des cartes : le lien-titre (h3) précède les métadonnées « PDF · 155 ko » dans le DOM,
 * remontées visuellement par `order-first` ; « PDF, nouvelle fenêtre » est porté par aria-describedby
 * vers le span `hidden` unique de la page (hintId) ; l'anneau de focus entoure toute la carte (::after).
 * Contenu : documentation.groups[n] et documentation.labels.
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import type {
  DocumentationContent,
  DocumentationLabels,
  DocumentGroupKey,
} from '@/content/types-v2';
import DocNoteRef from './DocNoteRef.astro';
import { withBase } from '@/lib/href';

interface Props {
  group: DocumentationContent['groups'][number];
  tone: 'paper' | 'white';
  labels: DocumentationLabels;
  /** id du span masqué « PDF, nouvelle fenêtre » (absent = pas d'aria-describedby). */
  hintId?: string;
}
const { group, tone, labels, hintId } = Astro.props;
const id = group.key;

/** Appels de note portés par l'introduction de chaque groupe (ids des notes de documentation.ts ; une note absente ne rend rien). */
const introNoteIds: Record<DocumentGroupKey, string[]> = {
  reglementaire: ['documentation-dic', 'documentation-statuts', 'documentation-note-visa'],
  frais: [],
  formulaire: ['documentation-formulaires'],
};

/** Poids en kilooctets, formaté en français (ex. « 2 232 »). */
const kbFormat = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 });
/** Clé analytics d'un document : sa clé de facts.ts, à défaut le nom du fichier sans extension. */
const docKey = (file: string, key?: string) =>
  key ?? file.replace(/^.*\//, '').replace(/\.pdf$/i, '');

/** Cartes en contraste avec le fond de la section. */
const cardTone = tone === 'paper' ? 'bg-white shadow-card' : 'bg-paper ring-1 ring-navy/5';
---

<Section id={id} tone={tone}>
  <Container size="wide">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- En-tête collant -->
      <div class="lg:col-span-5">
        <header class="lg:sticky lg:top-24">
          <h2 id={id + '-title'} class="text-display-md">{group.title}</h2>
          <p class="text-lead mt-6 text-ink">
            {group.intro}
            {
              introNoteIds[group.key].map((noteId) => (
                <span class="whitespace-nowrap">
                  <DocNoteRef id={noteId} />
                </span>
              ))
            }
          </p>
        </header>
      </div>

      <!-- Documents -->
      <ul
        role="list"
        aria-label={group.title}
        class="grid gap-5 lg:col-span-7 lg:gap-6"
        data-animate="stagger"
      >
        {
          group.items.map((item) => (
            <li
              class:list={[
                'group relative flex flex-col gap-5 rounded-3xl p-6 transition-shadow duration-300 hover:shadow-float focus-within:shadow-float sm:flex-row sm:gap-8 sm:p-8',
                cardTone,
              ]}
            >
              <span
                aria-hidden="true"
                class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-teal-100 text-navy transition-colors duration-300 group-hover:bg-navy group-hover:text-white"
              >
                <svg
                  class="size-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
                  <path d="M14 3v5h5" />
                  <path d="M9 13h6M9 17h6" />
                </svg>
              </span>

              <div class="flex min-w-0 flex-1 flex-col">
                <h3 class="text-display-sm mt-3">
                  <a
                    href={withBase(item.file)}
                    data-doc={docKey(item.file, item.key)}
                    target="_blank"
                    rel="noopener"
                    type="application/pdf"
                    aria-describedby={hintId}
                    class="text-ink no-underline after:absolute after:inset-0 after:rounded-3xl group-hover:text-navy focus-visible:shadow-none focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-2 focus-visible:after:outline-navy"
                  >
                    {item.title}
                  </a>
                </h3>

                <p class="text-caption order-first flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold tracking-wider text-slate-700">
                  {labels.fileTypeLabel && <span class="uppercase">{labels.fileTypeLabel}</span>}
                  {item.kb !== undefined && (
                    <>
                      {labels.fileTypeLabel && <span aria-hidden="true">·</span>}
                      <span class="relative z-10 tabular-nums">
                        {kbFormat.format(item.kb)}
                        {labels.sizeUnit && <> {labels.sizeUnit}</>}
                        <DocNoteRef id="documentation-poids" />
                      </span>
                    </>
                  )}
                </p>

                <p class="mt-3 text-base leading-relaxed text-ink">{item.description}</p>

                <p class="mt-4 flex items-center justify-between gap-4 text-sm text-slate-700">
                  <span class="relative z-10">
                    {item.version}
                    <DocNoteRef id="documentation-versions" />
                  </span>
                  <svg
                    aria-hidden="true"
                    class="size-5 shrink-0 text-navy transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10h12M11 5l5 5-5 5" />
                  </svg>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
