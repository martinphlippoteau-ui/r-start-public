---
/**
 * FAQ de la page /documentation (id « faq ») : questions importées de faq.ts via documentation.faq
 * (les quatre premières, puis un renvoi vers /faq, voir documentation.ts).
 * Même construction que la section FAQ de l'accueil : en-tête collant face aux accordéons natifs
 * <details name="faq" data-faq> (un seul ouvert à la fois), chevron animé en CSS, réponse en text-lead.
 * Animation déclarative : seul chaque <summary> porte un fade-up.
 * Le JSON-LD FAQPage n'est pas émis ici (réservé à l'accueil et à /frais, plan §12).
 * Contenu : documentation.faq et documentation.labels.
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import type { DocumentationContent, DocumentationLabels } from '@/content/types-v2';
import { withBase } from '@/lib/href';

interface Props {
  faq: DocumentationContent['faq'];
  labels: DocumentationLabels;
  tone?: 'paper' | 'white';
}
const { faq, labels, tone = 'paper' } = Astro.props;
const id = 'faq';
const items = faq.items;
---

<Section id={id} tone={tone}>
  <Container size="wide">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* En-tête collant */}
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          {labels.faqEyebrow && <p class="text-eyebrow mb-4 text-teal-700">{labels.faqEyebrow}</p>}
          <h2 id={id + '-title'} class="text-display-md">{faq.title}</h2>
        </div>
      </div>

      {/* Questions */}
      <div class="lg:col-span-7">
        <ul role="list" aria-label={labels.faqListLabel} class="border-t border-navy/15">
          {
            items.map((item, i) => (
              <li class="border-b border-navy/15">
                <details name="faq" data-faq={item.question} class="faq-item group">
                  <summary
                    class="block cursor-pointer list-none py-6 [&::-webkit-details-marker]:hidden sm:py-8"
                    data-animate="fade-up"
                  >
                    <h3 class="flex items-start justify-between gap-5 text-display-sm text-ink transition-colors duration-200 group-hover:text-navy sm:gap-8">
                      <span class="flex min-w-0 flex-col gap-2 sm:flex-row sm:gap-6">
                        <span
                          aria-hidden="true"
                          class="text-eyebrow pt-1.5 text-teal-700 tabular-nums sm:pt-2"
                        >
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span>{item.question}</span>
                      </span>
                      <span
                        aria-hidden="true"
                        class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-full border border-navy/40 text-navy transition-[transform,background-color,border-color,color] duration-300 ease-out-expo group-hover:border-navy group-hover:bg-navy group-hover:text-white group-open:rotate-180 group-open:border-navy group-open:bg-navy group-open:text-white motion-reduce:transition-none sm:mt-1 sm:size-12"
                      >
                        <svg
                          class="size-5 sm:size-6"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                        >
                          <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </h3>
                  </summary>
                  <div class="faq-answer max-w-3xl space-y-5 pb-8 sm:pb-10 sm:pl-12">
                    {item.answer.map((paragraph) => (
                      <p class="text-lead text-ink">{paragraph}</p>
                    ))}
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
        {
          /* La page ne republie plus la FAQ entière : les autres questions restent lisibles sur
            /faq, à un lien d'ici. */
        }
        {
          faq.fullFaqLink && (
            <div class="mt-8 border-t border-navy/15 pt-8">
              <p class="text-base leading-relaxed text-slate-700">{faq.fullFaqLink.intro}</p>
              {/* `withBase` : c'était le SEUL chemin interne du site posé brut. Sous le sous-chemin de
                GitHub Pages il sortait du site et tombait en 404 (audit du 18/09/2026) ; invisible en
                local, où la base vaut « / ». scripts/check-compliance.mjs refuse désormais tout lien
                interne sans le préfixe du site. */}
              <a
                href={withBase(faq.fullFaqLink.href)}
                class="link-underline mt-4 inline-flex items-center gap-2 text-base font-semibold text-navy hover:text-teal-700 sm:text-lg"
              >
                {faq.fullFaqLink.label}
                <svg
                  aria-hidden="true"
                  class="size-4 shrink-0"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</Section>

{
  /* L'ouverture animée en hauteur de `.faq-item::details-content` (global.css, « Accordéons ») est
    la même ici que sur l'accueil et /faq : trois accordéons, un seul geste. */
}
