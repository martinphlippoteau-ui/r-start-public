---
/**
 * Clôture de la page /documentation : mention 2 (legal.documentsNotice via documentation.mention, texte
 * normal, jamais animée), renvoi vers corum.fr (nouvel onglet, rel noopener noreferrer, mention lue par
 * les lecteurs d'écran) et CTA vers le tunnel de souscription (position « souscrire »).
 * Bloc sans titre propre : simple région de page, pas une <Section> (qui exige un H2).
 * Contenu : documentation.mention, corumLink, cta et labels.newTabHint.
 */
import Button from '@/components/ui/Button.astro';
import IconExterne from '@/components/ui/IconExterne.astro';
import Container from '@/components/ui/Container.astro';
import type { Cta } from '@/content/types';

interface Props {
  mention: string;
  corumLink: { label: string; href: string };
  cta: Cta;
  newTabHint?: string;
}
const { mention, corumLink, cta, newTabHint } = Astro.props;
---

<div id="mention" data-section="mention" class="bg-white py-section-sm text-ink">
  <Container size="wide">
    <div class="rounded-3xl bg-paper p-6 sm:p-10 lg:p-12">
      <p class="text-lead max-w-4xl">{mention}</p>
      <div class="mt-8 flex flex-col items-stretch gap-4 sm:flex-row sm:flex-wrap sm:items-center">
        <Button position={cta.position} variant="primary" size="lg">{cta.label}</Button>
        <a
          href={corumLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link inline-flex items-center gap-2 self-center rounded-full px-3.5 py-2 text-base font-semibold text-navy no-underline transition-colors hover:bg-teal-100 sm:text-lg"
        >
          {corumLink.label}
          <IconExterne class="size-4 shrink-0" />
          {newTabHint && <span class="visually-hidden">({newTabHint})</span>}
        </a>
      </div>
    </div>
  </Container>
</div>
