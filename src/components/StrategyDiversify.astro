---
/**
 * Illustration de la tuile « Diversifiée » : un globe filaire et des épingles qui s'y plantent une
 * à une, PARTOUT (le monde), la tête de chacune portant un pictogramme de secteur, bureaux,
 * commerces, logistique, santé (tous les secteurs) : une épingle dit « ici » et « dans quoi » d'un
 * seul geste. Même grammaire que les quatre autres dessins des cartes (StrategySelect.astro la
 * décrit en tête) ; décorative (aria-hidden). Troisième forme, retenue le 16/09/2026 : l'équipe a
 * écarté le globe en rotation (« on diversifie dans les secteurs d'activité et géographique », il
 * ne montrait que la géographie ; StrategyGlobe.astro, supprimé le 19/09/2026, reste dans
 * l'historique git) puis le plan à deux axes, trop abstrait.
 * CE QU'ELLE NE DIT PAS : ni où précisément, ni combien. Le globe est filaire, sans côtes ni
 * frontières, les positions ne désignent aucun pays : R Start n'a pas encore de patrimoine. L'image
 * montre une INTENTION de répartition, ce que le texte dit en toutes lettres (« R Start
 * diversifiera »). LE GLOBE NE SE VIDE JAMAIS D'UN COUP : chaque épingle vit le même temps puis se
 * retire, dans l'ordre où elle est arrivée, pendant que les suivantes reviennent ; entre deux et
 * six épingles à tout instant, jamais zéro, un patrimoine qui tourne, pas un GIF qui repart de
 * zéro.
 */

/** Le globe : centre et rayon dans un cadre de 160 × 120. */
const CX = 80;
const CY = 62;
const R = 50;
/* Parallèles et méridiens vus de face, légèrement inclinés : un parallèle est une ellipse aplatie,
   un méridien une ellipse verticale. Les rayons des parallèles hors équateur suivent la sphère : à
   25 unités du centre, la sphère fait 43,3 de demi-largeur. */
const PARALLELES = [
  { cy: CY, rx: R, ry: 11 },
  { cy: CY - 25, rx: 43.3, ry: 9.5 },
  { cy: CY + 25, rx: 43.3, ry: 9.5 },
];
const MERIDIENS = [20, 40];

/* Six épingles, la pointe posée sur la sphère, réparties sur tout le disque : les quatre secteurs
   tournent, deux reviennent. L'ordre du tableau est celui de l'apparition, d'un bord à l'autre et
   jamais deux voisines de suite. */
type Secteur = 'bureaux' | 'commerces' | 'logistique' | 'sante';
const EPINGLES: { x: number; y: number; secteur: Secteur }[] = [
  { x: 60, y: 44, secteur: 'bureaux' },
  { x: 118, y: 68, secteur: 'commerces' },
  { x: 98, y: 94, secteur: 'logistique' },
  { x: 104, y: 38, secteur: 'sante' },
  { x: 44, y: 78, secteur: 'bureaux' },
  { x: 74, y: 82, secteur: 'commerces' },
];

/** L'épingle : une goutte dont la pointe est en (x, y), la tête un disque de rayon 6,5 centré 13 plus haut. */
const goutte = (x: number, y: number): string =>
  `M${x} ${y}C${x - 3} ${y - 4} ${x - 6.5} ${y - 8} ${x - 6.5} ${y - 13}a6.5 6.5 0 0 1 13 0c0 5-3.5 9-6.5 13z`;

/**
 * Les quatre pictogrammes, dessinés dans la tête (centre hx, hy, 7 unités de côté) : deux fenêtres
 * sur deux (bureaux), un auvent (commerces), un hangar à toit plat et large porte (logistique ; un
 * toit en pente ferait une maison), une croix (santé). Ils se lisent à 14 px.
 */
const picto = (secteur: Secteur, hx: number, hy: number): string => {
  switch (secteur) {
    case 'bureaux':
      return `M${hx - 3} ${hy - 3}h2.4v2.4h-2.4zM${hx + 0.6} ${hy - 3}h2.4v2.4h-2.4zM${hx - 3} ${hy + 0.6}h2.4v2.4h-2.4zM${hx + 0.6} ${hy + 0.6}h2.4v2.4h-2.4z`;
    case 'commerces':
      return `M${hx - 4} ${hy - 1}l1.5-2.5h5l1.5 2.5zM${hx - 3} ${hy - 1}v4.5h6v-4.5`;
    case 'logistique':
      return `M${hx - 4} ${hy + 3.5}v-6h8v6zM${hx - 1.5} ${hy + 3.5}v-3h3v3`;
    case 'sante':
      return `M${hx} ${hy - 3.4}v6.8M${hx - 3.4} ${hy}h6.8`;
  }
};
---

<figure class="div-figure" aria-hidden="true" data-in-view="illus-en-vue">
  <svg viewBox="0 0 160 120" fill="none" class="div-svg">
    {/* La sphère : un disque à peine teinté, son limbe, ses parallèles et ses méridiens. */}
    <circle cx={CX} cy={CY} r={R} class="div-disque" />
    {PARALLELES.map((p) => <ellipse cx={CX} cy={p.cy} rx={p.rx} ry={p.ry} class="div-trame" />)}
    <path d={`M${CX} ${CY - R}v${2 * R}`} class="div-trame" />
    {MERIDIENS.map((rx) => <ellipse cx={CX} cy={CY} rx={rx} ry={R} class="div-trame" />)}
    <circle cx={CX} cy={CY} r={R} class="div-limbe" />

    {
      /* Les épingles. Chacune a son onde au sol, qui s'élargit quand elle se plante, et son
        pictogramme dans la tête. Le groupe porte la chute, l'onde son propre battement. */
    }
    {
      EPINGLES.map((e, i) => (
        <g class="div-epingle" style={`--rang:${i}`}>
          <ellipse cx={e.x} cy={e.y} rx="7" ry="2.6" class="div-onde" />
          <g class="div-chute">
            <path d={goutte(e.x, e.y)} class="div-goutte" />
            <path d={picto(e.secteur, e.x, e.y - 13)} class={`div-picto div-picto--${e.secteur}`} />
          </g>
        </g>
      ))
    }
  </svg>
</figure>

<style>
  .div-figure {
    margin: 0;
    /* Pleine largeur de la carte : enfant d\'une boîte flex, la figure retomberait sinon à la largeur
       intrinsèque du SVG, 300 px. */
    width: 100%;
    --cycle: 8s;
    /* Une épingle toutes les demi-secondes : six en trois secondes, puis le globe reste couvert. */
    --pas: 0.5s;
    --decal: var(--illus-decalage, 0s);
  }
  .div-svg {
    display: block;
    width: 100%;
    aspect-ratio: 160 / 120;
  }
  .div-disque {
    fill: var(--illus-accent);
    fill-opacity: 0.06;
  }
  .div-limbe {
    stroke: rgb(var(--illus-trait-rgb) / 0.32);
    stroke-width: 1;
  }
  .div-trame {
    stroke: rgb(var(--illus-trait-rgb) / 0.16);
    stroke-width: 1;
  }
  .div-goutte {
    fill: var(--illus-fond);
    stroke: var(--illus-trait);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .div-picto {
    stroke: var(--illus-trait);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .div-picto--bureaux {
    fill: var(--illus-trait);
    stroke: none;
  }
  .div-picto--sante {
    stroke-width: 1.6;
  }

  /* État de repos = image complète : les six épingles plantées, le globe couvert, aucune onde. */
  .div-epingle {
    opacity: 1;
  }
  .div-chute {
    transform: translateY(0);
  }
  .div-onde {
    stroke: var(--illus-accent);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /*
   * LE CYCLE, 8 s, par épingle (chacune décalée de son rang × 0,5 s, à partir de 0,4 s) :
   *    0 –  7 %  elle tombe et se plante (douze unités, dépasse d'un cheveu, se pose), son onde
   *              s'élargit au sol et s'éteint ;  7 – 64 % elle est là ;  64 – 70 % elle se retire.
   * Chaque épingle vit donc 5,6 s ; la première revient 2,9 s après le départ de la dernière.
   */
  @media (prefers-reduced-motion: no-preference) {
    .div-epingle,
    .div-chute,
    .div-onde {
      animation-duration: var(--cycle);
      animation-iteration-count: infinite;
      animation-fill-mode: both;
      animation-delay: calc(var(--decal) + 0.4s + var(--rang) * var(--pas));
    }
    .div-epingle {
      animation-name: div-presence;
    }
    .div-chute {
      animation-name: div-chute;
    }
    .div-onde {
      animation-name: div-onde;
    }
  }

  @keyframes div-presence {
    0% {
      opacity: 0;
      animation-timing-function: var(--ease-out-expo);
    }
    5% {
      opacity: 1;
      animation-timing-function: linear;
    }
    64% {
      opacity: 1;
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    70%,
    100% {
      opacity: 0;
    }
  }
  @keyframes div-chute {
    0% {
      transform: translateY(-12px);
      animation-timing-function: cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    7% {
      transform: translateY(0);
      animation-timing-function: linear;
    }
    64% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    70%,
    100% {
      transform: translateY(-6px);
    }
  }
  @keyframes div-onde {
    0%,
    5% {
      opacity: 0;
      transform: scale(0.3);
      animation-timing-function: var(--ease-out-expo);
    }
    7% {
      opacity: 0.9;
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    17%,
    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }
</style>
