---
/**
 * Moitié droite commune aux deux moteurs de /strategie (EngineRent.astro, EngineGain.astro) :
 * le versement gagne la marque R Start, qui le PARTAGE entre trois épargnants. Rendu DANS le
 * <svg> 236 × 100 de l'appelant. CE QU'ELLE DIT : ce que la SCPI encaisse revient aux épargnants
 * sous forme de dividendes (strategy.ts, texte des deux cartes). AUCUN CHIFFRE, AUCUNE ÉCHELLE,
 * RIEN QUI MONTE : trois parts égales, trois personnes, et le mot « Épargnants ». Dessin retenu
 * par Martin le 24/09/2026 (« la répartition ») après cinq pistes et dix variations essayées,
 * audité le 25/09/2026, et posé ici le même jour.
 * La marque est une goutte teal au R blanc, comme le logo sur l'écran de l'application (DA) : la
 * goutte pleine du dessous est blanche et se voit par le R évidé du tracé du dessus, sinon on
 * voyait la pièce passer au travers.
 * TEMPO fourni par l'appelant en variables CSS : `--partage-duree` (la durée du cycle de l'appelant)
 * et `--partage-retard` (l'instant où le versement atteint la marque) ; la marque s'assombrit un
 * dixième de seconde avant, les parts partent à cet instant et arrivent 28 % de la durée plus tard,
 * les épargnants répondent alors d'un battement. `--decal` : décalage de la carte voisine.
 */
const MARQUE =
  'M68.21.17C36.7,3.24,5.47,23.07,2.44,29.88c-11.59,26.1,21.48,52.52,27.22,55.34,21.52,10.59,48.04-1.99,59.51-27.5C93.5,48.09,104.2-3.34,68.21.17ZM64.76,69.76c-1.25,0-2.36-.57-3.09-1.47l-2.84-3.52c-4.06-4.98-10.05-12.1-12.26-13.54-1.92-1.22-4.48-1.84-7.59-1.84l-7.96.02c-2.02,0-3.66-1.64-3.66-3.66s1.64-3.66,3.66-3.66h18.33c3.05-.01,5.54-2.14,5.54-4.76s-2.49-4.74-5.54-4.74h-18.34c-2.02,0-3.66-1.63-3.66-3.65s1.64-3.66,3.66-3.66h18.34c7.58,0,13.73,5.4,13.73,12.05,0,4.74-3.2,9.03-8.07,10.97,3.22,3.36,7.64,8.61,11.3,13.08l1.52,1.86c.57.69.91,1.57.91,2.54,0,2.2-1.79,3.99-3.99,3.99Z';
/** La goutte pleine : le premier sous-chemin. */
const MARQUE_FOND = MARQUE.slice(0, MARQUE.indexOf('Z') + 1);
/** Les trois épargnants, de haut en bas. */
const RANGS = [28, 56, 84];
---

{/* Du versement à la marque, puis de la marque à chaque épargnant. */}
<path d="M92 56h40" class="partage-chemin" />
{RANGS.map((y) => <path d={`M146 56C170 56 176 ${y} 200 ${y}`} class="partage-chemin" />)}
{
  RANGS.map((y, e) => (
    <>
      <circle cx="146" cy="56" r="2.4" class="partage-part" style={`--e:${e};--dy:${y - 56}px`} />
      <g class="partage-epargnant" style={`--e:${e}`}>
        <circle cx="208" cy={y - 4} r="3.5" class="partage-trait" />
        <path d={`M201 ${y + 8}c0-4.5 3-7 7-7s7 2.5 7 7`} class="partage-trait" />
      </g>
    </>
  ))
}
<text x="208" y="99" class="partage-libelle">Épargnants</text>
<svg x="118" y="46" width="22" height="21" viewBox="0 0 94.08 88.98" class="partage-marque">
  <path d={MARQUE_FOND} class="partage-marque-fond" />
  <path d={MARQUE} />
</svg>

<style>
  .partage-chemin {
    stroke: rgb(var(--illus-trait-rgb) / 0.22);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }
  .partage-trait {
    stroke: rgb(var(--illus-trait-rgb) / 0.38);
    stroke-width: 1.6;
  }
  .partage-part {
    fill: var(--illus-trait);
    transform-box: fill-box;
    transform-origin: center;
    /* Repos : à mi-chemin de sa courbe. */
    transform: translate(27px, calc(var(--dy) / 2));
  }
  .partage-epargnant {
    fill: var(--illus-fond);
    transform-box: fill-box;
    transform-origin: center;
  }
  .partage-libelle {
    fill: rgb(var(--illus-trait-rgb) / 0.7);
    font-family: inherit;
    font-size: 6.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-anchor: middle;
  }
  .partage-marque {
    fill: var(--color-teal-700);
  }
  .partage-marque-fond {
    fill: var(--illus-fond);
  }

  @media (prefers-reduced-motion: no-preference) {
    .partage-marque {
      animation: partage-relais var(--partage-duree) infinite both;
      animation-delay: calc(var(--decal) + var(--partage-retard) - 0.1s);
    }
    .partage-part {
      animation: partage-part var(--partage-duree) infinite both;
      animation-delay: calc(var(--decal) + var(--partage-retard));
    }
    .partage-epargnant {
      animation: partage-battement var(--partage-duree) infinite both;
      animation-delay: calc(var(--decal) + var(--partage-retard) + var(--partage-duree) * 0.28 + var(--e) * 0.08s);
    }
  }
  /* La part naît à la marque, suit sa courbe, s'efface au bord de l'épargnant. */
  @keyframes partage-part {
    0% { opacity: 0; transform: translate(0, 0) scale(0.3); animation-timing-function: var(--ease-out-expo); }
    8% { opacity: 1; transform: translate(4px, 0) scale(1); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    28% { opacity: 1; transform: translate(50px, var(--dy)) scale(1); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    34%, 100% { opacity: 0; transform: translate(52px, var(--dy)) scale(0.3); }
  }
  @keyframes partage-battement {
    0%, 4% { transform: scale(1); animation-timing-function: var(--ease-out-expo); }
    10% { transform: scale(1.25); animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1); }
    30%, 100% { transform: scale(1); }
  }
  @keyframes partage-relais {
    0% { opacity: 1; }
    4% { opacity: 0.55; }
    14%, 100% { opacity: 1; }
  }
</style>
