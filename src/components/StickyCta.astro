---
/**
 * Pastille d'appel flottante (12/09/2026, demande de l'équipe). Un rond portant un chevron se pose en bas
 * de l'écran, puis se DÉPLIE en pastille pour révéler son libellé.
 *
 * Déclenchement : la disparition d'un REPÈRE de la page, l'invitation à défiler du hero (« Découvrir
 * R Start »). Tant qu'on la voit, elle dit déjà où aller et la pastille n'a rien à faire là ; dès qu'elle
 * n'est plus à l'écran, la pastille prend le relais. Elle se replie si le repère revient, au défilement
 * vers le haut. Les deux ne sont donc jamais visibles ensemble.
 *
 * Elle se replie aussi À PARTIR d'une section de fin (`until`), dès son premier pixel : au-delà, le
 * visiteur a dépassé ce que la pastille proposait, et elle empiéterait sur la section qui arrive.
 * Elle revient si l'on remonte au-dessus.
 *
 * « Ne plus être à l'écran » se mesure de DEUX façons, et il en faut deux. Sur téléphone, le repère sort
 * simplement du cadre. Sur grand écran, le hero est ÉPINGLÉ par le rideau de la section suivante : sa
 * boîte ne quitte jamais l'écran, elle reste à la même place pendant que le rideau la recouvre, et c'est
 * son opacité, menée par le défilement lié, qui tombe à zéro. Ne regarder que la géométrie ferait
 * apparaître la pastille mille pixels trop tard sur grand écran ; ne regarder que l'opacité la rendrait
 * aveugle sans le moteur d'animation. On regarde les deux.
 *
 * Rendue au niveau de la PAGE, jamais dans une section. Les sections de l'accueil sont épinglées au
 * défilement (`data-curtain`) : un ancêtre transformé devient le bloc conteneur d'un enfant `fixed`, la
 * pastille se calerait alors sur la section au lieu du viewport.
 *
 * Direction artistique : celle du bouton secondaire (contour navy, texte navy, remplissage au survol),
 * posée sur du verre liquide, la même matière que la barre de navigation.
 *
 * Elle disparaît tant que le bandeau cookies est déplié, il occupe la même place, et se retire du
 * parcours au clavier quand elle est invisible (`visibility`, pas seulement l'opacité).
 * Ce n'est pas un CTA de souscription : pas d'attribut `data-cta`, rien à compter côté conformité.
 */
interface Props {
  label: string;
  href: string;
  /** Sélecteur du repère dont la disparition fait apparaître la pastille, et le retour la replie. */
  watch: string;
  /** Sélecteur de la section à partir de laquelle la pastille se replie, dès son premier pixel. */
  until: string;
}
const { label, href, watch, until } = Astro.props as Props;
---

<div
  data-sticky-cta
  data-watch={watch}
  data-until={until}
  class="pointer-events-none fixed inset-x-0 bottom-4 z-30 flex justify-center px-4 sm:bottom-6"
>
  <a
    href={href}
    data-sticky-link
    class="cta-glass pointer-events-auto inline-flex h-14 min-w-14 items-center justify-center rounded-full border border-navy/60 text-base font-semibold text-navy no-underline outline-offset-4 hover:border-navy hover:bg-navy hover:text-white focus-visible:outline-3 focus-visible:outline-navy"
  >
    {
      /* Le libellé est dans une grille à une colonne : sa largeur passe de 0fr à 1fr, ce qui se transite,
        là où `width: auto` ne se transite pas. L'enfant coupe ce qui dépasse et ne se coupe jamais en
        deux lignes pendant le dépliage. */
    }
    <span data-sticky-label class="grid">
      <span class="overflow-hidden whitespace-nowrap">{label}</span>
    </span>
    <svg
      aria-hidden="true"
      class="size-5 shrink-0"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 3.5 10.5 8 6 12.5"></path>
    </svg>
  </a>
</div>

<script>
  /*
   * Un seul attribut porte l'état : `data-on`. Le rond se pose, et le dépliage suit, retardé en CSS
   * (global.css) : pas de minuterie à tenir en JavaScript, donc rien à annuler si l'on défile vite.
   *
   * Une seule lecture de défilement par frame, comme la barre de navigation, et aucune dépendance au
   * moteur d'animation : la pastille doit vivre même si GSAP n'est pas chargé.
   */
  const box = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const repere = box?.dataset.watch ? document.querySelector<HTMLElement>(box.dataset.watch) : null;
  /* Borne de fin. Absente, la pastille reste jusqu'au bas de page : c'est le repli prévu. */
  const fin = box?.dataset.until ? document.querySelector<HTMLElement>(box.dataset.until) : null;

  if (box && repere) {
    /* L'opacité se lit sur l'ENVELOPPE de défilement lié, celle que le moteur d'animation pilote ; le
       repère lui-même garde son opacité propre. Sans moteur, il n'y a pas d'enveloppe et l'opacité vaut
       1 : seule la géométrie décide alors, ce qui est exactement le bon repli, puisque sans moteur le
       hero n'est pas épinglé non plus et sort du cadre normalement. */
    const enveloppe = repere.closest<HTMLElement>('[data-scrub]') ?? repere;

    const repereVisible = () => {
      const r = repere.getBoundingClientRect();
      if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
      return parseFloat(getComputedStyle(enveloppe).opacity) > 0.05;
    };

    /* « À partir de » : dès que la section de fin montre son premier pixel en bas de l'écran. La
       pastille y est posée, elle empiéterait sur la section qui arrive. */
    const finAtteinte = () => !!fin && fin.getBoundingClientRect().top < window.innerHeight;

    let frame = 0;
    const sync = () => {
      frame = 0;
      box.toggleAttribute('data-on', !repereVisible() && !finAtteinte());
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(sync);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    sync();
  }
</script>
