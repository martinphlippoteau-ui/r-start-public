---
/**
 * Pastille d'appel flottante (12/09/2026, demande de l'équipe) : un rond à chevron se pose en bas
 * de l'écran, puis se DÉPLIE en pastille pour révéler son libellé. Rendue au niveau de la PAGE,
 * après </main>, jamais dans une section : les sections de l'accueil sont épinglées
 * (`data-curtain`) et un ancêtre transformé devient le bloc conteneur d'un enfant `fixed`.
 * DEUX DÉCLENCHEURS, il en faut exactement un : `watch`, la pastille apparaît quand ce repère N'EST
 * PLUS à l'écran (celle du comparateur relaie l'invitation à défiler du hero, jamais visibles
 * ensemble) ; `from`, elle apparaît quand ce repère EST ATTEINT, premier pixel en bas de l'écran
 * (celle de la souscription arrive avec sa section). `until` la replie dès le premier pixel d'une
 * section de fin, sur laquelle elle empiéterait ; sans elle, elle reste jusqu'en bas. « À l'écran »
 * se mesure en géométrie ET en opacité : voir `visible` dans le script.
 * Direction artistique (12/09/2026, demande de l'équipe) : REPLIÉE, la pastille n'est que son rond
 * de chevron, navy plein ; DÉPLIÉE, elle s'ouvre en BLANC PLEIN, libellé navy, le rond (élément à
 * part, `.sticky-dot`) restant à droite, inchangé. Pas de verre : au ras du texte, les lignes du
 * dessous se lisaient à travers. Elle disparaît tant que le bandeau cookies est déplié (même place)
 * et sort du parcours clavier quand elle est invisible (`visibility`, pas seulement l'opacité).
 * AU CLAVIER, UNE PASTILLE BORNÉE PAR `until` N'EST JAMAIS ATTEINTE (audit du 18/09/2026) : la
 * tabulation l'atteint en bas de page, repliée. Admis À UNE CONDITION : TOUTE PASTILLE A UN
 * ÉQUIVALENT DANS LE FLUX, un lien de même destination dans <main> ; tests/qualite.spec.ts le
 * vérifie.
 * SANS `href`, c'est un CTA de souscription : `data-cta` pour la mesure d'audience, comme Button,
 * même destination (config/site.ts, ctaHref). Avec `href`, un lien interne sans `data-cta`.
 */
import { ctaHref, site } from '@/config/site';
import { withBase } from '@/lib/href';
import type { CtaPosition } from '@/content/types';

interface Props {
  label: string;
  /** Lien interne. Sans valeur, la pastille mène au tunnel de souscription. */
  href?: string;
  position?: CtaPosition;
  /** Sélecteur du repère dont la DISPARITION fait apparaître la pastille, et le retour la replie. */
  watch?: string;
  /** Sélecteur du repère dont l'ARRIVÉE fait apparaître la pastille, dès son premier pixel. */
  from?: string;
  /** Sélecteur du repère à partir duquel la pastille se replie. Absent : elle reste jusqu'en bas. */
  until?: string;
}
const { label, href, position = 'sticky', watch, from, until } = Astro.props as Props;

const souscription = !href;
const lien = href ? withBase(href) : ctaHref(position);
---

<div
  data-sticky-cta
  data-watch={watch}
  data-from={from}
  data-until={until}
  class="pointer-events-none fixed inset-x-0 bottom-4 z-30 flex justify-center px-4 sm:bottom-6"
>
  <a
    href={lien}
    data-sticky-link
    data-cta={souscription ? 'souscrire' : undefined}
    data-cta-position={souscription ? position : undefined}
    rel={souscription && site.subscribeOpen ? 'noopener' : undefined}
    class="sticky-skin pointer-events-auto relative isolate inline-flex h-16 min-w-16 items-center justify-center rounded-full text-lg font-semibold no-underline outline-offset-4 focus-visible:outline-3 focus-visible:outline-navy"
  >
    {
      /* Le libellé est dans une grille à une colonne : sa largeur passe de 0fr à 1fr, ce qui se transite,
        là où `width: auto` ne se transite pas. L'enfant coupe ce qui dépasse et ne se coupe jamais en
        deux lignes pendant le dépliage. */
    }
    <span data-sticky-label class="grid">
      <span class="overflow-hidden whitespace-nowrap">{label}</span>
    </span>
    {
      /* Le rond, toujours là et toujours identique : c'est lui qu'on voit seul quand la pastille est
        repliée, et il reste à droite quand elle s'ouvre. */
    }
    <span class="sticky-dot">
      <svg
        aria-hidden="true"
        class="size-6"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 3.5 10.5 8 6 12.5"></path>
      </svg>
    </span>
  </a>
</div>

<script>
  /* Un seul attribut porte l'état : `data-on`. Le rond se pose et le dépliage suit, retardé en CSS
     (global.css) : pas de minuterie en JavaScript, rien à annuler si l'on défile vite. Plusieurs
     pastilles peuvent cohabiter, chacune avec son déclencheur : un seul écouteur de défilement les
     met à jour ensemble, une fois par frame. Aucune dépendance au moteur d'animation : elles vivent
     même sans GSAP. */
  const pastilles = [...document.querySelectorAll<HTMLElement>('[data-sticky-cta]')];

  if (pastilles.length) {
    /* Un repère est ATTEINT dès que son premier pixel entre par le bas de l'écran. */
    const atteint = (el: Element | null) =>
      !!el && el.getBoundingClientRect().top < window.innerHeight;

    /* Un repère est VISIBLE s'il est dans le cadre ET pas effacé par le défilement lié : sur
       téléphone, il sort simplement du cadre ; sur grand écran, le hero est ÉPINGLÉ par le rideau
       de la section suivante, sa boîte ne quitte jamais l'écran et c'est son opacité, menée par le
       défilement lié, qui tombe à zéro. La géométrie seule ferait apparaître la pastille mille
       pixels trop tard sur grand écran ; l'opacité seule serait aveugle sans moteur d'animation,
       absent justement quand le hero n'est pas épinglé. */
    const visible = (el: HTMLElement | null) => {
      if (!el) return false;
      const r = el.getBoundingClientRect();
      if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
      const enveloppe = el.closest<HTMLElement>('[data-scrub]') ?? el;
      return parseFloat(getComputedStyle(enveloppe).opacity) > 0.05;
    };

    const cible = (sel: string | undefined) =>
      sel ? document.querySelector<HTMLElement>(sel) : null;

    const reglees = pastilles.map((box) => ({
      box,
      /* Disparition d'un repère, ou arrivée d'un autre : exactement un des deux est renseigné. */
      surDisparition: cible(box.dataset.watch),
      surArrivee: cible(box.dataset.from),
      fin: cible(box.dataset.until),
    }));

    let frame = 0;
    const sync = () => {
      frame = 0;
      for (const p of reglees) {
        const ouverte = p.surArrivee ? atteint(p.surArrivee) : !visible(p.surDisparition);
        p.box.toggleAttribute('data-on', ouverte && !atteint(p.fin));
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(sync);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    sync();
  }
</script>
