---
/**
 * Pastille d'appel flottante (12/09/2026, demande de l'équipe). Un rond portant un chevron se pose en bas
 * de l'écran, puis se DÉPLIE en pastille pour révéler son libellé.
 *
 * Déclenchement : la disparition d'un REPÈRE de la page, l'invitation à défiler du hero (« Découvrir
 * R Start »). Tant qu'on la voit, elle dit déjà où aller et la pastille n'a rien à faire là ; dès qu'elle
 * n'est plus à l'écran, la pastille prend le relais. Elle se replie si le repère revient, au défilement
 * vers le haut. Les deux ne sont donc jamais visibles ensemble.
 *
 * Elle se replie aussi À PARTIR d'une section de fin (`until`), dès son premier pixel : au-delà, le
 * visiteur a dépassé ce que la pastille proposait, et elle empiéterait sur la section qui arrive.
 * Elle revient si l'on remonte au-dessus.
 *
 * « Ne plus être à l'écran » se mesure de DEUX façons, et il en faut deux. Sur téléphone, le repère sort
 * simplement du cadre. Sur grand écran, le hero est ÉPINGLÉ par le rideau de la section suivante : sa
 * boîte ne quitte jamais l'écran, elle reste à la même place pendant que le rideau la recouvre, et c'est
 * son opacité, menée par le défilement lié, qui tombe à zéro. Ne regarder que la géométrie ferait
 * apparaître la pastille mille pixels trop tard sur grand écran ; ne regarder que l'opacité la rendrait
 * aveugle sans le moteur d'animation. On regarde les deux.
 *
 * Rendue au niveau de la PAGE, jamais dans une section. Les sections de l'accueil sont épinglées au
 * défilement (`data-curtain`) : un ancêtre transformé devient le bloc conteneur d'un enfant `fixed`, la
 * pastille se calerait alors sur la section au lieu du viewport.
 *
 * Direction artistique en DEUX TEMPS (12/09/2026, demande de l'équipe), qui suit le pliage :
 *  - REPLIÉE, la pastille n'est que son rond de chevron, en couleur de CTA primaire, navy plein. C'est
 *    l'appel, réduit à un point ;
 *  - DÉPLIÉE, elle prend la MATIÈRE DE LA BARRE DE NAVIGATION, le même utilitaire `nav-glass` et donc
 *    la même transparence, libellé navy, et le rond reste, à droite, inchangé. Le point d'appel ne
 *    disparaît donc jamais, la pastille pousse autour de lui.
 * Le rond est un élément à part (`data-sticky-dot`) : c'est le seul moyen qu'il garde sa taille et sa
 * couleur pendant que tout le reste change autour.
 *
 * Elle disparaît tant que le bandeau cookies est déplié, il occupe la même place, et se retire du
 * parcours au clavier quand elle est invisible (`visibility`, pas seulement l'opacité).
 *
 * DEUX DÉCLENCHEURS, un par usage, et il faut en donner exactement un :
 *  - `watch` : la pastille apparaît quand ce repère N'EST PLUS à l'écran (la pastille du comparateur
 *    prend le relais de l'invitation à défiler du hero) ;
 *  - `from` : elle apparaît quand ce repère EST ATTEINT, premier pixel en bas de l'écran (la pastille
 *    de souscription arrive avec la section qui la propose).
 * `until` borne la fin ; sans elle, la pastille reste jusqu'au bas de la page.
 *
 * SANS `href`, c'est un CTA vers le tunnel de souscription : URL centralisée, `data-cta` pour la mesure
 * d'audience, exactement comme le composant Button. Avec `href`, c'est un lien interne, sans `data-cta`,
 * rien à compter côté conformité.
 */
import { subscribeHref } from '@/config/site';
import { withBase } from '@/lib/href';
import type { CtaPosition } from '@/content/types';

interface Props {
  label: string;
  /** Lien interne. Sans valeur, la pastille mène au tunnel de souscription. */
  href?: string;
  position?: CtaPosition;
  /** Sélecteur du repère dont la DISPARITION fait apparaître la pastille, et le retour la replie. */
  watch?: string;
  /** Sélecteur du repère dont l'ARRIVÉE fait apparaître la pastille, dès son premier pixel. */
  from?: string;
  /** Sélecteur du repère à partir duquel la pastille se replie. Absent : elle reste jusqu'en bas. */
  until?: string;
}
const { label, href, position = 'sticky', watch, from, until } = Astro.props as Props;

const souscription = !href;
const lien = href ? withBase(href) : subscribeHref(position);
---

<div
  data-sticky-cta
  data-watch={watch}
  data-from={from}
  data-until={until}
  class="pointer-events-none fixed inset-x-0 bottom-4 z-30 flex justify-center px-4 sm:bottom-6"
>
  <a
    href={lien}
    data-sticky-link
    data-cta={souscription ? 'souscrire' : undefined}
    data-cta-position={souscription ? position : undefined}
    rel={souscription ? 'noopener' : undefined}
    class="nav-glass sticky-skin pointer-events-auto relative isolate inline-flex h-16 min-w-16 items-center justify-center rounded-full text-lg font-semibold no-underline outline-offset-4 focus-visible:outline-3 focus-visible:outline-navy"
  >
    {
      /* Le libellé est dans une grille à une colonne : sa largeur passe de 0fr à 1fr, ce qui se transite,
        là où `width: auto` ne se transite pas. L'enfant coupe ce qui dépasse et ne se coupe jamais en
        deux lignes pendant le dépliage. */
    }
    <span data-sticky-label class="grid">
      <span class="overflow-hidden whitespace-nowrap">{label}</span>
    </span>
    {
      /* Le rond, toujours là et toujours identique : c'est lui qu'on voit seul quand la pastille est
        repliée, et il reste à droite quand elle s'ouvre. */
    }
    <span data-sticky-dot class="sticky-dot">
      <svg
        aria-hidden="true"
        class="size-6"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 3.5 10.5 8 6 12.5"></path>
      </svg>
    </span>
  </a>
</div>

<script>
  /*
   * Un seul attribut porte l'état : `data-on`. Le rond se pose, et le dépliage suit, retardé en CSS
   * (global.css) : pas de minuterie à tenir en JavaScript, donc rien à annuler si l'on défile vite.
   *
   * PLUSIEURS pastilles peuvent cohabiter sur une page, chacune avec son déclencheur : la boucle les
   * traite toutes, et un seul écouteur de défilement les met à jour ensemble, une fois par frame.
   * Aucune dépendance au moteur d'animation : elles doivent vivre même si GSAP n'est pas chargé.
   */
  const pastilles = [...document.querySelectorAll<HTMLElement>('[data-sticky-cta]')];

  if (pastilles.length) {
    /* Un repère est ATTEINT dès que son premier pixel entre par le bas de l'écran. */
    const atteint = (el: Element | null) =>
      !!el && el.getBoundingClientRect().top < window.innerHeight;

    /*
     * Un repère est VISIBLE s'il est dans le cadre ET pas effacé par le défilement lié.
     * Les deux mesures comptent. Sur téléphone, le repère sort simplement du cadre. Sur grand écran, le
     * hero est ÉPINGLÉ par le rideau de la section suivante : sa boîte ne quitte jamais l'écran, elle
     * reste à la même place pendant que le rideau la recouvre, et c'est son opacité, menée par le
     * défilement lié, qui tombe à zéro. La géométrie seule ferait apparaître la pastille mille pixels
     * trop tard sur grand écran ; l'opacité seule serait aveugle sans moteur d'animation, qui est
     * justement absent quand le hero n'est pas épinglé.
     */
    const visible = (el: HTMLElement | null) => {
      if (!el) return false;
      const r = el.getBoundingClientRect();
      if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
      const enveloppe = el.closest<HTMLElement>('[data-scrub]') ?? el;
      return parseFloat(getComputedStyle(enveloppe).opacity) > 0.05;
    };

    const cible = (sel: string | undefined) =>
      sel ? document.querySelector<HTMLElement>(sel) : null;

    const reglees = pastilles.map((box) => ({
      box,
      /* Disparition d'un repère, ou arrivée d'un autre : exactement un des deux est renseigné. */
      surDisparition: cible(box.dataset.watch),
      surArrivee: cible(box.dataset.from),
      fin: cible(box.dataset.until),
    }));

    let frame = 0;
    const sync = () => {
      frame = 0;
      for (const p of reglees) {
        const ouverte = p.surArrivee ? atteint(p.surArrivee) : !visible(p.surDisparition);
        p.box.toggleAttribute('data-on', ouverte && !atteint(p.fin));
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(sync);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    sync();
  }
</script>
