# Copier en .env (dev) ou définir dans les variables de build Azure / GitHub Actions.

# Domaine public du site (canonical, sitemap, Open Graph). Sans slash final.
PUBLIC_SITE_URL=https://r-start.com

# URL du tunnel de souscription réglementé (tous les CTA « Souscrire » pointent ici le jour où la
# souscription ouvre). Ajouter ici les paramètres de tracking si nécessaire (code partenaire, UTM).
# La valeur est entre guillemets : sans eux, tout ce qui suit un « # » est lu comme un commentaire.
PUBLIC_SUBSCRIBE_URL="https://www.corum.fr/?tunnel=r-start#placeholder"

# « true » le jour où la souscription ouvre. Vide ou « false » : tous les CTA « Souscrire » ouvrent la
# fenêtre « la souscription arrive bientôt » au lieu de quitter le site.
PUBLIC_SUBSCRIBE_OPEN=false

# Conteneur Google Tag Manager. Vide = aucun tag chargé.
# Il n'est PAS posé en dur dans le <head> : src/scripts/consent.ts l'injecte après accord,
# avec exactement la même requête que l'extrait officiel de Google.
PUBLIC_GTM_ID=GTM-K7B4GX8Z
